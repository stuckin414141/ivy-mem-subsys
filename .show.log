schema [rec[nat]][rec[nat]] {
    type q
    function base(V0:nat) : q
    function step(V0:q,V1:nat) : q
    function fun(V0:nat) : q
    property fun(X) = (base(X) if (X <= 0) else step(fun(X - 1),X))
}

schema [ind[nat]][ind[nat]] {
    relation p(V0:nat)
    property [base] {
        individual x : nat
        property x <= 0 -> p(x)
    }
    property [step] {
        individual x : nat
        property p(x) -> p(x + 1)
    }
    property p(X)
}

schema [lep[nat]][lep[nat]] {
    individual n : nat
    relation p(V0:nat)
    property exists L. (L:nat >= n & (forall B. (B:nat >= n & p(B)) -> (p(L) & L <= B)))
}

