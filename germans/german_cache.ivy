#lang ivy1.8

include numbers
include order

type key
type word
type line
type bit
type bv2

type ch2typ
type mshr_id

type store_idx
type load_idx

type four_words

# ---- a whole cache line: the unit the directory and the client trade.
# Two `four_words` beats wide, but the channels never see the seam. ----
type cache_line

function pack4(W3 : word, W2 : word, W1 : word, W0 : word) : four_words
function unp0(M : four_words) : word
function unp1(M : four_words) : word
function unp2(M : four_words) : word
function unp3(M : four_words) : word
function wsel4(M : four_words, J : bv2) : word
function wins4(M : four_words, J : bv2, D : word) : four_words

type addr
type woffset
type way

type cache_slot
# ---- the line <-> beat bridge.  `lsel`/`lins` are the word-granular view a
# cache needs; `lpack`/`lhi`/`llo` are the beat-granular view the memory
# controller needs, and the select-of-pack properties in `data_impl` are the
# only place the two meet. ----
function lsel(L : cache_line, O : woffset) : word
function lins(L : cache_line, O : woffset, D : word) : cache_line
function lpack(HI : four_words, LO : four_words) : cache_line
function lhi(L : cache_line) : four_words
function llo(L : cache_line) : four_words


# ---- the memory controller's service counter.  `nat` has no bit
# width, so it cannot appear in a hardware description. ----
type latency

# ---- control-state encodings.  Ivy enumerated types have no bit width
# either; these are narrow bit vectors whose named values are declared as
# 0-ary wires inside the isolate that uses them. ----
type mstate
type dstate
type wbstate
type mkstate

# ---- the queue index types.  A queue is a fixed-size array plus a head and
# a tail pointer: `qidx` indexes the array, and `qptr` is ONE BIT WIDER so
# that `tail - head` counts 0, 1 or 2 and an empty queue never aliases a
# full one.  Depth is two everywhere.  That is what the traffic needs and no
# more: both caches can surrender on consecutive edges, and one cache's
# request can sit behind the other's while a transaction runs. ----
type qidx
type qptr

# ---- the array slot a pointer names.  `wire`, so `ivy_to_rtl` emits the
# truncation rather than a call into the address theory. ----
wire qi(P : qptr) : qidx

# Copies of the above functions that can be synthesized to RTL. Kept separate
# so that use does not pull in the adddress theory
wire hw_pack4(W3 : word, W2 : word, W1 : word, W0 : word) : four_words
wire hw_unp0(M : four_words) : word
wire hw_unp1(M : four_words) : word
wire hw_unp2(M : four_words) : word
wire hw_unp3(M : four_words) : word
wire hw_wsel4(M : four_words, J : bv2) : word
wire hw_wins4(M : four_words, J : bv2, D : word) : four_words
wire hw_lsel(L : cache_line, O : woffset) : word
wire hw_lins(L : cache_line, O : woffset, D : word) : cache_line
wire hw_lpack(HI : four_words, LO : four_words) : cache_line
wire hw_lhi(L : cache_line) : four_words
wire hw_llo(L : cache_line) : four_words
wire hw_concatbv3(H : line, O : woffset) : addr
wire hw_high(A : addr) : line
wire hw_low(A : addr) : woffset
wire hw_concatbv2(B : bit, J : bv2) : woffset
wire hw_beat_of(O : woffset) : bit
wire hw_boff2(O : woffset) : bv2
wire hw_hash(H : line) : key
wire hw_cidx(K : key, W : way) : cache_slot

# ---- the narrow index types.  These are interpreted where every
# isolate can see them: they are three and four bit wide, so a
# quantifier over one costs the solver nothing, and both `data_impl`
# and `addr_thy` below need the widths to line up their concatenations.
# ----
isolate basis = {
    interpret key -> bv[3]
    interpret bit -> bv[1]
    interpret bv2 -> bv[2]
    interpret ch2typ -> bv[2]
    interpret mshr_id -> bv[1]
    interpret store_idx -> bv[3]
    interpret load_idx -> bv[3]
    interpret cache_slot -> bv[4]
    interpret latency -> bv[4]
    interpret mstate -> bv[3]
    interpret dstate -> bv[2]
    interpret wbstate -> bv[4]
    interpret mkstate -> bv[2]
    interpret qidx -> bv[1]
    interpret qptr -> bv[2]

    definition qi(P) = bfe[0][0](P)
}

function concatbv3(H : line, O : woffset) : addr
function high(A : addr) : line
function low(A : addr) : woffset
function concatbv2(B : bit, J : bv2) : woffset
function beat_of(O : woffset) : bit
function boff2(O : woffset) : bv2
function hash(H : line) : key
function cidx(K : key, W : way) : cache_slot

function init_mem(A : addr) : word   # the power-on memory image

# ---- the same image, indexed by the (line, offset) PAIR.  The cache's
# array and the controller's memory are both powered on from THIS one,
# not from `init_mem`, and that is load-bearing rather than cosmetic:
# `mem_img` below equates the two at an arbitrary address `A`, and if
# one side started at `init_mem(A)` and the other at
# `init_mem(concatbv3(high(A), low(A)))` the base case would need
# `p_recon` -- which `addr_thy` deliberately does not export, because
# outside it that equation is a matching loop.  Starting both from
# `init_img(high(A), low(A))` makes the base case syntactic.
# `p_initimg` ties it back to `init_mem` for the LSQ, which is where
# the trace's own image comes in.
function init_img(H : line, O : woffset) : word

isolate addr_thy = {
    interpret woffset -> bv[3]
    interpret way -> bv[1]
    definition concatbv2(B, J) = B :: J

    property [p_way2]  forall W : way. W = 0 | W = 1
    property [p_way_ne] (0 : way) ~= (1 : way)
    property [p_bit2]  forall B : bit. B = 0 | B = 1

    property [p_boff_beat]  forall B : bit, J : bv2. beat_of(concatbv2(B, J)) = B
    property [p_boff_word]  forall B : bit, J : bv2. boff2(concatbv2(B, J)) = J
    property [p_cover] forall O : woffset, B : bit. beat_of(O) = B ->
        (O = concatbv2(B, 0) | O = concatbv2(B, 1) | O = concatbv2(B, 2) | O = concatbv2(B, 3))
    property [p_full_inj] forall H1 : line, O1 : woffset, H2 : line, O2 : woffset. (concatbv3(H1, O1) = concatbv3(H2, O2)) -> (H1 = H2 & O1 = O2)
    property [p_highfull] forall H : line, O : woffset. high(concatbv3(H, O)) = H
    property [p_lowfull]  forall H : line, O : woffset. low(concatbv3(H, O)) = O

    property [p_hw_high] forall A : addr. hw_high(A) = high(A)
    property [p_hw_low]  forall A : addr. hw_low(A) = low(A)
    property [p_hw_cat3] forall H : line, O : woffset. hw_concatbv3(H, O) = concatbv3(H, O)
    property [p_hw_cat2] forall B : bit, J : bv2. hw_concatbv2(B, J) = concatbv2(B, J)
    property [p_hw_beat] forall O : woffset. hw_beat_of(O) = beat_of(O)
    property [p_hw_boff] forall O : woffset. hw_boff2(O) = boff2(O)
    property [p_hw_hash] forall H : line. hw_hash(H) = hash(H)
    property [p_hw_cidx] forall K : key, W : way. hw_cidx(K, W) = cidx(K, W)

    # ---- the cache slot index.  Unlike `concatbv3`, this one is NOT
    # opaque: `key` and `way` are already interpreted everywhere, the
    # packed slot is four bits wide, and the cache's data invariants
    # quantify over the pair.  Kept abstract, the injectivity they need
    # is an axiom with a two-term trigger that fires on every pair of
    # slots in the query, and `mem_img` -- which carries two such
    # quantifiers and the memory index besides -- stopped coming back.
    # Four bits of concat the solver can just evaluate. ----
    definition cidx(K, W) = K :: W

    # ---- the pair-indexed power-on image agrees with the flat one.
    # This is the ONLY place the two ever have to be compared, and it is
    # exported because the LSQ needs it: the trace's initial state is
    # `init_mem`, the cache's array is `init_img`, and `cimg_ctag` bridges
    # them at time zero. ----
    property [p_initimg] forall H : line, O : woffset.
        init_img(H, O) = init_mem(concatbv3(H, O))

    implementation {
        interpret addr -> bv[64]
        interpret line -> bv[61]
        # (`cache_slot` is interpreted in `basis`, beside `key` and `way`)
        definition high(A) = bfe[3][63](A)
        definition low(A) = bfe[0][2](A)
        definition concatbv3(H, O) = H :: O

        property [p_recon] forall A : addr. concatbv3(high(A), low(A)) = A

        definition hash(H) = bfe[0][2](H)
        definition init_img(H, O) = init_mem(concatbv3(H, O))
        definition beat_of(O) = bfe[2][2](O)
        definition boff2(O)   = bfe[0][1](O)
        definition hw_high(A) = bfe[3][63](A)
        definition hw_low(A)  = bfe[0][2](A)
        definition hw_concatbv3(H, O) = H :: O
        definition hw_concatbv2(B, J) = B :: J
        definition hw_beat_of(O) = bfe[2][2](O)
        definition hw_boff2(O)   = bfe[0][1](O)
        definition hw_hash(H)    = bfe[0][2](H)
        definition hw_cidx(K, W) = K :: W
    }
} with this, basis

# ---- `word`, `four_words` and `cache_line` are ABSTRACT outside this
# isolate.  The bit-level encoding lives in the implementation, so every
# other isolate sees a beat as an uninterpreted quadruple constrained only by
# `p_unp0..3` and a line as an uninterpreted eight-tuple constrained by
# `p_lsel_*`/`p_lins_*`.  This is the same trick `addr_thy` plays above, and
# for the same reason: with four_words = bv[256] visible, every query that
# mentions a fill or a writeback drags a 256-bit concat through the solver,
# and z3 bit-blasts it -- at 512 bits per line it is worse.  Nothing outside
# needs the encoding.
#
# It sits AFTER `addr_thy` and depends on it, which the beat-only version did
# not: the line <-> beat bridge is stated at `concatbv2(B, J)` offsets, so
# this isolate needs `woffset` interpreted and `p_boff_beat`/`p_boff_word` to
# take a packed offset apart.  That is also the plan's "keep the bridge
# axioms confined to the data isolate": they are PROVED here, against the
# encodings, and only their statements escape. ----
isolate data_impl = {
    property [p_unp0] forall W3 : word, W2 : word, W1 : word, W0 : word. unp0(pack4(W3, W2, W1, W0)) = W0
    property [p_unp1] forall W3 : word, W2 : word, W1 : word, W0 : word. unp1(pack4(W3, W2, W1, W0)) = W1
    property [p_unp2] forall W3 : word, W2 : word, W1 : word, W0 : word. unp2(pack4(W3, W2, W1, W0)) = W2
    property [p_unp3] forall W3 : word, W2 : word, W1 : word, W0 : word. unp3(pack4(W3, W2, W1, W0)) = W3

    # ---- the dynamic view of the same four positions.  `bv2` has four
    # values and they are enumerated here, so a caller that knows which
    # word it wants gets the static accessor back and one that does not
    # reasons with `p_wins_hit`/`p_wins_miss` alone. ----
    property [p_wsel0] forall M : four_words. wsel4(M, 0) = unp0(M)
    property [p_wsel1] forall M : four_words. wsel4(M, 1) = unp1(M)
    property [p_wsel2] forall M : four_words. wsel4(M, 2) = unp2(M)
    property [p_wsel3] forall M : four_words. wsel4(M, 3) = unp3(M)
    property [p_wins_hit] forall M : four_words, J : bv2, D : word.
        wsel4(wins4(M, J, D), J) = D
    property [p_wins_miss] forall M : four_words, J1 : bv2, J2 : bv2, D : word.
        J1 ~= J2 -> wsel4(wins4(M, J1, D), J2) = wsel4(M, J2)
    property [p_hw_pack4] forall W3 : word, W2 : word, W1 : word, W0 : word.
        hw_pack4(W3, W2, W1, W0) = pack4(W3, W2, W1, W0)
    property [p_hw_unp0] forall M : four_words. hw_unp0(M) = unp0(M)
    property [p_hw_unp1] forall M : four_words. hw_unp1(M) = unp1(M)
    property [p_hw_unp2] forall M : four_words. hw_unp2(M) = unp2(M)
    property [p_hw_unp3] forall M : four_words. hw_unp3(M) = unp3(M)
    property [p_hw_wsel4] forall M : four_words, J : bv2. hw_wsel4(M, J) = wsel4(M, J)
    property [p_hw_wins4] forall M : four_words, J : bv2, D : word.
        hw_wins4(M, J, D) = wins4(M, J, D)

    # ---- the line <-> beat bridge.  Four facts, and they are all anyone
    # outside ever needs: a packed line reads back as the beats it was built
    # from, and each beat of a line reads back as the line's words at that
    # beat's offsets.  Everything is phrased at `concatbv2(B, J)` so no
    # `beat_of`/`boff2` round trip appears in a client's query. ----
    property [p_lpack_lo] forall HI : four_words, LO : four_words, J : bv2.
        lsel(lpack(HI, LO), concatbv2(0, J)) = wsel4(LO, J)
    property [p_lpack_hi] forall HI : four_words, LO : four_words, J : bv2.
        lsel(lpack(HI, LO), concatbv2(1, J)) = wsel4(HI, J)
    property [p_llo] forall L : cache_line, J : bv2.
        wsel4(llo(L), J) = lsel(L, concatbv2(0, J))
    property [p_lhi] forall L : cache_line, J : bv2.
        wsel4(lhi(L), J) = lsel(L, concatbv2(1, J))
    property [p_lins_hit] forall L : cache_line, O : woffset, D : word.
        lsel(lins(L, O, D), O) = D
    property [p_lins_miss] forall L : cache_line, O1 : woffset, O2 : woffset, D : word.
        O1 ~= O2 -> lsel(lins(L, O1, D), O2) = lsel(L, O2)
    property [p_hw_lsel] forall L : cache_line, O : woffset. hw_lsel(L, O) = lsel(L, O)
    property [p_hw_lins] forall L : cache_line, O : woffset, D : word.
        hw_lins(L, O, D) = lins(L, O, D)
    property [p_hw_lpack] forall HI : four_words, LO : four_words.
        hw_lpack(HI, LO) = lpack(HI, LO)
    property [p_hw_lhi] forall L : cache_line. hw_lhi(L) = lhi(L)
    property [p_hw_llo] forall L : cache_line. hw_llo(L) = llo(L)

    implementation {
        interpret word -> bv[64]
        interpret four_words -> bv[256]
        interpret cache_line -> bv[512]
        definition pack4(W3, W2, W1, W0) = W3 :: W2 :: W1 :: W0
        definition unp0(M) = bfe[0][63](M)
        definition unp1(M) = bfe[64][127](M)
        definition unp2(M) = bfe[128][191](M)
        definition unp3(M) = bfe[192][255](M)
        definition wsel4(M, J) = (unp0(M) if J = 0 else
                                 (unp1(M) if J = 1 else
                                 (unp2(M) if J = 2 else unp3(M))))
        definition wins4(M, J, D) =
            (pack4(unp3(M), unp2(M), unp1(M), D) if J = 0 else
            (pack4(unp3(M), unp2(M), D, unp0(M)) if J = 1 else
            (pack4(unp3(M), D, unp1(M), unp0(M)) if J = 2 else
             pack4(D, unp2(M), unp1(M), unp0(M)))))
        definition hw_pack4(W3, W2, W1, W0) = W3 :: W2 :: W1 :: W0
        definition hw_unp0(M) = bfe[0][63](M)
        definition hw_unp1(M) = bfe[64][127](M)
        definition hw_unp2(M) = bfe[128][191](M)
        definition hw_unp3(M) = bfe[192][255](M)
        definition hw_wsel4(M, J) = (hw_unp0(M) if J = 0 else
                                    (hw_unp1(M) if J = 1 else
                                    (hw_unp2(M) if J = 2 else hw_unp3(M))))
        definition hw_wins4(M, J, D) =
            (hw_pack4(hw_unp3(M), hw_unp2(M), hw_unp1(M), D) if J = 0 else
            (hw_pack4(hw_unp3(M), hw_unp2(M), D, hw_unp0(M)) if J = 1 else
            (hw_pack4(hw_unp3(M), D, hw_unp1(M), hw_unp0(M)) if J = 2 else
             hw_pack4(D, hw_unp2(M), hw_unp1(M), hw_unp0(M)))))

        # ---- a line is its two beats, high first.  Every line operation is
        # routed through `wsel4`/`wins4` on the selected half rather than
        # through a fresh 512-bit case split, which is what keeps the six
        # properties above provable in seconds. ----
        definition lpack(HI, LO) = HI :: LO
        definition llo(L) = bfe[0][255](L)
        definition lhi(L) = bfe[256][511](L)
        definition lsel(L, O) = (wsel4(llo(L), boff2(O)) if beat_of(O) = 0
                                 else wsel4(lhi(L), boff2(O)))
        definition lins(L, O, D) =
            (lpack(lhi(L), wins4(llo(L), boff2(O), D)) if beat_of(O) = 0
             else lpack(wins4(lhi(L), boff2(O), D), llo(L)))
        definition hw_lpack(HI, LO) = HI :: LO
        definition hw_llo(L) = bfe[0][255](L)
        definition hw_lhi(L) = bfe[256][511](L)
        definition hw_lsel(L, O) = (hw_wsel4(hw_llo(L), hw_boff2(O)) if hw_beat_of(O) = 0
                                    else hw_wsel4(hw_lhi(L), hw_boff2(O)))
        definition hw_lins(L, O, D) =
            (hw_lpack(hw_lhi(L), hw_wins4(hw_llo(L), hw_boff2(O), D)) if hw_beat_of(O) = 0
             else hw_lpack(hw_wins4(hw_lhi(L), hw_boff2(O), D), hw_llo(L)))
    }
} with this, basis, addr_thy

export action posedge



    isolate cachemem = {

        # ---- the memory-side port, carried out to the top of the design ----
        wire mem_rd_en   : bool
        wire mem_rd_addr : addr
        wire mem_wr_en   : bool
        wire mem_wr_addr : addr
        wire mem_wr_data : four_words
        wire mem_rdata   : four_words

        # ---- one LSQ channel per CPU ----
        wire lsq_to_cache_req_en0     : bool
        wire lsq_to_cache_req_h0      : line
        wire lsq_to_cache_req_o0      : woffset
        wire lsq_to_cache_req_wen0    : bool
        wire lsq_to_cache_req_wdata0  : word
        wire lsq_to_cache_req_idx0    : load_idx
        wire cache_to_lsq_creq_ready0 : bool
        wire cache_to_lsq_resp_valid0 : bool
        wire cache_to_lsq_resp_h0     : line
        wire cache_to_lsq_resp_o0     : woffset
        wire cache_to_lsq_resp_data0  : word
        wire cache_to_lsq_resp_idx0   : load_idx
        wire lsq_to_cache_req_en1     : bool
        wire lsq_to_cache_req_h1      : line
        wire lsq_to_cache_req_o1      : woffset
        wire lsq_to_cache_req_wen1    : bool
        wire lsq_to_cache_req_wdata1  : word
        wire lsq_to_cache_req_idx1    : load_idx
        wire cache_to_lsq_creq_ready1 : bool
        wire cache_to_lsq_resp_valid1 : bool
        wire cache_to_lsq_resp_h1     : line
        wire cache_to_lsq_resp_o1     : woffset
        wire cache_to_lsq_resp_data1  : word
        wire cache_to_lsq_resp_idx1   : load_idx

        # Requests for a line from cache 0 -> crossbar
        #TODO: rename these to be c0_ch1_*
        wire c0_req_en    : bool
        wire c0_req_line  : line
        wire c0_req_excl  : bool
        wire c0_req_taken : bool

        wire c0_ch2_msg_valid : bool
        wire c0_ch2_msg_typ   : ch2typ
        wire c0_ch2_msg_line  : line
        wire c0_ch2_msg_data  : cache_line
        wire c0_ch2_msg_taken : bool

        # ---- what the consumer publishes about its channel-2 QUEUE.
        # `ready` is the producer's stall signal and `empty` is the one the
        # directory waits on before it sends a grant -- "emptiness observed by
        # a wire that both caches expose". ----
        wire c0_ch2_empty   : bool
        # ---- and the six VIEWS of that message the cache actually reads,
        # decoded at the port one hop from the code that reads them. ----
        wire c0_gr_valid  : bool
        wire c0_gr_excl   : bool
        wire c0_gr_line   : line
        wire c0_gr_data   : cache_line
        wire c0_inv_valid : bool
        wire c0_inv_line  : line
        wire c0_inv_taken : bool
        wire c0_ack_en    : bool
        wire c0_ack_line  : line
        wire c0_ack_dty   : bool
        wire c0_ack_dat   : cache_line
        wire c0_ack_taken : bool
        # TODO: expand instances of `st` to `store`
        wire c0_st_en     : bool
        wire c0_st_h      : line
        wire c0_st_o      : woffset
        wire c0_st_d      : word
        # Ghost wires for what cache0 sends in an invalidate acknowledgement
        wire c0_give_en   : bool
        wire c0_give_line : line
        wire c0_give_dty  : bool
        wire c0_give_dat  : cache_line

        # Requests for a line from cache 1 -> crossbar
        #TODO: rename these to be c1_ch1_*
        wire c1_req_en    : bool
        wire c1_req_line  : line
        wire c1_req_excl  : bool
        wire c1_req_taken : bool

        wire c1_ch2_msg_valid : bool
        wire c1_ch2_msg_typ   : ch2typ
        wire c1_ch2_msg_line  : line
        wire c1_ch2_msg_data  : cache_line
        wire c1_ch2_msg_taken : bool

        # ---- what the consumer publishes about its channel-2 QUEUE.
        # `ready` is the producer's stall signal and `empty` is the one the
        # directory waits on before it sends a grant -- "emptiness observed by
        # a wire that both caches expose". ----
        wire c1_ch2_empty   : bool
        # ---- and the six VIEWS of that message the cache actually reads,
        # decoded at the port one hop from the code that reads them. ----
        wire c1_gr_valid  : bool
        wire c1_gr_excl   : bool
        wire c1_gr_line   : line
        wire c1_gr_data   : cache_line
        wire c1_inv_valid : bool
        wire c1_inv_line  : line
        wire c1_inv_taken : bool
        wire c1_ack_en    : bool
        wire c1_ack_line  : line
        wire c1_ack_dty   : bool
        wire c1_ack_dat   : cache_line
        wire c1_ack_taken : bool
        # TODO: expand instances of `st` to `store`
        wire c1_st_en     : bool
        wire c1_st_h      : line
        wire c1_st_o      : woffset
        wire c1_st_d      : word
        # Ghost wires for what cache0 sends in an invalidate acknowledgement
        wire c1_give_en   : bool
        wire c1_give_line : line
        wire c1_give_dty  : bool
        wire c1_give_dat  : cache_line

        # ==================================================================
        # The ARBITRATED bus between the crossbar and the directory.  ONE set
        # per channel, because the directory has one set per channel now:
        # `xbar_body` arbitrates channels 1 and 3 -- the contended direction,
        # two caches and one directory -- and ROUTES channel 2, which is
        # directory-driven.
        #
        # `x_src` is a real port, not a proof device: both of the directory's
        # pickups latch it, which is what collapses their two hardcoded
        # priority branches into one.  It is also the exported witness of the
        # arbiter's `own`, which is what keeps `[xb_wb_own]` stated over nets
        # alone and the arbiter's registers private.
        # ==================================================================
        wire x_src           : bit
        wire x_req_en        : bool
        wire x_req_line      : line
        wire x_req_excl      : bool
        wire x_req_taken     : bool
        wire x_ack_en        : bool
        wire x_ack_line      : line
        wire x_ack_dty       : bool
        wire x_ack_dat       : cache_line
        wire x_ack_taken     : bool
        # ---- channel 3's SECOND handshake.  `x_ack_taken` now means only
        # "enqueued in the directory's channel-3 queue": it releases the
        # producer's holding slot and nothing else.  The acknowledgement
        # itself lives on inside the directory until the writeback it may
        # carry has landed, and THIS is the edge that says so -- the pulse
        # the in-flight ghost is cleared by, and what `[wb_done*]` is stated
        # over.  It carries the source and the line because the ghost is
        # per-line and the queue is shared.
        #
        # The crossbar's old `x_busy` hold is gone with it: the payload is
        # latched into the queue on the edge it is taken, so nothing is read
        # off the bus across an edge boundary any more. ----
        wire x_ch2_msg_valid : bool
        wire x_ch2_msg_typ   : ch2typ
        wire x_ch2_msg_cpu   : bit
        wire x_ch2_msg_line  : line
        wire x_ch2_msg_data  : cache_line
        wire x_ch2_msg_taken : bool

        # ---- channel 2's three kinds, named once at THIS level so the
        # directory that drives them and the decode that reads them cannot
        # disagree. ----
        wire ch2_gsh : ch2typ        # grant, Shared
        wire ch2_gex : ch2typ        # grant, Exclusive
        wire ch2_inv : ch2typ        # invalidate

        specification {

            # ---- the ONE memory the two caches jointly present ----
            # This is only updated when stores finish (their lines are written to the cache). 
            function img(H : line, O : woffset) : word

            function dirtied(C : bit, H : line, O : woffset) : bool

            # What each cache owns, as tracked in the cache. `holds` starts when a grant
            # for `H` is acknowledged by the cache
            function holds(C : bit, H : line) : bool
            # ---- permission is tracked beside possession.  Shared copies
            # may coexist; an exclusive copy excludes every other holder. ----
            function exclusive(C : bit, H : line) : bool

            # ==========================================================
            # Channel 3 in flight, in TWO pieces, because the channel now
            # has two stages and one ghost register cannot mirror both.
            #
            #   `ackN_g_*`  -- the producer's holding slot, exactly the old
            #                  mirror of `cacheN_body.ae_r`, minus the data.
            #   `ackN_p/d`  -- the DIRECTORY's side, per line: the entry is
            #                  in its channel-3 queue or under its writeback
            #                  sequencer.
            #
            # The split is forced by what each consumer can see.  A
            # directory invariant may not be phrased over a cache-driven
            # wire: `cN_ack_en`'s definition lives inside `cacheN_body`'s
            # implementation, so in `dir_body`'s query it is an opaque
            # symbol with no transition and nothing about it is preserved.
            # Both halves here are public specification state written by
            # this monitor, so every isolate sees the update AND its guard.
            #
            # The per-line half is EXACT, not an over-approximation: the
            # producer's slot moves into the queue on one edge and a second
            # surrender of the same line needs the line back first, which
            # `[ca_ack_idle_p*]` forbids while anything is outstanding.
            # `[ag_notp*]`, `[q3_uniq]` and `[q3_ag_ne*]` are that argument,
            # each discharged where its symbols are visible.
            #
            # The DATA is in neither half.  It rode along only for
            # `[ack_img_p*]`, and that obligation is discharged
            # combinationally at the producer's port and then carried
            # forward by the directory over its own queue entries.
            # ==========================================================
            var ack0_g_en   : bool
            var ack0_g_line : line
            var ack0_g_dty  : bool
            var ack1_g_en   : bool
            var ack1_g_line : line
            var ack1_g_dty  : bool
            # ---- the directory's channel-3 queue, mirrored SLOT FOR SLOT
            # rather than as a per-line predicate.  Two records, because the
            # queue is two deep, and the directory says which slot it filled
            # and which it emptied.
            #
            # A `line`-indexed pair of ghost arrays is the obvious encoding
            # and it does not work: every arm that writes one spawns a frame
            # axiom quantified over `line`, and with `img`, `dirtied*`,
            # `holds*` and `exclusive*` already doing that in this monitor the
            # caches' `[ca_dirtied_p*]` stops coming back at all (measured:
            # four minutes and still running, against ten seconds for the
            # whole file).  Eight plain registers add no quantifier and no
            # frame. ----
            var g3a_v : bool
            var g3a_c : bit
            var g3a_l : line
            var g3a_d : bool
            var g3b_v : bool
            var g3b_c : bit
            var g3b_l : line
            var g3b_d : bool

            # ==========================================================
            # The queued GRANT, one record per cache.
            #
            # A grant is enqueued on the edge the directory finishes the
            # transaction and forgets it -- there is no grant slot left in the
            # home and no acknowledgement -- but the cache takes possession
            # only when `process_ch2` pops it.  This record is that window,
            # and it is the window `[d_back*]` needed a third disjunct for,
            # before those two were withdrawn (see the note beside
            # `[dsh_ack]` in `dir_body`).
            #
            # ONE record is exact: a grant is sent only into an EMPTY channel-2
            # queue, so a cache can never have two queued at once.  That is a
            # syntactic property of `grant_now` on the directory's side and
            # `[q2_gq_*]` on the cache's.
            # ==========================================================
            var gq0_v : bool
            var gq0_x : bool
            var gq0_l : line
            var gq1_v : bool
            var gq1_x : bool
            var gq1_l : line

            # ---- the two halves read as one.  Defined rather than
            # duplicated at every use: an in-flight acknowledgement is an
            # in-flight acknowledgement wherever it happens to be sitting. ----
            function ack0_q(H : line) : bool
            function ack1_q(H : line) : bool
            function ack0_any(H : line) : bool
            function ack0_dty(H : line) : bool
            function ack1_any(H : line) : bool
            function ack1_dty(H : line) : bool
            definition ack0_q(H) = (g3a_v & g3a_c = 0 & g3a_l = H)
                                 | (g3b_v & g3b_c = 0 & g3b_l = H)
            definition ack1_q(H) = (g3a_v & g3a_c = 1 & g3a_l = H)
                                 | (g3b_v & g3b_c = 1 & g3b_l = H)
            definition ack0_any(H) = (ack0_g_en & ack0_g_line = H) | ack0_q(H)
            definition ack1_any(H) = (ack1_g_en & ack1_g_line = H) | ack1_q(H)
            definition ack0_dty(H) = (ack0_g_en & ack0_g_line = H & ack0_g_dty)
                                   | (g3a_v & g3a_c = 0 & g3a_l = H & g3a_d)
                                   | (g3b_v & g3b_c = 0 & g3b_l = H & g3b_d)
            definition ack1_dty(H) = (ack1_g_en & ack1_g_line = H & ack1_g_dty)
                                   | (g3a_v & g3a_c = 1 & g3a_l = H & g3a_d)
                                   | (g3b_v & g3b_c = 1 & g3b_l = H & g3b_d)

            after init {
                img(H, O)     := init_img(H, O);
                dirtied(C, H, O) := false;
                holds(C, H)     := false;
                exclusive(C, H) := false;
                ack0_g_en := false; ack0_g_line := 0; ack0_g_dty := false;
                ack1_g_en := false; ack1_g_line := 0; ack1_g_dty := false;
                g3a_v := false; g3a_c := 0; g3a_l := 0; g3a_d := false;
                g3b_v := false; g3b_c := 0; g3b_l := 0; g3b_d := false;
                gq0_v := false; gq0_x := false; gq0_l := 0;
                gq1_v := false; gq1_x := false; gq1_l := 0;
            }

            after posedge {

                # ---- CLEAR dirtied words at a command-beat landing, BEFORE the
                # store arms below.  BOTH halves clear: the beat that lands
                # is accurate to `img` (`[wb_img]`), so after it DRAM agrees
                # with the image at those words no matter which cache had
                # been holding them. ----
                if mc_body.cmd_en & mc_body.cmd_wen {
                    dirtied(C, H, O) := (false
                                    if (H = high(mc_body.cmd_addr)
                                        & beat_of(O) = beat_of(low(mc_body.cmd_addr)))
                                    else dirtied(C, H, O));
                };

                # ---- a load answer is BINDING on the image.  With
                # `[resp_img_int_*]` these arms rewrite `img` with the value
                # it already holds, so they are no-ops today; they are here
                # so the weak contract is the one the machine is proved
                # against.  AHEAD of the store arms: a commit on this edge
                # must not be rolled back by an answer that predates it. ----
                if cache_to_lsq_resp_valid0 {
                    img(H, O) := (cache_to_lsq_resp_data0
                                  if (H = cache_to_lsq_resp_h0
                                      & O = cache_to_lsq_resp_o0)
                                  else img(H, O));
                };
                if cache_to_lsq_resp_valid1 {
                    img(H, O) := (cache_to_lsq_resp_data1
                                  if (H = cache_to_lsq_resp_h1
                                      & O = cache_to_lsq_resp_o1)
                                  else img(H, O));
                };

                # ---- the store commits.  `img` moves HERE and nowhere else.
                # Both CPUs can commit on one edge, but only to different
                # lines -- that is the exclusivity backbone, and it is why
                # the two arms compose. ----
                if c0_st_en {
                    img(H, O) := (c0_st_d
                                  if (H = c0_st_h & O = c0_st_o)
                                  else img(H, O));
                    dirtied(C, H, O) := (true
                                    if (C = 0 & H = c0_st_h & O = c0_st_o)
                                    else dirtied(C, H, O));
                };
                if c1_st_en {
                    img(H, O) := (c1_st_d
                                  if (H = c1_st_h & O = c1_st_o)
                                  else img(H, O));
                    dirtied(C, H, O) := (true
                                    if (C = 1 & H = c1_st_h & O = c1_st_o)
                                    else dirtied(C, H, O));
                };

                # ---- channel 3, per CPU: retire, then hand off, then
                # post.  Three arms now rather than two, one per stage
                # boundary, and in that order so a slot freed on this edge is
                # reusable on it.
                #
                # The hand-off names `ackN_g_line`, not `cN_ack_line`: the
                # ghost fields are visible in every query and the port wires
                # are not, and `dir_body` has to know WHICH line its queue
                # just took.  `[ack_sync_line_p*]` is what makes the two the
                # same line. ----
                if c0_ack_taken { ack0_g_en := false; };
                if c1_ack_taken { ack1_g_en := false; };
                if c0_give_en {
                    ack0_g_en   := true;
                    ack0_g_line := c0_give_line;
                    ack0_g_dty  := c0_give_dty;
                };
                if c1_give_en {
                    ack1_g_en   := true;
                    ack1_g_line := c1_give_line;
                    ack1_g_dty  := c1_give_dty;
                };

                # ---- the queued-grant window: filled when the message is
                # enqueued, emptied when `process_ch2` pops it.  The two can
                # never fire together -- a grant is only sent into an empty
                # queue and a pop needs a non-empty one. ----
                if c0_ch2_msg_taken & c0_ch2_msg_typ ~= ch2_inv {
                    gq0_v := true;
                    gq0_x := (c0_ch2_msg_typ = ch2_gex);
                    gq0_l := c0_ch2_msg_line;
                };
                if c1_ch2_msg_taken & c1_ch2_msg_typ ~= ch2_inv {
                    gq1_v := true;
                    gq1_x := (c1_ch2_msg_typ = ch2_gex);
                    gq1_l := c1_ch2_msg_line;
                };

                # ---- possession and permission follow POPPED grants and
                # every channel-3 surrender, including invalidate replies. ----
                if c0_give_en {
                    holds(C, H) := (false if C = 0 & H = c0_give_line else holds(C, H));
                    exclusive(C, H) := (false if C = 0 & H = c0_give_line else exclusive(C, H));
                };
                if c1_give_en {
                    holds(C, H) := (false if C = 1 & H = c1_give_line else holds(C, H));
                    exclusive(C, H) := (false if C = 1 & H = c1_give_line else exclusive(C, H));
                };
            }
        }
        # ==================================================================
        # CPU 0's cache.  8 sets x 2 ways, 2 MSHRs, whole-line data.
        #
        # Cache lines are at the same granularity as the directory/LLC. 
        # All evictions trigger a notification to the directory. 
        # ==================================================================
        isolate cache0_body = {

            # ---- LSQ request channel: the request comes from the LSQ, the
            # ready is driven here.  `lsq_to_cache_req_idx0` is opaque to the
            # cache: it is stored beside the request in the MSHR slot and
            # handed straight back on the response. ----
            wire lsq_to_cache_req_en0     : bool
            wire lsq_to_cache_req_h0      : line
            wire lsq_to_cache_req_o0      : woffset
            wire lsq_to_cache_req_wen0    : bool
            wire lsq_to_cache_req_wdata0  : word
            wire lsq_to_cache_req_idx0    : load_idx
            wire cache_to_lsq_creq_ready0 : bool

            # ---- LSQ response channel: all driven here ----
            wire cache_to_lsq_resp_valid0 : bool
            wire cache_to_lsq_resp_h0     : line
            wire cache_to_lsq_resp_o0     : woffset
            wire cache_to_lsq_resp_data0  : word
            wire cache_to_lsq_resp_idx0   : load_idx

            # ---- the ports this cache drives on the directory side ----
            wire req_en    : bool
            wire req_line  : line
            wire req_excl  : bool
            wire ch2_msg_taken : bool
            wire inv_taken : bool
            # ---- channel 2's queue, seen from outside: `empty` is what the
            # directory waits on before it sends a grant, and `has_grant` with
            # its payload is what `process_ch2` produced this edge. ----
            wire ch2_empty   : bool
            wire inv_pop_line : line
            wire has_grant   : bool
            wire grant_excl  : bool
            wire grant_line  : line

            # ---- channel 3 as REAL hardware, held by its producer (plan
            # decision 2).  `cachemem` keeps a ghost copy of the same slot --
            # the directory's `[wb_*]` invariants are claims about the
            # POST-state and need a symbol the environment cannot re-drive --
            # and `[ack_sync_*]` pins the two together, the `ae_r` pattern
            # widened from the enable bit to the whole payload.  Without these
            # registers the directory's datapath reads specification state and
            # `ivy_to_rtl` emits a dangling wire. ----
            wire ack_en    : bool
            wire ack_line  : line
            wire ack_dty   : bool
            wire ack_dat   : cache_line

            # ---- the pending-store view the LSQ contract is stated over.
            # A store is accepted at the port one edge before it reaches the
            # array: it waits in the stage, and on a miss it waits again in
            # the allocating MSHR's slot.  Those three records ARE
            # `in_progress`, and they are exported as wires so the contract
            # can name them without naming the registers behind them. ----
            wire stage_go : bool
            wire ps_v : bool
            wire ps_h : line
            wire ps_o : woffset
            wire ps_d : word
            wire p0_v : bool
            wire p0_h : line
            wire p0_o : woffset
            wire p0_d : word
            wire p1_v : bool
            wire p1_h : line
            wire p1_o : woffset
            wire p1_d : word
            wire in_progress(H : line) : bool

            # ---- proof observation ports ----
            wire st_en     : bool
            wire st_h      : line
            wire st_o      : woffset
            wire st_d      : word
            wire give_en   : bool
            wire give_line : line
            wire give_dty  : bool
            wire give_dat  : cache_line

            specification {
                # This holds since `img` is only updated after stores commit. It is possible
                # that one of the caches holds stale data while the other cache has an ongoing write.
                # In that case, `img` does not reflect the in-progress write. This works since we have
                # depth-1 MSHRs and don't implement store-to-load forwarding
                invariant [resp_img_int_p0] cache_to_lsq_resp_valid0 ->
                    cache_to_lsq_resp_data0 = img(cache_to_lsq_resp_h0,
                                                 cache_to_lsq_resp_o0)

                
                # The cache only surrenders lines it holds
                invariant [ca_gv_hold_p0] c0_give_en -> holds(0, c0_give_line)
                # Guarantee to the directory that if we don't hold a line, then
                # it is not exclusive
                invariant [ca_excl_hold_p0] cachemem.exclusive(0, H) -> holds(0, H)

                # Storing a line implies that we have exclusive perms
                invariant [ca_st_excl_p0] c0_st_en -> cachemem.exclusive(0, c0_st_h)

                # We never start to give a new invalidate acknowledgement while there is an old invalidate
                # acknowledgement waiting to be sent. 
                invariant [ca_gv_nodouble_p0] c0_give_en -> ~ack0_g_en

                invariant [ca_gv_nost_p0] c0_give_en -> ~c0_st_en

                # A clean surrender carries no write debt: no word of the
                # line is dirtied, so the directory may keep trusting its
                # own copy of it.
                invariant [ca_gv_clean_p0] c0_give_en & ~c0_give_dty ->
                    ~dirtied(0, c0_give_line, O)
                # A dirty surrender is believable as the whole image only
                # under SWMR: dirty implies the copy was Exclusive.
                invariant [ca_gv_dirty_excl_p0] c0_give_en & c0_give_dty ->
                    cachemem.exclusive(0, c0_give_line)

                # Write debt never floats unaccounted: a word is dirtied
                # only while its line is held or while the dirty ack
                # carrying it is in flight.
                invariant [ca_dirtied_p0]
                      ~holds(0, H)
                    & ~ack0_dty(H)
                    -> ~dirtied(0, H, O)
                invariant [ca_dirtied_excl_p0] dirtied(0, H, O) ->
                      cachemem.exclusive(0, H)
                    | ack0_dty(H)

                # A clean ack vouches for nothing: no word of its line is dirtied.
                invariant [ca_clean_ack_p0] ack0_any(H) & ~ack0_dty(H) ->
                    ~dirtied(0, H, O)

                # If we send an invalidate acknowledgement, then we don't hold the line
                invariant [ca_ack_idle_p0] ack0_any(H) -> ~holds(0, H)

                # Data we send as part of the invalidate is valid
                # 
                # This works since all dirtied lines are a result of completed stores,
                # which means that they are reflected in `img`.
                invariant [ack_img_p0] c0_ack_en & c0_ack_dty ->
                    lsel(c0_ack_dat, O) = img(c0_ack_line, O)

                # ---- the hardware slot and the ghost slot are the same slot ----
                invariant [ack_sync_en_p0] c0_ack_en = ack0_g_en
                invariant [ack_sync_line_p0] ack0_g_en ->
                    c0_ack_line = ack0_g_line
                invariant [ack_sync_dty_p0] ack0_g_en ->
                    c0_ack_dty = ack0_g_dty

                # `c0_ch2_msg_valid` is true if we acknowledge the grant. 
                invariant [ca_ch2_taken_valid_p0] c0_ch2_msg_taken ->
                    c0_ch2_msg_valid
                # Popped grants are from the top of the queue
                invariant [ca_gr_gq_p0] has_grant ->
                    gq0_v & grant_line = gq0_l & grant_excl = gq0_x

                after posedge {
                    if has_grant {
                        gq0_v := false;
                        holds(C, H) := (true if C = 0 & H = grant_line else holds(C, H));
                        cachemem.exclusive(C, H) := (grant_excl if C = 0 & H = grant_line
                                          else cachemem.exclusive(C, H));
                    };
                }
            }

            implementation {
                # ==========================================================
                # The array.  One memory per former struct field, indexed by
                # the packed (set, way) slot -- an RTLIL memory is
                # one-dimensional and a struct sort has no bit width.  The
                # data is ONE whole line per slot now: a fill writes it in a
                # single edge, so there is nothing left for the beat split to
                # buy.
                #
                # `set_lru` is ONE bit per set, not one per way: per way it
                # took two writes to the same memory on every hit, which the
                # translator merges into a single port.
                # ==========================================================
                # `tag_exc` is written at a fill, off the grant's kind, and
                # RE-ASSERTED on the two store paths.  The re-assert is
                # provably idempotent -- a store only commits where the
                # permission already is -- but stating it syntactically is
                # what keeps `[ca_gv_clean_*]` inductive: without it the
                # solver has to rediscover the permission through the hit
                # test, and the query stops coming back.
                var tag_occ(S : cache_slot) : bool
                var tag_dty(S : cache_slot) : bool
                var tag_exc(S : cache_slot) : bool
                var tag_ln(S : cache_slot)  : line
                var set_lru(K : key)        : bit
                var dat(S : cache_slot)     : cache_line

                # ---- the (set, way) view the invariants are written in.
                # Plain defined functions, so `ivy_to_rtl` never sees them. ----
                function occupied(K : key, W : way) : bool
                definition occupied(K, W) = tag_occ(cidx(K, W))
                function dirty(K : key, W : way) : bool
                definition dirty(K, W) = tag_dty(cidx(K, W))
                function exclusive(K : key, W : way) : bool
                definition exclusive(K, W) = tag_exc(cidx(K, W))
                function ltag(K : key, W : way) : line
                definition ltag(K, W) = tag_ln(cidx(K, W))
                function val(K : key, W : way, O : woffset) : word
                definition val(K, W, O) = lsel(dat(cidx(K, W)), O)

                # ---- the MSHR's control states.  An enumeration has no bit
                # width, so these are narrow bit vectors and the names are
                # 0-ary wires. ----
                wire m_idle   : mstate
                wire m_req    : mstate
                wire m_wait   : mstate
                wire m_fill   : mstate
                wire m_replay : mstate
                definition m_idle   = 0
                definition m_req    = 1
                definition m_wait   = 2
                definition m_fill   = 3
                definition m_replay = 4

                # ==========================================================
                # The two MSHRs, as registers rather than as an array over
                # `mshr_id`: `m_state` is written by the capture, by an
                # allocation and by a fill on the same edge, and a memory has
                # one write port per clock.  The proof sees them only at the
                # two literal indices, which is what keeps every invariant a
                # clean trigger.
                #
                # `mvline` is GHOST: the line this MSHR is evicting, recorded
                # when the victim way is picked.  Metadata carried BESIDE the
                # slot rather than read back out of it, which is what keeps
                # the writeback proof inside the decidable fragment -- naming
                # the victim as `ltag(hash(m_base(Id)), ...)` under a
                # quantifier sends the query from a line, through `hash`,
                # into the array and back out to a line.
                # ==========================================================
                var s0_m_state : mstate
                var s0_m_base  : line
                var s0_m_excl  : bool
                var s0_m_vway  : way
                var s0_mvline  : line
                var s0_mfb     : cache_line
                var s0_rq_valid : bool
                var s0_rq_off   : woffset
                var s0_rq_wen   : bool
                var s0_rq_wdata : word
                var s0_rq_idx   : load_idx
                var s1_m_state : mstate
                var s1_m_base  : line
                var s1_m_excl  : bool
                var s1_m_vway  : way
                var s1_mvline  : line
                var s1_mfb     : cache_line
                var s1_rq_valid : bool
                var s1_rq_off   : woffset
                var s1_rq_wen   : bool
                var s1_rq_wdata : word
                var s1_rq_idx   : load_idx

                # ---- the input stage.  ALL requests pass through it. ----
                var p_valid : bool
                var p_h     : line
                var p_o     : woffset
                var p_wen   : bool
                var p_wdata : word
                var p_idx   : load_idx

                var port_used : bool

                var ev_ans     : bool
                var ev_ans_h   : line
                var ev_ans_o   : woffset
                var ev_ans_d   : word
                var ev_ans_idx : load_idx

                # ==========================================================
                # Channel 2 as a QUEUE, depth 2, held by its CONSUMER.
                #
                # The directory stores at the tail and `process_ch2` reads at
                # the head, so the two message kinds cannot overtake each
                # other: an invalidate posted behind a grant is popped behind
                # it, and the cache installs the line before it gives it up.
                # That ordering is the whole reason the queue is here.
                #
                # Two entries is exactly what the protocol can produce.  A
                # grant is sent only into an EMPTY queue, so a grant is always
                # the head; the transaction that sent it then ends, and the
                # next one can post one invalidate to this cache behind it.
                # `[G]`, `[I]` and `[G, I]` are the only non-empty states, and
                # `[I, G]` is unreachable.
                # ==========================================================
                var q2_typ(I : qidx)  : ch2typ
                var q2_line(I : qidx) : line
                var q2_dat(I : qidx)  : cache_line
                var q2_head : qptr
                var q2_tail : qptr

                # ---- this side's copy of the channel-3 slot.  A guard has
                # to be a function of THIS isolate's registers: the record at
                # `cachemem` is written by a monitor that runs before this
                # one, so a guard phrased over `ack0_g_en` would be read there
                # at its old value and re-read here at its new one. ----
                var ae_r : bool
                var ae_line : line
                var ae_dty  : bool
                var ae_dat  : cache_line

                after init {
                    tag_occ(S) := false; tag_dty(S) := false; tag_exc(S) := false; tag_ln(S) := 0;
                    set_lru(K) := 0; dat(S) := 0;
                    s0_m_state := 0; s0_m_base := 0; s0_m_excl := false;
                    s0_m_vway := 0; s0_mvline := 0; s0_mfb := 0;
                    s0_rq_valid := false; s0_rq_off := 0; s0_rq_wen := false;
                    s0_rq_wdata := 0; s0_rq_idx := 0;
                    s1_m_state := 0; s1_m_base := 0; s1_m_excl := false;
                    s1_m_vway := 0; s1_mvline := 0; s1_mfb := 0;
                    s1_rq_valid := false; s1_rq_off := 0; s1_rq_wen := false;
                    s1_rq_wdata := 0; s1_rq_idx := 0;
                    p_valid := false; p_h := 0; p_o := 0; p_wen := false;
                    p_wdata := 0; p_idx := 0;
                    port_used := false;
                    ev_ans := false; ev_ans_h := 0; ev_ans_o := 0;
                    ev_ans_d := 0; ev_ans_idx := 0;
                    ae_r := false;
                    ae_line := 0; ae_dty := false; ae_dat := 0;
                    q2_typ(I) := 0; q2_line(I) := 0; q2_dat(I) := 0;
                    q2_head := 0; q2_tail := 0;
                }

                # ==========================================================
                # `process_ch2`.
                #
                # One message leaves the queue per edge and the whole of it is
                # combinational: `has_grant` and `process_ch2_inval` are the
                # two decodes of the head, exclusive because a head has one
                # kind, and they are what the rest of the cache reads instead
                # of a channel-2 port.
                #
                # `must_inval_ch2` IS the channel-3 holding slot.  A popped
                # invalidate has to be answerable on the edge it is popped --
                # its reply is latched and the copy dropped at the same time --
                # so no message is taken while that slot is occupied.
                # `ae_line`/`ae_dty`/`ae_dat` are the plan's
                # `inval_ch2_data*`: the slot already existed for evictions
                # and self-downgrades and a second one would only have to be
                # arbitrated against it.
                #
                # A grant is popped only when an MSHR is waiting for exactly
                # it.  Otherwise possession would be taken and then dropped
                # with the home still recording this cache as a sharer.
                # Holding the head instead costs liveness in a case the
                # protocol cannot produce -- a grant answers a request -- and
                # costs nothing in safety.
                # ==========================================================
                wire q2_empty : bool
                wire q2_full  : bool
                definition q2_empty = (q2_head = q2_tail)
                definition q2_full  = (q2_tail - q2_head = 2)

                wire q2h_typ  : ch2typ
                wire q2h_line : line
                wire q2h_dat  : cache_line
                definition q2h_typ  = q2_typ(qi(q2_head))
                definition q2h_line = q2_line(qi(q2_head))
                definition q2h_dat  = q2_dat(qi(q2_head))

                wire must_inval_ch2 : bool
                definition must_inval_ch2 = ae_r

                wire g_match0 : bool
                wire g_match1 : bool
                definition g_match0 = s0_m_state = m_wait & s0_m_base = q2h_line
                    & (~s0_rq_wen | q2h_typ = ch2_gex)
                definition g_match1 = s1_m_state = m_wait & s1_m_base = q2h_line
                    & (~s1_rq_wen | q2h_typ = ch2_gex)

                wire process_ch2_inval : bool
                wire ch2_pop : bool
                definition has_grant = ~must_inval_ch2 & ~q2_empty
                    & q2h_typ ~= ch2_inv & (g_match0 | g_match1)
                definition process_ch2_inval = ~must_inval_ch2 & ~q2_empty
                    & q2h_typ = ch2_inv
                definition ch2_pop = has_grant | process_ch2_inval
                definition grant_excl = (q2h_typ = ch2_gex)
                definition grant_line = q2h_line

                definition ch2_empty      = q2_empty
                definition inv_pop_line   = q2h_line
                definition ch2_msg_taken = c0_ch2_msg_valid & ~q2_full

                # ==========================================================
                # The arbiter, written out as three wires.  `stage_go` is the
                # stage-movable gate: the staged request enters only when its
                # line aliases no active MSHR, no MSHR wants the array this
                # edge, and an MSHR is free to take a miss.  Otherwise the
                # first MSHR that wants the array gets it.  Exactly one of
                # the three is true, which is what makes the single-writer
                # discipline on the array and on `c_st_*` syntactic.
                #
                # The gate does NOT mention the response port.  It does not
                # have to: one array action per edge means a store commit and
                # a load answer never share an edge, so `[resp_img]` cannot
                # be overtaken by an image move.
                # ==========================================================
                # ---- presence and permission are separate.  Loads hit any
                # resident copy; stores hit only an Exclusive copy. ----
                wire p_present : bool
                wire p_hit     : bool
                wire p_hway    : way
                wire p_hexcl   : bool
                wire p_slot    : cache_slot
                definition p_present =
                      (tag_occ(hw_cidx(hw_hash(p_h), 1)) & tag_ln(hw_cidx(hw_hash(p_h), 1)) = p_h)
                    | (tag_occ(hw_cidx(hw_hash(p_h), 0)) & tag_ln(hw_cidx(hw_hash(p_h), 0)) = p_h)
                definition p_hway =
                    (1 if (tag_occ(hw_cidx(hw_hash(p_h), 1))
                           & tag_ln(hw_cidx(hw_hash(p_h), 1)) = p_h) else 0)
                definition p_slot = hw_cidx(hw_hash(p_h), p_hway)
                definition p_hexcl = p_present & tag_exc(p_slot)
                definition p_hit = p_present & (~p_wen | p_hexcl)
                wire arb0 : bool
                wire arb1 : bool

                # ---- invalidates use a separate held slot and have array and
                # channel-3 priority.  An invalidate is answered for a
                # resident copy AND for either MSHR's post-grant window,
                # where the line is held but not yet installed: that MSHR
                # bounces back to `m_req` with its request still parked, and
                # the reply is clean because the parked store applies only at
                # replay.  At most one of the three can match: `[c_uniq]`
                # keeps a line in one way and `[mshr_distinct_p0]` keeps the
                # two MSHRs off each other's line. ----
                wire inv_hit    : bool
                wire inv_hway   : way
                wire inv_slot   : cache_slot
                wire inv_mshr0  : bool
                wire inv_mshr1  : bool
                wire inv_act    : bool
                definition inv_hit =
                      (tag_occ(hw_cidx(hw_hash(q2h_line), 1)) & tag_ln(hw_cidx(hw_hash(q2h_line), 1)) = q2h_line)
                    | (tag_occ(hw_cidx(hw_hash(q2h_line), 0)) & tag_ln(hw_cidx(hw_hash(q2h_line), 0)) = q2h_line)
                definition inv_hway =
                    (1 if (tag_occ(hw_cidx(hw_hash(q2h_line), 1))
                           & tag_ln(hw_cidx(hw_hash(q2h_line), 1)) = q2h_line) else 0)
                definition inv_slot = hw_cidx(hw_hash(q2h_line), inv_hway)
                definition inv_mshr0 = (s0_m_state = m_fill | s0_m_state = m_replay)
                    & s0_m_base = q2h_line
                definition inv_mshr1 = (s1_m_state = m_fill | s1_m_state = m_replay)
                    & s1_m_base = q2h_line
                # ---- a popped invalidate is ANSWERED only if the line is
                # here.  A miss needs no reply, and the argument is local:
                # this cache holds no copy and has no MSHR window on the
                # line, so it owes the home nothing for it -- whatever the
                # home is waiting on was already put in flight by the
                # self-eviction that overtook this invalidate.  The pop
                # still happens: the message is consumed either way. ----
                definition inv_act = process_ch2_inval
                    & (inv_hit | inv_mshr0 | inv_mshr1)
                definition inv_taken = inv_act

                # ---- the stage-movable gate, back to its two-MSHR shape:
                # the staged request enters only when its line aliases no
                # active MSHR, no MSHR wants the array this edge, and an MSHR
                # is free to take a miss -- plus, new here, channel 3 is free
                # if the request is a store that has to self-downgrade a
                # Shared copy first.  Otherwise the first MSHR that wants the
                # array gets it, and an invalidate outranks all of them. ----
                definition stage_go = p_valid
                    & ~process_ch2_inval
                    & ~(s0_m_state ~= m_idle & s0_m_base = p_h)
                    & ~(s1_m_state ~= m_idle & s1_m_base = p_h)
                    & ~(s0_m_state = m_fill | s0_m_state = m_replay)
                    & ~(s1_m_state = m_fill | s1_m_state = m_replay)
                    & (s0_m_state = m_idle | s1_m_state = m_idle)
                    & (~p_wen | ~p_present | p_hexcl | ~ae_r)
                definition arb0 = ~stage_go & ~process_ch2_inval
                    & (s0_m_state = m_fill | s0_m_state = m_replay)
                definition arb1 = ~stage_go & ~process_ch2_inval
                    & ~(s0_m_state = m_fill | s0_m_state = m_replay)
                    & (s1_m_state = m_fill | s1_m_state = m_replay)

                definition ps_v = p_valid & p_wen
                definition ps_h = p_h
                definition ps_o = p_o
                definition ps_d = p_wdata
                definition p0_v = s0_rq_valid & s0_rq_wen
                definition p0_h = s0_m_base
                definition p0_o = s0_rq_off
                definition p0_d = s0_rq_wdata
                definition p1_v = s1_rq_valid & s1_rq_wen
                definition p1_h = s1_m_base
                definition p1_o = s1_rq_off
                definition p1_d = s1_rq_wdata
                definition in_progress(H) =
                      (p_valid & p_wen & p_h = H)
                    | (s0_rq_valid & s0_rq_wen & s0_m_base = H)
                    | (s1_rq_valid & s1_rq_wen & s1_m_base = H)

                # ---- the victim slot each MSHR is aiming at ----
                wire v0 : cache_slot
                wire v1 : cache_slot
                definition v0 = hw_cidx(hw_hash(s0_m_base), s0_m_vway)
                definition v1 = hw_cidx(hw_hash(s1_m_base), s1_m_vway)

                # ---- channel 3 has four producers now: the invalidate
                # reply, the store's self-downgrade, and each MSHR's
                # fill-eviction.  They are one-hot because the invalidate
                # outranks everything and `stage_go`, `arb0`, `arb1` are
                # mutually exclusive. ----
                wire gv0 : bool
                wire gv1 : bool
                wire ugv : bool
                definition gv0 = (s0_m_state = m_fill) & tag_occ(v0) & ~ae_r
                definition gv1 = (s1_m_state = m_fill) & tag_occ(v1) & ~ae_r
                definition ugv = stage_go & p_wen & p_present & ~p_hexcl

                definition give_en = inv_taken | ugv | (arb0 & gv0) | (arb1 & gv1)
                definition give_line = (q2h_line if inv_taken else
                                        (p_h if ugv else
                                         (s0_mvline if arb0 else s1_mvline)))
                definition give_dty = ((tag_dty(inv_slot) if inv_hit else false) if inv_taken else
                                       (tag_dty(p_slot) if ugv else
                                        (tag_dty(v0) if arb0 else tag_dty(v1))))
                definition give_dat = ((dat(inv_slot) if inv_hit else 0) if inv_taken else
                                       (dat(p_slot) if ugv else
                                        (dat(v0) if arb0 else dat(v1))))

                # ---- a store commits on the stage's Exclusive-hit path or on
                # an MSHR's replay ----
                definition st_en = (stage_go & p_wen & p_hit)
                    | (arb0 & s0_m_state = m_replay & s0_rq_valid & s0_rq_wen)
                    | (arb1 & s1_m_state = m_replay & s1_rq_valid & s1_rq_wen)
                definition st_h = (p_h if stage_go
                                   else (s0_m_base if arb0 else s1_m_base))
                definition st_o = (p_o if stage_go
                                   else (s0_rq_off if arb0 else s1_rq_off))
                definition st_d = (p_wdata if stage_go
                                   else (s0_rq_wdata if arb0 else s1_rq_wdata))

                # ---- channel 1 is held by one `m_req` MSHR at a time, MSHR0
                # first ----
                definition req_en   = (s0_m_state = m_req) | (s1_m_state = m_req)
                definition req_line = (s0_m_base if s0_m_state = m_req
                                       else s1_m_base)
                definition req_excl = (s0_m_excl if s0_m_state = m_req
                                       else s1_m_excl)

                definition ack_en   = ae_r
                definition ack_line = ae_line
                definition ack_dty  = ae_dty
                definition ack_dat  = ae_dat

                definition cache_to_lsq_creq_ready0 = ~p_valid | stage_go

                definition cache_to_lsq_resp_valid0 = ev_ans
                definition cache_to_lsq_resp_h0     = ev_ans_h
                definition cache_to_lsq_resp_o0     = ev_ans_o
                definition cache_to_lsq_resp_data0  = ev_ans_d
                definition cache_to_lsq_resp_idx0   = ev_ans_idx

                # ==========================================================
                # The three array actions.
                # ==========================================================
                action serve_stage = {
                    var h  : line    := p_h;
                    var o  : woffset := p_o;
                    var rs : key     := hw_hash(h);
                    var present : bool := false;
                    var hit     : bool := false;
                    var hway    : way  := 1;
                    p_valid := false;
                    if tag_occ(hw_cidx(rs, 1)) & tag_ln(hw_cidx(rs, 1)) = h {
                        present := true; hway := 1;
                    } else { if tag_occ(hw_cidx(rs, 0)) & tag_ln(hw_cidx(rs, 0)) = h {
                        present := true; hway := 0;
                    } };
                    hit := present & (~p_wen | tag_exc(hw_cidx(rs, hway)));
                    if hit {
                        if p_wen {
                            dat(hw_cidx(rs, hway)) :=
                                hw_lins(dat(hw_cidx(rs, hway)), o, p_wdata);
                            tag_dty(hw_cidx(rs, hway)) := true;
                            tag_exc(hw_cidx(rs, hway)) := true;
                        } else {
                            ev_ans     := true;
                            ev_ans_h   := h;
                            ev_ans_o   := o;
                            ev_ans_d   := hw_lsel(dat(hw_cidx(rs, hway)), o);
                            ev_ans_idx := p_idx;
                            port_used  := true;
                        };
                        if hway = 1 { set_lru(rs) := 0; } else { set_lru(rs) := 1; };
                    } else {
                        # A store to Shared surrenders that clean copy before
                        # requesting Exclusive.  `stage_go` waited for ch3.
                        if present {
                            ae_r := true;
                            ae_line := h;
                            ae_dty  := tag_dty(hw_cidx(rs, hway));
                            ae_dat  := dat(hw_cidx(rs, hway));
                            tag_occ(hw_cidx(rs, hway)) := false;
                        };
                        # ---- allocate.  Under the gate one MSHR is idle, so
                        # the else arm is closed by construction. ----
                        if s0_m_state = m_idle {
                            s0_m_state := m_req;
                            s0_m_base  := h;
                            s0_m_excl  := p_wen;
                            s0_rq_valid := true; s0_rq_off := o;
                            s0_rq_wen := p_wen; s0_rq_wdata := p_wdata;
                            s0_rq_idx := p_idx;
                        } else {
                            s1_m_state := m_req;
                            s1_m_base  := h;
                            s1_m_excl  := p_wen;
                            s1_rq_valid := true; s1_rq_off := o;
                            s1_rq_wen := p_wen; s1_rq_wdata := p_wdata;
                            s1_rq_idx := p_idx;
                        };
                    };
                }

                action step_0(ae0 : bool) = {
                    if s0_m_state = m_fill {
                        if tag_occ(v0) {
                            if ~ae0 {
                                ae_r := true;
                                ae_line := s0_mvline;
                                ae_dty  := tag_dty(v0);
                                ae_dat  := dat(v0);
                                tag_occ(v0) := false;
                            };
                        } else {
                            dat(v0)     := s0_mfb;
                            tag_ln(v0)  := s0_m_base;
                            tag_dty(v0) := false;
                            tag_exc(v0) := s0_m_excl;
                            tag_occ(v0) := true;
                            if s0_m_vway = 1 { set_lru(hw_hash(s0_m_base)) := 0; }
                            else { set_lru(hw_hash(s0_m_base)) := 1; };
                            s0_m_state := m_replay;
                        };
                    } else {
                        if s0_rq_valid & s0_rq_wen {
                            dat(v0) := hw_lins(dat(v0), s0_rq_off, s0_rq_wdata);
                            tag_dty(v0) := true;
                            tag_exc(v0) := true;
                            s0_rq_valid := false;
                            s0_m_state  := m_idle;
                        } else { if s0_rq_valid {
                            if ~port_used {
                                ev_ans     := true;
                                ev_ans_h   := s0_m_base;
                                ev_ans_o   := s0_rq_off;
                                ev_ans_d   := hw_lsel(dat(v0), s0_rq_off);
                                ev_ans_idx := s0_rq_idx;
                                port_used  := true;
                                s0_rq_valid := false;
                                s0_m_state  := m_idle;
                            };
                        } else {
                            s0_m_state := m_idle;
                        } };
                    };
                }

                action step_1(ae0 : bool) = {
                    if s1_m_state = m_fill {
                        if tag_occ(v1) {
                            if ~ae0 {
                                ae_r := true;
                                ae_line := s1_mvline;
                                ae_dty  := tag_dty(v1);
                                ae_dat  := dat(v1);
                                tag_occ(v1) := false;
                            };
                        } else {
                            dat(v1)     := s1_mfb;
                            tag_ln(v1)  := s1_m_base;
                            tag_dty(v1) := false;
                            tag_exc(v1) := s1_m_excl;
                            tag_occ(v1) := true;
                            if s1_m_vway = 1 { set_lru(hw_hash(s1_m_base)) := 0; }
                            else { set_lru(hw_hash(s1_m_base)) := 1; };
                            s1_m_state := m_replay;
                        };
                    } else {
                        if s1_rq_valid & s1_rq_wen {
                            dat(v1) := hw_lins(dat(v1), s1_rq_off, s1_rq_wdata);
                            tag_dty(v1) := true;
                            tag_exc(v1) := true;
                            s1_rq_valid := false;
                            s1_m_state  := m_idle;
                        } else { if s1_rq_valid {
                            if ~port_used {
                                ev_ans     := true;
                                ev_ans_h   := s1_m_base;
                                ev_ans_o   := s1_rq_off;
                                ev_ans_d   := hw_lsel(dat(v1), s1_rq_off);
                                ev_ans_idx := s1_rq_idx;
                                port_used  := true;
                                s1_rq_valid := false;
                                s1_m_state  := m_idle;
                            };
                        } else {
                            s1_m_state := m_idle;
                        } };
                    };
                }

                after posedge {
                    var ae0 : bool := ae_r;
                    # ---- the channel-2 store, SNAPSHOT at the top: the pop
                    # at the bottom moves the head and `q2_full` with it, and
                    # the producer read this expression off the pre-edge
                    # pointers as `ch2_msg_taken`. ----
                    var pushc2 : bool := c0_ch2_msg_valid & ~q2_full;
                    # ---- and the channel-2 DECODE, snapshot for the same
                    # reason.  `must_inval_ch2` is `ae_r`, and the array
                    # action below can claim that slot for an eviction on this
                    # very edge; recomputing `has_grant` after it would drop a
                    # grant the ghost mirror has already taken possession of. ----
                    var hg  : bool := has_grant;
                    var pci : bool := process_ch2_inval;
                    # ---- the PRE-edge control states.  Channel 1's handshake
                    # has to be resolved against the states the directory
                    # sampled, not against the ones an invalidate bounce
                    # produced on this same edge: a bounce manufactures a
                    # fresh `m_req`, and advancing THAT slot would hand it a
                    # grant the other slot asked for. ----
                    var q0 : mstate := s0_m_state;
                    var q1 : mstate := s1_m_state;

                    port_used := false;
                    ev_ans    := false;

                    # ---- THE array action, exactly one.  Invalidation
                    # outranks the stage and both MSHRs: a
                    # granted-but-unreplayed line is clean, so bouncing it
                    # keeps the parked request and simply re-requests. ----
                    if inv_act {
                        ae_r := true;
                        ae_line := q2h_line;
                        ae_dty  := (tag_dty(inv_slot) if inv_hit else false);
                        ae_dat  := (dat(inv_slot) if inv_hit else 0);
                        if inv_hit {
                            tag_occ(inv_slot) := false;
                        };
                        if (s0_m_state = m_fill | s0_m_state = m_replay)
                                & s0_m_base = q2h_line {
                            s0_m_state := m_req;
                        };
                        if (s1_m_state = m_fill | s1_m_state = m_replay)
                                & s1_m_base = q2h_line {
                            s1_m_state := m_req;
                        };
                    } else { if p_valid & ~process_ch2_inval
                            & ~(s0_m_state ~= m_idle & s0_m_base = p_h)
                            & ~(s1_m_state ~= m_idle & s1_m_base = p_h)
                            & ~(s0_m_state = m_fill | s0_m_state = m_replay)
                            & ~(s1_m_state = m_fill | s1_m_state = m_replay)
                            & (s0_m_state = m_idle | s1_m_state = m_idle)
                            & (~p_wen | ~p_present | p_hexcl | ~ae_r) {
                        call serve_stage;
                    } else { if ~process_ch2_inval
                                      & (s0_m_state = m_fill | s0_m_state = m_replay) {
                        call step_0(ae0);
                    } else { if ~process_ch2_inval
                                      & (s1_m_state = m_fill | s1_m_state = m_replay) {
                        call step_1(ae0);
                    } } } };

                    # ---- channel 2: latch the matching Shared/Exclusive
                    # grant and reserve a victim way, away from whatever the
                    # other MSHR is already aiming at in the same set. ----
                    if hg & g_match0 {
                        s0_mfb := q2h_dat;
                        s0_m_excl := grant_excl;
                        var w0 : way := 1;
                        if set_lru(hw_hash(s0_m_base)) = 1 { w0 := 0; };
                        if (s1_m_state = m_fill | s1_m_state = m_replay)
                                & hw_hash(s1_m_base) = hw_hash(s0_m_base) {
                            if s1_m_vway = 0 { w0 := 1; } else { w0 := 0; };
                        };
                        s0_m_vway  := w0;
                        s0_mvline  := tag_ln(hw_cidx(hw_hash(s0_m_base), w0));
                        s0_m_state := m_fill;
                    };
                    if hg & g_match1 {
                        s1_mfb := q2h_dat;
                        s1_m_excl := grant_excl;
                        var w1 : way := 1;
                        if set_lru(hw_hash(s1_m_base)) = 1 { w1 := 0; };
                        if (s0_m_state = m_fill | s0_m_state = m_replay)
                                & hw_hash(s0_m_base) = hw_hash(s1_m_base) {
                            if s0_m_vway = 0 { w1 := 1; } else { w1 := 0; };
                        };
                        s1_m_vway  := w1;
                        s1_mvline  := tag_ln(hw_cidx(hw_hash(s1_m_base), w1));
                        s1_m_state := m_fill;
                    };

                    # ---- channel 1, resolved against the pre-edge states ----
                    if c0_req_taken {
                        if q0 = m_req {
                            s0_m_state := m_wait;
                        } else { if q1 = m_req {
                            s1_m_state := m_wait;
                        } };
                    };

                    # ---- stage intake, after the move ----
                    if lsq_to_cache_req_en0 & ~p_valid {
                        p_valid := true;
                        p_h := lsq_to_cache_req_h0;   p_o := lsq_to_cache_req_o0;
                        p_wen := lsq_to_cache_req_wen0;
                        p_wdata := lsq_to_cache_req_wdata0;
                        p_idx := lsq_to_cache_req_idx0;
                    };

                    # ---- channel 3 retires, off the PRE-edge slot ----
                    if ae0 & c0_ack_taken {
                        ae_r := false;
                    };

                    # ---- channel 2's head leaves and the producer's message
                    # arrives.  LAST, after every read of `q2h_*` above: the
                    # decode the whole edge was resolved against is the
                    # PRE-edge head. ----
                    if hg | pci {
                        q2_head := q2_head + 1;
                    };
                    if pushc2 {
                        q2_typ(qi(q2_tail))  := c0_ch2_msg_typ;
                        q2_line(qi(q2_tail)) := c0_ch2_msg_line;
                        q2_dat(qi(q2_tail))  := c0_ch2_msg_data;
                        q2_tail := q2_tail + 1;
                    };
                }

                # ==========================================================
                # 3.1  Array data and permissions.
                # ==========================================================
                invariant [c_set_p0] occupied(K, W) -> hash(ltag(K, W)) = K
                invariant [c_uniq_p0] occupied(K, W1) & occupied(K, W2)
                    & ltag(K, W1) = ltag(K, W2) -> W1 = W2
                invariant [c_img_p0] occupied(K, W) ->
                    val(K, W, O) = img(ltag(K, W), O)
                invariant [c_clean_p0] occupied(K, W) & ~dirty(K, W) ->
                    ~dirtied(0, ltag(K, W), O)
                invariant [dirty_excl_p0] occupied(K, W) & dirty(K, W) ->
                    exclusive(K, W)
                invariant [hold_inf_a_p0] occupied(K, W) -> holds(0, ltag(K, W))
                invariant [excl_inf_a_p0] occupied(K, W) & exclusive(K, W) ->
                    cachemem.exclusive(0, ltag(K, W))

                # ==========================================================
                # 3.2  The two MSHRs do not alias the array, or each other.
                # ==========================================================
                invariant [no_alias_0_p0]
                    (s0_m_state = m_req | s0_m_state = m_wait | s0_m_state = m_fill)
                    & occupied(K, W) -> ltag(K, W) ~= s0_m_base
                invariant [no_alias_1_p0]
                    (s1_m_state = m_req | s1_m_state = m_wait | s1_m_state = m_fill)
                    & occupied(K, W) -> ltag(K, W) ~= s1_m_base
                invariant [mshr_distinct_p0] s0_m_state ~= m_idle & s1_m_state ~= m_idle
                    -> s0_m_base ~= s1_m_base

                # ---- a filling MSHR owns its victim way, and the two never
                # aim at the same one ----
                invariant [mv_ok_0_p0] s0_m_state = m_fill & tag_occ(v0) ->
                    s0_mvline = ltag(hash(s0_m_base), s0_m_vway)
                invariant [mv_ok_1_p0] s1_m_state = m_fill & tag_occ(v1) ->
                    s1_mvline = ltag(hash(s1_m_base), s1_m_vway)
                invariant [ev_distinct_p0]
                      (s0_m_state = m_fill | s0_m_state = m_replay)
                    & (s1_m_state = m_fill | s1_m_state = m_replay)
                    & hash(s0_m_base) = hash(s1_m_base)
                    -> s0_m_vway ~= s1_m_vway

                # ---- past the fill the line really is where the MSHR left
                # it, which is what the replay writes into ----
                invariant [replay_way_0_p0] s0_m_state = m_replay ->
                    tag_occ(v0) & ltag(hash(s0_m_base), s0_m_vway) = s0_m_base
                invariant [replay_way_1_p0] s1_m_state = m_replay ->
                    tag_occ(v1) & ltag(hash(s1_m_base), s1_m_vway) = s1_m_base

                # ---- a parked store only ever sits behind an Exclusive
                # request: that is what makes the replay's write legal ----
                invariant [rq_store_excl_0_p0] s0_rq_valid & s0_rq_wen -> s0_m_excl
                invariant [rq_store_excl_1_p0] s1_rq_valid & s1_rq_wen -> s1_m_excl

                # ==========================================================
                # 3.3  The fill buffers.
                # ==========================================================
                invariant [fill_clean_0_p0] s0_m_state = m_fill ->
                    ~dirtied(0, s0_m_base, O)
                invariant [fill_clean_1_p0] s1_m_state = m_fill ->
                    ~dirtied(0, s1_m_base, O)
                invariant [mfb_img_0_p0] s0_m_state = m_fill ->
                    lsel(s0_mfb, O) = img(s0_m_base, O)
                invariant [mfb_img_1_p0] s1_m_state = m_fill ->
                    lsel(s1_mfb, O) = img(s1_m_base, O)

                invariant [hold_inf_0_p0]
                    (s0_m_state = m_fill | s0_m_state = m_replay) ->
                    holds(0, s0_m_base)
                invariant [hold_inf_1_p0]
                    (s1_m_state = m_fill | s1_m_state = m_replay) ->
                    holds(0, s1_m_base)
                invariant [excl_inf_0_p0]
                    (s0_m_state = m_fill | s0_m_state = m_replay) & s0_m_excl ->
                    cachemem.exclusive(0, s0_m_base)
                invariant [excl_inf_1_p0]
                    (s1_m_state = m_fill | s1_m_state = m_replay) & s1_m_excl ->
                    cachemem.exclusive(0, s1_m_base)

                # ==========================================================
                # 3.4  The channel-2 queue, and channel 2's NET NAMES.
                #
                # `[gr_push_empty0]` and `[grant_img_*]` are the home's
                # promises about the message on this cache's channel 2.
                # The first is stated -- as it must be -- over the net names
                # `c0_gr_valid` and `c0_ch2_empty`; the second is stated once
                # over the uplink `x_ch2_msg_*` and reaches this cache only
                # by unfolding through `c0_gr_valid`, `c0_gr_line` and
                # `c0_gr_data`.  A definition is admitted into an isolate's
                # query only when the defined symbol occurs in that isolate's
                # OWN code or invariants; an occurrence inside an invariant
                # imported from a sibling does NOT count (the note above the
                # channel declarations at `cachemem` is the same rule).
                # Nothing in this datapath mentions those four -- it reads the
                # raw `c0_ch2_msg_*` wires -- so without these identities
                # every one of the home's promises relates opaque constants
                # and says NOTHING.  Such a query does not fail, it runs
                # forever: measured, `q2_gq_a_p0` alone did not come back
                # inside twenty minutes.
                #
                # Each holds by unfolding in the pre-state AND the post-state,
                # so consecution is syntactic; the content is entirely in
                # making the four definitions visible.
                # ==========================================================
                invariant [ch2_net_grv_p0] c0_gr_valid =
                    (c0_ch2_msg_valid & c0_ch2_msg_typ ~= ch2_inv)
                invariant [ch2_net_grl_p0] c0_gr_line = c0_ch2_msg_line
                invariant [ch2_net_grd_p0] c0_gr_data = c0_ch2_msg_data
                invariant [ch2_net_mt_p0] c0_ch2_empty = q2_empty

                invariant [q2_bound_p0] q2_tail - q2_head <= 2

                # ---- a grant, if the queue holds one, is at the HEAD, and
                # the slot behind the head is always an invalidate: a grant is
                # sent only into an EMPTY queue (`[gr_push_empty0]`), so
                # nothing can ever sit in front of one and `[I, G]` is
                # unreachable.  That is what collapses the per-slot statements
                # into one apiece, and it is the form every consumer already
                # wants -- `has_grant`, the fill path and the home's
                # queued-grant record all read the head and nothing else.
                #
                # `[q2_gq_*]` is the two-way tie between the queue and that
                # record: every head grant IS `gq0_*`, and `gq0_*` has a head
                # grant behind it.  `dsh` went up when the message was sent,
                # so without the second direction a pop would clear the record
                # while the home still believed the line was here.
                #
                # `[q2_img_lo_p0]`/`[q2_img_hi_p0]` are what a fill installs.
                # Nothing can move
                # `img` under a queued grant: this cache does not hold the
                # line yet, so it cannot store into it (`[gq_nothold0]`), and
                # the other cache cannot either, because a queued grant
                # already owns the sharer bit (`[gr_shared0i]`). ----
                invariant [q2_gq_h_p0] ~q2_empty & q2h_typ ~= ch2_inv ->
                    gq0_v & gq0_l = q2h_line
                    & gq0_x = (q2h_typ = ch2_gex)
                invariant [q2_gq_v_p0] gq0_v ->
                    ~q2_empty & q2h_typ ~= ch2_inv
                invariant [q2_2nd_inv_p0] q2_tail - q2_head = 2 ->
                    q2_typ(qi(q2_head + 1)) = ch2_inv

                # ---- and per BEAT, which is the granularity the home's
                # promise arrives at (`[grant_img_lo]`/`[grant_img_hi]`).
                # Kept at that granularity all the way through the queue so
                # the push is a SYNTACTIC match against the promise -- no
                # `p_cover` round trip on an edge that is also moving two
                # pointers.  The bridge to a word-granular `lsel(_, O)`
                # happens exactly once, at the fill, in `[mfb_img_*]`, which
                # is where it was paid for before the queue existed. ----
                invariant [q2_img_lo_p0] ~q2_empty & q2h_typ ~= ch2_inv ->
                    lsel(q2h_dat, concatbv2(0, J)) = img(q2h_line, concatbv2(0, J))
                invariant [q2_img_hi_p0] ~q2_empty & q2h_typ ~= ch2_inv ->
                    lsel(q2h_dat, concatbv2(1, J)) = img(q2h_line, concatbv2(1, J))

                # ---- the concrete channel-3 register mirrors cachemem. ----
                invariant [ae_sync_p0] ack0_g_en = ae_r

            }

        } with this, dir_body, xbar_body, addr_thy, basis, data_impl
        # ==================================================================
        # CPU 1's cache.  8 sets x 2 ways, 2 MSHRs, whole-line data.
        #
        # Cache lines are at the same granularity as the directory/LLC. 
        # All evictions trigger a notification to the directory. 
        # ==================================================================
        isolate cache1_body = {

            # ---- LSQ request channel: the request comes from the LSQ, the
            # ready is driven here.  `lsq_to_cache_req_idx1` is opaque to the
            # cache: it is stored beside the request in the MSHR slot and
            # handed straight back on the response. ----
            wire lsq_to_cache_req_en1     : bool
            wire lsq_to_cache_req_h1      : line
            wire lsq_to_cache_req_o1      : woffset
            wire lsq_to_cache_req_wen1    : bool
            wire lsq_to_cache_req_wdata1  : word
            wire lsq_to_cache_req_idx1    : load_idx
            wire cache_to_lsq_creq_ready1 : bool

            # ---- LSQ response channel: all driven here ----
            wire cache_to_lsq_resp_valid1 : bool
            wire cache_to_lsq_resp_h1     : line
            wire cache_to_lsq_resp_o1     : woffset
            wire cache_to_lsq_resp_data1  : word
            wire cache_to_lsq_resp_idx1   : load_idx

            # ---- the ports this cache drives on the directory side ----
            wire req_en    : bool
            wire req_line  : line
            wire req_excl  : bool
            wire ch2_msg_taken : bool
            wire inv_taken : bool
            # ---- channel 2's queue, seen from outside: `empty` is what the
            # directory waits on before it sends a grant, and `has_grant` with
            # its payload is what `process_ch2` produced this edge. ----
            wire ch2_empty   : bool
            wire inv_pop_line : line
            wire has_grant   : bool
            wire grant_excl  : bool
            wire grant_line  : line

            # ---- channel 3 as REAL hardware, held by its producer (plan
            # decision 2).  `cachemem` keeps a ghost copy of the same slot --
            # the directory's `[wb_*]` invariants are claims about the
            # POST-state and need a symbol the environment cannot re-drive --
            # and `[ack_sync_*]` pins the two together, the `ae_r` pattern
            # widened from the enable bit to the whole payload.  Without these
            # registers the directory's datapath reads specification state and
            # `ivy_to_rtl` emits a dangling wire. ----
            wire ack_en    : bool
            wire ack_line  : line
            wire ack_dty   : bool
            wire ack_dat   : cache_line

            # ---- the pending-store view the LSQ contract is stated over.
            # A store is accepted at the port one edge before it reaches the
            # array: it waits in the stage, and on a miss it waits again in
            # the allocating MSHR's slot.  Those three records ARE
            # `in_progress`, and they are exported as wires so the contract
            # can name them without naming the registers behind them. ----
            wire stage_go : bool
            wire ps_v : bool
            wire ps_h : line
            wire ps_o : woffset
            wire ps_d : word
            wire p0_v : bool
            wire p0_h : line
            wire p0_o : woffset
            wire p0_d : word
            wire p1_v : bool
            wire p1_h : line
            wire p1_o : woffset
            wire p1_d : word
            wire in_progress(H : line) : bool

            # ---- proof observation ports ----
            wire st_en     : bool
            wire st_h      : line
            wire st_o      : woffset
            wire st_d      : word
            wire give_en   : bool
            wire give_line : line
            wire give_dty  : bool
            wire give_dat  : cache_line

            specification {
                # This holds since `img` is only updated after stores commit. It is possible
                # that one of the caches holds stale data while the other cache has an ongoing write.
                # In that case, `img` does not reflect the in-progress write. This works since we have
                # depth-1 MSHRs and don't implement store-to-load forwarding
                invariant [resp_img_int_p1] cache_to_lsq_resp_valid1 ->
                    cache_to_lsq_resp_data1 = img(cache_to_lsq_resp_h1,
                                                 cache_to_lsq_resp_o1)

                
                # The cache only surrenders lines it holds
                invariant [ca_gv_hold_p1] c1_give_en -> holds(1, c1_give_line)
                # Guarantee to the directory that if we don't hold a line, then
                # it is not exclusive
                invariant [ca_excl_hold_p1] cachemem.exclusive(1, H) -> holds(1, H)

                # Storing a line implies that we have exclusive perms
                invariant [ca_st_excl_p1] c1_st_en -> cachemem.exclusive(1, c1_st_h)

                # We never start to give a new invalidate acknowledgement while there is an old invalidate
                # acknowledgement waiting to be sent. 
                invariant [ca_gv_nodouble_p1] c1_give_en -> ~ack1_g_en

                invariant [ca_gv_nost_p1] c1_give_en -> ~c1_st_en

                # A clean surrender carries no write debt: no word of the
                # line is dirtied, so the directory may keep trusting its
                # own copy of it.
                invariant [ca_gv_clean_p1] c1_give_en & ~c1_give_dty ->
                    ~dirtied(1, c1_give_line, O)
                # A dirty surrender is believable as the whole image only
                # under SWMR: dirty implies the copy was Exclusive.
                invariant [ca_gv_dirty_excl_p1] c1_give_en & c1_give_dty ->
                    cachemem.exclusive(1, c1_give_line)

                # Write debt never floats unaccounted: a word is dirtied
                # only while its line is held or while the dirty ack
                # carrying it is in flight.
                invariant [ca_dirtied_p1]
                      ~holds(1, H)
                    & ~ack1_dty(H)
                    -> ~dirtied(1, H, O)
                invariant [ca_dirtied_excl_p1] dirtied(1, H, O) ->
                      cachemem.exclusive(1, H)
                    | ack1_dty(H)

                # A clean ack vouches for nothing: no word of its line is dirtied.
                invariant [ca_clean_ack_p1] ack1_any(H) & ~ack1_dty(H) ->
                    ~dirtied(1, H, O)

                # If we send an invalidate acknowledgement, then we don't hold the line
                invariant [ca_ack_idle_p1] ack1_any(H) -> ~holds(1, H)

                # Data we send as part of the invalidate is valid
                # 
                # This works since all dirtied lines are a result of completed stores,
                # which means that they are reflected in `img`.
                invariant [ack_img_p1] c1_ack_en & c1_ack_dty ->
                    lsel(c1_ack_dat, O) = img(c1_ack_line, O)

                # ---- the hardware slot and the ghost slot are the same slot ----
                invariant [ack_sync_en_p1] c1_ack_en = ack1_g_en
                invariant [ack_sync_line_p1] ack1_g_en ->
                    c1_ack_line = ack1_g_line
                invariant [ack_sync_dty_p1] ack1_g_en ->
                    c1_ack_dty = ack1_g_dty

                # `c1_ch2_msg_valid` is true if we acknowledge the grant. 
                invariant [ca_ch2_taken_valid_p1] c1_ch2_msg_taken ->
                    c1_ch2_msg_valid
                # Popped grants are from the top of the queue
                invariant [ca_gr_gq_p1] has_grant ->
                    gq1_v & grant_line = gq1_l & grant_excl = gq1_x

                after posedge {
                    if has_grant {
                        gq1_v := false;
                        holds(C, H) := (true if C = 1 & H = grant_line else holds(C, H));
                        cachemem.exclusive(C, H) := (grant_excl if C = 1 & H = grant_line
                                          else cachemem.exclusive(C, H));
                    };
                }
            }

            implementation {
                # ==========================================================
                # The array.  One memory per former struct field, indexed by
                # the packed (set, way) slot -- an RTLIL memory is
                # one-dimensional and a struct sort has no bit width.  The
                # data is ONE whole line per slot now: a fill writes it in a
                # single edge, so there is nothing left for the beat split to
                # buy.
                #
                # `set_lru` is ONE bit per set, not one per way: per way it
                # took two writes to the same memory on every hit, which the
                # translator merges into a single port.
                # ==========================================================
                # `tag_exc` is written at a fill, off the grant's kind, and
                # RE-ASSERTED on the two store paths.  The re-assert is
                # provably idempotent -- a store only commits where the
                # permission already is -- but stating it syntactically is
                # what keeps `[ca_gv_clean_*]` inductive: without it the
                # solver has to rediscover the permission through the hit
                # test, and the query stops coming back.
                var tag_occ(S : cache_slot) : bool
                var tag_dty(S : cache_slot) : bool
                var tag_exc(S : cache_slot) : bool
                var tag_ln(S : cache_slot)  : line
                var set_lru(K : key)        : bit
                var dat(S : cache_slot)     : cache_line

                # ---- the (set, way) view the invariants are written in.
                # Plain defined functions, so `ivy_to_rtl` never sees them. ----
                function occupied(K : key, W : way) : bool
                definition occupied(K, W) = tag_occ(cidx(K, W))
                function dirty(K : key, W : way) : bool
                definition dirty(K, W) = tag_dty(cidx(K, W))
                function exclusive(K : key, W : way) : bool
                definition exclusive(K, W) = tag_exc(cidx(K, W))
                function ltag(K : key, W : way) : line
                definition ltag(K, W) = tag_ln(cidx(K, W))
                function val(K : key, W : way, O : woffset) : word
                definition val(K, W, O) = lsel(dat(cidx(K, W)), O)

                # ---- the MSHR's control states.  An enumeration has no bit
                # width, so these are narrow bit vectors and the names are
                # 0-ary wires. ----
                wire m_idle   : mstate
                wire m_req    : mstate
                wire m_wait   : mstate
                wire m_fill   : mstate
                wire m_replay : mstate
                definition m_idle   = 0
                definition m_req    = 1
                definition m_wait   = 2
                definition m_fill   = 3
                definition m_replay = 4

                # ==========================================================
                # The two MSHRs, as registers rather than as an array over
                # `mshr_id`: `m_state` is written by the capture, by an
                # allocation and by a fill on the same edge, and a memory has
                # one write port per clock.  The proof sees them only at the
                # two literal indices, which is what keeps every invariant a
                # clean trigger.
                #
                # `mvline` is GHOST: the line this MSHR is evicting, recorded
                # when the victim way is picked.  Metadata carried BESIDE the
                # slot rather than read back out of it, which is what keeps
                # the writeback proof inside the decidable fragment -- naming
                # the victim as `ltag(hash(m_base(Id)), ...)` under a
                # quantifier sends the query from a line, through `hash`,
                # into the array and back out to a line.
                # ==========================================================
                var s0_m_state : mstate
                var s0_m_base  : line
                var s0_m_excl  : bool
                var s0_m_vway  : way
                var s0_mvline  : line
                var s0_mfb     : cache_line
                var s0_rq_valid : bool
                var s0_rq_off   : woffset
                var s0_rq_wen   : bool
                var s0_rq_wdata : word
                var s0_rq_idx   : load_idx
                var s1_m_state : mstate
                var s1_m_base  : line
                var s1_m_excl  : bool
                var s1_m_vway  : way
                var s1_mvline  : line
                var s1_mfb     : cache_line
                var s1_rq_valid : bool
                var s1_rq_off   : woffset
                var s1_rq_wen   : bool
                var s1_rq_wdata : word
                var s1_rq_idx   : load_idx

                # ---- the input stage.  ALL requests pass through it. ----
                var p_valid : bool
                var p_h     : line
                var p_o     : woffset
                var p_wen   : bool
                var p_wdata : word
                var p_idx   : load_idx

                var port_used : bool

                var ev_ans     : bool
                var ev_ans_h   : line
                var ev_ans_o   : woffset
                var ev_ans_d   : word
                var ev_ans_idx : load_idx

                # ==========================================================
                # Channel 2 as a QUEUE, depth 2, held by its CONSUMER.
                #
                # The directory stores at the tail and `process_ch2` reads at
                # the head, so the two message kinds cannot overtake each
                # other: an invalidate posted behind a grant is popped behind
                # it, and the cache installs the line before it gives it up.
                # That ordering is the whole reason the queue is here.
                #
                # Two entries is exactly what the protocol can produce.  A
                # grant is sent only into an EMPTY queue, so a grant is always
                # the head; the transaction that sent it then ends, and the
                # next one can post one invalidate to this cache behind it.
                # `[G]`, `[I]` and `[G, I]` are the only non-empty states, and
                # `[I, G]` is unreachable.
                # ==========================================================
                var q2_typ(I : qidx)  : ch2typ
                var q2_line(I : qidx) : line
                var q2_dat(I : qidx)  : cache_line
                var q2_head : qptr
                var q2_tail : qptr

                # ---- this side's copy of the channel-3 slot.  A guard has
                # to be a function of THIS isolate's registers: the record at
                # `cachemem` is written by a monitor that runs before this
                # one, so a guard phrased over `ack1_g_en` would be read there
                # at its old value and re-read here at its new one. ----
                var ae_r : bool
                var ae_line : line
                var ae_dty  : bool
                var ae_dat  : cache_line

                after init {
                    tag_occ(S) := false; tag_dty(S) := false; tag_exc(S) := false; tag_ln(S) := 0;
                    set_lru(K) := 0; dat(S) := 0;
                    s0_m_state := 0; s0_m_base := 0; s0_m_excl := false;
                    s0_m_vway := 0; s0_mvline := 0; s0_mfb := 0;
                    s0_rq_valid := false; s0_rq_off := 0; s0_rq_wen := false;
                    s0_rq_wdata := 0; s0_rq_idx := 0;
                    s1_m_state := 0; s1_m_base := 0; s1_m_excl := false;
                    s1_m_vway := 0; s1_mvline := 0; s1_mfb := 0;
                    s1_rq_valid := false; s1_rq_off := 0; s1_rq_wen := false;
                    s1_rq_wdata := 0; s1_rq_idx := 0;
                    p_valid := false; p_h := 0; p_o := 0; p_wen := false;
                    p_wdata := 0; p_idx := 0;
                    port_used := false;
                    ev_ans := false; ev_ans_h := 0; ev_ans_o := 0;
                    ev_ans_d := 0; ev_ans_idx := 0;
                    ae_r := false;
                    ae_line := 0; ae_dty := false; ae_dat := 0;
                    q2_typ(I) := 0; q2_line(I) := 0; q2_dat(I) := 0;
                    q2_head := 0; q2_tail := 0;
                }

                # ==========================================================
                # `process_ch2`.
                #
                # One message leaves the queue per edge and the whole of it is
                # combinational: `has_grant` and `process_ch2_inval` are the
                # two decodes of the head, exclusive because a head has one
                # kind, and they are what the rest of the cache reads instead
                # of a channel-2 port.
                #
                # `must_inval_ch2` IS the channel-3 holding slot.  A popped
                # invalidate has to be answerable on the edge it is popped --
                # its reply is latched and the copy dropped at the same time --
                # so no message is taken while that slot is occupied.
                # `ae_line`/`ae_dty`/`ae_dat` are the plan's
                # `inval_ch2_data*`: the slot already existed for evictions
                # and self-downgrades and a second one would only have to be
                # arbitrated against it.
                #
                # A grant is popped only when an MSHR is waiting for exactly
                # it.  Otherwise possession would be taken and then dropped
                # with the home still recording this cache as a sharer.
                # Holding the head instead costs liveness in a case the
                # protocol cannot produce -- a grant answers a request -- and
                # costs nothing in safety.
                # ==========================================================
                wire q2_empty : bool
                wire q2_full  : bool
                definition q2_empty = (q2_head = q2_tail)
                definition q2_full  = (q2_tail - q2_head = 2)

                wire q2h_typ  : ch2typ
                wire q2h_line : line
                wire q2h_dat  : cache_line
                definition q2h_typ  = q2_typ(qi(q2_head))
                definition q2h_line = q2_line(qi(q2_head))
                definition q2h_dat  = q2_dat(qi(q2_head))

                wire must_inval_ch2 : bool
                definition must_inval_ch2 = ae_r

                wire g_match0 : bool
                wire g_match1 : bool
                definition g_match0 = s0_m_state = m_wait & s0_m_base = q2h_line
                    & (~s0_rq_wen | q2h_typ = ch2_gex)
                definition g_match1 = s1_m_state = m_wait & s1_m_base = q2h_line
                    & (~s1_rq_wen | q2h_typ = ch2_gex)

                wire process_ch2_inval : bool
                wire ch2_pop : bool
                definition has_grant = ~must_inval_ch2 & ~q2_empty
                    & q2h_typ ~= ch2_inv & (g_match0 | g_match1)
                definition process_ch2_inval = ~must_inval_ch2 & ~q2_empty
                    & q2h_typ = ch2_inv
                definition ch2_pop = has_grant | process_ch2_inval
                definition grant_excl = (q2h_typ = ch2_gex)
                definition grant_line = q2h_line

                definition ch2_empty      = q2_empty
                definition inv_pop_line   = q2h_line
                definition ch2_msg_taken = c1_ch2_msg_valid & ~q2_full

                # ==========================================================
                # The arbiter, written out as three wires.  `stage_go` is the
                # stage-movable gate: the staged request enters only when its
                # line aliases no active MSHR, no MSHR wants the array this
                # edge, and an MSHR is free to take a miss.  Otherwise the
                # first MSHR that wants the array gets it.  Exactly one of
                # the three is true, which is what makes the single-writer
                # discipline on the array and on `c_st_*` syntactic.
                #
                # The gate does NOT mention the response port.  It does not
                # have to: one array action per edge means a store commit and
                # a load answer never share an edge, so `[resp_img]` cannot
                # be overtaken by an image move.
                # ==========================================================
                # ---- presence and permission are separate.  Loads hit any
                # resident copy; stores hit only an Exclusive copy. ----
                wire p_present : bool
                wire p_hit     : bool
                wire p_hway    : way
                wire p_hexcl   : bool
                wire p_slot    : cache_slot
                definition p_present =
                      (tag_occ(hw_cidx(hw_hash(p_h), 1)) & tag_ln(hw_cidx(hw_hash(p_h), 1)) = p_h)
                    | (tag_occ(hw_cidx(hw_hash(p_h), 0)) & tag_ln(hw_cidx(hw_hash(p_h), 0)) = p_h)
                definition p_hway =
                    (1 if (tag_occ(hw_cidx(hw_hash(p_h), 1))
                           & tag_ln(hw_cidx(hw_hash(p_h), 1)) = p_h) else 0)
                definition p_slot = hw_cidx(hw_hash(p_h), p_hway)
                definition p_hexcl = p_present & tag_exc(p_slot)
                definition p_hit = p_present & (~p_wen | p_hexcl)
                wire arb0 : bool
                wire arb1 : bool

                # ---- invalidates use a separate held slot and have array and
                # channel-3 priority.  An invalidate is answered for a
                # resident copy AND for either MSHR's post-grant window,
                # where the line is held but not yet installed: that MSHR
                # bounces back to `m_req` with its request still parked, and
                # the reply is clean because the parked store applies only at
                # replay.  At most one of the three can match: `[c_uniq]`
                # keeps a line in one way and `[mshr_distinct_p1]` keeps the
                # two MSHRs off each other's line. ----
                wire inv_hit    : bool
                wire inv_hway   : way
                wire inv_slot   : cache_slot
                wire inv_mshr0  : bool
                wire inv_mshr1  : bool
                wire inv_act    : bool
                definition inv_hit =
                      (tag_occ(hw_cidx(hw_hash(q2h_line), 1)) & tag_ln(hw_cidx(hw_hash(q2h_line), 1)) = q2h_line)
                    | (tag_occ(hw_cidx(hw_hash(q2h_line), 0)) & tag_ln(hw_cidx(hw_hash(q2h_line), 0)) = q2h_line)
                definition inv_hway =
                    (1 if (tag_occ(hw_cidx(hw_hash(q2h_line), 1))
                           & tag_ln(hw_cidx(hw_hash(q2h_line), 1)) = q2h_line) else 0)
                definition inv_slot = hw_cidx(hw_hash(q2h_line), inv_hway)
                definition inv_mshr0 = (s0_m_state = m_fill | s0_m_state = m_replay)
                    & s0_m_base = q2h_line
                definition inv_mshr1 = (s1_m_state = m_fill | s1_m_state = m_replay)
                    & s1_m_base = q2h_line
                # ---- a popped invalidate is ANSWERED only if the line is
                # here.  A miss needs no reply, and the argument is local:
                # this cache holds no copy and has no MSHR window on the
                # line, so it owes the home nothing for it -- whatever the
                # home is waiting on was already put in flight by the
                # self-eviction that overtook this invalidate.  The pop
                # still happens: the message is consumed either way. ----
                definition inv_act = process_ch2_inval
                    & (inv_hit | inv_mshr0 | inv_mshr1)
                definition inv_taken = inv_act

                # ---- the stage-movable gate, back to its two-MSHR shape:
                # the staged request enters only when its line aliases no
                # active MSHR, no MSHR wants the array this edge, and an MSHR
                # is free to take a miss -- plus, new here, channel 3 is free
                # if the request is a store that has to self-downgrade a
                # Shared copy first.  Otherwise the first MSHR that wants the
                # array gets it, and an invalidate outranks all of them. ----
                definition stage_go = p_valid
                    & ~process_ch2_inval
                    & ~(s0_m_state ~= m_idle & s0_m_base = p_h)
                    & ~(s1_m_state ~= m_idle & s1_m_base = p_h)
                    & ~(s0_m_state = m_fill | s0_m_state = m_replay)
                    & ~(s1_m_state = m_fill | s1_m_state = m_replay)
                    & (s0_m_state = m_idle | s1_m_state = m_idle)
                    & (~p_wen | ~p_present | p_hexcl | ~ae_r)
                definition arb0 = ~stage_go & ~process_ch2_inval
                    & (s0_m_state = m_fill | s0_m_state = m_replay)
                definition arb1 = ~stage_go & ~process_ch2_inval
                    & ~(s0_m_state = m_fill | s0_m_state = m_replay)
                    & (s1_m_state = m_fill | s1_m_state = m_replay)

                definition ps_v = p_valid & p_wen
                definition ps_h = p_h
                definition ps_o = p_o
                definition ps_d = p_wdata
                definition p0_v = s0_rq_valid & s0_rq_wen
                definition p0_h = s0_m_base
                definition p0_o = s0_rq_off
                definition p0_d = s0_rq_wdata
                definition p1_v = s1_rq_valid & s1_rq_wen
                definition p1_h = s1_m_base
                definition p1_o = s1_rq_off
                definition p1_d = s1_rq_wdata
                definition in_progress(H) =
                      (p_valid & p_wen & p_h = H)
                    | (s0_rq_valid & s0_rq_wen & s0_m_base = H)
                    | (s1_rq_valid & s1_rq_wen & s1_m_base = H)

                # ---- the victim slot each MSHR is aiming at ----
                wire v0 : cache_slot
                wire v1 : cache_slot
                definition v0 = hw_cidx(hw_hash(s0_m_base), s0_m_vway)
                definition v1 = hw_cidx(hw_hash(s1_m_base), s1_m_vway)

                # ---- channel 3 has four producers now: the invalidate
                # reply, the store's self-downgrade, and each MSHR's
                # fill-eviction.  They are one-hot because the invalidate
                # outranks everything and `stage_go`, `arb0`, `arb1` are
                # mutually exclusive. ----
                wire gv0 : bool
                wire gv1 : bool
                wire ugv : bool
                definition gv0 = (s0_m_state = m_fill) & tag_occ(v0) & ~ae_r
                definition gv1 = (s1_m_state = m_fill) & tag_occ(v1) & ~ae_r
                definition ugv = stage_go & p_wen & p_present & ~p_hexcl

                definition give_en = inv_taken | ugv | (arb0 & gv0) | (arb1 & gv1)
                definition give_line = (q2h_line if inv_taken else
                                        (p_h if ugv else
                                         (s0_mvline if arb0 else s1_mvline)))
                definition give_dty = ((tag_dty(inv_slot) if inv_hit else false) if inv_taken else
                                       (tag_dty(p_slot) if ugv else
                                        (tag_dty(v0) if arb0 else tag_dty(v1))))
                definition give_dat = ((dat(inv_slot) if inv_hit else 0) if inv_taken else
                                       (dat(p_slot) if ugv else
                                        (dat(v0) if arb0 else dat(v1))))

                # ---- a store commits on the stage's Exclusive-hit path or on
                # an MSHR's replay ----
                definition st_en = (stage_go & p_wen & p_hit)
                    | (arb0 & s0_m_state = m_replay & s0_rq_valid & s0_rq_wen)
                    | (arb1 & s1_m_state = m_replay & s1_rq_valid & s1_rq_wen)
                definition st_h = (p_h if stage_go
                                   else (s0_m_base if arb0 else s1_m_base))
                definition st_o = (p_o if stage_go
                                   else (s0_rq_off if arb0 else s1_rq_off))
                definition st_d = (p_wdata if stage_go
                                   else (s0_rq_wdata if arb0 else s1_rq_wdata))

                # ---- channel 1 is held by one `m_req` MSHR at a time, MSHR0
                # first ----
                definition req_en   = (s0_m_state = m_req) | (s1_m_state = m_req)
                definition req_line = (s0_m_base if s0_m_state = m_req
                                       else s1_m_base)
                definition req_excl = (s0_m_excl if s0_m_state = m_req
                                       else s1_m_excl)

                definition ack_en   = ae_r
                definition ack_line = ae_line
                definition ack_dty  = ae_dty
                definition ack_dat  = ae_dat

                definition cache_to_lsq_creq_ready1 = ~p_valid | stage_go

                definition cache_to_lsq_resp_valid1 = ev_ans
                definition cache_to_lsq_resp_h1     = ev_ans_h
                definition cache_to_lsq_resp_o1     = ev_ans_o
                definition cache_to_lsq_resp_data1  = ev_ans_d
                definition cache_to_lsq_resp_idx1   = ev_ans_idx

                # ==========================================================
                # The three array actions.
                # ==========================================================
                action serve_stage = {
                    var h  : line    := p_h;
                    var o  : woffset := p_o;
                    var rs : key     := hw_hash(h);
                    var present : bool := false;
                    var hit     : bool := false;
                    var hway    : way  := 1;
                    p_valid := false;
                    if tag_occ(hw_cidx(rs, 1)) & tag_ln(hw_cidx(rs, 1)) = h {
                        present := true; hway := 1;
                    } else { if tag_occ(hw_cidx(rs, 0)) & tag_ln(hw_cidx(rs, 0)) = h {
                        present := true; hway := 0;
                    } };
                    hit := present & (~p_wen | tag_exc(hw_cidx(rs, hway)));
                    if hit {
                        if p_wen {
                            dat(hw_cidx(rs, hway)) :=
                                hw_lins(dat(hw_cidx(rs, hway)), o, p_wdata);
                            tag_dty(hw_cidx(rs, hway)) := true;
                            tag_exc(hw_cidx(rs, hway)) := true;
                        } else {
                            ev_ans     := true;
                            ev_ans_h   := h;
                            ev_ans_o   := o;
                            ev_ans_d   := hw_lsel(dat(hw_cidx(rs, hway)), o);
                            ev_ans_idx := p_idx;
                            port_used  := true;
                        };
                        if hway = 1 { set_lru(rs) := 0; } else { set_lru(rs) := 1; };
                    } else {
                        # A store to Shared surrenders that clean copy before
                        # requesting Exclusive.  `stage_go` waited for ch3.
                        if present {
                            ae_r := true;
                            ae_line := h;
                            ae_dty  := tag_dty(hw_cidx(rs, hway));
                            ae_dat  := dat(hw_cidx(rs, hway));
                            tag_occ(hw_cidx(rs, hway)) := false;
                        };
                        # ---- allocate.  Under the gate one MSHR is idle, so
                        # the else arm is closed by construction. ----
                        if s0_m_state = m_idle {
                            s0_m_state := m_req;
                            s0_m_base  := h;
                            s0_m_excl  := p_wen;
                            s0_rq_valid := true; s0_rq_off := o;
                            s0_rq_wen := p_wen; s0_rq_wdata := p_wdata;
                            s0_rq_idx := p_idx;
                        } else {
                            s1_m_state := m_req;
                            s1_m_base  := h;
                            s1_m_excl  := p_wen;
                            s1_rq_valid := true; s1_rq_off := o;
                            s1_rq_wen := p_wen; s1_rq_wdata := p_wdata;
                            s1_rq_idx := p_idx;
                        };
                    };
                }

                action step_0(ae0 : bool) = {
                    if s0_m_state = m_fill {
                        if tag_occ(v0) {
                            if ~ae0 {
                                ae_r := true;
                                ae_line := s0_mvline;
                                ae_dty  := tag_dty(v0);
                                ae_dat  := dat(v0);
                                tag_occ(v0) := false;
                            };
                        } else {
                            dat(v0)     := s0_mfb;
                            tag_ln(v0)  := s0_m_base;
                            tag_dty(v0) := false;
                            tag_exc(v0) := s0_m_excl;
                            tag_occ(v0) := true;
                            if s0_m_vway = 1 { set_lru(hw_hash(s0_m_base)) := 0; }
                            else { set_lru(hw_hash(s0_m_base)) := 1; };
                            s0_m_state := m_replay;
                        };
                    } else {
                        if s0_rq_valid & s0_rq_wen {
                            dat(v0) := hw_lins(dat(v0), s0_rq_off, s0_rq_wdata);
                            tag_dty(v0) := true;
                            tag_exc(v0) := true;
                            s0_rq_valid := false;
                            s0_m_state  := m_idle;
                        } else { if s0_rq_valid {
                            if ~port_used {
                                ev_ans     := true;
                                ev_ans_h   := s0_m_base;
                                ev_ans_o   := s0_rq_off;
                                ev_ans_d   := hw_lsel(dat(v0), s0_rq_off);
                                ev_ans_idx := s0_rq_idx;
                                port_used  := true;
                                s0_rq_valid := false;
                                s0_m_state  := m_idle;
                            };
                        } else {
                            s0_m_state := m_idle;
                        } };
                    };
                }

                action step_1(ae0 : bool) = {
                    if s1_m_state = m_fill {
                        if tag_occ(v1) {
                            if ~ae0 {
                                ae_r := true;
                                ae_line := s1_mvline;
                                ae_dty  := tag_dty(v1);
                                ae_dat  := dat(v1);
                                tag_occ(v1) := false;
                            };
                        } else {
                            dat(v1)     := s1_mfb;
                            tag_ln(v1)  := s1_m_base;
                            tag_dty(v1) := false;
                            tag_exc(v1) := s1_m_excl;
                            tag_occ(v1) := true;
                            if s1_m_vway = 1 { set_lru(hw_hash(s1_m_base)) := 0; }
                            else { set_lru(hw_hash(s1_m_base)) := 1; };
                            s1_m_state := m_replay;
                        };
                    } else {
                        if s1_rq_valid & s1_rq_wen {
                            dat(v1) := hw_lins(dat(v1), s1_rq_off, s1_rq_wdata);
                            tag_dty(v1) := true;
                            tag_exc(v1) := true;
                            s1_rq_valid := false;
                            s1_m_state  := m_idle;
                        } else { if s1_rq_valid {
                            if ~port_used {
                                ev_ans     := true;
                                ev_ans_h   := s1_m_base;
                                ev_ans_o   := s1_rq_off;
                                ev_ans_d   := hw_lsel(dat(v1), s1_rq_off);
                                ev_ans_idx := s1_rq_idx;
                                port_used  := true;
                                s1_rq_valid := false;
                                s1_m_state  := m_idle;
                            };
                        } else {
                            s1_m_state := m_idle;
                        } };
                    };
                }

                after posedge {
                    var ae0 : bool := ae_r;
                    # ---- the channel-2 store, SNAPSHOT at the top: the pop
                    # at the bottom moves the head and `q2_full` with it, and
                    # the producer read this expression off the pre-edge
                    # pointers as `ch2_msg_taken`. ----
                    var pushc2 : bool := c1_ch2_msg_valid & ~q2_full;
                    # ---- and the channel-2 DECODE, snapshot for the same
                    # reason.  `must_inval_ch2` is `ae_r`, and the array
                    # action below can claim that slot for an eviction on this
                    # very edge; recomputing `has_grant` after it would drop a
                    # grant the ghost mirror has already taken possession of. ----
                    var hg  : bool := has_grant;
                    var pci : bool := process_ch2_inval;
                    # ---- the PRE-edge control states.  Channel 1's handshake
                    # has to be resolved against the states the directory
                    # sampled, not against the ones an invalidate bounce
                    # produced on this same edge: a bounce manufactures a
                    # fresh `m_req`, and advancing THAT slot would hand it a
                    # grant the other slot asked for. ----
                    var q0 : mstate := s0_m_state;
                    var q1 : mstate := s1_m_state;

                    port_used := false;
                    ev_ans    := false;

                    # ---- THE array action, exactly one.  Invalidation
                    # outranks the stage and both MSHRs: a
                    # granted-but-unreplayed line is clean, so bouncing it
                    # keeps the parked request and simply re-requests. ----
                    if inv_act {
                        ae_r := true;
                        ae_line := q2h_line;
                        ae_dty  := (tag_dty(inv_slot) if inv_hit else false);
                        ae_dat  := (dat(inv_slot) if inv_hit else 0);
                        if inv_hit {
                            tag_occ(inv_slot) := false;
                        };
                        if (s0_m_state = m_fill | s0_m_state = m_replay)
                                & s0_m_base = q2h_line {
                            s0_m_state := m_req;
                        };
                        if (s1_m_state = m_fill | s1_m_state = m_replay)
                                & s1_m_base = q2h_line {
                            s1_m_state := m_req;
                        };
                    } else { if p_valid & ~process_ch2_inval
                            & ~(s0_m_state ~= m_idle & s0_m_base = p_h)
                            & ~(s1_m_state ~= m_idle & s1_m_base = p_h)
                            & ~(s0_m_state = m_fill | s0_m_state = m_replay)
                            & ~(s1_m_state = m_fill | s1_m_state = m_replay)
                            & (s0_m_state = m_idle | s1_m_state = m_idle)
                            & (~p_wen | ~p_present | p_hexcl | ~ae_r) {
                        call serve_stage;
                    } else { if ~process_ch2_inval
                                      & (s0_m_state = m_fill | s0_m_state = m_replay) {
                        call step_0(ae0);
                    } else { if ~process_ch2_inval
                                      & (s1_m_state = m_fill | s1_m_state = m_replay) {
                        call step_1(ae0);
                    } } } };

                    # ---- channel 2: latch the matching Shared/Exclusive
                    # grant and reserve a victim way, away from whatever the
                    # other MSHR is already aiming at in the same set. ----
                    if hg & g_match0 {
                        s0_mfb := q2h_dat;
                        s0_m_excl := grant_excl;
                        var w0 : way := 1;
                        if set_lru(hw_hash(s0_m_base)) = 1 { w0 := 0; };
                        if (s1_m_state = m_fill | s1_m_state = m_replay)
                                & hw_hash(s1_m_base) = hw_hash(s0_m_base) {
                            if s1_m_vway = 0 { w0 := 1; } else { w0 := 0; };
                        };
                        s0_m_vway  := w0;
                        s0_mvline  := tag_ln(hw_cidx(hw_hash(s0_m_base), w0));
                        s0_m_state := m_fill;
                    };
                    if hg & g_match1 {
                        s1_mfb := q2h_dat;
                        s1_m_excl := grant_excl;
                        var w1 : way := 1;
                        if set_lru(hw_hash(s1_m_base)) = 1 { w1 := 0; };
                        if (s0_m_state = m_fill | s0_m_state = m_replay)
                                & hw_hash(s0_m_base) = hw_hash(s1_m_base) {
                            if s0_m_vway = 0 { w1 := 1; } else { w1 := 0; };
                        };
                        s1_m_vway  := w1;
                        s1_mvline  := tag_ln(hw_cidx(hw_hash(s1_m_base), w1));
                        s1_m_state := m_fill;
                    };

                    # ---- channel 1, resolved against the pre-edge states ----
                    if c1_req_taken {
                        if q0 = m_req {
                            s0_m_state := m_wait;
                        } else { if q1 = m_req {
                            s1_m_state := m_wait;
                        } };
                    };

                    # ---- stage intake, after the move ----
                    if lsq_to_cache_req_en1 & ~p_valid {
                        p_valid := true;
                        p_h := lsq_to_cache_req_h1;   p_o := lsq_to_cache_req_o1;
                        p_wen := lsq_to_cache_req_wen1;
                        p_wdata := lsq_to_cache_req_wdata1;
                        p_idx := lsq_to_cache_req_idx1;
                    };

                    # ---- channel 3 retires, off the PRE-edge slot ----
                    if ae0 & c1_ack_taken {
                        ae_r := false;
                    };

                    # ---- channel 2's head leaves and the producer's message
                    # arrives.  LAST, after every read of `q2h_*` above: the
                    # decode the whole edge was resolved against is the
                    # PRE-edge head. ----
                    if hg | pci {
                        q2_head := q2_head + 1;
                    };
                    if pushc2 {
                        q2_typ(qi(q2_tail))  := c1_ch2_msg_typ;
                        q2_line(qi(q2_tail)) := c1_ch2_msg_line;
                        q2_dat(qi(q2_tail))  := c1_ch2_msg_data;
                        q2_tail := q2_tail + 1;
                    };
                }

                # ==========================================================
                # 3.1  Array data and permissions.
                # ==========================================================
                invariant [c_set_p1] occupied(K, W) -> hash(ltag(K, W)) = K
                invariant [c_uniq_p1] occupied(K, W1) & occupied(K, W2)
                    & ltag(K, W1) = ltag(K, W2) -> W1 = W2
                invariant [c_img_p1] occupied(K, W) ->
                    val(K, W, O) = img(ltag(K, W), O)
                invariant [c_clean_p1] occupied(K, W) & ~dirty(K, W) ->
                    ~dirtied(1, ltag(K, W), O)
                invariant [dirty_excl_p1] occupied(K, W) & dirty(K, W) ->
                    exclusive(K, W)
                invariant [hold_inf_a_p1] occupied(K, W) -> holds(1, ltag(K, W))
                invariant [excl_inf_a_p1] occupied(K, W) & exclusive(K, W) ->
                    cachemem.exclusive(1, ltag(K, W))

                # ==========================================================
                # 3.2  The two MSHRs do not alias the array, or each other.
                # ==========================================================
                invariant [no_alias_0_p1]
                    (s0_m_state = m_req | s0_m_state = m_wait | s0_m_state = m_fill)
                    & occupied(K, W) -> ltag(K, W) ~= s0_m_base
                invariant [no_alias_1_p1]
                    (s1_m_state = m_req | s1_m_state = m_wait | s1_m_state = m_fill)
                    & occupied(K, W) -> ltag(K, W) ~= s1_m_base
                invariant [mshr_distinct_p1] s0_m_state ~= m_idle & s1_m_state ~= m_idle
                    -> s0_m_base ~= s1_m_base

                # ---- a filling MSHR owns its victim way, and the two never
                # aim at the same one ----
                invariant [mv_ok_0_p1] s0_m_state = m_fill & tag_occ(v0) ->
                    s0_mvline = ltag(hash(s0_m_base), s0_m_vway)
                invariant [mv_ok_1_p1] s1_m_state = m_fill & tag_occ(v1) ->
                    s1_mvline = ltag(hash(s1_m_base), s1_m_vway)
                invariant [ev_distinct_p1]
                      (s0_m_state = m_fill | s0_m_state = m_replay)
                    & (s1_m_state = m_fill | s1_m_state = m_replay)
                    & hash(s0_m_base) = hash(s1_m_base)
                    -> s0_m_vway ~= s1_m_vway

                # ---- past the fill the line really is where the MSHR left
                # it, which is what the replay writes into ----
                invariant [replay_way_0_p1] s0_m_state = m_replay ->
                    tag_occ(v0) & ltag(hash(s0_m_base), s0_m_vway) = s0_m_base
                invariant [replay_way_1_p1] s1_m_state = m_replay ->
                    tag_occ(v1) & ltag(hash(s1_m_base), s1_m_vway) = s1_m_base

                # ---- a parked store only ever sits behind an Exclusive
                # request: that is what makes the replay's write legal ----
                invariant [rq_store_excl_0_p1] s0_rq_valid & s0_rq_wen -> s0_m_excl
                invariant [rq_store_excl_1_p1] s1_rq_valid & s1_rq_wen -> s1_m_excl

                # ==========================================================
                # 3.3  The fill buffers.
                # ==========================================================
                invariant [fill_clean_0_p1] s0_m_state = m_fill ->
                    ~dirtied(1, s0_m_base, O)
                invariant [fill_clean_1_p1] s1_m_state = m_fill ->
                    ~dirtied(1, s1_m_base, O)
                invariant [mfb_img_0_p1] s0_m_state = m_fill ->
                    lsel(s0_mfb, O) = img(s0_m_base, O)
                invariant [mfb_img_1_p1] s1_m_state = m_fill ->
                    lsel(s1_mfb, O) = img(s1_m_base, O)

                invariant [hold_inf_0_p1]
                    (s0_m_state = m_fill | s0_m_state = m_replay) ->
                    holds(1, s0_m_base)
                invariant [hold_inf_1_p1]
                    (s1_m_state = m_fill | s1_m_state = m_replay) ->
                    holds(1, s1_m_base)
                invariant [excl_inf_0_p1]
                    (s0_m_state = m_fill | s0_m_state = m_replay) & s0_m_excl ->
                    cachemem.exclusive(1, s0_m_base)
                invariant [excl_inf_1_p1]
                    (s1_m_state = m_fill | s1_m_state = m_replay) & s1_m_excl ->
                    cachemem.exclusive(1, s1_m_base)

                # ==========================================================
                # 3.4  The channel-2 queue, and channel 2's NET NAMES.
                #
                # `[gr_push_empty1]` and `[grant_img_*]` are the home's
                # promises about the message on this cache's channel 2.
                # The first is stated -- as it must be -- over the net names
                # `c1_gr_valid` and `c1_ch2_empty`; the second is stated once
                # over the uplink `x_ch2_msg_*` and reaches this cache only
                # by unfolding through `c1_gr_valid`, `c1_gr_line` and
                # `c1_gr_data`.  A definition is admitted into an isolate's
                # query only when the defined symbol occurs in that isolate's
                # OWN code or invariants; an occurrence inside an invariant
                # imported from a sibling does NOT count (the note above the
                # channel declarations at `cachemem` is the same rule).
                # Nothing in this datapath mentions those four -- it reads the
                # raw `c1_ch2_msg_*` wires -- so without these identities
                # every one of the home's promises relates opaque constants
                # and says NOTHING.  Such a query does not fail, it runs
                # forever: measured, `q2_gq_a_p1` alone did not come back
                # inside twenty minutes.
                #
                # Each holds by unfolding in the pre-state AND the post-state,
                # so consecution is syntactic; the content is entirely in
                # making the four definitions visible.
                # ==========================================================
                invariant [ch2_net_grv_p1] c1_gr_valid =
                    (c1_ch2_msg_valid & c1_ch2_msg_typ ~= ch2_inv)
                invariant [ch2_net_grl_p1] c1_gr_line = c1_ch2_msg_line
                invariant [ch2_net_grd_p1] c1_gr_data = c1_ch2_msg_data
                invariant [ch2_net_mt_p1] c1_ch2_empty = q2_empty

                invariant [q2_bound_p1] q2_tail - q2_head <= 2

                # ---- a grant, if the queue holds one, is at the HEAD, and
                # the slot behind the head is always an invalidate: a grant is
                # sent only into an EMPTY queue (`[gr_push_empty1]`), so
                # nothing can ever sit in front of one and `[I, G]` is
                # unreachable.  That is what collapses the per-slot statements
                # into one apiece, and it is the form every consumer already
                # wants -- `has_grant`, the fill path and the home's
                # queued-grant record all read the head and nothing else.
                #
                # `[q2_gq_*]` is the two-way tie between the queue and that
                # record: every head grant IS `gq1_*`, and `gq1_*` has a head
                # grant behind it.  `dsh` went up when the message was sent,
                # so without the second direction a pop would clear the record
                # while the home still believed the line was here.
                #
                # `[q2_img_lo_p1]`/`[q2_img_hi_p1]` are what a fill installs.
                # Nothing can move
                # `img` under a queued grant: this cache does not hold the
                # line yet, so it cannot store into it (`[gq_nothold1]`), and
                # the other cache cannot either, because a queued grant
                # already owns the sharer bit (`[gr_shared1i]`). ----
                invariant [q2_gq_h_p1] ~q2_empty & q2h_typ ~= ch2_inv ->
                    gq1_v & gq1_l = q2h_line
                    & gq1_x = (q2h_typ = ch2_gex)
                invariant [q2_gq_v_p1] gq1_v ->
                    ~q2_empty & q2h_typ ~= ch2_inv
                invariant [q2_2nd_inv_p1] q2_tail - q2_head = 2 ->
                    q2_typ(qi(q2_head + 1)) = ch2_inv

                # ---- and per BEAT, which is the granularity the home's
                # promise arrives at (`[grant_img_lo]`/`[grant_img_hi]`).
                # Kept at that granularity all the way through the queue so
                # the push is a SYNTACTIC match against the promise -- no
                # `p_cover` round trip on an edge that is also moving two
                # pointers.  The bridge to a word-granular `lsel(_, O)`
                # happens exactly once, at the fill, in `[mfb_img_*]`, which
                # is where it was paid for before the queue existed. ----
                invariant [q2_img_lo_p1] ~q2_empty & q2h_typ ~= ch2_inv ->
                    lsel(q2h_dat, concatbv2(0, J)) = img(q2h_line, concatbv2(0, J))
                invariant [q2_img_hi_p1] ~q2_empty & q2h_typ ~= ch2_inv ->
                    lsel(q2h_dat, concatbv2(1, J)) = img(q2h_line, concatbv2(1, J))

                # ---- the concrete channel-3 register mirrors cachemem. ----
                invariant [ae_sync_p1] ack1_g_en = ae_r

            }

        } with this, dir_body, xbar_body, addr_thy, basis, data_impl
        isolate mc_body = {

            # ---- directory command channel: the command comes from the
            # directory, the ready is driven here ----
            wire cmd_en    : bool
            wire cmd_wen   : bool
            wire cmd_addr  : addr
            wire cmd_data  : four_words
            wire cmd_ready : bool

            # ---- directory response channel: all driven here ----
            wire rsp_valid : bool
            wire rsp_addr  : addr
            wire rsp_data  : four_words

            wire mem_rd_en   : bool
            wire mem_rd_addr : addr
            wire mem_wr_en   : bool
            wire mem_wr_addr : addr
            wire mem_wr_data : four_words
            wire mem_rdata   : four_words

            # ==================================================================
            # The controller.  UNCHANGED from the cache-driven version: same
            # beat-granular port, same two-command buffer, same latency
            # counter, same `mc_owns_img`.  Only the driver of the command
            # wires is different, and `mc_owns_img` never named the driver --
            # it needs `wb_img`, and `wb_img` now arrives from `dir_body`.
            #
            # `mmem` is real hardware -- the DRAM behind the port -- but its
            # client is proved against it, so it lives in the specification
            # where that client can see it.
            #
            # The write is unbuffered and is applied from the command wires
            # alone: a command lands in memory on the edge the port carries
            # it, one edge after it was issued.  The buffer below delays only
            # the *response*, and the write is applied at the top of the
            # edge, so a read never overtakes a write to the same beat.
            # ==================================================================
            specification {
                # The memory that the memory controller presents
                function mmem(H : line, O : woffset) : word

                after init {
                    mmem(H, O) := init_img(H, O);
                }

                # ---- ONE conditional whole-array write: four sequential
                # writes each spawn a quantified frame axiom and they
                # chain, which measured as the dominant instantiation cost
                # in `mem_img`'s consecution.  `wsel4` bridges to the
                # `unp0..3` forms by `p_wsel0..3` under `p_cover`. ----
                after posedge {
                    if cmd_en & cmd_wen {
                        mmem(H, O) := (wsel4(cmd_data, boff2(O))
                                       if (H = high(cmd_addr)
                                           & beat_of(O) = beat_of(low(cmd_addr)))
                                       else mmem(H, O));
                        # (the matching `dirtied` CLEAR lives in
                        # `cachemem`'s monitor, ahead of the store arm, so
                        # a same-edge store-set wins)
                    };
                }

                # ==========================================================
                # Wherever neither cache has dirtied the word, the DRAM is
                # the reference image.  Proven HERE, against the
                # controller's own small
                # transition.  What it needs of its client is `wb_img` --
                # anything put on the command wire is accurate to `img` --
                # and that arrives by IMPORT, through `with this`: `cachemem`
                # presents its children's `specification` blocks, so
                # `dir_body.wb_img` is a pre-state assumption here without
                # `dir_body` being named below.  It is load-bearing: with
                # `wb_img` moved into a `private` block this goal stops
                # closing entirely.
                # ==========================================================

                invariant [mc_owns_img] ~dirtied(0, H, O) & ~dirtied(1, H, O) ->
                    mmem(H, O) = img(H, O)

                before posedge {
                    assume [dram_read] mem_rd_en ->
                          unp0(mem_rdata) = mmem(high(mem_rd_addr), concatbv2(beat_of(low(mem_rd_addr)), 0))
                        & unp1(mem_rdata) = mmem(high(mem_rd_addr), concatbv2(beat_of(low(mem_rd_addr)), 1))
                        & unp2(mem_rdata) = mmem(high(mem_rd_addr), concatbv2(beat_of(low(mem_rd_addr)), 2))
                        & unp3(mem_rdata) = mmem(high(mem_rd_addr), concatbv2(beat_of(low(mem_rd_addr)), 3));
                }

                # ---- when the controller raises a response it carries the
                # *current* content of its memory at the address it echoes,
                # not a stale snapshot: the response registers are cleared at
                # the top of every edge and refilled after that edge's write
                # has landed. ----
                invariant [mc_resp] rsp_valid ->
                      unp0(rsp_data) = mmem(high(rsp_addr), concatbv2(beat_of(low(rsp_addr)), 0))
                    & unp1(rsp_data) = mmem(high(rsp_addr), concatbv2(beat_of(low(rsp_addr)), 1))
                    & unp2(rsp_data) = mmem(high(rsp_addr), concatbv2(beat_of(low(rsp_addr)), 2))
                    & unp3(rsp_data) = mmem(high(rsp_addr), concatbv2(beat_of(low(rsp_addr)), 3))

                # ---- the port never accepts a command on the edge one is
                # already travelling: `cmd_ready` implies the wire is idle.
                # The directory needs this to know that a writeback beat it
                # issued has already been applied by the time the port lets
                # it issue the next one -- which is what makes the two beats
                # of a writeback sequential rather than overlapping. ----
                invariant [rdy_idle] cmd_ready -> ~cmd_en

            }

            implementation {

                # ---- the command buffer ----
                var cb0_valid : bool
                var cb0_wen   : bool
                var cb0_addr  : addr
                var cb1_valid : bool
                var cb1_wen   : bool
                var cb1_addr  : addr
                var svc_count : latency
                wire mem_latency : latency
                definition mem_latency = 8

                # ---- the registers driving the response port ----
                var rsp_valid_r : bool
                var rsp_addr_r  : addr
                var rsp_data_r  : four_words

                after init {
                    cb0_valid := false; cb0_wen := false; cb0_addr := 0;
                    cb1_valid := false; cb1_wen := false; cb1_addr := 0;
                    svc_count := 0;
                    rsp_valid_r := false; rsp_addr_r := 0; rsp_data_r := 0;
                }

                definition cmd_ready = ~(cb0_valid & cb1_valid) & ~cmd_en

                definition rsp_valid = rsp_valid_r
                definition rsp_addr  = rsp_addr_r
                definition rsp_data  = rsp_data_r

                definition mem_rd_en   = cb0_valid & ~cb0_wen & ~rsp_valid & svc_count = 0
                definition mem_rd_addr = cb0_addr
                definition mem_wr_en   = cmd_en & cmd_wen
                definition mem_wr_addr = cmd_addr
                definition mem_wr_data = cmd_data

                after posedge {
                    rsp_valid_r := false;

                    if cmd_en {
                        var a : addr := cmd_addr;
                        if ~cb0_valid {
                            cb0_valid := true; cb0_wen := cmd_wen; cb0_addr := a;
                            svc_count := mem_latency;
                        } else {
                            cb1_valid := true; cb1_wen := cmd_wen; cb1_addr := a;
                        };
                    };

                    if cb0_valid & (cb0_wen | ~rsp_valid) {
                        if svc_count = 0 {
                            if ~cb0_wen {
                                var h : line := hw_high(cb0_addr);
                                var b : bit  := hw_beat_of(hw_low(cb0_addr));
                                rsp_valid_r := true;
                                rsp_addr_r  := cb0_addr;
                                rsp_data_r  := (cmd_data
                                    if (cmd_en & cmd_wen
                                        & hw_high(cmd_addr) = h
                                        & hw_beat_of(hw_low(cmd_addr)) = b)
                                    else mem_rdata);
                            };
                            if cb1_valid {
                                cb0_valid := true; cb0_wen := cb1_wen; cb0_addr := cb1_addr;
                                cb1_valid := false;
                                svc_count := mem_latency;
                            } else {
                                cb0_valid := false;
                            };
                        } else {
                            svc_count := svc_count - 1;
                        }
                    };
                }

            }

        } with this, addr_thy, basis, data_impl


        # ==================================================================
        # The directory: German's home node, now with two clients.
        #
        # It owns no data (decision 4) and dirty data always round-trips DRAM
        # (decision 3), so the whole of it is one current-request register
        # set, a two-beat read ladder, and a two-beat writeback sequencer
        # sharing one command port -- writebacks first.
        #
        # Blocking, single slot everywhere (decision 2): one request start to
        # finish, one grant outstanding, one writeback at a time, one
        # invalidate in flight.  There is ONE port set per channel:
        # `xbar_body` arbitrates channels 1 and 3 and routes channel 2, so
        # the sequencer reads `x_src` and never chooses between the clients
        # itself.
        #
        # SHARED AND EXCLUSIVE.  Every request is picked; `d_inv` is what
        # makes room for it.  An Exclusive request displaces every holder, a
        # Shared one only the exclusive holder, and both wait for the
        # REQUESTER's own bit as well -- which can only ever be a stale one,
        # since a cache never requests a line it holds.  That last clause is
        # what makes a grant land on a line the directory has no record of
        # the requester at, and it is what `[gr_notack*]` and `[gr_clean*]`
        # rest on.
        #
        # An invalidate is sent only to a cache with no ack of its own in
        # flight: a bit backed by an ack already in the channel needs no
        # invalidate, it clears itself when that ack retires.  With
        # the send guard, "the directory only ever invalidates a holder" is a
        # convention here rather than a theorem: `[d_back*]`, which would
        # have made it one, is withdrawn (see the note beside `[dsh_ack]`).
        # ==================================================================
        isolate dir_body = {

            # ---- the ports this directory drives.  ONE set per channel:
            # the crossbar arbitrates the contended ones, and channel 2 is a
            # single addressed message whose `typ` names its kind, because a
            # grant and an invalidate are never live on the same edge. ----
            wire req_taken : bool
            wire ack_taken : bool
            # ---- channel 3's retire pulse, with the source and line it
            # retires.  `ack_taken` above is the ENQUEUE -- it frees the
            # producer's holding slot and nothing else; this is the edge the
            # directory is finally done with the acknowledgement, and the
            # per-line half of the ghost is cleared by it.
            #
            # The old `busy` port is gone.  It existed so the crossbar could
            # pin the uplink for the whole length of a writeback, because the
            # payload was read off the bus at `wb_lo` and `wb_hi`.  The queue
            # latches the payload on the edge it takes it, so there is
            # nothing left to pin. ----
            wire ack_done      : bool
            wire ack_done_line : line
            wire ack_enq_slot  : qidx
            wire ack_done_slot : qidx
            wire ch2_msg_valid : bool
            wire ch2_msg_typ   : ch2typ      # ch2_gsh | ch2_gex | ch2_inv
            wire ch2_msg_cpu   : bit
            wire ch2_msg_line  : line
            wire ch2_msg_data  : cache_line  # grant only

            # ---- memory command channel ----
            wire cmd_en    : bool
            wire cmd_wen   : bool
            wire cmd_addr  : addr
            wire cmd_data  : four_words
            wire cmd_ready : bool

            # ---- memory response channel ----
            wire rsp_valid : bool
            wire rsp_addr  : addr
            wire rsp_data  : four_words

            # ==============================================================
            # The contract.
            #
            # `[swmr]` is the coherence property, and it is what each cache's
            # data invariants rely on: with it, a store by one CPU cannot
            # move `img` under a line the other is holding.  The chain is
            # acyclic -- the caches' seam facts are cache-local and assume no
            # protocol, the directory consumes them and returns SWMR, and the
            # ---- the sharer bits and the one exclusive bit, at the
            # isolate's TOP LEVEL rather than behind `implementation`, for the
            # reason `xbar_body`'s arbiter registers are: the caches have to be
            # told about them.  Still REAL registers, so `ivy_to_rtl` sees them
            # and nothing here reads a ghost.
            #
            # What the caches need of a grant is that its line is one they
            # cannot be writing on the edge it is driven.  Stated over
            # `holds*`/`exclusive*` that is a POST-state property of ghost
            # state the home moves off wires it cannot see, and the home
            # cannot prove it -- the `~holds` form of this promise did not
            # come back.  Stated
            # over these bits it is definitional on both sides --
            # `[gr_msg_notdsh*]` is one unfolding of `inv_settled`, and the
            # consumer composes it with `[d_exact*]` in its OWN pre-state,
            # where both are simply assumptions. ----
            var dsh(C : bit, H : line) : bool
            var dex(H : line)  : bool

            # caches consume SWMR only for their data half.
            # ==============================================================
            specification {
                function dir(H : line, O : woffset) : word
                definition dir(H, O) = mc_body.mmem(H, O)

                invariant [dir_img] ~dirtied(0, H, O) & ~dirtied(1, H, O) ->
                    dir(H, O) = img(H, O)

                # Shared holders may coexist.  Only an Exclusive holder
                # excludes every copy in the other cache.
                invariant [swmr] exclusive(C, H) & D ~= C -> ~holds(D, H)

                # Granted data is accurate.  
                invariant [grant_img_lo] x_ch2_msg_valid & x_ch2_msg_typ ~= ch2_inv ->
                    lsel(x_ch2_msg_data, concatbv2(0, J)) = img(x_ch2_msg_line, concatbv2(0, J))
                invariant [grant_img_hi] x_ch2_msg_valid & x_ch2_msg_typ ~= ch2_inv ->
                    lsel(x_ch2_msg_data, concatbv2(1, J)) = img(x_ch2_msg_line, concatbv2(1, J))

                invariant [wb_img] cmd_en & cmd_wen ->
                    wsel4(cmd_data, J) =
                        img(high(cmd_addr), concatbv2(beat_of(low(cmd_addr)), J))

                # ---- the queue mirror, slot for slot.  Emptied first,
                # filled second; the two can never be the same slot (the head
                # is emptied, the tail is filled, and they coincide only when
                # the queue is full, where nothing is taken). ----
                before posedge {
                    if ack_done & ack_done_slot = 0 { g3a_v := false; };
                    if ack_done & ack_done_slot = 1 { g3b_v := false; };
                    if ack_taken & ack_enq_slot = 0 {
                        g3a_v := true;            g3a_c := x_src;
                        g3a_l := (ack0_g_line if x_src = 0 else ack1_g_line);
                        g3a_d := (ack0_g_dty  if x_src = 0 else ack1_g_dty);
                    };
                    if ack_taken & ack_enq_slot = 1 {
                        g3b_v := true;            g3b_c := x_src;
                        g3b_l := (ack0_g_line if x_src = 0 else ack1_g_line);
                        g3b_d := (ack0_g_dty  if x_src = 0 else ack1_g_dty);
                    };
                }

                # Popping acknowledgements from ch3 queue is reflected in the ghost.
                invariant [ack_taken_en] ack_taken -> x_ack_en
                invariant [enq_free0] ack_taken & ack_enq_slot = 0 -> ~g3a_v
                invariant [enq_free1] ack_taken & ack_enq_slot = 1 -> ~g3b_v
                invariant [done_slot0] ack_done & ack_done_slot = 0 ->
                    g3a_v & g3a_l = ack_done_line
                invariant [done_slot1] ack_done & ack_done_slot = 1 ->
                    g3b_v & g3b_l = ack_done_line

                # ---- when the directory lets go of an acknowledgement, the
                # write debt it was carrying is settled.  This is what the
                # caches' `[ca_dirtied_p*]` is preserved by on the edge the
                # mirror slot empties. ----
                invariant [wb_done] ack_done ->
                    ~dirtied(C, ack_done_line, O)

                # TODO: having an invalidate list + better idea of sharers should resolve this.
                # If a grant is sent out, there isn't an invalidate acknowledgement for it running at the same time
                invariant [gr_msg_notack_g] x_ch2_msg_valid & x_ch2_msg_typ ~= ch2_inv ->
                      ~(ack0_g_en & ack0_g_line = x_ch2_msg_line)
                    & ~(ack1_g_en & ack1_g_line = x_ch2_msg_line)
                invariant [gr_msg_notack_q] x_ch2_msg_valid & x_ch2_msg_typ ~= ch2_inv ->
                    ~ack0_q(x_ch2_msg_line) & ~ack1_q(x_ch2_msg_line)
                invariant [gr_msg_clean] x_ch2_msg_valid & x_ch2_msg_typ ~= ch2_inv ->
                    ~dirtied(C, x_ch2_msg_line, O)
                invariant [gr_msg_excl] x_ch2_msg_valid & x_ch2_msg_typ = ch2_gex ->
                    ~holds(C, x_ch2_msg_line)
                invariant [gr_msg_shared] x_ch2_msg_valid & x_ch2_msg_typ ~= ch2_inv ->
                    ~exclusive(C, x_ch2_msg_line)
                # ---- the granted line has no sharer bit for the requester,
                # which is `inv_settled` restated at the port: ONE unfolding,
                # no ghost state, nothing about possession.  Paired with
                # `[d_exact*]` just below, the consumer gets `~holds*` and then
                # `~exclusive*` entirely inside its own pre-state. ----
                invariant [gr_msg_notdsh] x_ch2_msg_valid & x_ch2_msg_typ ~= ch2_inv ->
                    ~dsh(x_ch2_msg_cpu, x_ch2_msg_line)
                invariant [d_exact] holds(C, H) -> dsh(C, H)

                # ---- split per STAGE of channel 3.  `~ackN_any` is a
                # conjunction of the producer's slot and the home's queue, and
                # the two are preserved by different arms; as one goal the
                # query did not come back. ----
                invariant [gr_notack_g0] gq0_v -> ~(ack0_g_en & ack0_g_line = gq0_l)
                invariant [gr_notack_q0] gq0_v -> ~ack0_q(gq0_l)
                invariant [gr_notack_g1] gq1_v -> ~(ack1_g_en & ack1_g_line = gq1_l)
                invariant [gr_notack_q1] gq1_v -> ~ack1_q(gq1_l)
                invariant [gr_clean0] gq0_v -> ~dirtied(C, gq0_l, O)
                invariant [gr_clean1] gq1_v -> ~dirtied(C, gq1_l, O)

                invariant [gr_excl0i] gq0_v & gq0_x -> ~holds(1, gq0_l)
                invariant [gr_excl1i] gq1_v & gq1_x -> ~holds(0, gq1_l)
                invariant [gr_shared0i] gq0_v -> ~exclusive(1, gq0_l)
                invariant [gr_shared1i] gq1_v -> ~exclusive(0, gq1_l)

                invariant [gq_nothold0] gq0_v -> ~holds(0, gq0_l)
                invariant [gq_nothold1] gq1_v -> ~holds(1, gq1_l)

                # ---- a grant is sent only into an EMPTY channel-2 queue.
                # That is what keeps a grant at the head of the consumer's
                # queue -- ahead of any invalidate the next transaction posts
                # for the same line -- and it is what makes ONE queued-grant
                # record per cache exact.  Definitional here: `grant_now`
                # carries `ch2_empty_t` and `ch2_msg_cpu` is `cr_cpu`. ----
                invariant [gr_push_empty0] c0_gr_valid -> c0_ch2_empty
                invariant [gr_push_empty1] c1_gr_valid -> c1_ch2_empty

                invariant [ack_excl] holds(C, H) ->
                    (C ~= 0 | ~ack1_dty(H)) & (C ~= 1 | ~ack0_dty(H))

                # ---- German's at-most-one-exclusive corollary, over the
                # permission ghosts: `~(cacheExclusive(C) & cacheExclusive(D))`
                # for the two clients.  Falls out of `[d_ex*]` + `[dex_one]`. ----
                invariant [g_one_excl] exclusive(C, H) & exclusive(D, H) -> C = D

                invariant [commit_safe] exclusive(C, H) & D ~= C ->
                      ~holds(D, H)
                    & (D ~= 0 | ~ack0_dty(H) & ~(gq0_v & gq0_l = H)
                              & ~(c0_gr_valid & c0_gr_line = H))
                    & (D ~= 1 | ~ack1_dty(H) & ~(gq1_v & gq1_l = H)
                              & ~(c1_gr_valid & c1_gr_line = H))
            }

            implementation {
                # ==========================================================
                # THREE control states, and the ladder is gone.
                #
                # A transaction is "idle" or "serving a Shared request" or
                # "serving an Exclusive request", and the kind IS the state --
                # there is no `cr_excl` register left to disagree with it.
                # Everything the eight-state ladder sequenced by hand is now a
                # guard on the one register set: invalidates go out while
                # `inv_need*` is set, the data arrives either from a dirty
                # acknowledgement or from a read, and the transaction ends on
                # the edge all three conditions of `grant_now` hold at once.
                # ==========================================================
                wire d_idle       : dstate
                wire d_req_shared : dstate
                wire d_req_excl   : dstate
                definition d_idle       = 0
                definition d_req_shared = 1
                definition d_req_excl   = 2

                # ---- ONE memory sequencer, for writebacks AND reads.  The
                # write path is unchanged; the read path is the old
                # `d_rd_lo`/`d_rdw_lo`/`d_rd_hi`/`d_rdw_hi` ladder moved in
                # beside it, so the two uses of the command port serialize on
                # a state register instead of on a hand-written priority.
                # Writebacks still go first: a read only starts with channel 3
                # empty. ----
                wire wb_idle : wbstate
                wire wb_lo   : wbstate
                wire wb_hi   : wbstate
                wire wb_fin  : wbstate
                wire wb_ret  : wbstate
                wire wb_rlo  : wbstate
                wire wb_rwlo : wbstate
                wire wb_rhi  : wbstate
                wire wb_rwhi : wbstate
                definition wb_idle = 0
                definition wb_lo   = 1
                definition wb_hi   = 2
                definition wb_fin  = 3
                definition wb_ret  = 4
                definition wb_rlo  = 5
                definition wb_rwlo = 6
                definition wb_rhi  = 7
                definition wb_rwhi = 8

                # ---- the current request, and who still has to give the
                # line up before it can be served.  `cr_excl` is a WIRE off
                # the state now, not a register. ----
                var dstate_r  : dstate
                var cr_cpu    : bit
                var cr_line   : line
                var inv_need0 : bool
                var inv_need1 : bool

                # ---- the line to hand over, and whether it is in hand.  It
                # arrives one of two ways: lifted off a dirty invalidate
                # acknowledgement as that acknowledgement retires, or read out
                # of memory once nothing is outstanding.  The first is the
                # exclusive-holder case and it costs no read at all; the
                # second covers a clean surrender and a line nobody held. ----
                var dfb    : cache_line
                var d_have : bool

                wire cr_excl : bool
                definition cr_excl = (dstate_r = d_req_excl)

                # ---- ONE held invalidate slot, addressed the way the grant
                # is addressed by `cr_cpu`.  One slot is one invalidate in
                # flight, so invalidates to the two caches serialize. ----
                var inv_v : bool
                var inv_l : line
                var inv_c : bit

                # ---- the writeback sequencer.  `wb_lo_done`/`wb_hi_done`
                # are GHOST: the beat has LANDED in memory, not merely been
                # issued.
                #
                # There is no `wb_cpu`/`wb_line`/`wb_dat` register any more.
                # The channel-3 entry is TAKEN at `wb_idle` and POPPED at the
                # retire, so the head IS the payload for the whole length of
                # the writeback and a second copy of it would only have to be
                # proved equal to the first. ----
                var wb_st      : wbstate
                var wb_lo_done : bool
                var wb_hi_done : bool

                # ==========================================================
                # Channels 1 and 3 as QUEUES: a fixed-size array plus a head
                # and a tail pointer, with the SOURCE stored beside every
                # entry.  The producer stores at the tail, the sequencers
                # read at the head, and a full queue is what the producer
                # stalls on -- `req_taken`/`ack_taken` simply go low and the
                # cache holds what it had.
                #
                # This is what retires `[xb_wb_own]`.  Channel 3 used to be
                # the one channel read across more than one edge, so the
                # crossbar had to pin the uplink for the length of a
                # writeback and the directory had to prove it stayed pinned.
                # An entry is a copy, so there is nothing to pin.
                #
                # `q*_occ` is the "this array slot holds a live entry"
                # predicate the invariants below are written over, wired out
                # by hand across the two slots rather than through a loop.
                # ==========================================================
                var q1_src(I : qidx)  : bit
                var q1_line(I : qidx) : line
                var q1_excl(I : qidx) : bool
                var q1_head : qptr
                var q1_tail : qptr

                var q3_src(I : qidx)  : bit
                var q3_line(I : qidx) : line
                var q3_dty(I : qidx)  : bool
                var q3_dat(I : qidx)  : cache_line
                var q3_head : qptr
                var q3_tail : qptr

                wire q1_empty : bool
                wire q1_full  : bool
                wire q3_empty : bool
                wire q3_full  : bool
                definition q1_empty = (q1_head = q1_tail)
                definition q1_full  = (q1_tail - q1_head = 2)
                definition q3_empty = (q3_head = q3_tail)
                definition q3_full  = (q3_tail - q3_head = 2)

                wire q1_occ(I : qidx) : bool
                wire q3_occ(I : qidx) : bool
                definition q1_occ(I) =
                      (q1_head ~= q1_tail & I = qi(q1_head))
                    | (q1_tail - q1_head = 2 & I ~= qi(q1_head))
                definition q3_occ(I) =
                      (q3_head ~= q3_tail & I = qi(q3_head))
                    | (q3_tail - q3_head = 2 & I ~= qi(q3_head))

                # ---- the channel-3 head, named the way the sequencer used
                # to name its own registers ----
                wire wb_cpu  : bit
                wire wb_line : line
                wire wb_dty  : bool
                wire wb_dat  : cache_line
                definition wb_cpu  = q3_src(qi(q3_head))
                definition wb_line = q3_line(qi(q3_head))
                definition wb_dty  = q3_dty(qi(q3_head))
                definition wb_dat  = q3_dat(qi(q3_head))

                # ==========================================================
                # The sharer bits, and ONE exclusive bit beside them: the
                # owner is not stored, it is `dex(H) & dshC(H)` -- exactly
                # one sharer bit can be set under `dex` (`[dex_one]`), so
                # naming the owner with a `bit` register and comparing it
                # against `wb_cpu` bought nothing and cost the solver a
                # great deal (with an owner index, `[wb_done]` stopped
                # coming back).  It is also what makes the retire arm's
                # clear unconditional: a cache with a sharer bit and an ack
                # in flight IS the exclusive holder if there is one.
                #
                # The bits are EXACT in the direction the protocol needs: a
                # line with no bit is in no cache, and a line with no
                # exclusive bit is writable by nobody.
                # ==========================================================
                # (the three arrays live at this isolate's TOP LEVEL, above
                # `specification`, so the caches can be told about them)

                # ---- the command port's registers ----
                var ev_cmd      : bool
                var ev_cmd_wen  : bool
                var ev_cmd_addr : addr
                var ev_cmd_data : four_words

                after init {
                    dsh(C, H) := false;
                    dex(H) := false;
                    dstate_r := 0; cr_cpu := 0; cr_line := 0;
                    inv_need0 := false; inv_need1 := false;
                    dfb := 0; d_have := false;
                    inv_v := false; inv_l := 0; inv_c := 0;
                    wb_st := 0;
                    wb_lo_done := false; wb_hi_done := false;
                    q1_src(I) := 0; q1_line(I) := 0; q1_excl(I) := false;
                    q1_head := 0; q1_tail := 0;
                    q3_src(I) := 0; q3_line(I) := 0; q3_dty(I) := false;
                    q3_dat(I) := 0;
                    q3_head := 0; q3_tail := 0;
                    ev_cmd := false; ev_cmd_wen := false;
                    ev_cmd_addr := 0; ev_cmd_data := 0;
                }

                # ==========================================================
                # The end of a transaction, as ONE wire.
                #
                # `inv_settled` is the old `d_inv` completion test: every
                # invalidate this transaction owed has been SENT, and every
                # bit it was waiting on has cleared.  An Exclusive request
                # needs both caches out; a Shared one needs only the exclusive
                # bit gone and the requester's own stale bit with it.
                #
                # `grant_now` adds the two things the queues make necessary:
                # the requester's channel 2 must be EMPTY -- which is what
                # keeps a grant at the head of that queue, and therefore ahead
                # of any invalidate the next transaction posts -- and channel 3
                # must be quiet, so `d_have` really is the finished read and
                # not a writeback still in flight.
                #
                # There is no grant register and no grant acknowledgement.
                # The message is combinational on this wire, so
                # "`c0_ch2_msg_valid` and a grant" IMPLIES `c0_ch2_empty` by
                # definition, with nothing imported from the cache -- which is
                # exactly what the caches' `[q2_gq_*]` needs and what a
                # registered grant could not give them.
                # ==========================================================
                wire inv_settled : bool
                wire ch2_empty_t : bool
                wire grant_now   : bool
                # ---- three FLAT conjuncts rather than a nest of
                # conditionals, and that is load-bearing rather than cosmetic.
                # Nested, the requester's own bit is reachable only through
                # `if cr_cpu = 0`, so every promise about a grant to CPU 1 has
                # to refute that arm while its CPU-0 twin lands in it directly.
                # That is the whole of an asymmetry that cost a great deal to
                # find: the CPU-1 half of four different promise families
                # diverged -- `[gr_msg_notdsh1]`, which mentions no ghost state
                # at all, among them -- while every CPU-0 twin passed in
                # milliseconds.  Flat, `cr_cpu = N` discharges `cr_cpu ~= N` by
                # equality alone and the two sides are symmetric.
                #
                # Equivalent by cases: an Exclusive request needs both bits
                # clear, a Shared one needs the exclusive bit clear and the
                # requester's own -- necessarily stale -- bit with it. ----
                definition inv_settled = ~inv_need0 & ~inv_need1
                    & (~dsh(0, cr_line) | (dstate_r ~= d_req_excl & cr_cpu ~= 0))
                    & (~dsh(1, cr_line) | (dstate_r ~= d_req_excl & cr_cpu ~= 1))
                    & (dstate_r = d_req_excl | ~dex(cr_line))
                definition ch2_empty_t = (c0_ch2_empty if cr_cpu = 0
                                          else c1_ch2_empty)
                # `grant_now` waits for ALL of channel 3, not just the
                # home's own queue: `~ackN_g_en` covers the producers' holding
                # slots too.  That is what queues.md asks for -- "a grant is
                # not given until all previous invalidate acknowledgements
                # have been processed" -- and `q3_empty & wb_st = wb_idle`
                # alone did not deliver it, because a surrender posted after
                # the pick sits in the producer's slot with the home's queue
                # still empty.
                #
                # It is also what makes the grant's promises CHEAP.  With
                # channel 3 quiet by construction, `[gr_msg_notack_g*]` is one
                # unfolding of this wire; phrased over the sharer bits instead
                # it has to re-derive `[dsh_ack*]` through the whole
                # transition, and that query does not come back.
                #
                # Reads the ghost mirror `ackN_g_en` rather than `cN_ack_en`
                # for the reason `pick_ok` does: `[ack_sync_en_p*]` makes them
                # the same bit and only the ghost is visible here.
                definition grant_now = dstate_r ~= d_idle & inv_settled
                    & d_have & ch2_empty_t & q3_empty & wb_st = wb_idle
                    & ~ack0_g_en & ~ack1_g_en

                # ---- channel 2: one message, one port set.  A grant and an
                # invalidate are still never live together -- `inv_v` implies
                # a sharer bit this transaction is waiting on, and
                # `inv_settled` is exactly the absence of one -- so the mux
                # never has to choose.  `ch2_msg_data` needs no mux: nothing
                # reads it under `ch2_inv`. ----
                definition ch2_msg_valid = grant_now | inv_v
                definition ch2_msg_typ   = (ch2_inv if inv_v
                                            else (ch2_gex if dstate_r = d_req_excl
                                                  else ch2_gsh))
                definition ch2_msg_cpu   = (inv_c if inv_v else cr_cpu)
                definition ch2_msg_line  = (inv_l if inv_v else cr_line)
                definition ch2_msg_data  = dfb

                # ---- EVERY request is picked; `d_inv` is what makes room
                # for it.  WHICH client is asking is the crossbar's business:
                # the uplink presents one request and `x_src` names its
                # source, so no priority is left here. ----
                # `pick_ok` now also demands that channel 3 be EMPTY and
                # that neither cache still be holding an acknowledgement --
                # nothing of channel 3 anywhere.  With nothing in flight
                # every sharer bit is a real holder at the moment a request
                # is picked -- nothing is in flight that could have made one
                # stale -- which is what "the directory only ever
                # invalidates a holder" rests on now that a surrender no
                # longer blocks its producer until the home is done with it.
                #
                # It reads `ackN_g_en`, the ghost mirror, rather than
                # `cN_ack_en`: `[ack_sync_en_p*]` makes them the same bit and
                # only the ghost is visible in this query. ----
                wire pick_ok : bool
                definition pick_ok = (dstate_r = d_idle) & (wb_st = wb_idle)
                    & q3_empty & ~ack0_g_en & ~ack1_g_en & ~q1_empty
                definition req_taken = x_req_en & ~q1_full

                # ---- and one `taken` back on channel 3: it means ENQUEUED,
                # so it needs no CPU test either -- the crossbar's demux
                # lands it on whoever holds the uplink, which is whoever the
                # entry was just copied from. ----
                definition ack_taken = x_ack_en & ~q3_full

                # ---- the retire, off the sequencer's last state.  The head
                # is still the entry at that point: it is popped at the
                # bottom of the same arm. ----
                definition ack_done      = (wb_st = wb_ret)
                definition ack_done_line = wb_line
                definition ack_enq_slot  = qi(q3_tail)
                definition ack_done_slot = qi(q3_head)

                definition cmd_en   = ev_cmd
                definition cmd_wen  = ev_cmd_wen
                definition cmd_addr = ev_cmd_addr
                definition cmd_data = ev_cmd_data

                after posedge {
                    # ---- the two enqueue decisions, SNAPSHOT at the top.
                    # `q3_full` is read again by the producer's side of the
                    # handshake off the pre-edge pointers, and the retire arm
                    # below moves `q3_head`: taking the snapshot here is what
                    # keeps the two sides of `ack_taken` the same bit. ----
                    var push1 : bool := x_req_en & ~q1_full;
                    var push3 : bool := x_ack_en & ~q3_full;

                    # ---- GHOST.  The command presented on the last edge is
                    # applied to memory on THIS one. ----
                    if ev_cmd & ev_cmd_wen & hw_high(ev_cmd_addr) = wb_line {
                        if hw_beat_of(hw_low(ev_cmd_addr)) = 0 {
                            wb_lo_done := true;
                        } else {
                            wb_hi_done := true;
                        };
                    };

                    ev_cmd := false;

                    # ---- the transaction ends.  The grant is the message
                    # `grant_now` is already driving, so there is nothing to
                    # send here and nothing to wait for: the metadata moves
                    # and the home is idle.  `grant_now` implies
                    # `ch2_empty_t`, so the enqueue cannot fail. ----
                    if grant_now {
                        dsh(C, H) := (true if C = cr_cpu & H = cr_line
                                      else dsh(C, H));
                        if dstate_r = d_req_excl {
                            dex(H) := (true if H = cr_line else dex(H));
                        };
                        dstate_r := d_idle;
                        d_have   := false;
                    };

                    # ---- the read's two beats land.  `wb_st` sequences them
                    # the way it sequences a writeback's; the second one is
                    # what sets `d_have`. ----
                    if rsp_valid & hw_high(rsp_addr) = cr_line {
                        if wb_st = wb_rwlo & hw_beat_of(hw_low(rsp_addr)) = 0 {
                            dfb    := hw_lpack(hw_lhi(dfb), rsp_data);
                            wb_st  := wb_rhi;
                        } else { if wb_st = wb_rwhi & hw_beat_of(hw_low(rsp_addr)) = 1 {
                            dfb    := hw_lpack(rsp_data, hw_llo(dfb));
                            wb_st  := wb_idle;
                            d_have := true;
                        } };
                    };

                    # ---- the one command port.  Writeback beats first, and
                    # AHEAD of the channel-3 pickup below so a beat is never
                    # issued on the edge its ack was posted. ----
                    if cmd_ready {
                        if wb_st = wb_lo {
                            ev_cmd      := true;
                            ev_cmd_wen  := true;
                            ev_cmd_addr := hw_concatbv3(wb_line, hw_concatbv2(0, 0));
                            ev_cmd_data := hw_llo(wb_dat);
                            wb_st       := wb_hi;
                        } else { if wb_st = wb_hi {
                            ev_cmd      := true;
                            ev_cmd_wen  := true;
                            ev_cmd_addr := hw_concatbv3(wb_line, hw_concatbv2(1, 0));
                            ev_cmd_data := hw_lhi(wb_dat);
                            wb_st       := wb_fin;
                        } else { if wb_st = wb_rlo {
                            ev_cmd      := true;
                            ev_cmd_wen  := false;
                            ev_cmd_addr := hw_concatbv3(cr_line, hw_concatbv2(0, 0));
                            ev_cmd_data := 0;
                            wb_st       := wb_rwlo;
                        } else { if wb_st = wb_rhi {
                            ev_cmd      := true;
                            ev_cmd_wen  := false;
                            ev_cmd_addr := hw_concatbv3(cr_line, hw_concatbv2(1, 0));
                            ev_cmd_data := 0;
                            wb_st       := wb_rwhi;
                        } } } };
                    };

                    # ---- channel 3 is always on -- an ack answers an
                    # invalidate, a self-downgrade or a fill-eviction, and
                    # the arm cannot tell them apart.  The head is TAKEN here
                    # and POPPED at the retire: the entry is the writeback's
                    # payload, so it has to outlive the pickup.  Nothing is
                    # copied out of it, which is the whole point -- and the
                    # source rides in the entry, so there is still one branch
                    # rather than two. ----
                    if wb_st = wb_idle {
                        if ~q3_empty {
                            wb_lo_done := false;
                            wb_hi_done := false;
                            if wb_dty { wb_st := wb_lo; }
                            else { wb_st := wb_ret; };
                        } else { if dstate_r ~= d_idle & ~d_have & inv_settled {
                            # ---- nothing left on channel 3, and the line is
                            # still not in hand: read it.  Second in this
                            # chain, so a writeback always goes first -- a
                            # read that overtook one would return the stale
                            # beat.
                            #
                            # `inv_settled` is REQUIRED here, and it is the
                            # difference between queues.md's two cases: a
                            # memory request is started when there is no
                            # exclusive holder, and when there is one the data
                            # comes from its acknowledgement instead.  Without
                            # it the read starts while an exclusive holder is
                            # still being invalidated, returns the stale beat,
                            # and sets `d_have` on it -- `[rd_noex]` is simply
                            # false, and `[dfb_img_*]` with it.  (The stale value
                            # was later overwritten by the dirty ack, so the
                            # grant was never wrong; the window was.) ----
                            wb_st := wb_rlo;
                        } };
                    } else { if wb_st = wb_fin & wb_lo_done & wb_hi_done {
                        wb_st := wb_ret;
                    } else { if wb_st = wb_ret {
                        # ---- an acknowledgement for a line whose sharer bit
                        # is already clear is IGNORED: it was overtaken by a
                        # self-eviction of the same line and the bit went with
                        # that one.  Writebacks are the same message, so they
                        # retire the same way.
                        #
                        # A DIRTY acknowledgement for the line under request
                        # is also the data: the exclusive holder sends its copy
                        # when it is invalidated, which is why that case costs
                        # no read at all. ----
                        if wb_dty & dstate_r ~= d_idle & wb_line = cr_line {
                            dfb    := wb_dat;
                            d_have := true;
                        };
                        dex(H) := (false if H = wb_line else dex(H));
                        dsh(C, H) := (false if C = wb_cpu & H = wb_line
                                      else dsh(C, H));
                        if wb_cpu = 0 {
                            # ---- the bit this transaction was waiting on
                            # just cleared, so whatever it still owed for that
                            # line is moot: an invalidate not yet sent is
                            # dropped, and one already sent is answered.  This
                            # is the "overtaken by a self-eviction" case, and
                            # it is what keeps `[inv_need0_ok]` and
                            # `[inv_live]` inductive across a retire. ----
                            if dstate_r ~= d_idle & cr_line = wb_line {
                                inv_need0 := false;
                            };
                            if inv_v & inv_c = 0 & inv_l = wb_line { inv_v := false; };
                        } else {
                            if dstate_r ~= d_idle & cr_line = wb_line {
                                inv_need1 := false;
                            };
                            if inv_v & inv_c = 1 & inv_l = wb_line { inv_v := false; };
                        };
                        # ---- the pop is LAST in this arm: `wb_line`,
                        # `wb_cpu` and `wb_dat` above are reads of the head. ----
                        q3_head    := q3_head + 1;
                        wb_st      := wb_idle;
                        wb_lo_done := false;
                        wb_hi_done := false;
                    } } };

                    # ---- make room for the request.  An invalidate is sent
                    # only to a cache with no ack of its own in flight: a bit
                    # backed by an ack already in the channel needs no
                    # invalidate, it clears itself when that ack retires.
                    #
                    # The wait is on the BITS, in `inv_settled`, never on the
                    # invalidate slot, and it always includes the requester's
                    # own bit -- which can only be a stale one, since a cache
                    # never requests a line it holds.  That is what makes the
                    # grant land on a line with no record of the requester at
                    # all, and it is what `[gq_nothold*]` rests on.
                    #
                    # ONE slot, addressed by `inv_c`, so the two posts
                    # SEQUENCE: the second arm reads the `inv_v` the first
                    # just wrote, CPU 0 goes first and CPU 1 waits for the
                    # slot.  The slot now clears at the ENQUEUE -- the message
                    # is in the addressed cache's queue and will be popped in
                    # order -- so the two posts cost two edges rather than two
                    # round trips.  The guard keeps reading `ackN_g_en`: it
                    # means "this cache already has an acknowledgement posted,
                    # so its sharer bit will clear itself when that one
                    # retires", and the ghost mirror is the visible form of
                    # that register. ----
                    if dstate_r ~= d_idle {
                        if inv_v & x_ch2_msg_taken & x_ch2_msg_typ = ch2_inv {
                            inv_v := false;
                        };
                        if inv_need0 & ~inv_v & ~ack0_g_en {
                            inv_v := true; inv_l := cr_line; inv_c := 0;
                            inv_need0 := false;
                        };
                        if inv_need1 & ~inv_v & ~ack1_g_en {
                            inv_v := true; inv_l := cr_line; inv_c := 1;
                            inv_need1 := false;
                        };
                    };

                    # ---- pick a new request, from the HEAD of channel 1's
                    # queue.  Last, so the slot a grant freed this edge is not
                    # reused on the same edge.  An Exclusive request must
                    # displace every holder; a Shared one only the exclusive
                    # holder.  ONE branch: the entry carries its own source,
                    # so there is still nothing to choose here.
                    #
                    # `pick_ok` spelled out, and resolved against the state
                    # THIS handler has already produced -- a retire on this
                    # edge frees channel 3 for a pick on it.  The wire is the
                    # pre-edge form of the same predicate and the producer's
                    # `req_taken` no longer needs it. ----
                    if dstate_r = d_idle & wb_st = wb_idle & q3_empty
                            & ~ack0_g_en & ~ack1_g_en & ~q1_empty {
                        var pk : qidx := qi(q1_head);
                        var pl : line := q1_line(pk);
                        var px : bool := q1_excl(pk);
                        cr_cpu   := q1_src(pk);
                        cr_line  := pl;
                        inv_need0 := dsh(0, pl) & (px | dex(pl));
                        inv_need1 := dsh(1, pl) & (px | dex(pl));
                        dstate_r := (d_req_excl if px else d_req_shared);
                        d_have   := false;
                        q1_head  := q1_head + 1;
                    };

                    # ---- the producers' stores, at the tails.  LAST of all:
                    # a request enqueued on this edge is not picked on it, and
                    # an acknowledgement enqueued on this edge is not taken by
                    # the sequencer on it.  Both guards are the snapshots
                    # taken at the top -- the same expressions the producers
                    # read as `req_taken`/`ack_taken`. ----
                    if push1 {
                        q1_src(qi(q1_tail))  := x_src;
                        q1_line(qi(q1_tail)) := x_req_line;
                        q1_excl(qi(q1_tail)) := x_req_excl;
                        q1_tail := q1_tail + 1;
                    };
                    if push3 {
                        q3_src(qi(q3_tail))  := x_src;
                        q3_line(qi(q3_tail)) := x_ack_line;
                        q3_dty(qi(q3_tail))  := x_ack_dty;
                        q3_dat(qi(q3_tail))  := x_ack_dat;
                        q3_tail := q3_tail + 1;
                    };
                }

                # ==========================================================
                # 6.1a  The two queues.
                #
                # `[q*_bound]` is what makes `full` a legal test at all:
                # `qptr` is two bits, so `tail - head` is only a count while
                # it is known not to have run past the depth.
                #
                # `[q3_ack*]` is the bridge to the per-line half of the
                # channel-3 ghost, and `[q3_uniq]`/`[q3_ag_ne*]` are what
                # make that half EXACT -- without them the retire could clear
                # a bit a second live entry still needs.  Both come from one
                # fact imported from the caches: a surrender's line has
                # nothing of that cache's already in flight
                # (`[ca_gv_nodouble_p*]`), because a second surrender needs
                # the line back and an outstanding acknowledgement forbids
                # holding it.
                # ==========================================================
                invariant [q1_bound] q1_tail - q1_head <= 2
                invariant [q3_bound] q3_tail - q3_head <= 2

                # ---- a push never lands on the HEAD slot.  Depth two: not
                # empty means `tail - head` is 1 or 2, and at 2 the queue is
                # full and no push happens at all -- so on any edge that
                # pushes, the tail slot and the head slot are distinct and the
                # entry under the sequencer is stable.
                #
                # Stated once because every `wb_*` invariant below reads that
                # entry THROUGH the array, and without this each of them has to
                # re-derive it from `[q3_bound]` and two-bit pointer arithmetic
                # inside its own query.  `[wb_lo_clean]` did not come back. ----
                invariant [q3_push_safe] ~q3_empty & ~q3_full ->
                    qi(q3_tail) ~= qi(q3_head)

                # ---- the mirror is faithful, slot for slot.  Wired out by
                # hand over the two slots; there is no loop to write. ----
                invariant [q3g_a_v] g3a_v = q3_occ(0)
                invariant [q3g_b_v] g3b_v = q3_occ(1)
                invariant [q3g_a] q3_occ(0) ->
                    g3a_c = q3_src(0) & g3a_l = q3_line(0) & g3a_d = q3_dty(0)
                invariant [q3g_b] q3_occ(1) ->
                    g3b_c = q3_src(1) & g3b_l = q3_line(1) & g3b_d = q3_dty(1)

                # ---- one acknowledgement per (cache, line) in the whole
                # channel, which is what makes the mirror EXACT: without it a
                # retire could empty a slot a second live entry still needs.
                # Both halves come from one fact imported from the caches --
                # a surrender's line is a line the cache HELD, and an
                # outstanding acknowledgement forbids holding it, so a second
                # surrender of the same line cannot be posted until the first
                # is done.  In THIS query the surrender's line is an opaque
                # constant and the argument is one ground instance of
                # `[ca_ack_idle_p*]`; over in `cacheN_body` the same statement
                # would put an array read under `cN_give_line`'s four-way
                # conditional in every arm of the cache's transition, and that
                # query does not come back. ----
                invariant [q3g_uniq] g3a_v & g3b_v ->
                    ~(g3a_c = g3b_c & g3a_l = g3b_l)
                invariant [ag_notp0] ack0_g_en -> ~ack0_q(ack0_g_line)
                invariant [ag_notp1] ack1_g_en -> ~ack1_q(ack1_g_line)

                # ---- a dirty entry's payload is the image, carried forward
                # from the edge it was latched.  Nothing can move `img` under
                # it: a store needs the exclusive bit, and a dirty ack in
                # flight is exactly the absence of one. ----
                invariant [q3_img0] q3_occ(0) & q3_dty(0) ->
                    lsel(q3_dat(0), O) = img(q3_line(0), O)
                invariant [q3_img1] q3_occ(1) & q3_dty(1) ->
                    lsel(q3_dat(1), O) = img(q3_line(1), O)

                # ---- the WRITEBACK half of the sequencer runs off the
                # head, so it runs only while there IS a head; the READ half
                # runs only while there is a transaction and no head at all. ----
                invariant [wb_busy_q3] wb_st = wb_lo | wb_st = wb_hi
                    | wb_st = wb_fin | wb_st = wb_ret -> ~q3_empty
                invariant [wb_busy_dty] wb_st = wb_lo | wb_st = wb_hi
                    | wb_st = wb_fin -> wb_dty
                # ---- the READ half of the sequencer runs only while there
                # is a transaction and the line is not in hand.  It does NOT
                # claim channel 3 is empty: the read STARTS with the queue
                # empty, but an acknowledgement can be enqueued on that very
                # edge and simply waits -- the sequencer is one state machine,
                # so no writeback beat can issue until the read gives it back.
                # Claiming emptiness here was false for exactly that race. ----
                invariant [wb_rd_state] wb_st = wb_rlo | wb_st = wb_rwlo
                    | wb_st = wb_rhi | wb_st = wb_rwhi ->
                    dstate_r ~= d_idle & ~d_have & inv_settled
                invariant [wb_ret_clean] wb_st = wb_ret ->
                    ~dirtied(C, wb_line, O)

                invariant [wb_cmd] ev_cmd & ev_cmd_wen ->
                    high(ev_cmd_addr) = wb_line
                    & ((wb_st = wb_hi & beat_of(low(ev_cmd_addr)) = 0)
                       | (wb_st = wb_fin & beat_of(low(ev_cmd_addr)) = 1))
                # ---- and the window each ghost flag is live in.  The
                # `hi` half was already pinned; the `lo` half was not, so
                # `[wb_lo_clean]` had to hold across every state instead of
                # across the three the flag can actually be set in. ----
                invariant [wb_lo_late] wb_lo_done
                    -> wb_st = wb_hi | wb_st = wb_fin | wb_st = wb_ret
                invariant [wb_hi_late] wb_hi_done
                    -> wb_st = wb_fin | wb_st = wb_ret
                invariant [rd_cmd] ev_cmd & ~ev_cmd_wen ->
                    (wb_st = wb_rwlo | wb_st = wb_rwhi)
                    & high(ev_cmd_addr) = cr_line

                invariant [wb_lo_clean] wb_lo_done & beat_of(O) = 0
                    -> ~dirtied(C, wb_line, O)
                invariant [wb_hi_clean] wb_hi_done & beat_of(O) = 1
                    -> ~dirtied(C, wb_line, O)
                invariant [wb_ghost_idle] wb_st = wb_idle
                    -> ~wb_lo_done & ~wb_hi_done

                # ==========================================================
                # 6.2  The bits are exact, and the exclusive bit is what
                # SWMR now rests on.
                #
                # `[dex_sh*]` is the whole coherence argument in one line: an
                # exclusive bit excludes the other cache's sharer bit, and
                # `[d_exact*]` turns that into "the other cache does not hold
                # the line".  Shared bits are free to coexist.
                # ==========================================================
                invariant [dsh_ack] (ack0_any(H) if C = 0 else ack1_any(H)) -> dsh(C, H)

                # ==========================================================
                # WITHDRAWN: `[d_back0]`/`[d_back1]`, the converse -- no STALE
                # bits.  They read
                #
                #     dshC(H) -> holdsC(H) | ackC_any(H) | (gqC_v & gqC_l = H)
                #
                # and the third disjunct is the queued-grant window the
                # channel-2 queue introduced: the bit goes up on the edge the
                # grant is SENT and possession only follows when the consumer
                # pops it.
                #
                # The statement is believed true and it does not verify.  Its
                # consecution is a five-way case analysis under a `line`
                # quantifier -- the grant enqueue, the surrender, the two-stage
                # channel-3 hand-off, the retire, and the pop -- and it did not
                # come back in fifteen minutes in any form tried: as written,
                # with `ackC_any` unfolded by hand, with the third disjunct
                # moved into the premise, and weakened to a bare `gqC_v`.
                # Solver strategy made no difference either (`incremental`,
                # `macro_finder`, seed).
                #
                # Removing them costs NOTHING else in this file: every other
                # invariant in every isolate still passes, which is what says
                # they were carrying no other goal.  What is lost is the audit
                # trail -- they were German's "homeSharerList(C) -> C holds it
                # or a message for it is in flight", and the two comments that
                # cited them (the invalidate-miss reply in each cache, and
                # `pick_ok` in this isolate) now argue the point directly
                # instead of by reference.
                #
                # SAFETY IS UNAFFECTED.  Nothing rests on them: `[swmr*]`,
                # `[g_one_excl]`, `[commit_safe*]`, `[dir_img]` and the whole
                # image chain are proved without them.  A stale bit costs
                # liveness -- an invalidate sent to a cache that already gave
                # the line up is answered by the miss path -- and the miss path
                # is proved sound on its own terms.
                # ==========================================================

                # ---- and the converse: no STALE bits.  A set bit is backed
                # by a copy the cache still holds, or by an ack already in the
                # channel.  With the send guard (`~ackN_g_en`) this is what
                # makes "the directory only invalidates a holder" a theorem:
                # `[inv_live*]` says a live invalidate names a line whose bit
                # is set, and this says such a line is really there. ----
                # The third disjunct is the queued-grant window: the bit
                # goes up on the edge the grant is SENT and possession only
                # follows when the consumer pops it.


                # ---- and what a queued grant means for the bits: the sharer
                # bit is already up, the exclusive bit too if the grant is an
                # Exclusive one, and one record per cache is exact because a
                # grant is only sent into an EMPTY channel-2 queue. ----
                invariant [gq_dsh0] gq0_v -> dsh(0, gq0_l)
                invariant [gq_dsh1] gq1_v -> dsh(1, gq1_l)
                invariant [gq_dex0] gq0_v & gq0_x -> dex(gq0_l)
                invariant [gq_dex1] gq1_v & gq1_x -> dex(gq1_l)
                invariant [gq_notidle0] gq0_v & ~gq0_x -> ~dex(gq0_l)
                invariant [gq_notidle1] gq1_v & ~gq1_x -> ~dex(gq1_l)
                # ==========================================================
                # 6.5  German's backbone, transcribed per line.
                #
                # These are the classic invariants of `german.ivy` /
                # `german_evict.ivy` restated over this file's holder
                # relations, and they are the audit trail for the
                # correspondence rather than load-bearing lemmas -- each is a
                # consequence of the exactness block above.  They are stated
                # HERE and not in the specification only because `dsh*`/`dex`/
                # `dstate_r`/`inv_v` are private to this section.
                #
                #   german.ivy                            this file
                #   ------------------------------------  ---------------------
                #   cacheShared(C) -> homeSharerList(C)   [g_cacheS_dir*]
                #     & ~homeExclusiveGranted
                #   cacheExclusive(C) -> homeSharerList   [d_ex]
                #     & homeExclusiveGranted & C = owner
                #   homeExclusiveGranted                  [dex_owned], [dex_one]
                #     & homeSharerList(C) -> C = owner
                #   invalidateAck(C) -> ~cacheS/E(C)      [ca_ack_idle_p*]
                #     & homeSharerList(C)                 [dsh_ack]
                #   invalidate(C) -> homeCurrentReq       [g_inv_of_cr]
                #     & homeSharerList(C)                 [inv_live]
                #   ~(invalidate(C) & grant*(C))          [g_no_gr_inv]
                #   homeSharerList(C) -> C holds it or a  WITHDRAWN -- see the
                #     message for it is in flight         note at [dsh_ack]
                #   at most one exclusive                 [g_one_excl] (exported)
                #   grant answers the picked request      [grant_kind]
                # ==========================================================

                # ---- an exclusive bit has an owner: some sharer bit backs
                # it, and `[dex_one]` says only one can. ----
                invariant [dex_owned] dex(H) -> dsh(0, H) | dsh(1, H)

                # ---- a SHARED holder implies nobody holds the line
                # exclusively.  The other direction of `[d_ex*]`, and the
                # concrete form of `cacheShared -> ~homeExclusiveGranted`. ----
                invariant [g_cacheS_dir] holds(C, H) & ~exclusive(C, H) -> ~dex(H)

                # ---- an invalidate belongs to the request in progress: it is
                # posted in `d_inv` for `cr_line` and retired before the
                # transaction can leave `d_inv`, so the stale-invalidate case
                # the eviction extension had to absorb abstractly cannot arise
                # here.  With `[d_gr_state]` it is also what channel 2's
                # shared port rests on: `d_gwt` and `d_inv` are distinct
                # constants, so a grant and an invalidate are never live
                # together and `ch2_msg_typ` never has to choose.
                # `[g_no_gr_inv]` is stronger than the two per-CPU forms it
                # replaces, which that same pair already implied. ----
                invariant [g_inv_of_cr] inv_v ->
                    dstate_r ~= d_idle & inv_l = cr_line
                invariant [g_no_gr_inv] grant_now -> ~inv_v

                # ---- a pending invalidate still names a set bit: that is
                # what carries "the bit was set when the request was picked"
                # forward to the edge the invalidate is actually sent. ----
                # The `(cr_excl | dex ...)` clause is the CONFLICT the
                # invalidate was sent for, carried alongside it: without it a
                # Shared request could reach `d_rd_lo` -- whose completion test
                # only names the exclusive bit -- while the other cache's
                # invalidate slot was still live.
                invariant [inv_need0_ok] inv_need0 ->
                    dstate_r ~= d_idle & dsh(0, cr_line)
                    & (cr_excl | dex(cr_line))
                invariant [inv_need1_ok] inv_need1 ->
                    dstate_r ~= d_idle & dsh(1, cr_line)
                    & (cr_excl | dex(cr_line))
                invariant [inv_live] inv_v ->
                    dsh(inv_c, inv_l) & (cr_excl | dex(inv_l))

                invariant [d_ex] exclusive(C, H) -> dex(H) & dsh(C, H)
                invariant [dex_one] dex(H) -> ~(dsh(0, H) & dsh(1, H))

                # ---- a dirty ack comes from the cache that had write
                # permission, and its exclusive bit is still set: the home
                # has not consumed the ack yet. ----
                invariant [dirty_ack_ex0] ack0_dty(H) -> dex(H)
                invariant [dirty_ack_ex1] ack1_dty(H) -> dex(H)

                # ==========================================================
                # 6.3  The line in hand.
                #
                # The eight-state ladder proved `[rd_perm]` once, at the edge
                # the read started, and carried it to the grant.  With three
                # states there is no such edge: `inv_settled` is re-evaluated
                # every cycle and it IS the guard on the grant, so the
                # permission argument has moved onto `d_have` instead --
                # "once the line is in hand, nobody can write it".
                #
                # `[dfb_noex]` is the whole of it.  The data arrives either
                # from the exclusive holder's own acknowledgement, whose
                # retire clears `dex`, or from a read that only starts once
                # `inv_settled` has cleared it.  With no exclusive bit,
                # `[d_ex*]` says neither cache can store, and `[dfb_img_*]`
                # stands still.
                # ==========================================================
                invariant [dfb_noex] d_have -> ~dex(cr_line)
                # ---- per BEAT, not per word.  Everything that consumes this
                # consumes it beat-granular: `dfb` IS `ch2_msg_data`, and the
                # promise the caches read off it -- `[grant_img_lo]` /
                # `[grant_img_hi]` -- is already stated at `concatbv2(B, J)`
                # offsets, with the bridge to a word-granular `lsel(_, O)` paid
                # once inside each cache at the fill (`[mfb_img_*]`).
                #
                # Stated at an arbitrary `O` this goal has to run `p_cover` and
                # `p_bit2` over the read ladder's two-beat assembly, and it is
                # BORDERLINE: with Python's hash randomisation changing the
                # order the assertions reach z3, the same file verified in
                # fourteen seconds on one run and had not come back after four
                # minutes on the next.  Beat-granular it is a syntactic match
                # against `[dfb_rd_lo]` and `[q3_img*]` and the variance is
                # gone. ----
                invariant [dfb_img_lo] d_have ->
                    lsel(dfb, concatbv2(0, J)) = img(cr_line, concatbv2(0, J))
                invariant [dfb_img_hi] d_have ->
                    lsel(dfb, concatbv2(1, J)) = img(cr_line, concatbv2(1, J))
                invariant [dfb_clean] d_have ->
                    ~dirtied(C, cr_line, O)
                invariant [dfb_idle] dstate_r = d_idle -> ~d_have

                # ---- the read ladder's half-filled buffer.  `dfb` is not
                # `img` until both beats are in, so the low half is claimed
                # on its own while the high beat is outstanding. ----
                invariant [dfb_rd_lo] wb_st = wb_rhi | wb_st = wb_rwhi ->
                    wsel4(llo(dfb), J) = img(cr_line, concatbv2(0, J))
                invariant [rd_noex] dstate_r ~= d_idle & ~d_have
                    & (wb_st = wb_rlo | wb_st = wb_rwlo | wb_st = wb_rhi
                       | wb_st = wb_rwhi) ->
                      ~dex(cr_line)
                    & ~dirtied(C, cr_line, O)
            }

        } with this, mc_body, cache0_body, cache1_body, xbar_body, addr_thy, basis, data_impl

        # ==================================================================
        # The crossbar.  Two clients, one directory: channels 1 and 3 are the
        # contended direction, so this block ARBITRATES them and presents one
        # uplink; channel 2 is directory-driven, so it is ROUTED and never
        # arbitrated.  Channel 3 IS the invalidate acknowledgement channel,
        # so acknowledging an invalidate is arbitrated for exactly the reason
        # a request is and needs no mechanism of its own.
        #
        # Declared LAST, after `dir_body`, so on any edge the directory
        # samples the PRE-edge arbiter state -- the state the combinational
        # bus value it read was built from -- and the arbiter settles
        # afterwards against post-edge cache state.  This is the file's
        # existing discipline, not a new convention (see the comment above
        # the channel-3 pickup); declaring the arbiter first would invert it
        # and break `[xb_wb_own]`.
        # ==================================================================
        isolate xbar_body = {

            # ---- the ports this crossbar drives.  Uplink to the directory
            # first: ONE set, because the directory has one set now. ----
            wire src       : bit
            wire req_en    : bool
            wire req_line  : line
            wire req_excl  : bool
            wire ack_en    : bool
            wire ack_line  : line
            wire ack_dty   : bool
            wire ack_dat   : cache_line

            # ---- channel 2's handshake, muxed back by destination.  One
            # wire, unused if the message is an invalidate. ----
            wire ch2_msg_taken : bool

            # ---- the uplink's `taken` returns, demuxed by `own` ----
            wire req_taken0 : bool
            wire ack_taken0 : bool
            wire req_taken1 : bool
            wire ack_taken1 : bool

            # ---- and channel 2 out to the two caches: one message, no
            # separate grant and invalidate.  The type is either a grant --
            # Shared or Exclusive -- or a request to invalidate, and `data`
            # is unused if it is an invalidate. ----
            wire ch2_msg_valid0 : bool
            wire ch2_msg_typ0   : ch2typ
            wire ch2_msg_line0  : line
            wire ch2_msg_data0  : cache_line
            wire ch2_msg_valid1 : bool
            wire ch2_msg_typ1   : ch2typ
            wire ch2_msg_line1  : line
            wire ch2_msg_data1  : cache_line

            # ---- the arbiter's own state, and it is at the isolate's TOP
            # LEVEL rather than behind `implementation`.  That is forced, not
            # a style choice: a definition inside an `implementation` block is
            # private to its isolate, and the directory's query has to unfold
            # `x_ack_en`, `x_src` and `x_ack_dat` through this mux to reach
            # `cN_ack_*` at all -- behind `implementation` those three would
            # be opaque constants, `[grant_img_lo]` would have nothing to
            # unfold to and `[xb_wb_own]` would have no transition to be
            # preserved by.  Public is what a crossbar has to be.
            #
            # These are still REAL registers, not specification state, so
            # `ivy_to_rtl` sees them and the directory's datapath reads no
            # ghost. ----
            var own_v : bool     # the uplink is held
            var own   : bit      # by whom
            var last  : bit      # who used it last

            after init {
                own_v := false; own := 0; last := 0;
            }

            # ---- `want` decides who gets the bus, and NOTHING decides who
            # keeps it: the bus is released on every edge it was held.
            #
            # The hold is gone with the queues.  It existed because channel 3
            # was read across more than one edge -- the directory latched
            # `wb_cpu`/`wb_line` at the pickup but fetched `x_ack_dat`
            # combinationally at `wb_lo` and `wb_hi` cycles later, so a
            # per-cycle arbiter could swap the source out from under a
            # writeback in flight.  An enqueue is a copy and takes one edge,
            # so both uplink transactions are now single-edge and the arbiter
            # owes the directory nothing across edges.
            #
            # Both channels can complete on the same grant: they are separate
            # queues, so a cache with a request AND an acknowledgement pending
            # gets both taken on the edge it owns the bus.
            #
            # Cost is one dead cycle of turnaround between transactions, the
            # same as before.  Fusing them costs more logic than it is worth
            # in a file whose header already lists liveness as a non-goal. ----
            wire want0 : bool
            wire want1 : bool
            definition want0 = c0_req_en | c0_ack_en
            definition want1 = c1_req_en | c1_ack_en

            # ---- the uplink mux, selected by `own`.  `src` publishes the
            # selector itself. ----
            definition src      = own
            definition req_en   = own_v & (c0_req_en if own = 0
                                           else c1_req_en)
            definition req_line = (c0_req_line if own = 0
                                   else c1_req_line)
            definition req_excl = (c0_req_excl if own = 0
                                   else c1_req_excl)
            definition ack_en   = own_v & (c0_ack_en if own = 0
                                           else c1_ack_en)
            definition ack_line = (c0_ack_line if own = 0
                                   else c1_ack_line)
            definition ack_dty  = (c0_ack_dty if own = 0
                                   else c1_ack_dty)
            definition ack_dat  = (c0_ack_dat if own = 0
                                   else c1_ack_dat)

            # ---- the uplink's two `taken` pulses, demuxed back ----
            definition req_taken0 = x_req_taken & own_v & own = 0
            definition req_taken1 = x_req_taken & own_v & own = 1
            definition ack_taken0 = x_ack_taken & own_v & own = 0
            definition ack_taken1 = x_ack_taken & own_v & own = 1

            # ---- channel 2, demuxed by `x_ch2_msg_cpu`: `valid` gated by
            # destination, the rest fanout, the one `taken` muxed back by the
            # same selector -- NOT by `own`, because the directory drives this
            # channel and there is one slot, so a `taken` belongs to the
            # destination rather than to whoever holds the bus.  Two
            # independent fabrics, an arbitrated uplink and a routed channel
            # 2.  Nothing here reads `typ`: the fabric routes the message, the
            # cache's port decodes it. ----
            definition ch2_msg_valid0 = x_ch2_msg_valid & x_ch2_msg_cpu = 0
            definition ch2_msg_typ0   = x_ch2_msg_typ
            definition ch2_msg_line0  = x_ch2_msg_line
            definition ch2_msg_data0  = x_ch2_msg_data
            definition ch2_msg_valid1 = x_ch2_msg_valid & x_ch2_msg_cpu = 1
            definition ch2_msg_typ1   = x_ch2_msg_typ
            definition ch2_msg_line1  = x_ch2_msg_line
            definition ch2_msg_data1  = x_ch2_msg_data
            definition ch2_msg_taken  = (c0_ch2_msg_taken
                                         if x_ch2_msg_cpu = 0
                                         else c1_ch2_msg_taken)

            # ---- the policy.  One cache wants the bus and it gets it; both
            # want it and the one that is not `last` gets it; the owner
            # releases on the next edge either way, `last` handing over.
            # `last` is written at release rather than at grant: `own` cannot
            # change while held, so the two are the same bit and release is
            # the cheaper place. ----
            after posedge {
                if own_v {
                    last  := own;
                    own_v := false;
                } else {
                    if want0 & want1 {
                        own_v := true;
                        own   := (1 if last = 0 else 0);
                    } else { if want0 {
                        own_v := true; own := 0;
                    } else { if want1 {
                        own_v := true; own := 1;
                    } } };
                };
            }
        } with this, dir_body, cache0_body, cache1_body, basis

        # ---- each net aliased to the port that drives it, and to nothing
        # else: the far side reads the net itself. ----
        definition c0_req_en    = cache0_body.req_en
        definition c0_req_line  = cache0_body.req_line
        definition c0_req_excl  = cache0_body.req_excl
        definition c0_req_taken = xbar_body.req_taken0
        definition c0_ack_en   = cache0_body.ack_en
        definition c0_ack_line = cache0_body.ack_line
        definition c0_ack_dty  = cache0_body.ack_dty
        definition c0_ack_dat  = cache0_body.ack_dat
        definition c0_ack_taken = xbar_body.ack_taken0
        definition c0_ch2_msg_valid = xbar_body.ch2_msg_valid0
        definition c0_ch2_msg_typ   = xbar_body.ch2_msg_typ0
        definition c0_ch2_msg_line  = xbar_body.ch2_msg_line0
        definition c0_ch2_msg_data  = xbar_body.ch2_msg_data0
        definition c0_ch2_msg_taken = cache0_body.ch2_msg_taken
        definition c0_ch2_empty   = cache0_body.ch2_empty
        definition c0_inv_taken = cache0_body.inv_taken
        definition c0_st_en     = cache0_body.st_en
        definition c0_st_h      = cache0_body.st_h
        definition c0_st_o      = cache0_body.st_o
        definition c0_st_d      = cache0_body.st_d
        definition c0_give_en   = cache0_body.give_en
        definition c0_give_line = cache0_body.give_line
        definition c0_give_dty  = cache0_body.give_dty
        definition c0_give_dat  = cache0_body.give_dat

        definition c1_req_en    = cache1_body.req_en
        definition c1_req_line  = cache1_body.req_line
        definition c1_req_excl  = cache1_body.req_excl
        definition c1_req_taken = xbar_body.req_taken1
        definition c1_ack_en   = cache1_body.ack_en
        definition c1_ack_line = cache1_body.ack_line
        definition c1_ack_dty  = cache1_body.ack_dty
        definition c1_ack_dat  = cache1_body.ack_dat
        definition c1_ack_taken = xbar_body.ack_taken1
        definition c1_ch2_msg_valid = xbar_body.ch2_msg_valid1
        definition c1_ch2_msg_typ   = xbar_body.ch2_msg_typ1
        definition c1_ch2_msg_line  = xbar_body.ch2_msg_line1
        definition c1_ch2_msg_data  = xbar_body.ch2_msg_data1
        definition c1_ch2_msg_taken = cache1_body.ch2_msg_taken
        definition c1_ch2_empty   = cache1_body.ch2_empty
        definition c1_inv_taken = cache1_body.inv_taken
        definition c1_st_en     = cache1_body.st_en
        definition c1_st_h      = cache1_body.st_h
        definition c1_st_o      = cache1_body.st_o
        definition c1_st_d      = cache1_body.st_d
        definition c1_give_en   = cache1_body.give_en
        definition c1_give_line = cache1_body.give_line
        definition c1_give_dty  = cache1_body.give_dty
        definition c1_give_dat  = cache1_body.give_dat

        # ---- the kind is decoded at the cache's port: six views of the one
        # message, defined here rather than driven as nets.  The two valids
        # come out SYNTACTICALLY disjoint -- `typ = ch2_inv` against
        # `typ ~= ch2_inv` -- inside the cache's own query, with no directory
        # invariant imported.  That is what makes the `~cN_inv_valid`
        # conjuncts in `ch2_msg_taken` and on the fill path redundant; they
        # stay.  Grant payload is read only under `cN_gr_valid`, so the extra
        # `~inv_v` the decode carries weakens nothing. ----
        definition c0_gr_valid  = c0_ch2_msg_valid & (c0_ch2_msg_typ ~= ch2_inv)
        definition c0_gr_excl   = (c0_ch2_msg_typ = ch2_gex)
        definition c0_gr_line   = c0_ch2_msg_line
        definition c0_gr_data   = c0_ch2_msg_data
        definition c0_inv_valid = c0_ch2_msg_valid & (c0_ch2_msg_typ = ch2_inv)
        definition c0_inv_line  = c0_ch2_msg_line
        definition c1_gr_valid  = c1_ch2_msg_valid & (c1_ch2_msg_typ ~= ch2_inv)
        definition c1_gr_excl   = (c1_ch2_msg_typ = ch2_gex)
        definition c1_gr_line   = c1_ch2_msg_line
        definition c1_gr_data   = c1_ch2_msg_data
        definition c1_inv_valid = c1_ch2_msg_valid & (c1_ch2_msg_typ = ch2_inv)
        definition c1_inv_line  = c1_ch2_msg_line

        # ---- the arbitrated bus: the crossbar drives the uplink and channel
        # 2 out, the directory drives the uplink's `taken` returns and
        # channel 2 in, and the crossbar muxes channel 2's one handshake back
        # by destination. ----
        definition x_src           = xbar_body.src
        definition x_req_en        = xbar_body.req_en
        definition x_req_line      = xbar_body.req_line
        definition x_req_excl      = xbar_body.req_excl
        definition x_req_taken     = dir_body.req_taken
        definition x_ack_en        = xbar_body.ack_en
        definition x_ack_line      = xbar_body.ack_line
        definition x_ack_dty       = xbar_body.ack_dty
        definition x_ack_dat       = xbar_body.ack_dat
        definition x_ack_taken     = dir_body.ack_taken
        definition x_ch2_msg_valid = dir_body.ch2_msg_valid
        definition x_ch2_msg_typ   = dir_body.ch2_msg_typ
        definition x_ch2_msg_cpu   = dir_body.ch2_msg_cpu
        definition x_ch2_msg_line  = dir_body.ch2_msg_line
        definition x_ch2_msg_data  = dir_body.ch2_msg_data
        definition x_ch2_msg_taken = xbar_body.ch2_msg_taken

        # ---- and channel 2's three kinds ----
        definition ch2_gsh = 0
        definition ch2_gex = 1
        definition ch2_inv = 2

        # ---- the two LSQ-side channels ----
        definition cache0_body.lsq_to_cache_req_en0    = lsq_to_cache_req_en0
        definition cache0_body.lsq_to_cache_req_h0     = lsq_to_cache_req_h0
        definition cache0_body.lsq_to_cache_req_o0     = lsq_to_cache_req_o0
        definition cache0_body.lsq_to_cache_req_wen0   = lsq_to_cache_req_wen0
        definition cache0_body.lsq_to_cache_req_wdata0 = lsq_to_cache_req_wdata0
        definition cache0_body.lsq_to_cache_req_idx0   = lsq_to_cache_req_idx0
        definition cache_to_lsq_creq_ready0 = cache0_body.cache_to_lsq_creq_ready0
        definition cache_to_lsq_resp_valid0 = cache0_body.cache_to_lsq_resp_valid0
        definition cache_to_lsq_resp_h0     = cache0_body.cache_to_lsq_resp_h0
        definition cache_to_lsq_resp_o0     = cache0_body.cache_to_lsq_resp_o0
        definition cache_to_lsq_resp_data0  = cache0_body.cache_to_lsq_resp_data0
        definition cache_to_lsq_resp_idx0   = cache0_body.cache_to_lsq_resp_idx0
        definition cache1_body.lsq_to_cache_req_en1    = lsq_to_cache_req_en1
        definition cache1_body.lsq_to_cache_req_h1     = lsq_to_cache_req_h1
        definition cache1_body.lsq_to_cache_req_o1     = lsq_to_cache_req_o1
        definition cache1_body.lsq_to_cache_req_wen1   = lsq_to_cache_req_wen1
        definition cache1_body.lsq_to_cache_req_wdata1 = lsq_to_cache_req_wdata1
        definition cache1_body.lsq_to_cache_req_idx1   = lsq_to_cache_req_idx1
        definition cache_to_lsq_creq_ready1 = cache1_body.cache_to_lsq_creq_ready1
        definition cache_to_lsq_resp_valid1 = cache1_body.cache_to_lsq_resp_valid1
        definition cache_to_lsq_resp_h1     = cache1_body.cache_to_lsq_resp_h1
        definition cache_to_lsq_resp_o1     = cache1_body.cache_to_lsq_resp_o1
        definition cache_to_lsq_resp_data1  = cache1_body.cache_to_lsq_resp_data1
        definition cache_to_lsq_resp_idx1   = cache1_body.cache_to_lsq_resp_idx1

        # ---- the directory's command port drives the memory controller's ----
        definition mc_body.cmd_en    = dir_body.cmd_en
        definition mc_body.cmd_wen   = dir_body.cmd_wen
        definition mc_body.cmd_addr  = dir_body.cmd_addr
        definition mc_body.cmd_data  = dir_body.cmd_data

        # ---- the memory controller's response port drives the directory's ----
        definition dir_body.cmd_ready = mc_body.cmd_ready
        definition dir_body.rsp_valid = mc_body.rsp_valid
        definition dir_body.rsp_addr  = mc_body.rsp_addr
        definition dir_body.rsp_data  = mc_body.rsp_data

        # ---- and the memory-side port on out ----
        definition mem_rd_en   = mc_body.mem_rd_en
        definition mem_rd_addr = mc_body.mem_rd_addr
        definition mem_wr_en   = mc_body.mem_wr_en
        definition mem_wr_addr = mc_body.mem_wr_addr
        definition mem_wr_data = mc_body.mem_wr_data
        definition mc_body.mem_rdata = mem_rdata
    } with this, addr_thy, basis, data_impl
