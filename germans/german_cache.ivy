#lang ivy1.8

# ============================================================================
# PLAN PHASE 2: the directory, in isolation.
#
# The beat-granular cache is gone from this file (preserved verbatim in
# `cache_beats.ivy`); the memory controller's client is now `dir_body`, the
# German home node, and the only thing on the other side of the coherence
# channels is `mock_body` -- a one-line stand-in for the cache that requests
# lines, stores into what it holds, and writes back what it dirtied.
#
#            mock_body                (phase 3: the real cache)
#          ch1 / ch2 / ch3
#            dir_body                 (grants, dirty writebacks; no
#          four_words beats            invalidates, no sharer array yet)
#            mc_body                  (UNCHANGED)
#          mem_* top-level wires
#
# What is proved here, and why each piece exists:
#
#   [dir_img]    `~cache_owns(H,O) -> dir(H,O) = img(H,O)` -- the phase's
#                headline.  `dir` is the image the directory + controller
#                present; the directory holds no data array (design decision
#                4) and dirty data always round-trips memory (decision 3),
#                so `dir` IS `mmem` and the fact is `mc_owns_img` restated at
#                the seam the client consumes it across.
#   [grant_img]  the payload of a grant is the image at the granted line.
#                This is the client-facing half of the data guarantee and
#                the only dir-facing data fact the cache will consume.
#   [rd_clean]   by the time the directory reads DRAM for a request, nobody
#                owns the line -- so `mc_owns_img` turns the read into `img`.
#   [wb_img]     what the directory puts on the controller's command wires is
#                accurate to `img`; `mc_owns_img` is proved from it.
#   [wb_done]    an ack is only retired once its data has LANDED in DRAM.
#                This is what lets the client's ownership bookkeeping close.
#
# Deliberately NOT here (phase 5): invalidates, the 8x8 sharer array, SWMR.
# The directory tracks one client, so there is nothing to invalidate; the
# entry array is protocol state for that flow and would carry no invariant
# yet.  `cache_line` IS introduced here rather than in phase 3, so the
# directory is built once in its final shape.
# ============================================================================

include numbers
include order

type key
type word
type line
type bit
type bv2
type mshr_id

type store_idx
type load_idx

type four_words

# ---- a whole cache line: the unit the directory and the client trade.
# Two `four_words` beats wide, but the channels never see the seam. ----
type cache_line

function pack4(W3 : word, W2 : word, W1 : word, W0 : word) : four_words
function unp0(M : four_words) : word
function unp1(M : four_words) : word
function unp2(M : four_words) : word
function unp3(M : four_words) : word
function wsel4(M : four_words, J : bv2) : word
function wins4(M : four_words, J : bv2, D : word) : four_words

type addr
type woffset
type way

type cache_slot
# ---- the line <-> beat bridge.  `lsel`/`lins` are the word-granular view a
# cache needs; `lpack`/`lhi`/`llo` are the beat-granular view the memory
# controller needs, and the select-of-pack properties in `data_impl` are the
# only place the two meet. ----
function lsel(L : cache_line, O : woffset) : word
function lins(L : cache_line, O : woffset, D : word) : cache_line
function lpack(HI : four_words, LO : four_words) : cache_line
function lhi(L : cache_line) : four_words
function llo(L : cache_line) : four_words


# ---- the memory controller's service counter.  `nat` has no bit
# width, so it cannot appear in a hardware description. ----
type latency

# ---- control-state encodings.  Ivy enumerated types have no bit width
# either; these are narrow bit vectors whose named values are declared as
# 0-ary wires inside the isolate that uses them. ----
type mstate
type dstate
type wbstate
type mkstate

# Copies of the above functions that can be synthesized to RTL. Kept separate
# so that use does not pull in the adddress theory
wire hw_pack4(W3 : word, W2 : word, W1 : word, W0 : word) : four_words
wire hw_unp0(M : four_words) : word
wire hw_unp1(M : four_words) : word
wire hw_unp2(M : four_words) : word
wire hw_unp3(M : four_words) : word
wire hw_wsel4(M : four_words, J : bv2) : word
wire hw_wins4(M : four_words, J : bv2, D : word) : four_words
wire hw_lsel(L : cache_line, O : woffset) : word
wire hw_lins(L : cache_line, O : woffset, D : word) : cache_line
wire hw_lpack(HI : four_words, LO : four_words) : cache_line
wire hw_lhi(L : cache_line) : four_words
wire hw_llo(L : cache_line) : four_words
wire hw_concatbv3(H : line, O : woffset) : addr
wire hw_high(A : addr) : line
wire hw_low(A : addr) : woffset
wire hw_concatbv2(B : bit, J : bv2) : woffset
wire hw_beat_of(O : woffset) : bit
wire hw_boff2(O : woffset) : bv2
wire hw_hash(H : line) : key
wire hw_cidx(K : key, W : way) : cache_slot

# ---- the narrow index types.  These are interpreted where every
# isolate can see them: they are three and four bit wide, so a
# quantifier over one costs the solver nothing, and both `data_impl`
# and `addr_thy` below need the widths to line up their concatenations.
# ----
isolate basis = {
    interpret key -> bv[3]
    interpret bit -> bv[1]
    interpret bv2 -> bv[2]
    interpret mshr_id -> bv[1]
    interpret store_idx -> bv[3]
    interpret load_idx -> bv[3]
    interpret cache_slot -> bv[4]
    interpret latency -> bv[4]
    interpret mstate -> bv[3]
    interpret dstate -> bv[3]
    interpret wbstate -> bv[3]
    interpret mkstate -> bv[2]
}

function concatbv3(H : line, O : woffset) : addr
function high(A : addr) : line
function low(A : addr) : woffset
function concatbv2(B : bit, J : bv2) : woffset
function beat_of(O : woffset) : bit
function boff2(O : woffset) : bv2
function hash(H : line) : key
function cidx(K : key, W : way) : cache_slot

function init_mem(A : addr) : word   # the power-on memory image

# ---- the same image, indexed by the (line, offset) PAIR.  The cache's
# array and the controller's memory are both powered on from THIS one,
# not from `init_mem`, and that is load-bearing rather than cosmetic:
# `mem_img` below equates the two at an arbitrary address `A`, and if
# one side started at `init_mem(A)` and the other at
# `init_mem(concatbv3(high(A), low(A)))` the base case would need
# `p_recon` -- which `addr_thy` deliberately does not export, because
# outside it that equation is a matching loop.  Starting both from
# `init_img(high(A), low(A))` makes the base case syntactic.
# `p_initimg` ties it back to `init_mem` for the LSQ, which is where
# the trace's own image comes in.
function init_img(H : line, O : woffset) : word

isolate addr_thy = {
    interpret woffset -> bv[3]
    interpret way -> bv[1]
    definition concatbv2(B, J) = B :: J

    property [p_way2]  forall W : way. W = 0 | W = 1
    property [p_way_ne] (0 : way) ~= (1 : way)
    property [p_bit2]  forall B : bit. B = 0 | B = 1
    property [p_boff_beat]  forall B : bit, J : bv2. beat_of(concatbv2(B, J)) = B
    property [p_boff_word]  forall B : bit, J : bv2. boff2(concatbv2(B, J)) = J
    property [p_cover] forall O : woffset, B : bit. beat_of(O) = B ->
        (O = concatbv2(B, 0) | O = concatbv2(B, 1) | O = concatbv2(B, 2) | O = concatbv2(B, 3))
    property [p_full_inj] forall H1 : line, O1 : woffset, H2 : line, O2 : woffset. (concatbv3(H1, O1) = concatbv3(H2, O2)) -> (H1 = H2 & O1 = O2)
    property [p_highfull] forall H : line, O : woffset. high(concatbv3(H, O)) = H
    property [p_lowfull]  forall H : line, O : woffset. low(concatbv3(H, O)) = O

    property [p_hw_high] forall A : addr. hw_high(A) = high(A)
    property [p_hw_low]  forall A : addr. hw_low(A) = low(A)
    property [p_hw_cat3] forall H : line, O : woffset. hw_concatbv3(H, O) = concatbv3(H, O)
    property [p_hw_cat2] forall B : bit, J : bv2. hw_concatbv2(B, J) = concatbv2(B, J)
    property [p_hw_beat] forall O : woffset. hw_beat_of(O) = beat_of(O)
    property [p_hw_boff] forall O : woffset. hw_boff2(O) = boff2(O)
    property [p_hw_hash] forall H : line. hw_hash(H) = hash(H)
    property [p_hw_cidx] forall K : key, W : way. hw_cidx(K, W) = cidx(K, W)

    # ---- the cache slot index.  Unlike `concatbv3`, this one is NOT
    # opaque: `key` and `way` are already interpreted everywhere, the
    # packed slot is four bits wide, and the cache's data invariants
    # quantify over the pair.  Kept abstract, the injectivity they need
    # is an axiom with a two-term trigger that fires on every pair of
    # slots in the query, and `mem_img` -- which carries two such
    # quantifiers and the memory index besides -- stopped coming back.
    # Four bits of concat the solver can just evaluate. ----
    definition cidx(K, W) = K :: W

    # ---- the pair-indexed power-on image agrees with the flat one.
    # This is the ONLY place the two ever have to be compared, and it is
    # exported because the LSQ needs it: the trace's initial state is
    # `init_mem`, the cache's array is `init_img`, and `cimg_ctag` bridges
    # them at time zero. ----
    property [p_initimg] forall H : line, O : woffset.
        init_img(H, O) = init_mem(concatbv3(H, O))

    implementation {
        interpret addr -> bv[64]
        interpret line -> bv[61]
        # (`cache_slot` is interpreted in `basis`, beside `key` and `way`)
        definition high(A) = bfe[3][63](A)
        definition low(A) = bfe[0][2](A)
        definition concatbv3(H, O) = H :: O

        property [p_recon] forall A : addr. concatbv3(high(A), low(A)) = A

        definition hash(H) = bfe[0][2](H)
        definition init_img(H, O) = init_mem(concatbv3(H, O))
        definition beat_of(O) = bfe[2][2](O)
        definition boff2(O)   = bfe[0][1](O)
        definition hw_high(A) = bfe[3][63](A)
        definition hw_low(A)  = bfe[0][2](A)
        definition hw_concatbv3(H, O) = H :: O
        definition hw_concatbv2(B, J) = B :: J
        definition hw_beat_of(O) = bfe[2][2](O)
        definition hw_boff2(O)   = bfe[0][1](O)
        definition hw_hash(H)    = bfe[0][2](H)
        definition hw_cidx(K, W) = K :: W
    }
} with this, basis

# ---- `word`, `four_words` and `cache_line` are ABSTRACT outside this
# isolate.  The bit-level encoding lives in the implementation, so every
# other isolate sees a beat as an uninterpreted quadruple constrained only by
# `p_unp0..3` and a line as an uninterpreted eight-tuple constrained by
# `p_lsel_*`/`p_lins_*`.  This is the same trick `addr_thy` plays above, and
# for the same reason: with four_words = bv[256] visible, every query that
# mentions a fill or a writeback drags a 256-bit concat through the solver,
# and z3 bit-blasts it -- at 512 bits per line it is worse.  Nothing outside
# needs the encoding.
#
# It sits AFTER `addr_thy` and depends on it, which the beat-only version did
# not: the line <-> beat bridge is stated at `concatbv2(B, J)` offsets, so
# this isolate needs `woffset` interpreted and `p_boff_beat`/`p_boff_word` to
# take a packed offset apart.  That is also the plan's "keep the bridge
# axioms confined to the data isolate": they are PROVED here, against the
# encodings, and only their statements escape. ----
isolate data_impl = {
    property [p_unp0] forall W3 : word, W2 : word, W1 : word, W0 : word. unp0(pack4(W3, W2, W1, W0)) = W0
    property [p_unp1] forall W3 : word, W2 : word, W1 : word, W0 : word. unp1(pack4(W3, W2, W1, W0)) = W1
    property [p_unp2] forall W3 : word, W2 : word, W1 : word, W0 : word. unp2(pack4(W3, W2, W1, W0)) = W2
    property [p_unp3] forall W3 : word, W2 : word, W1 : word, W0 : word. unp3(pack4(W3, W2, W1, W0)) = W3

    # ---- the dynamic view of the same four positions.  `bv2` has four
    # values and they are enumerated here, so a caller that knows which
    # word it wants gets the static accessor back and one that does not
    # reasons with `p_wins_hit`/`p_wins_miss` alone. ----
    property [p_wsel0] forall M : four_words. wsel4(M, 0) = unp0(M)
    property [p_wsel1] forall M : four_words. wsel4(M, 1) = unp1(M)
    property [p_wsel2] forall M : four_words. wsel4(M, 2) = unp2(M)
    property [p_wsel3] forall M : four_words. wsel4(M, 3) = unp3(M)
    property [p_wins_hit] forall M : four_words, J : bv2, D : word.
        wsel4(wins4(M, J, D), J) = D
    property [p_wins_miss] forall M : four_words, J1 : bv2, J2 : bv2, D : word.
        J1 ~= J2 -> wsel4(wins4(M, J1, D), J2) = wsel4(M, J2)
    property [p_hw_pack4] forall W3 : word, W2 : word, W1 : word, W0 : word.
        hw_pack4(W3, W2, W1, W0) = pack4(W3, W2, W1, W0)
    property [p_hw_unp0] forall M : four_words. hw_unp0(M) = unp0(M)
    property [p_hw_unp1] forall M : four_words. hw_unp1(M) = unp1(M)
    property [p_hw_unp2] forall M : four_words. hw_unp2(M) = unp2(M)
    property [p_hw_unp3] forall M : four_words. hw_unp3(M) = unp3(M)
    property [p_hw_wsel4] forall M : four_words, J : bv2. hw_wsel4(M, J) = wsel4(M, J)
    property [p_hw_wins4] forall M : four_words, J : bv2, D : word.
        hw_wins4(M, J, D) = wins4(M, J, D)

    # ---- the line <-> beat bridge.  Four facts, and they are all anyone
    # outside ever needs: a packed line reads back as the beats it was built
    # from, and each beat of a line reads back as the line's words at that
    # beat's offsets.  Everything is phrased at `concatbv2(B, J)` so no
    # `beat_of`/`boff2` round trip appears in a client's query. ----
    property [p_lpack_lo] forall HI : four_words, LO : four_words, J : bv2.
        lsel(lpack(HI, LO), concatbv2(0, J)) = wsel4(LO, J)
    property [p_lpack_hi] forall HI : four_words, LO : four_words, J : bv2.
        lsel(lpack(HI, LO), concatbv2(1, J)) = wsel4(HI, J)
    property [p_llo] forall L : cache_line, J : bv2.
        wsel4(llo(L), J) = lsel(L, concatbv2(0, J))
    property [p_lhi] forall L : cache_line, J : bv2.
        wsel4(lhi(L), J) = lsel(L, concatbv2(1, J))
    property [p_lins_hit] forall L : cache_line, O : woffset, D : word.
        lsel(lins(L, O, D), O) = D
    property [p_lins_miss] forall L : cache_line, O1 : woffset, O2 : woffset, D : word.
        O1 ~= O2 -> lsel(lins(L, O1, D), O2) = lsel(L, O2)
    property [p_hw_lsel] forall L : cache_line, O : woffset. hw_lsel(L, O) = lsel(L, O)
    property [p_hw_lins] forall L : cache_line, O : woffset, D : word.
        hw_lins(L, O, D) = lins(L, O, D)
    property [p_hw_lpack] forall HI : four_words, LO : four_words.
        hw_lpack(HI, LO) = lpack(HI, LO)
    property [p_hw_lhi] forall L : cache_line. hw_lhi(L) = lhi(L)
    property [p_hw_llo] forall L : cache_line. hw_llo(L) = llo(L)

    implementation {
        interpret word -> bv[64]
        interpret four_words -> bv[256]
        interpret cache_line -> bv[512]
        definition pack4(W3, W2, W1, W0) = W3 :: W2 :: W1 :: W0
        definition unp0(M) = bfe[0][63](M)
        definition unp1(M) = bfe[64][127](M)
        definition unp2(M) = bfe[128][191](M)
        definition unp3(M) = bfe[192][255](M)
        definition wsel4(M, J) = (unp0(M) if J = 0 else
                                 (unp1(M) if J = 1 else
                                 (unp2(M) if J = 2 else unp3(M))))
        definition wins4(M, J, D) =
            (pack4(unp3(M), unp2(M), unp1(M), D) if J = 0 else
            (pack4(unp3(M), unp2(M), D, unp0(M)) if J = 1 else
            (pack4(unp3(M), D, unp1(M), unp0(M)) if J = 2 else
             pack4(D, unp2(M), unp1(M), unp0(M)))))
        definition hw_pack4(W3, W2, W1, W0) = W3 :: W2 :: W1 :: W0
        definition hw_unp0(M) = bfe[0][63](M)
        definition hw_unp1(M) = bfe[64][127](M)
        definition hw_unp2(M) = bfe[128][191](M)
        definition hw_unp3(M) = bfe[192][255](M)
        definition hw_wsel4(M, J) = (hw_unp0(M) if J = 0 else
                                    (hw_unp1(M) if J = 1 else
                                    (hw_unp2(M) if J = 2 else hw_unp3(M))))
        definition hw_wins4(M, J, D) =
            (hw_pack4(hw_unp3(M), hw_unp2(M), hw_unp1(M), D) if J = 0 else
            (hw_pack4(hw_unp3(M), hw_unp2(M), D, hw_unp0(M)) if J = 1 else
            (hw_pack4(hw_unp3(M), D, hw_unp1(M), hw_unp0(M)) if J = 2 else
             hw_pack4(D, hw_unp2(M), hw_unp1(M), hw_unp0(M)))))

        # ---- a line is its two beats, high first.  Every line operation is
        # routed through `wsel4`/`wins4` on the selected half rather than
        # through a fresh 512-bit case split, which is what keeps the six
        # properties above provable in seconds. ----
        definition lpack(HI, LO) = HI :: LO
        definition llo(L) = bfe[0][255](L)
        definition lhi(L) = bfe[256][511](L)
        definition lsel(L, O) = (wsel4(llo(L), boff2(O)) if beat_of(O) = 0
                                 else wsel4(lhi(L), boff2(O)))
        definition lins(L, O, D) =
            (lpack(lhi(L), wins4(llo(L), boff2(O), D)) if beat_of(O) = 0
             else lpack(wins4(lhi(L), boff2(O), D), llo(L)))
        definition hw_lpack(HI, LO) = HI :: LO
        definition hw_llo(L) = bfe[0][255](L)
        definition hw_lhi(L) = bfe[256][511](L)
        definition hw_lsel(L, O) = (hw_wsel4(hw_llo(L), hw_boff2(O)) if hw_beat_of(O) = 0
                                    else hw_wsel4(hw_lhi(L), hw_boff2(O)))
        definition hw_lins(L, O, D) =
            (hw_lpack(hw_lhi(L), hw_wins4(hw_llo(L), hw_boff2(O), D)) if hw_beat_of(O) = 0
             else hw_lpack(hw_wins4(hw_lhi(L), hw_boff2(O), D), hw_llo(L)))
    }
} with this, basis, addr_thy

export action posedge



    isolate cachemem = {

        # ---- the memory-side port, carried out to the top of the design ----
        wire mem_rd_en   : bool
        wire mem_rd_addr : addr
        wire mem_wr_en   : bool
        wire mem_wr_addr : addr
        wire mem_wr_data : four_words
        wire mem_rdata   : four_words

        # ==================================================================
        # The coherence channels, declared ONCE, here, ahead of both
        # children.  Each net has exactly one name: the child that drives it
        # exports a port wire and this level aliases the net to it, and the
        # child that reads it reads THIS wire, not a copy of its own.
        #
        # That is not tidiness.  `ivy_check` admits a definition into an
        # isolate's query only when the defined symbol occurs in that
        # isolate's OWN code or invariants -- an occurrence inside an
        # invariant imported from a sibling does not count.  With a net named
        # twice, an imported invariant about the far end's copy is a
        # statement about a symbol the query never connects to anything, and
        # it silently says nothing.  (Measured: `[wb_done]` phrased over
        # `dir_body.ack_line` left `mock_body.mk_owns` unprovable, and the
        # query did not fail -- it ran for twenty minutes.)
        #
        # `c_st_*`/`c_mk_ev*` are proof observation nets rather than
        # protocol: the store the ghost image moves on, and the eviction the
        # channel-3 record is posted from.
        # ==================================================================
        wire c_req_en    : bool         # client -> directory
        wire c_req_line  : line
        wire c_req_excl  : bool
        wire c_req_taken : bool         # directory -> client
        wire c_gr_valid  : bool         # directory -> client
        wire c_gr_excl   : bool
        wire c_gr_line   : line
        wire c_gr_data   : cache_line
        wire c_gr_taken  : bool         # client -> directory
        wire c_ack_taken : bool         # directory -> client
        wire c_st_en     : bool         # client -> proof
        wire c_st_h      : line
        wire c_st_o      : woffset
        wire c_st_d      : word
        wire c_mk_ev     : bool         # client -> proof
        wire c_mk_ev_l   : line
        wire c_mk_ev_d   : bool
        wire c_mk_ev_dat : cache_line

        specification {

            function img(H : line, O : woffset) : word

            # Specifies what lines are owned by the client
            # in practice, the lines it holds dirty or is shipping back
            function cache_owns(H : line, O : woffset) : bool

            # ==============================================================
            # The client's holding, and channel 3, kept HERE.
            #
            # Not decoration, and not a mirror that could be dropped: an
            # isolate cannot prove anything about its own free inputs.  The
            # directory has to state that the writeback it is running is the
            # ack still in the channel (`[wb_ack]`), and that a retired ack's
            # data has landed (`[wb_done]`) -- both are claims about the
            # POST-state, and if the ack lives in the client's registers then
            # across the seam it is a wire the environment may re-drive, so
            # neither invariant is provable at all.  (Measured: the query
            # does not fail, it diverges.)  Held here it is ordinary state
            # whose transition both isolates see, and both facts are
            # ordinary induction.
            #
            # `mk_g_hold` does the same job for the client's line: it moves
            # only on `c_mk_ev` (the client gives the line up) and on
            # `c_gr_valid & c_gr_taken` (the client takes a grant), and
            # `c_gr_valid` is the DIRECTORY's own output, so the directory
            # can prove the record does not move behind its back.  That is
            # what makes `[rd_clean]` inductive.  `mock_body` keeps both
            # synced (`mk_sync`, `mk_ack_sync`).
            # ==============================================================
            var mk_g_hold : bool
            var mk_g_line : line

            var ack_g_en   : bool
            var ack_g_line : line
            var ack_g_dty  : bool
            var ack_g_data : cache_line

            after init {
                img(H, O)         := init_img(H, O);
                cache_owns(H, O)  := false;
                mk_g_hold := false;
                mk_g_line := 0;
                ack_g_en := false; ack_g_line := 0;
                ack_g_dty := false; ack_g_data := 0;
            }

            # ---- this monitor is declared FIRST, so in every isolate's
            # check it runs before any child's transition: the child wires it
            # reads carry pre-edge values, and the records it writes are seen
            # with the same value by every child that reads them later in the
            # edge. ----
            after posedge {

                # ---- CLEAR ownership at a command-beat landing, BEFORE
                # the store arm below: on the one edge where a store to a
                # just-written-back line lands with that line's last beat,
                # the set must win.  Keyed on the controller-side command
                # wires -- the same nets `mc_body`'s `mmem` write is keyed
                # on.  Unchanged from the cache-driven version; only the
                # driver of those wires is different. ----
                if mc_body.cmd_en & mc_body.cmd_wen {
                    cache_owns(H, O) := (false
                                         if (H = high(mc_body.cmd_addr)
                                             & beat_of(O) = beat_of(low(mc_body.cmd_addr)))
                                         else cache_owns(H, O));
                };

                # ---- the client's store.  `img` moves HERE and nowhere
                # else, and ownership begins on the same edge -- the edge
                # the datum enters the image and DRAM stops agreeing with
                # it.  A whole-array update in conditional form: written the
                # obvious way, `img(c_st_h, c_st_o) := c_st_d`, an index
                # carrying a non-literal value is the shape this Ivy build
                # mishandles -- it neutralises the transition and everything
                # downstream passes vacuously. ----
                if c_st_en {
                    img(H, O) := (c_st_d
                                  if (H = c_st_h & O = c_st_o)
                                  else img(H, O));
                    cache_owns(H, O) := (true
                                         if (H = c_st_h & O = c_st_o)
                                         else cache_owns(H, O));
                };

                # ---- channel 3: retire first, post second, so the slot a
                # retiring ack frees is available to an eviction on the same
                # edge. ----
                if c_ack_taken {
                    ack_g_en := false;
                };
                if c_mk_ev {
                    ack_g_en   := true;
                    ack_g_line := c_mk_ev_l;
                    ack_g_dty  := c_mk_ev_d;
                    ack_g_data := c_mk_ev_dat;
                    mk_g_hold  := false;
                };

                # ---- and the client takes what it asked for ----
                if c_gr_valid & c_gr_taken {
                    mk_g_hold := true;
                    mk_g_line := c_gr_line;
                };
            }
        }

        # ==================================================================
        # The client stand-in.
        #
        # One line of storage, one outstanding request, one channel-3 slot.
        # It is not hardware and it is not meant to be: it is the smallest
        # thing that can exercise every edge of the directory's data path --
        # request, grant capture, store, dirty writeback -- and, crucially,
        # the smallest thing that can DISCHARGE the seam facts the directory
        # needs.  The seven invariants in its `specification` block are the
        # contract phase 3's real cache has to re-prove; nothing else about
        # this object escapes.
        #
        # Environment nondeterminism arrives as undriven wires (`go_*`),
        # exactly as the LSQ port used to: an undefined wire is a free value
        # every edge, so "the client decides to store now" is a free choice.
        # ==================================================================
        isolate mock_body = {

            # ---- the ports this client DRIVES.  Its inputs are the `c_*`
            # nets and the `cachemem` records, read directly. ----
            wire req_en    : bool
            wire req_line  : line
            wire req_excl  : bool
            wire gr_taken  : bool
            wire st_en     : bool
            wire st_h      : line
            wire st_o      : woffset
            wire st_d      : word
            wire mk_ev     : bool
            wire mk_ev_l   : line
            wire mk_ev_d   : bool
            wire mk_ev_dat : cache_line

            # ==============================================================
            # The contract.  This is the whole of what the client owes the
            # directory, and the only thing phase 3's cache has to re-prove.
            #
            # The first four are structural -- a client with a request
            # outstanding, or an ack in the channel, is holding nothing; it
            # only ever stores into the line it holds; it never posts a
            # second ack over a live one.  Between them they pin every net
            # that can move `img` or `cache_owns` to the `mk_g_hold` record,
            # which is what makes `[rd_clean]` inductive.
            #
            # `[mk_owns]` is the client's half of the old `[unowned]`: if a
            # word is owned then either the client is still sitting on the
            # line or the dirty ack carrying it has not been retired.  The
            # directory's half -- the beats between the ack and DRAM -- is
            # `[wb_lo_clean]`/`[wb_hi_clean]` on the other side of the seam,
            # and the two meet at `[wb_done]`.  Contrapositive form, like the
            # `[unowned]` it descends from: with `cache_owns` in the
            # antecedent the invariant fires on every word the two array
            # arms touch.
            # ==============================================================
            specification {
                invariant [mk_req_idle] c_req_en -> ~mk_g_hold & ~ack_g_en

                invariant [mk_ack_idle] ack_g_en -> ~mk_g_hold

                invariant [mk_st_line] c_st_en -> mk_g_hold & c_st_h = mk_g_line

                invariant [mk_no_double] c_mk_ev ->
                    ~ack_g_en & mk_g_hold & c_mk_ev_l = mk_g_line

                invariant [mk_owns]
                      ~(mk_g_hold & mk_g_line = H)
                    & ~(ack_g_en & ack_g_dty & ack_g_line = H)
                    -> ~cache_owns(H, O)

                invariant [mk_clean_ack] ack_g_en & ~ack_g_dty ->
                    ~cache_owns(ack_g_line, O)

                # ---- the same fact one edge earlier, about the eviction
                # that is being posted RIGHT NOW: the directory reads the
                # channel-3 record after `cachemem` has written it, so on a
                # posting edge `[mk_clean_ack]` is about the record that was
                # there before.  A clean eviction surrenders a line nobody
                # owns, and it never rides with a store. ----
                invariant [mk_ev_clean] c_mk_ev & ~c_mk_ev_d ->
                    ~cache_owns(c_mk_ev_l, O)
                invariant [mk_ev_nost] c_mk_ev -> ~c_st_en

                invariant [ack_img] ack_g_en & ack_g_dty ->
                    lsel(ack_g_data, O) = img(ack_g_line, O)
            }

            implementation {
                # ---- the environment's choices ----
                wire go_req   : bool
                wire go_line  : line
                wire go_excl  : bool
                wire go_store : bool
                wire go_off   : woffset
                wire go_data  : word
                wire go_evict : bool

                wire mk_idle : mkstate
                wire mk_req  : mkstate
                wire mk_wait : mkstate
                definition mk_idle = 0
                definition mk_req  = 1
                definition mk_wait = 2

                # ---- the transaction ----
                var mk_st : mkstate
                var mk_bl : line
                var mk_bx : bool

                # ---- the one line of storage ----
                var mk_v   : bool
                var mk_l   : line
                var mk_d   : cache_line
                var mk_dty : bool

                # ---- this side's copy of the channel-3 slot ----
                var mk_ae : bool

                after init {
                    mk_st := 0; mk_bl := 0; mk_bx := false;
                    mk_v := false; mk_l := 0; mk_d := 0; mk_dty := false;
                    mk_ae := false;
                }

                definition req_en   = (mk_st = mk_req)
                definition req_line = mk_bl
                definition req_excl = mk_bx

                definition gr_taken = (mk_st = mk_wait) & c_gr_valid
                    & c_gr_line = mk_bl

                # ---- every observation wire is a function of THIS
                # isolate's registers and the free `go_*` choices, and of
                # nothing at `cachemem`.  That is deliberate: the records at
                # `cachemem` are written by a monitor that runs before this
                # one, so a guard phrased over `ack_g_en` would be read by
                # `cachemem` at its old value and re-read here at its new
                # one, and the two arms would disagree.  `mk_ae` is this
                # side's copy of the channel-3 slot, and `[mk_ack_sync]`
                # ties it to the record. ----
                definition st_en = mk_v & go_store & ~mk_ae
                definition st_h  = mk_l
                definition st_o  = go_off
                definition st_d  = go_data

                # ---- store and eviction are mutually exclusive by
                # construction, so the line and its dirty bit are the same
                # here as they are when `cachemem`'s monitor reads them ----
                definition mk_ev     = mk_v & go_evict & ~go_store & ~mk_ae
                definition mk_ev_l   = mk_l
                definition mk_ev_d   = mk_dty
                definition mk_ev_dat = mk_d

                after posedge {
                    var ae0 : bool := mk_ae;

                    # ---- the store, FIRST, so it reads the same registers
                    # `cachemem`'s image arm just read ----
                    if mk_v & go_store & ~mk_ae {
                        mk_d   := hw_lins(mk_d, go_off, go_data);
                        mk_dty := true;
                    };

                    # ---- the eviction: the payload goes into the channel-3
                    # record at `cachemem`, and the slot is taken here.
                    # Before the retire arm, and off the PRE-edge slot, so
                    # the two arms cannot cross. ----
                    if mk_v & go_evict & ~go_store & ~mk_ae {
                        mk_v  := false;
                        mk_ae := true;
                    };

                    if ae0 & c_ack_taken {
                        mk_ae := false;
                    };

                    # ---- channel 2 capture, then channel 1 handshake: in
                    # this order a request cannot be issued and answered on
                    # one edge ----
                    if mk_st = mk_wait & c_gr_valid & c_gr_line = mk_bl {
                        mk_v   := true;
                        mk_l   := mk_bl;
                        mk_d   := c_gr_data;
                        mk_dty := false;
                        mk_st  := mk_idle;
                    };

                    if mk_st = mk_req & c_req_taken {
                        mk_st := mk_wait;
                    };

                    if mk_st = mk_idle & ~mk_v & ~mk_ae & go_req {
                        mk_st := mk_req;
                        mk_bl := go_line;
                        mk_bx := go_excl;
                    };
                }

                # ---- the records at `cachemem` really are this client's
                # holding and its ack.  Both move on `mk_ev` and on the grant
                # capture, and `gr_taken` is defined to BE the capture
                # condition, so the agreement is syntactic. ----
                invariant [mk_sync] mk_g_hold = mk_v
                invariant [mk_sync_l] mk_v -> mk_g_line = mk_l
                invariant [mk_ack_sync] ack_g_en = mk_ae

                # ---- one line, one transaction: a client with a request
                # outstanding holds nothing and has nothing in channel 3.
                # This is what `mshr_distinct`/`no_alias` will supply in the
                # real cache. ----
                invariant [mk_one] (mk_st ~= mk_idle) -> ~mk_v & ~mk_ae
                invariant [mk_ae_v] mk_ae -> ~mk_v

                # ---- the resident copy is the image, and only a dirty copy
                # can be owned: the local `[c_img]` and `[dirty_excl]`. ----
                invariant [mk_img] mk_v -> lsel(mk_d, O) = img(mk_l, O)
                invariant [mk_dty_owns] ~mk_dty & mk_v & mk_l = H
                    -> ~cache_owns(H, O)
            }

        } with this, addr_thy, basis, data_impl

        isolate mc_body = {

            # ---- directory command channel: the command comes from the
            # directory, the ready is driven here ----
            wire cmd_en    : bool
            wire cmd_wen   : bool
            wire cmd_addr  : addr
            wire cmd_data  : four_words
            wire cmd_ready : bool

            # ---- directory response channel: all driven here ----
            wire rsp_valid : bool
            wire rsp_addr  : addr
            wire rsp_data  : four_words

            wire mem_rd_en   : bool
            wire mem_rd_addr : addr
            wire mem_wr_en   : bool
            wire mem_wr_addr : addr
            wire mem_wr_data : four_words
            wire mem_rdata   : four_words

            # ==================================================================
            # The controller.  UNCHANGED from the cache-driven version: same
            # beat-granular port, same two-command buffer, same latency
            # counter, same `mc_owns_img`.  Only the driver of the command
            # wires is different, and `mc_owns_img` never named the driver --
            # it needs `wb_img`, and `wb_img` now arrives from `dir_body`.
            #
            # `mmem` is real hardware -- the DRAM behind the port -- but its
            # client is proved against it, so it lives in the specification
            # where that client can see it.
            #
            # The write is unbuffered and is applied from the command wires
            # alone: a command lands in memory on the edge the port carries
            # it, one edge after it was issued.  The buffer below delays only
            # the *response*, and the write is applied at the top of the
            # edge, so a read never overtakes a write to the same beat.
            # ==================================================================
            specification {
                # The memory that the memory controller presents
                function mmem(H : line, O : woffset) : word

                after init {
                    mmem(H, O) := init_img(H, O);
                }

                # ---- ONE conditional whole-array write: four sequential
                # writes each spawn a quantified frame axiom and they
                # chain, which measured as the dominant instantiation cost
                # in `mem_img`'s consecution.  `wsel4` bridges to the
                # `unp0..3` forms by `p_wsel0..3` under `p_cover`. ----
                after posedge {
                    if cmd_en & cmd_wen {
                        mmem(H, O) := (wsel4(cmd_data, boff2(O))
                                       if (H = high(cmd_addr)
                                           & beat_of(O) = beat_of(low(cmd_addr)))
                                       else mmem(H, O));
                        # (the matching `cache_owns` CLEAR lives in
                        # `cachemem`'s monitor, ahead of the store arm, so
                        # a same-edge store-set wins)
                    };
                }

                # ==========================================================
                # Wherever nobody owns the word, the DRAM is the reference
                # image.  Proven HERE, against the controller's own small
                # transition.  What it needs of its client is `wb_img` --
                # anything put on the command wire is accurate to `img` --
                # and that arrives by IMPORT, through `with this`: `cachemem`
                # presents its children's `specification` blocks, so
                # `dir_body.wb_img` is a pre-state assumption here without
                # `dir_body` being named below.  It is load-bearing: with
                # `wb_img` moved into a `private` block this goal stops
                # closing entirely.
                # ==========================================================

                invariant [mc_owns_img] ~cache_owns(H, O) ->
                    mmem(H, O) = img(H, O)

                before posedge {
                    assume [dram_read] mem_rd_en ->
                          unp0(mem_rdata) = mmem(high(mem_rd_addr), concatbv2(beat_of(low(mem_rd_addr)), 0))
                        & unp1(mem_rdata) = mmem(high(mem_rd_addr), concatbv2(beat_of(low(mem_rd_addr)), 1))
                        & unp2(mem_rdata) = mmem(high(mem_rd_addr), concatbv2(beat_of(low(mem_rd_addr)), 2))
                        & unp3(mem_rdata) = mmem(high(mem_rd_addr), concatbv2(beat_of(low(mem_rd_addr)), 3));
                }

                # ---- when the controller raises a response it carries the
                # *current* content of its memory at the address it echoes,
                # not a stale snapshot: the response registers are cleared at
                # the top of every edge and refilled after that edge's write
                # has landed. ----
                invariant [mc_resp] rsp_valid ->
                      unp0(rsp_data) = mmem(high(rsp_addr), concatbv2(beat_of(low(rsp_addr)), 0))
                    & unp1(rsp_data) = mmem(high(rsp_addr), concatbv2(beat_of(low(rsp_addr)), 1))
                    & unp2(rsp_data) = mmem(high(rsp_addr), concatbv2(beat_of(low(rsp_addr)), 2))
                    & unp3(rsp_data) = mmem(high(rsp_addr), concatbv2(beat_of(low(rsp_addr)), 3))

                # ---- the port never accepts a command on the edge one is
                # already travelling: `cmd_ready` implies the wire is idle.
                # The directory needs this to know that a writeback beat it
                # issued has already been applied by the time the port lets
                # it issue the next one -- which is what makes the two beats
                # of a writeback sequential rather than overlapping. ----
                invariant [rdy_idle] cmd_ready -> ~cmd_en

            }

            implementation {

                # ---- the command buffer ----
                var cb0_valid : bool
                var cb0_wen   : bool
                var cb0_addr  : addr
                var cb1_valid : bool
                var cb1_wen   : bool
                var cb1_addr  : addr
                var svc_count : latency
                wire mem_latency : latency
                definition mem_latency = 8

                # ---- the registers driving the response port ----
                var rsp_valid_r : bool
                var rsp_addr_r  : addr
                var rsp_data_r  : four_words

                after init {
                    cb0_valid := false; cb0_wen := false; cb0_addr := 0;
                    cb1_valid := false; cb1_wen := false; cb1_addr := 0;
                    svc_count := 0;
                    rsp_valid_r := false; rsp_addr_r := 0; rsp_data_r := 0;
                }

                definition cmd_ready = ~(cb0_valid & cb1_valid) & ~cmd_en

                definition rsp_valid = rsp_valid_r
                definition rsp_addr  = rsp_addr_r
                definition rsp_data  = rsp_data_r

                definition mem_rd_en   = cb0_valid & ~cb0_wen & ~rsp_valid & svc_count = 0
                definition mem_rd_addr = cb0_addr
                definition mem_wr_en   = cmd_en & cmd_wen
                definition mem_wr_addr = cmd_addr
                definition mem_wr_data = cmd_data

                after posedge {
                    rsp_valid_r := false;

                    if cmd_en {
                        var a : addr := cmd_addr;
                        if ~cb0_valid {
                            cb0_valid := true; cb0_wen := cmd_wen; cb0_addr := a;
                            svc_count := mem_latency;
                        } else {
                            cb1_valid := true; cb1_wen := cmd_wen; cb1_addr := a;
                        };
                    };

                    if cb0_valid & (cb0_wen | ~rsp_valid) {
                        if svc_count = 0 {
                            if ~cb0_wen {
                                var h : line := hw_high(cb0_addr);
                                var b : bit  := hw_beat_of(hw_low(cb0_addr));
                                rsp_valid_r := true;
                                rsp_addr_r  := cb0_addr;
                                rsp_data_r  := (cmd_data
                                    if (cmd_en & cmd_wen
                                        & hw_high(cmd_addr) = h
                                        & hw_beat_of(hw_low(cmd_addr)) = b)
                                    else mem_rdata);
                            };
                            if cb1_valid {
                                cb0_valid := true; cb0_wen := cb1_wen; cb0_addr := cb1_addr;
                                cb1_valid := false;
                                svc_count := mem_latency;
                            } else {
                                cb0_valid := false;
                            };
                        } else {
                            svc_count := svc_count - 1;
                        }
                    };
                }

            }

        } with this, addr_thy, basis, data_impl

        # ==================================================================
        # The directory.
        #
        # It owns no data: a grant is answered out of DRAM (decision 4) and a
        # dirty ack is pushed to DRAM before anything reads the line again
        # (decision 3).  So the whole of it is a request register, a two-beat
        # read ladder, and a two-beat writeback sequencer sharing one command
        # port -- writebacks first, because a writeback is what unblocks the
        # client, and because a read must never overtake the write it is
        # waiting for.
        #
        # Blocking, single slot everywhere (decision 2): one request start to
        # finish, one grant in channel 2, one ack in channel 3.
        # ==================================================================
        isolate dir_body = {

            # ---- the ports this directory DRIVES on the client side.  Its
            # client-side inputs are the `c_*` nets and the channel-3 record,
            # read directly. ----
            wire req_taken : bool
            wire gr_valid  : bool
            wire gr_excl   : bool
            wire gr_line   : line
            wire gr_data   : cache_line
            wire ack_taken : bool

            # ---- memory command channel: the command is driven here, the
            # ready comes from the memory controller ----
            wire cmd_en    : bool
            wire cmd_wen   : bool
            wire cmd_addr  : addr
            wire cmd_data  : four_words
            wire cmd_ready : bool

            # ---- memory response channel: all driven by the controller ----
            wire rsp_valid : bool
            wire rsp_addr  : addr
            wire rsp_data  : four_words

            # ==============================================================
            # The contract.
            #
            # `dir` is the image the directory and the controller jointly
            # present to the client.  The directory keeps no data array, so
            # it IS the controller's memory -- and that identity is the
            # content of decisions 3 and 4, not a shortcut: if a dirty ack
            # could be answered out of the directory instead of round-
            # tripping DRAM, `dir` would need a case for it and every data
            # invariant downstream would grow one too.
            #
            # `[grant_img_*]` is the client-facing guarantee: whatever comes
            # back on channel 2 is the image.  It is stated per BEAT rather
            # than at an arbitrary offset so that `p_lpack_lo`/`p_lpack_hi`
            # fire on it directly; at a free offset the goal has to go
            # through `p_cover` first and stops closing.
            #
            # `[wb_img]` is the controller-facing one, and `mc_body` proves
            # `mc_owns_img` from it -- by IMPORT, through `with this`,
            # exactly as it did from the cache's `wb_img` before.
            #
            # `[wb_done]` is the one fact that flows the other way across the
            # client seam: an ack is not retired until its data is in DRAM,
            # so the client may drop the line from its ownership books the
            # edge it sees `c_ack_taken`.
            # ==============================================================
            specification {
                function dir(H : line, O : woffset) : word
                definition dir(H, O) = mc_body.mmem(H, O)

                invariant [dir_img] ~cache_owns(H, O) -> dir(H, O) = img(H, O)

                invariant [grant_img_lo] c_gr_valid ->
                    lsel(c_gr_data, concatbv2(0, J)) = img(c_gr_line, concatbv2(0, J))
                invariant [grant_img_hi] c_gr_valid ->
                    lsel(c_gr_data, concatbv2(1, J)) = img(c_gr_line, concatbv2(1, J))

                invariant [wb_img] cmd_en & cmd_wen ->
                    wsel4(cmd_data, J) =
                        img(high(cmd_addr),
                            concatbv2(beat_of(low(cmd_addr)), J))

                invariant [wb_done] c_ack_taken -> ~cache_owns(ack_g_line, O)
            }

            implementation {
                wire d_idle   : dstate
                wire d_rd_lo  : dstate
                wire d_rdw_lo : dstate
                wire d_rd_hi  : dstate
                wire d_rdw_hi : dstate
                wire d_grant  : dstate
                wire d_gwt    : dstate
                definition d_idle   = 0
                definition d_rd_lo  = 1
                definition d_rdw_lo = 2
                definition d_rd_hi  = 3
                definition d_rdw_hi = 4
                definition d_grant  = 5
                definition d_gwt    = 6

                wire wb_idle : wbstate
                wire wb_lo   : wbstate
                wire wb_hi   : wbstate
                wire wb_fin  : wbstate
                wire wb_ret  : wbstate
                definition wb_idle = 0
                definition wb_lo   = 1
                definition wb_hi   = 2
                definition wb_fin  = 3
                definition wb_ret  = 4

                # ---- the current request ----
                var dstate_r : dstate
                var cr_line  : line
                var cr_excl  : bool
                var dfb_lo   : four_words
                var dfb_hi   : four_words

                # ---- channel 2's registers ----
                var gr_v : bool
                var gr_x : bool
                var gr_l : line
                var gr_d : cache_line

                # ---- the writeback sequencer.  `wb_lo_done`/`wb_hi_done`
                # are GHOST: the beat has LANDED in memory, not merely been
                # issued.  Recorded at the top of the edge off the command
                # wires, the same nets `cachemem`'s ownership clear is keyed
                # on, so the two agree by construction. ----
                var wb_st      : wbstate
                var wb_line    : line
                var wb_lo_done : bool
                var wb_hi_done : bool

                # ---- the command port's registers ----
                var ev_cmd      : bool
                var ev_cmd_wen  : bool
                var ev_cmd_addr : addr
                var ev_cmd_data : four_words

                after init {
                    dstate_r := 0; cr_line := 0; cr_excl := false;
                    dfb_lo := 0; dfb_hi := 0;
                    gr_v := false; gr_x := false; gr_l := 0; gr_d := 0;
                    wb_st := 0; wb_line := 0;
                    wb_lo_done := false; wb_hi_done := false;
                    ev_cmd := false; ev_cmd_wen := false;
                    ev_cmd_addr := 0; ev_cmd_data := 0;
                }

                definition gr_valid = gr_v
                definition gr_excl  = gr_x
                definition gr_line  = gr_l
                definition gr_data  = gr_d

                # ---- a request is taken the edge it is latched ----
                definition req_taken = (dstate_r = d_idle) & c_req_en
                    & (wb_st = wb_idle) & ~gr_v

                # ---- an ack is retired when there is nothing left to do
                # with it: EVERY ack goes through the sequencer, a clean one
                # straight to `wb_ret` and a dirty one only once both its
                # beats have landed.  Holding a dirty one that long is what
                # makes the client's ownership books close without a second
                # ghost on the client side; routing the clean one through the
                # same state is what makes the retire pulse a function of
                # this isolate's OWN register, so `[wb_done]` is a claim
                # about state the directory can reason about after the edge
                # rather than about the client's free wires. ----
                definition ack_taken = (wb_st = wb_ret)

                definition cmd_en   = ev_cmd
                definition cmd_wen  = ev_cmd_wen
                definition cmd_addr = ev_cmd_addr
                definition cmd_data = ev_cmd_data

                after posedge {
                    # ---- GHOST.  The command presented on the last edge is
                    # applied to memory on THIS one, so a writeback beat that
                    # was on the wire has now landed. ----
                    if ev_cmd & ev_cmd_wen & hw_high(ev_cmd_addr) = wb_line {
                        if hw_beat_of(hw_low(ev_cmd_addr)) = 0 {
                            wb_lo_done := true;
                        } else {
                            wb_hi_done := true;
                        };
                    };

                    ev_cmd := false;

                    # ---- channel 2 retires ----
                    if gr_v & c_gr_taken {
                        gr_v := false;
                        if dstate_r = d_gwt {
                            dstate_r := d_idle;
                        };
                    };

                    # ---- the read ladder.  AHEAD of the command port, so the
                    # state a response advances is the state the port then
                    # issues from -- and so a command on the wire is never
                    # left behind by a same-edge response, which is what
                    # `[rd_cmd]` says. ----
                    if rsp_valid & hw_high(rsp_addr) = cr_line {
                        if dstate_r = d_rdw_lo & hw_beat_of(hw_low(rsp_addr)) = 0 {
                            dfb_lo   := rsp_data;
                            dstate_r := d_rd_hi;
                        } else { if dstate_r = d_rdw_hi & hw_beat_of(hw_low(rsp_addr)) = 1 {
                            dfb_hi   := rsp_data;
                            dstate_r := d_grant;
                        } };
                    };

                    # ---- the one command port.  Writeback beats first.
                    # AHEAD of the channel-3 pickup below, so a beat is never
                    # issued on the edge its ack was posted: `cachemem`'s
                    # channel-3 record is written by a monitor that runs
                    # before this one, and on that edge `[ack_img]` -- the
                    # client's promise about the payload -- is a statement
                    # about the PRE-edge record, which is not the one that
                    # would go on the wire.  One edge later the record is
                    # settled and the pre-state fact is the right one. ----
                    if cmd_ready {
                        if wb_st = wb_lo {
                            ev_cmd      := true;
                            ev_cmd_wen  := true;
                            ev_cmd_addr := hw_concatbv3(wb_line, hw_concatbv2(0, 0));
                            ev_cmd_data := hw_llo(ack_g_data);
                            wb_st       := wb_hi;
                        } else { if wb_st = wb_hi {
                            ev_cmd      := true;
                            ev_cmd_wen  := true;
                            ev_cmd_addr := hw_concatbv3(wb_line, hw_concatbv2(1, 0));
                            ev_cmd_data := hw_lhi(ack_g_data);
                            wb_st       := wb_fin;
                        } else { if dstate_r = d_rd_lo {
                            ev_cmd      := true;
                            ev_cmd_wen  := false;
                            ev_cmd_addr := hw_concatbv3(cr_line, hw_concatbv2(0, 0));
                            ev_cmd_data := 0;
                            dstate_r    := d_rdw_lo;
                        } else { if dstate_r = d_rd_hi {
                            ev_cmd      := true;
                            ev_cmd_wen  := false;
                            ev_cmd_addr := hw_concatbv3(cr_line, hw_concatbv2(1, 0));
                            ev_cmd_data := 0;
                            dstate_r    := d_rdw_hi;
                        } } } };
                    };

                    # ---- channel 3.  Pick a dirty ack up into the
                    # sequencer, or finish with one whose beats have all
                    # landed (`ack_taken` is high this edge). ----
                    if wb_st = wb_idle {
                        if ack_g_en {
                            wb_line    := ack_g_line;
                            wb_lo_done := false;
                            wb_hi_done := false;
                            if ack_g_dty {
                                wb_st := wb_lo;
                            } else {
                                wb_st := wb_ret;
                            };
                        };
                    } else { if wb_st = wb_fin & wb_lo_done & wb_hi_done {
                        wb_st := wb_ret;
                    } else { if wb_st = wb_ret {
                        wb_st      := wb_idle;
                        wb_lo_done := false;
                        wb_hi_done := false;
                    } } };

                    # ---- the grant ----
                    if dstate_r = d_grant {
                        gr_v     := true;
                        gr_x     := cr_excl;
                        gr_l     := cr_line;
                        gr_d     := hw_lpack(dfb_hi, dfb_lo);
                        dstate_r := d_gwt;
                    };

                    # ---- pick a new request.  Last, so the slot a grant
                    # freed this edge is not reused on the same edge. ----
                    if dstate_r = d_idle & c_req_en & wb_st = wb_idle & ~gr_v
                            & ~(mk_g_hold & mk_g_line = c_req_line) {
                        cr_line  := c_req_line;
                        cr_excl  := c_req_excl;
                        dstate_r := d_rd_lo;
                    };
                }

                # ==========================================================
                # 2.1  Structure of the two sequencers.
                # ==========================================================

                # ---- a grant only ever rides channel 2 in the one state
                # that put it there ----
                invariant [d_gr_state] gr_v -> dstate_r = d_gwt
                invariant [d_gwt_gr] dstate_r = d_gwt -> gr_v

                # ---- the sequencer is running exactly while the ack it is
                # running for is still in the channel ----
                invariant [wb_ack] wb_st ~= wb_idle & wb_st ~= wb_ret ->
                    ack_g_en & ack_g_dty & ack_g_line = wb_line

                # ---- the retire state: the ack it is retiring is still in
                # the record, and everything it carried is in DRAM.  These
                # two ARE `[wb_done]`. ----
                invariant [wb_ret_line] wb_st = wb_ret ->
                    ack_g_en & ack_g_line = wb_line
                invariant [wb_ret_clean] wb_st = wb_ret ->
                    ~cache_owns(wb_line, O)

                # ---- what is on the command wire, and for whom ----
                invariant [wb_cmd] ev_cmd & ev_cmd_wen ->
                    high(ev_cmd_addr) = wb_line
                    & ((wb_st = wb_hi & beat_of(low(ev_cmd_addr)) = 0)
                       | (wb_st = wb_fin & beat_of(low(ev_cmd_addr)) = 1))

                # ---- which is what dates the two landing ghosts: the high
                # beat is only ever on the wire out of `wb_fin` ----
                invariant [wb_hi_late] wb_hi_done
                    -> wb_st = wb_fin | wb_st = wb_ret
                invariant [rd_cmd] ev_cmd & ~ev_cmd_wen ->
                    (dstate_r = d_rdw_lo | dstate_r = d_rdw_hi)
                    & high(ev_cmd_addr) = cr_line

                # ==========================================================
                # 2.2  The client is not sitting on the line being fetched.
                #
                # The record moves up only on `c_gr_valid & c_gr_taken`, and
                # `c_gr_valid` is this isolate's own output, raised in
                # `d_gwt` alone -- the edge the directory finishes.  So the
                # client cannot acquire the line behind the directory's back,
                # and `[mk_st_line]` then says no store can move `img` at
                # `cr_line` while the request is in flight.  That is the
                # whole argument behind `[rd_clean]` and `[dfb_img]`.
                # ==========================================================
                invariant [d_notheld] dstate_r ~= d_idle ->
                    ~(mk_g_hold & mk_g_line = cr_line)

                # ---- `[rd_clean]`: nothing owns the line under a request,
                # from the edge it is picked to the edge it is granted. ----
                invariant [rd_clean] dstate_r ~= d_idle ->
                    ~cache_owns(cr_line, O)

                # ==========================================================
                # 2.3  The fetch buffers, and the grant they become.
                # ==========================================================
                invariant [dfb_img_lo]
                    (dstate_r = d_rd_hi | dstate_r = d_rdw_hi
                     | dstate_r = d_grant | dstate_r = d_gwt)
                    -> wsel4(dfb_lo, J) = img(cr_line, concatbv2(0, J))
                invariant [dfb_img_hi]
                    (dstate_r = d_grant | dstate_r = d_gwt)
                    -> wsel4(dfb_hi, J) = img(cr_line, concatbv2(1, J))
                invariant [gr_of_cr] gr_v -> gr_l = cr_line

                # ==========================================================
                # 2.4  The writeback: what is in the sequencer, on the wire,
                # and already in DRAM.
                #
                # `[wb_lo_clean]`/`[wb_hi_clean]` are the directory's half of
                # the old `[unowned]` -- the beats between the client's ack
                # and DRAM -- and they are what `[wb_done]` is assembled
                # from.  Their preservation leans on `[mk_ack_idle]`: while
                # the ack is in the channel the client holds nothing, so
                # `[mk_st_line]` forbids a store that could re-own the line
                # behind the landed beat.
                # ==========================================================
                invariant [wb_lo_clean] wb_lo_done & beat_of(O) = 0
                    -> ~cache_owns(wb_line, O)
                invariant [wb_hi_clean] wb_hi_done & beat_of(O) = 1
                    -> ~cache_owns(wb_line, O)
                invariant [wb_ghost_idle] wb_st = wb_idle
                    -> ~wb_lo_done & ~wb_hi_done
            }

        } with this, mc_body, mock_body, addr_thy, basis, data_impl

        # ---- each net aliased to the port that drives it, and to nothing
        # else: the far side reads the net itself. ----
        definition c_req_en    = mock_body.req_en
        definition c_req_line  = mock_body.req_line
        definition c_req_excl  = mock_body.req_excl
        definition c_req_taken = dir_body.req_taken
        definition c_gr_valid  = dir_body.gr_valid
        definition c_gr_excl   = dir_body.gr_excl
        definition c_gr_line   = dir_body.gr_line
        definition c_gr_data   = dir_body.gr_data
        definition c_gr_taken  = mock_body.gr_taken
        definition c_ack_taken = dir_body.ack_taken
        definition c_st_en     = mock_body.st_en
        definition c_st_h      = mock_body.st_h
        definition c_st_o      = mock_body.st_o
        definition c_st_d      = mock_body.st_d
        definition c_mk_ev     = mock_body.mk_ev
        definition c_mk_ev_l   = mock_body.mk_ev_l
        definition c_mk_ev_d   = mock_body.mk_ev_d
        definition c_mk_ev_dat = mock_body.mk_ev_dat

        # ---- the directory's command port drives the memory controller's ----
        definition mc_body.cmd_en    = dir_body.cmd_en
        definition mc_body.cmd_wen   = dir_body.cmd_wen
        definition mc_body.cmd_addr  = dir_body.cmd_addr
        definition mc_body.cmd_data  = dir_body.cmd_data

        # ---- the memory controller's response port drives the directory's ----
        definition dir_body.cmd_ready = mc_body.cmd_ready
        definition dir_body.rsp_valid = mc_body.rsp_valid
        definition dir_body.rsp_addr  = mc_body.rsp_addr
        definition dir_body.rsp_data  = mc_body.rsp_data

        # ---- and the memory-side port on out ----
        definition mem_rd_en   = mc_body.mem_rd_en
        definition mem_rd_addr = mc_body.mem_rd_addr
        definition mem_wr_en   = mc_body.mem_wr_en
        definition mem_wr_addr = mc_body.mem_wr_addr
        definition mem_wr_data = mc_body.mem_wr_data
        definition mc_body.mem_rdata = mem_rdata
    } with this, addr_thy, basis, data_impl
