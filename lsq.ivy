#lang ivy1.8

# ============================================================================
# cache_with_mshr_param.ivy -- the MSHR cache of cache_with_mshr.ivy with the
# two big verification units factored into PARAMETRIZED modules:
#
#     instance simple_cache      : cache_body(trace, user, bus)
#     instance memory_controller : mc_body(trace, bus)
#
# The environment still drives a SINGLE exported clock (env.clock); all
# datapath I/O is RTL-style wires.  What changes is the cache<->memory
# interface: instead of shared wires whose contract is re-proved as inductive
# invariants over havocked state in BOTH isolates (the old if_* / inv_resp_*
# pattern -- which also forced each isolate to `with`-include the other,
# exploding its VCs with the other's transition relation), the interface is
# the `bus` object below: two GHOST CHANNEL ACTIONS (bus.cmd, bus.rresp)
# called inside the after-clock monitors (a ghost action called in a cycle
# happens IN that cycle), carrying `require`s in the tilelink assume-guarantee
# style.  A require is CHECKED at the call site in the isolate containing the
# caller and ASSUMED where the caller's code is erased -- so each obligation
# is discharged exactly once, with the call's concrete arguments.
#
# The contract itself references NOTHING but the trace and the bus's own
# ghost state -- this is what makes the two modules genuinely parametric
# (neither isolate `with`-includes the other, in either direction).  The key
# device is the bus ghost
#
#     mem_tag(H : line, B : bit) : trace.tag
#
# -- for each 256-bit beat of each line, the point on the trace whose memory
# the physical beat currently holds (0 initially: all-zero memory = the trace
# at tag 0).  It is updated by bus.cmd itself on a writeback, to the
# writeback's tag.  This states the correctness of main memory PER BEAT,
# relative to a point on the trace BEFORE any of the not-yet-written-back
# writes have occurred -- so the controller's private memory invariant
# (inv_mm below) mentions no cache state at all (no dirty-line exceptions,
# no commit frontier), and the burden of "mem_tag is still current for a
# CLEAN line" is carried by the cache (inv_memtag), which is the only party
# that knows when writes commit.
# ============================================================================

include numbers
include order

type key
type word
type line
type bit
type bv2
# MSHR coalescing-queue position (0..4 used; a bv so quantifiers stay finite).
type qidx
# cache backing-store index (2-way, 16 slots): 4 bits = concat(key, way).
type cache_idx
type mshr_id
# LSQ store-/load-queue positions (0..2 used; a bv so quantifiers stay finite).
type sqx
type lqx

type two_words
type four_words
individual mzero : four_words

# Pack four words into a beat (W0 in the low position); unp0..3 extract them.
function cat_w(H : word, L : word) : two_words
function cat_d(H : two_words, L : two_words) : four_words
function pack4(W3 : word, W2 : word, W1 : word, W0 : word) : four_words
function unp0(M : four_words) : word
function unp1(M : four_words) : word
function unp2(M : four_words) : word
function unp3(M : four_words) : word

function mem_latency : nat

type addr
type woffset
type way

isolate data_impl = {
    interpret two_words -> bv[128]
    interpret four_words -> bv[256]
    interpret cat_w -> concat
    interpret cat_d -> concat
    definition pack4(W3, W2, W1, W0) = cat_d(cat_w(W3, W2), cat_w(W1, W0))
    definition unp0(M) = bfe[0][63](M)
    definition unp1(M) = bfe[64][127](M)
    definition unp2(M) = bfe[128][191](M)
    definition unp3(M) = bfe[192][255](M)
    definition mzero = 0
}

# ============================================================================
# basis -- the "small-sort theory".  It fixes the small scalar sorts to
# concrete bit-vectors and proves the pack/unpack layout facts (p_unp*) and
# the memory-latency constant.  These used to be plain GLOBAL declarations,
# visible to the two big isolates because they listed the root scope
# (`with this`) in their `with` clause.  Now that those isolates are factored
# into parametrized MODULES (cache_body / mc_body), their `with this` refers
# to the module, not the root, so root-global interpretations no longer reach
# them.  Collecting the interpretations here -- an ordinary isolate the
# modules (and addr_thy) list in their `with` -- restores exactly that
# visibility, while keeping the WIDE sorts (two_words/four_words) hidden
# inside data_impl so clients still reason about pack4/unp0..3 abstractly
# through p_unp*.
# ============================================================================
isolate basis = {
    interpret key -> bv[3]
    interpret word -> bv[64]
    interpret line -> bv[61]
    interpret bit -> bv[1]
    interpret bv2 -> bv[2]
    interpret qidx -> bv[3]
    interpret cache_idx -> bv[4]
    interpret mshr_id -> bv[1]
    interpret sqx -> bv[2]
    interpret lqx -> bv[2]

    property [p_unp0] forall W3 : word, W2 : word, W1 : word, W0 : word. unp0(pack4(W3, W2, W1, W0)) = W0
    property [p_unp1] forall W3 : word, W2 : word, W1 : word, W0 : word. unp1(pack4(W3, W2, W1, W0)) = W1
    property [p_unp2] forall W3 : word, W2 : word, W1 : word, W0 : word. unp2(pack4(W3, W2, W1, W0)) = W2
    property [p_unp3] forall W3 : word, W2 : word, W1 : word, W0 : word. unp3(pack4(W3, W2, W1, W0)) = W3

    definition mem_latency = 8
} with this, data_impl

function concatbv3(H : line, O : woffset) : addr
function high(A : addr) : line
function low(A : addr) : woffset
function concatbv2(B : bit, J : bv2) : woffset
function beat_of(O : woffset) : bit
# the slot index of a (set, way) pair, and the two abstract ways.
function slot(K : key, W : way) : cache_idx
individual w0 : way
individual w1 : way
# the cache set index, hashed from the line address.  Kept ABSTRACT
# (uninterpreted) -- its bit-vector definition is hidden inside addr_thy so
# client VCs never bit-blast the 61-bit line->key extraction.  No proof step
# needs hash's concrete value, only that it is a consistent function (+ the
# slot/key layout facts).
function hash(H : line) : key

# ============================================================================
# addr_thy -- the SINGLE addressing-model isolate.  It fixes the small sorts
# to concrete bit-vectors, proves all layout facts as `property`s, and HIDES
# a bit-vector model of the abstract sort `addr` in its `implementation`
# section so `addr` stays abstract (decidable FAU fragment) in every client
# isolate.  (The old ahigh/waddr beat-addressing helpers are gone: with the
# bus as ghost ACTIONS the beat structure of an address travels through the
# uniform term concatbv3(high(a), concatbv2(beat_of(low(a)), J)) instead of
# through raw response wires, so no second addressing decomposition is
# needed.)
# ============================================================================
isolate addr_thy = {
    interpret woffset -> bv[3]
    interpret way -> bv[1]
    interpret concatbv2 -> concat
    interpret slot -> concat
    definition beat_of(O) = bfe[2][2](O)
    definition w0 = 0
    definition w1 = 1

    property [p_slot_key]   forall K : key, W : way. bfe[1][3](slot(K, W)) = K
    property [p_key_slots]  forall I : cache_idx, K : key. bfe[1][3](I) = K -> (I = slot(K, w0) | I = slot(K, w1))
    property [p_way2]  forall W : way. W = w0 | W = w1
    property [p_way_ne] w0 ~= w1
    property [p_boff_beat]  forall B : bit, J : bv2. beat_of(concatbv2(B, J)) = B
    property [p_cover] forall O : woffset, B : bit. beat_of(O) = B ->
        (O = concatbv2(B, 0) | O = concatbv2(B, 1) | O = concatbv2(B, 2) | O = concatbv2(B, 3))
    property [p_full_inj] forall H1 : line, O1 : woffset, H2 : line, O2 : woffset. (concatbv3(H1, O1) = concatbv3(H2, O2)) -> (H1 = H2 & O1 = O2)
    property [p_highfull] forall H : line, O : woffset. high(concatbv3(H, O)) = H
    property [p_lowfull]  forall H : line, O : woffset. low(concatbv3(H, O)) = O
    # reconstruct a full address from its line/offset split (needed by the
    # LSQ, which splits CPU addresses into high/low for ctrace.step and must
    # recover the original address to match queue entries and responses).
    property [p_recon] forall A : addr. concatbv3(high(A), low(A)) = A

    implementation {
        interpret addr -> bv[64]
        definition high(A) = bfe[3][63](A)
        definition low(A) = bfe[0][2](A)
        interpret concatbv3 -> concat
        # hidden bit-vector model of hash (local to addr_thy; keeps hash
        # abstract for every client isolate).
        definition hash(H) = bfe[0][2](H)
    }
} with this, basis

# ============================================================================
# user -- the CPU-facing ports (parameter of `simple_cache`).  The REQUEST
# wires are assigned by env.clock each edge and havocked after every action.
# The RESPONSE/READY wires are DEFINITION-driven from registered spec state
# of the cache (the c0/c1 pattern of refinement3.ivy): a definition is
# reapplied after every wire havoc, so these outputs stay pinned to their
# registers at EVERY entry point of the cache's isolate -- not just at the
# clock.  (This matters now that bus.rresp is a second, mid-cycle entry: an
# ASSIGNED output wire would be havocked there and any invariant over it
# would be unprovable.)  The invariants over the response port therefore
# live on the registers, not the wires.
# ============================================================================
object user = {
    # user request bus (environment -> cache), driven each posedge by `clock`.
    wire req_en    : bool
    wire req_addr  : addr
    wire req_wen   : bool
    wire req_wdata : word
    # user response bus (cache -> environment): a one-edge valid pulse
    # carrying the address and data of a completed READ.  (Writes complete
    # silently.)  Definition-driven by the cache.
    wire valid     : bool
    wire resp_addr : addr    # named resp_addr (not addr): don't shadow type `addr`
    wire data      : word
    # user ready wire (cache -> environment): high iff the cache will accept
    # a new CPU request THIS edge.  `clock` samples it and invalidates the
    # request wires when it is low.  Definition-driven by the cache.
    wire ready : bool
}

# ============================================================================
# cpu -- the CPU-facing ports of the LOAD-STORE QUEUE (parameter of the LSQ).
# Mirror of `user`, one level up: the environment now drives THESE request
# wires each posedge; the LSQ answers loads on the response wires and gates
# acceptance with `ready`.  The LSQ sits between here and `user` (which is
# now driven by the LSQ, toward the cache).  Response/ready wires are
# DEFINITION-driven from LSQ registers, so they stay pinned at every entry
# point (same discipline as the cache's user outputs).
# ============================================================================
object cpu = {
    # request bus (environment -> LSQ), driven each posedge by `clock`.
    wire req_en    : bool
    wire req_addr  : addr
    wire req_wen   : bool
    wire req_wdata : word
    # response bus (LSQ -> environment): a one-edge valid pulse carrying the
    # address and data of a completed LOAD.  (Stores complete silently.)
    wire valid     : bool
    wire resp_addr : addr
    wire data      : word
    # ready (LSQ -> environment): high iff the LSQ will accept a new CPU
    # request THIS edge.  `clock` samples it and invalidates the request
    # wires when it is low.
    wire ready : bool

    after init {
        req_en    := false;
        req_addr  := 0;
        req_wen   := false;
        req_wdata := 0;
    }
}

# ---- the clocked environment driver: the ONE exported action.  Kept in its
# own object so both parametrized isolates can hook `after env.clock` (and
# list `env` in their `with`) without either having to be parametrized over
# the other's ports. ----
object env = {
    action clock(env_en : bool, env_addr : addr, env_wen : bool, env_wdata : word) = {
        cpu.req_en    := env_en & cpu.ready;
        cpu.req_addr  := env_addr;
        cpu.req_wen   := env_wen;
        cpu.req_wdata := env_wdata;
    }
    export clock
}

# ============================================================================
# The REFERENCE MODEL (reference-tagging style, per the Ivy tutorial in
# doc/examples/hardware/reference_tagging.md).
#
# The cache guarantees COHERENCE, not consistency, so there is NO abstract
# memory in the specification.  The spec is a TRACE of the accepted
# operations, in acceptance order: entry T records the operation's kind
# (st(T).op), its word address, and its datum -- for a write the value
# written; for a read the value RETURNED, recorded by trace.observe at the
# moment the cache responds (op_done marks that it has been).  The
# correctness statement is a pair of invariants over this operation
# sequence alone:
#
#   [coh_lw]  every answered read returns the value of the LAST write to
#             its address preceding it in the trace;
#   [coh_nw]  ... or the initial value 0 if no such write exists.
#
# "The last write" is NAMED BY GHOST RELATIONS derived from the ops alone
# (a skolemized "no write in between" quantifier would leave Ivy's
# decidable fragment, and these invariants travel into every isolate that
# mentions trace state): lwc_r(A, W) tracks the last write to each address
# as the trace grows, each accepted read snapshots it as op_lw_r(R, W),
# and the pure-forall invariants lwc_* / lw_* pin both down declaratively
# (the related W is a write to that address, and no later write to it
# precedes the read).
#
# The per-entry field st(T).mem -- the fold of the writes among entries
# 1..T -- is retained purely as a GHOST PROOF DEVICE (a derived history
# variable): the cache's invariants relate every microarchitectural element
# to it, and lw_memd / lw_memat connect it back to the last-write ghosts,
# from which coh_lw / coh_nw follow locally at each observe.  It is not
# part of the specification.
#
# The trace is advanced (trace.step) exactly when the cache ACCEPTS a new
# operation from the user; the accepted operation is thereby associated
# with a tag -- its index in the trace.  (A set-conflict miss is DROPPED,
# i.e. NOT accepted: it is never serviced, produces no response, and does
# not advance the trace.)
# ============================================================================
type op_kind = {op_read, op_write}

isolate trace = {
    specification {
        instance tag : unbounded_sequence

        # one trace entry: the operation itself, plus (GHOST) the folded
        # memory after it and the last-write snapshot of a read.
        type state_t = struct {
            mem(A : addr) : word,   # GHOST: fold of the writes (proof device)
            op      : op_kind,
            op_addr : addr,
            op_data : word,         # write: value written; read: value returned
            op_done : bool,         # a read has been answered (op_data valid)
            op_lwd  : word          # GHOST (reads): datum of the last write to
                                    # op_addr before this read (0 if none)
        }

        var now : tag               # length of the trace so far
        var st(T : tag) : state_t   # the recorded states

        # ---- ghost last-write bookkeeping, derived from the ops alone ----
        # W is the tag of the last write to A in the trace SO FAR (0: none)
        relation lwc_r(A : addr, W : tag)
        # ... and that write's datum (0 if none)
        function lwd(A : addr) : word
        # W is the tag of the last write to read R's address BEFORE R
        # (0: none) -- R's acceptance-time snapshot of lwc_r
        relation op_lw_r(R : tag, W : tag)

        after init {
            now := 0;
            st(T).mem(A : addr) := 0;
            st(T).op      := op_read;
            st(T).op_addr := 0;
            st(T).op_data := 0;
            st(T).op_done := false;
            st(T).op_lwd  := 0;
            lwc_r(A, W)   := W = 0;
            lwd(A)        := 0;
            op_lw_r(R, W) := W = 0;
        }

        # ghost action, called by the cache when it accepts an operation on
        # word address (h, o).  A write is complete at acceptance (its datum
        # is its own) and becomes the last write to its address; a read
        # snapshots the last write to ITS address (op_lw_r / op_lwd) and has
        # its op_data recorded later, by observe.
        action step(h : line, o : woffset, wen : bool, wd : word) = {
            var prev : tag := now;
            now := now.next;
            st(now).mem(A : addr) := st(prev).mem(A);
            st(now).op_addr := concatbv3(h, o);
            st(now).op_done := wen;
            if wen {
                st(now).op      := op_write;
                st(now).op_data := wd;
                st(now).op_lwd  := 0;
                st(now).mem(concatbv3(h, o)) := wd;
                lwc_r(concatbv3(h, o), W) := W = now;
                lwd(concatbv3(h, o)) := wd;
            } else {
                st(now).op      := op_read;
                st(now).op_data := 0;
                st(now).op_lwd  := lwd(concatbv3(h, o));
                op_lw_r(now, W) := lwc_r(concatbv3(h, o), W);
            };
        }

        # ghost action, called by the cache at the moment it RESPONDS to the
        # read accepted at trace position t: records the returned value in
        # the trace.  The CALLER proves the value equals the read's
        # PRE-state memory at its address (a read's entry carries its
        # predecessor's memory unchanged); coherence over the operation
        # sequence then follows locally here, via lw_memat / lw_is_wr.
        action observe(t : tag, v : word) = {
            require t ~= 0 & t <= now;
            require st(t).op = op_read & ~st(t).op_done;
            require v = st(t).mem(st(t).op_addr);
            st(t).op_data := v;
            st(t).op_done := true;
        }

        # ---- ghost-memory bookkeeping (proof devices, not the spec) ----
        # consecutive recorded entries are related by one fold step
        invariant [tr_step] (tag.succ(T,U) & U <= now) ->
            st(U).mem(A) = (st(U).op_data if (st(U).op = op_write & A = st(U).op_addr) else st(T).mem(A))
        # the top of the fold is the last-write datum at every address ...
        invariant [lw_memd] st(now).mem(A) = lwd(A)
        # ... and a read's own entry holds its last-write datum at its
        # address (this is what turns observe's require into coh_val)
        invariant [lw_memat] (R <= now & st(R).op = op_read) ->
            st(R).mem(st(R).op_addr) = st(R).op_lwd

        # ---- lwc_r really is "the last write so far": a related W ~= 0 is
        # a write to A ... ----
        invariant [lwc_wr] (lwc_r(A,W) & W ~= 0) ->
            (W <= now & st(W).op = op_write & st(W).op_addr = A)
        # ... no LATER write to A exists ...
        invariant [lwc_latest] (lwc_r(A,W) & W < V & V <= now & st(V).op = op_write) ->
            st(V).op_addr ~= A
        # ... W = 0 means NO write to A exists at all ...
        invariant [lwc_none] (lwc_r(A,0) & V <= now & st(V).op = op_write) ->
            st(V).op_addr ~= A
        # ... lwd carries exactly the related write's datum, and each
        # address relates to exactly one W ----
        invariant [lwc_datum] (lwc_r(A,W) & W ~= 0) -> st(W).op_data = lwd(A)
        invariant [lwc_datum0] lwc_r(A,0) -> lwd(A) = 0
        invariant [lwc_fun] (lwc_r(A,W1) & lwc_r(A,W2)) -> W1 = W2

        # ---- op_lw_r really is "the last write BEFORE read R": a related
        # W ~= 0 is an earlier write to R's address holding R's op_lwd ... ----
        invariant [lw_is_wr] (op_lw_r(R,W) & R <= now & st(R).op = op_read & W ~= 0) ->
            (W < R & st(W).op = op_write & st(W).op_addr = st(R).op_addr
             & st(W).op_data = st(R).op_lwd)
        # ... no write to R's address lies strictly between W and R ...
        invariant [lw_latest] (op_lw_r(R,W) & R <= now & st(R).op = op_read
             & W < V & V < R & st(V).op = op_write) ->
            st(V).op_addr ~= st(R).op_addr
        # ... W = 0 means NO write to R's address precedes R ...
        invariant [lw_none] (op_lw_r(R,0) & R <= now & st(R).op = op_read
             & V < R & st(V).op = op_write) ->
            st(V).op_addr ~= st(R).op_addr
        invariant [lw_zero] (op_lw_r(R,0) & R <= now & st(R).op = op_read) ->
            st(R).op_lwd = 0
        invariant [lw_fun] (op_lw_r(R,W1) & op_lw_r(R,W2) & R <= now & st(R).op = op_read) ->
            W1 = W2

        # ================ the SPECIFICATION: coherence ================
        # every answered read returned its last-write snapshot ...
        invariant [coh_val] (R <= now & st(R).op = op_read & st(R).op_done) ->
            st(R).op_data = st(R).op_lwd
        # ... i.e. the value of the LAST write to its address before it in
        # the trace (per lw_is_wr / lw_latest, W below is exactly that) ...
        invariant [coh_lw] (op_lw_r(R,W) & W ~= 0
             & R <= now & st(R).op = op_read & st(R).op_done) ->
            st(R).op_data = st(W).op_data
        # ... or 0 if no write to its address precedes it (per lw_none)
        invariant [coh_nw] (op_lw_r(R,0)
             & R <= now & st(R).op = op_read & st(R).op_done) ->
            st(R).op_data = 0
    }
} with this

# ============================================================================
# memtrace -- the reference model as a REUSABLE (parametrized) module, so the
# same reference-tagging machinery serves two DIFFERENT orders:
#
#   instance trace  : ... (inline above)  -- COHERENCE, in cache-ACCEPTANCE order
#   instance ctrace : memtrace            -- CONSISTENCY, in program (dispatch) order
#
# Both record a sequence of memory operations with a folded single memory
# st(T).mem : addr -> word and prove the SAME theorem over that sequence:
# every answered read returns the value of the last write to its address
# preceding it (coh_val / coh_lw / coh_nw).  Fed in ACCEPTANCE order this is
# coherence (what the cache guarantees); fed in PROGRAM order it is
# single-processor CONSISTENCY -- i.e. the whole subsystem, seen at the CPU
# port, behaves as ONE uncached memory you read and write in program order.
# The LSQ is the only party that advances ctrace (at CPU dispatch); it
# discharges ctrace's theorem via ctrace.observe at each load it answers.
# ============================================================================
module memtrace = {
    specification {
        instance tag : unbounded_sequence

        # one trace entry: the operation itself, plus (GHOST) the folded
        # memory after it and the last-write snapshot of a read.
        type state_t = struct {
            mem(A : addr) : word,   # GHOST: fold of the writes (proof device)
            op      : op_kind,
            op_addr : addr,
            op_data : word,         # write: value written; read: value returned
            op_done : bool,         # a read has been answered (op_data valid)
            op_lwd  : word          # GHOST (reads): datum of the last write to
                                    # op_addr before this read (0 if none)
        }

        var now : tag               # length of the trace so far
        var st(T : tag) : state_t   # the recorded states

        # ---- ghost last-write bookkeeping, derived from the ops alone ----
        # W is the tag of the last write to A in the trace SO FAR (0: none)
        relation lwc_r(A : addr, W : tag)
        # ... and that write's datum (0 if none)
        function lwd(A : addr) : word
        # W is the tag of the last write to read R's address BEFORE R
        # (0: none) -- R's acceptance-time snapshot of lwc_r
        relation op_lw_r(R : tag, W : tag)

        after init {
            now := 0;
            st(T).mem(A : addr) := 0;
            st(T).op      := op_read;
            st(T).op_addr := 0;
            st(T).op_data := 0;
            st(T).op_done := false;
            st(T).op_lwd  := 0;
            lwc_r(A, W)   := W = 0;
            lwd(A)        := 0;
            op_lw_r(R, W) := W = 0;
        }

        # ghost action, called by the cache when it accepts an operation on
        # word address (h, o).  A write is complete at acceptance (its datum
        # is its own) and becomes the last write to its address; a read
        # snapshots the last write to ITS address (op_lw_r / op_lwd) and has
        # its op_data recorded later, by observe.
        action step(h : line, o : woffset, wen : bool, wd : word) = {
            var prev : tag := now;
            now := now.next;
            st(now).mem(A : addr) := st(prev).mem(A);
            st(now).op_addr := concatbv3(h, o);
            st(now).op_done := wen;
            if wen {
                st(now).op      := op_write;
                st(now).op_data := wd;
                st(now).op_lwd  := 0;
                st(now).mem(concatbv3(h, o)) := wd;
                lwc_r(concatbv3(h, o), W) := W = now;
                lwd(concatbv3(h, o)) := wd;
            } else {
                st(now).op      := op_read;
                st(now).op_data := 0;
                st(now).op_lwd  := lwd(concatbv3(h, o));
                op_lw_r(now, W) := lwc_r(concatbv3(h, o), W);
            };
        }

        # ghost action, called by the cache at the moment it RESPONDS to the
        # read accepted at trace position t: records the returned value in
        # the trace.  The CALLER proves the value equals the read's
        # PRE-state memory at its address (a read's entry carries its
        # predecessor's memory unchanged); coherence over the operation
        # sequence then follows locally here, via lw_memat / lw_is_wr.
        action observe(t : tag, v : word) = {
            require t ~= 0 & t <= now;
            require st(t).op = op_read & ~st(t).op_done;
            require v = st(t).mem(st(t).op_addr);
            st(t).op_data := v;
            st(t).op_done := true;
        }

        # the top of the fold is the last-write datum at every address ...
        invariant [lw_memd] st(now).mem(A) = lwd(A)
        # ... and a read's own entry holds its last-write datum at its
        # address (this is what turns observe's require into coh_val)
        invariant [lw_memat] (R <= now & st(R).op = op_read) ->
            st(R).mem(st(R).op_addr) = st(R).op_lwd
    }
    implementation {
        # ---- ghost-memory bookkeeping (proof devices) and the CONSISTENCY
        # THEOREM.  All PRIVATE to memtrace: proven here but NOT exported, so a
        # client that lists ctrace in its `with` (the LSQ) sees only the lean
        # fold facts lw_memd / lw_memat above, not these heavy quantified
        # invariants -- which is what keeps the client's VCs tractable.  The
        # coherence spec coh_val / coh_lw / coh_nw is proven here regardless. ----
        # consecutive recorded entries are related by one fold step
        invariant [tr_step] (tag.succ(T,U) & U <= now) ->
            st(U).mem(A) = (st(U).op_data if (st(U).op = op_write & A = st(U).op_addr) else st(T).mem(A))

        # ---- lwc_r really is "the last write so far": a related W ~= 0 is
        # a write to A ... ----
        invariant [lwc_wr] (lwc_r(A,W) & W ~= 0) ->
            (W <= now & st(W).op = op_write & st(W).op_addr = A)
        # ... no LATER write to A exists ...
        invariant [lwc_latest] (lwc_r(A,W) & W < V & V <= now & st(V).op = op_write) ->
            st(V).op_addr ~= A
        # ... W = 0 means NO write to A exists at all ...
        invariant [lwc_none] (lwc_r(A,0) & V <= now & st(V).op = op_write) ->
            st(V).op_addr ~= A
        # ... lwd carries exactly the related write's datum, and each
        # address relates to exactly one W ----
        invariant [lwc_datum] (lwc_r(A,W) & W ~= 0) -> st(W).op_data = lwd(A)
        invariant [lwc_datum0] lwc_r(A,0) -> lwd(A) = 0
        invariant [lwc_fun] (lwc_r(A,W1) & lwc_r(A,W2)) -> W1 = W2

        # ---- op_lw_r really is "the last write BEFORE read R": a related
        # W ~= 0 is an earlier write to R's address holding R's op_lwd ... ----
        invariant [lw_is_wr] (op_lw_r(R,W) & R <= now & st(R).op = op_read & W ~= 0) ->
            (W < R & st(W).op = op_write & st(W).op_addr = st(R).op_addr
             & st(W).op_data = st(R).op_lwd)
        # ... no write to R's address lies strictly between W and R ...
        invariant [lw_latest] (op_lw_r(R,W) & R <= now & st(R).op = op_read
             & W < V & V < R & st(V).op = op_write) ->
            st(V).op_addr ~= st(R).op_addr
        # ... W = 0 means NO write to R's address precedes R ...
        invariant [lw_none] (op_lw_r(R,0) & R <= now & st(R).op = op_read
             & V < R & st(V).op = op_write) ->
            st(V).op_addr ~= st(R).op_addr
        invariant [lw_zero] (op_lw_r(R,0) & R <= now & st(R).op = op_read) ->
            st(R).op_lwd = 0
        invariant [lw_fun] (op_lw_r(R,W1) & op_lw_r(R,W2) & R <= now & st(R).op = op_read) ->
            W1 = W2

        # ================ the SPECIFICATION: coherence ================
        # every answered read returned its last-write snapshot ...
        invariant [coh_val] (R <= now & st(R).op = op_read & st(R).op_done) ->
            st(R).op_data = st(R).op_lwd
        # ... i.e. the value of the LAST write to its address before it in
        # the trace (per lw_is_wr / lw_latest, W below is exactly that) ...
        invariant [coh_lw] (op_lw_r(R,W) & W ~= 0
             & R <= now & st(R).op = op_read & st(R).op_done) ->
            st(R).op_data = st(W).op_data
        # ... or 0 if no write to its address precedes it (per lw_none)
        invariant [coh_nw] (op_lw_r(R,0)
             & R <= now & st(R).op = op_read & st(R).op_done) ->
            st(R).op_data = 0
    }
    isolate iso = this with this
}
# The CONSISTENCY reference: the single uncached memory, in program order.
instance ctrace : memtrace

# ============================================================================
# lsq_body -- the LOAD-STORE QUEUE, a PARAMETRIZED module over the
# consistency reference `ctrace`, the CPU-facing ports `cpu`, and the
# cache-facing ports `user`.  Instantiated once below as `the_lsq`.
#
# The LSQ is the ONLY part of the memory subsystem that maintains memory
# CONSISTENCY: at the `cpu` port the whole subsystem behaves as ONE uncached
# memory (a function addr -> word) accessed in program order.  It keeps
# SEPARATE load and store buffers and does store-to-load forwarding.
# Everything below (cache + memory controller) maintains COHERENCE; the LSQ
# treats that layer abstractly as a coherent backing memory `dmem` -- the
# "abstract function from addresses to words" the cache implements -- and
# replays every drained store onto the real `user` cache port, so the
# coherent cache runs underneath in lockstep on the write stream.
#
# Reference tagging: each queue entry carries its index into `ctrace` (its
# program position); a local invariant relates the entry -- and the backing
# memory -- to `ctrace` at that index.  Each load answered (by a forward or
# by a memory read) discharges ctrace.observe, which is what proves the
# consistency theorem coh_val / coh_lw / coh_nw over the program order.
#
# DISCIPLINE (single-processor consistency):
#   * in-order DISPATCH: CPU ops enter the queues in program order (ctrace
#     steps once per accepted op);
#   * out-of-order COMPLETION: a load forwards from the youngest older store
#     to its address in the store queue, else reads the backing memory;
#   * in-order-commit DRAIN: stores drain to memory in program order (the
#     store queue is FIFO) and a store is held from draining while any OLDER
#     load has not yet read memory -- so a younger store can never overwrite
#     the value an older load must observe (the one hazard a single-processor
#     LSQ has to rule out).
# ============================================================================
module lsq_body(ctrace, cpu, user) = {

    # ---- the abstract coherent backing memory: the single function
    # addr -> word the cache+MC coherently implement.  A store reaches it by
    # DRAINING (in program order); a load that misses the store queue reads
    # it.  This is the memory the whole subsystem refines. ----
    function dmem(A : addr) : word

    # ---- STORE QUEUE (FIFO): stores accepted from the CPU but not yet
    # drained, oldest (sq_head) to newest (sq_next - 1). ----
    function sq_addr(K : sqx) : addr
    function sq_data(K : sqx) : word
    function sq_ctag(K : sqx) : ctrace.tag        # GHOST: its program position
    var sq_head : sqx
    var sq_next : sqx

    # ---- LOAD QUEUE (FIFO): loads that missed the store queue and are
    # waiting to read the backing memory, oldest (lq_head) to newest. ----
    function lq_addr(K : lqx) : addr
    function lq_ctag(K : lqx) : ctrace.tag        # GHOST: its program position
    var lq_head : lqx
    var lq_next : lqx

    # ---- registered CPU-side outputs (drive cpu.* through definitions) ----
    var cpu_valid_r : bool
    var cpu_addr_r  : addr
    var cpu_data_r  : word
    var cpu_tag_r   : ctrace.tag                  # GHOST: the answered op
    var cpu_ready_r : bool

    # ---- registered cache-side request (drives user.req_* through
    # definitions): the write stream replayed onto the coherent cache. ----
    var ureq_en_r   : bool
    var ureq_addr_r : addr
    var ureq_wen_r  : bool
    var ureq_data_r : word

    # ---- transient per-edge guard: the single CPU response port ----
    var port_used : bool

    after init {
        dmem(A) := 0;
        sq_addr(K) := 0; sq_data(K) := 0; sq_ctag(K) := 0;
        sq_head := 0; sq_next := 0;
        lq_addr(K) := 0; lq_ctag(K) := 0;
        lq_head := 0; lq_next := 0;
        cpu_valid_r := false; cpu_addr_r := 0; cpu_data_r := 0;
        cpu_tag_r := 0; cpu_ready_r := true;
        ureq_en_r := false; ureq_addr_r := 0; ureq_wen_r := false; ureq_data_r := 0;
        port_used := false;
    }

    # ---- queue occupancy / fullness ----
    relation sq_pend(K : sqx)
    definition sq_pend(K) = sq_head <= K & K < sq_next
    relation lq_pend(K : lqx)
    definition lq_pend(K) = lq_head <= K & K < lq_next
    relation sq_full
    definition sq_full = sq_next = 2
    relation lq_full
    definition lq_full = lq_next = 2

    # ---- drive the ports combinationally from the registers ----
    definition cpu.valid      = cpu_valid_r
    definition cpu.resp_addr  = cpu_addr_r
    definition cpu.data       = cpu_data_r
    definition cpu.ready      = cpu_ready_r
    definition user.req_en    = ureq_en_r
    definition user.req_addr  = ureq_addr_r
    definition user.req_wen   = ureq_wen_r
    definition user.req_wdata = ureq_data_r

    # ---- "an OLDER load (smaller program tag) than store-tag C is still
    # pending" -- the load queue is FIFO in program order, so the oldest
    # pending load sits at lq_head. ----
    relation older_load_than(C : ctrace.tag)
    definition older_load_than(C) = lq_head < lq_next & lq_ctag(lq_head) < C

    # ========================================================================
    # the clocked datapath.
    # ========================================================================
    after env.clock(env_en : bool, env_addr : addr, env_wen : bool, env_wdata : word) {
        port_used   := false;
        cpu_valid_r := false; cpu_addr_r := 0; cpu_data_r := 0; cpu_tag_r := 0;
        ureq_en_r   := false; ureq_addr_r := 0; ureq_wen_r := false; ureq_data_r := 0;

        # reset an empty FIFO to 0 so the non-wrapping buffer can be reused.
        if sq_head = sq_next { sq_head := 0; sq_next := 0; };
        if lq_head = lq_next { lq_head := 0; lq_next := 0; };

        # ===== STEP A: drain the oldest store to memory (program order) =====
        # Held while an OLDER load has not read memory (in-order commit): a
        # younger store must not overwrite what an older load will observe.
        if sq_head < sq_next {
            var h : sqx := sq_head;
            if ~older_load_than(sq_ctag(h)) {
                dmem(sq_addr(h)) := sq_data(h);
                ureq_en_r := true; ureq_wen_r := true;
                ureq_addr_r := sq_addr(h); ureq_data_r := sq_data(h);
                sq_head := h + 1;
            };
        };

        # ===== STEP B: accept a new CPU request (dispatch, program order) ====
        if cpu.req_en {
            var ra : addr := cpu.req_addr;
            ctrace.step(high(ra), low(ra), cpu.req_wen, cpu.req_wdata);
            if cpu.req_wen {
                # STORE: append to the store queue.
                sq_addr(sq_next) := ra;
                sq_data(sq_next) := cpu.req_wdata;
                sq_ctag(sq_next) := ctrace.now;
                sq_next := sq_next + 1;
            } else {
                # LOAD: forward the YOUNGEST older store to ra in the store
                # queue (every queued store is older than this load, so the
                # youngest is the last write to ra so far); else enqueue.
                var fwd   : bool := false;
                var fdata : word := 0;
                if sq_pend(1) & sq_addr(1) = ra { fwd := true; fdata := sq_data(1); }
                else { if sq_pend(0) & sq_addr(0) = ra { fwd := true; fdata := sq_data(0); } };
                if fwd {
                    cpu_valid_r := true; cpu_addr_r := ra; cpu_data_r := fdata;
                    cpu_tag_r := ctrace.now;
                    ctrace.observe(ctrace.now, fdata);
                    port_used := true;
                } else {
                    lq_addr(lq_next) := ra;
                    lq_ctag(lq_next) := ctrace.now;
                    lq_next := lq_next + 1;
                };
            };
        };

        # ===== STEP C: service the oldest pending load from memory =====
        # It missed the store queue, so every older store to its address has
        # already drained and (in-order commit) no younger store has drained
        # ahead of it: dmem holds exactly its program-order value.
        if lq_head < lq_next & ~port_used {
            var k : lqx := lq_head;
            cpu_valid_r := true; cpu_addr_r := lq_addr(k); cpu_data_r := dmem(lq_addr(k));
            cpu_tag_r := lq_ctag(k);
            ctrace.observe(lq_ctag(k), dmem(lq_addr(k)));
            if ~ureq_en_r { ureq_en_r := true; ureq_wen_r := false; ureq_addr_r := lq_addr(k); };
            port_used := true;
            lq_head := k + 1;
        };

        # ===== STEP D: readiness -- accept only when neither buffer is full ==
        cpu_ready_r := ~sq_full & ~lq_full;
    }

    # ========================================================================
    # Reference-tagging invariants.  All are PRIVATE to this isolate and refer
    # only to ctrace and the LSQ's own state (never the cache) -- the LSQ's
    # consistency proof is decoupled from the coherence layer below.
    # ========================================================================

    # ---- (1) structural: FIFO pointer discipline ----
    invariant [sq_bound] sq_head <= sq_next & sq_next <= 2
    invariant [lq_bound] lq_head <= lq_next & lq_next <= 2
    # the registered ready output means exactly "neither buffer is full", so
    # a dispatch (cpu.req_en, gated by cpu.ready) cannot overflow a buffer.
    invariant [inv_ready] cpu_ready_r = (~sq_full & ~lq_full)

    # ---- (2) tags: each buffered store is its ctrace WRITE entry ----
    invariant [sq_tag] sq_pend(K) -> (sq_ctag(K) ~= 0 & sq_ctag(K) <= ctrace.now)
    invariant [sq_is_wr] sq_pend(K) ->
        (ctrace.st(sq_ctag(K)).op = op_write
         & ctrace.st(sq_ctag(K)).op_addr = sq_addr(K)
         & ctrace.st(sq_ctag(K)).op_data = sq_data(K))
    invariant [sq_mono] (sq_pend(K1) & sq_pend(K2) & K1 < K2) -> sq_ctag(K1) < sq_ctag(K2)

    # ---- each queued load is its ctrace READ entry, still unanswered ----
    invariant [lq_tag] lq_pend(K) -> (lq_ctag(K) ~= 0 & lq_ctag(K) <= ctrace.now)
    invariant [lq_is_rd] lq_pend(K) ->
        (ctrace.st(lq_ctag(K)).op = op_read
         & ~ctrace.st(lq_ctag(K)).op_done
         & ctrace.st(lq_ctag(K)).op_addr = lq_addr(K))
    invariant [lq_mono] (lq_pend(K1) & lq_pend(K2) & K1 < K2) -> lq_ctag(K1) < lq_ctag(K2)

    # ---- (3) the BRIDGE between program memory (ctrace) and backing memory
    # (dmem), patched by the store queue.  No quantified address is matched
    # against a quantified queue index (that leaves FAU): the "no buffered
    # store to A" case ENUMERATES the two store slots; the "youngest buffered
    # store to A" case is per-slot with the address only a function argument.
    #   * no buffered store to A            =>  dmem holds A's last write;
    #   * the youngest buffered store to A  =>  its datum is A's last write.
    invariant [br_mem] forall A : addr.
        (~(sq_pend(0) & sq_addr(0) = A) & ~(sq_pend(1) & sq_addr(1) = A))
        -> dmem(A) = ctrace.lwd(A)
    invariant [br_fwd] forall K : sqx.
        (sq_pend(K)
         & (forall K2 : sqx. (sq_pend(K2) & sq_addr(K2) = sq_addr(K)) -> K2 <= K))
        -> sq_data(K) = ctrace.lwd(sq_addr(K))

    # ---- any buffered store to a PENDING load's address is YOUNGER than the
    # load (the load missed forwarding at dispatch, so no older store to its
    # address remained buffered): this keeps dmem stable at the load's
    # address until it is serviced. ----
    invariant [lq_nofwd] (lq_pend(K) & sq_pend(J) & sq_addr(J) = lq_addr(K)) ->
        lq_ctag(K) < sq_ctag(J)

    # ---- THE per-load tag invariant: the backing memory at a pending load's
    # address equals ctrace's memory at the load's own entry (its pre-state,
    # the last write to its address before it).  This discharges
    # ctrace.observe when the load is serviced from memory. ----
    invariant [lq_val] lq_pend(K) ->
        dmem(lq_addr(K)) = ctrace.st(lq_ctag(K)).mem(lq_addr(K))

    # ---- (4) the response port ties back to ctrace: a valid CPU response is
    # an answered read whose recorded datum/address are the wires. ----
    invariant [cpu_done] cpu_valid_r ->
        (cpu_tag_r ~= 0 & cpu_tag_r <= ctrace.now
         & ctrace.st(cpu_tag_r).op = op_read & ctrace.st(cpu_tag_r).op_done
         & ctrace.st(cpu_tag_r).op_data = cpu_data_r
         & ctrace.st(cpu_tag_r).op_addr = cpu_addr_r)

    isolate iso = this with this, ctrace, cpu, user, env, addr_thy, basis
}
# The load-store queue, parametrized over the consistency reference, the CPU
# ports, and the cache (user) ports.
instance the_lsq : lsq_body(ctrace, cpu, user)


# ============================================================================
# bus -- the cache<->memory INTERFACE (parameter of both `simple_cache` and
# `memory_controller`).  Declared after `trace` because its contract speaks
# about the trace.
#
# The channels are GHOST ACTIONS in the tilelink assume-guarantee style,
# called inside the after-clock monitors (so a transfer happens IN the cycle
# of the call):
#
#   cmd(wen, a, d, tg) -- one beat command, cache -> controller.  wen: victim
#       writeback (d = the beat data, correct for the trace at tg) vs. fetch
#       read (d = mzero, tg irrelevant).  Its requires are the cache's
#       obligations (checked at the cache's call sites, assumed by the
#       controller's latch); its BODY -- visible to both sides -- advances
#       the ghost beat version mem_tag on a writeback.
#
#   rresp(a, d)        -- read response, controller -> cache.  Its require
#       is the controller's guarantee (checked at the controller's resolve,
#       assumed by the cache's capture monitor): the four words of beat `a`
#       equal the trace memory at mem_tag(high(a), beat_of(low(a))).
#
# Note what the contract does NOT mention: the cache's commit frontier, the
# MSHR file, the controller's buffer.  Both sides prove their half against
# the trace and mem_tag alone -- that is what lets the two modules be
# parametrized with no reference to one another.
# ============================================================================
object bus = {
    # flow control (memory_controller -> cache): high iff the controller will
    # accept a command THIS edge.  DEFINITION-driven from the controller's
    # private command buffer; havocked in isolates that cannot see that.
    wire ready : bool

    # ---- GHOST: per-beat memory version.  mem_tag(H, B) is the point on the
    # trace whose memory the physical beat B of line H currently holds; a
    # beat is only ever written by a writeback command, whose tag becomes the
    # beat's new version.  All-zero initial memory = the trace at tag 0. ----
    function mem_tag(H : line, B : bit) : trace.tag

    after init {
        mem_tag(H, B) := 0;
    }

    # command channel (cache -> memory_controller): one beat command per call.
    action cmd(wen : bool, a : addr, d : four_words, tg : trace.tag) = {
        # flow control: a command is only issued when the controller's
        # buffer is free (the cache's arbiter gates on the ready wire).
        require ready;
        # the version a command installs names a RECORDED trace entry
        # (trace.step must never be able to clobber it).
        require tg <= trace.now;
        # a WRITE command (victim writeback) ships the trace at its tag,
        # at the four word addresses of its beat.
        require wen ->
            ( unp0(d) = trace.st(tg).mem(concatbv3(high(a), concatbv2(beat_of(low(a)), 0)))
            & unp1(d) = trace.st(tg).mem(concatbv3(high(a), concatbv2(beat_of(low(a)), 1)))
            & unp2(d) = trace.st(tg).mem(concatbv3(high(a), concatbv2(beat_of(low(a)), 2)))
            & unp3(d) = trace.st(tg).mem(concatbv3(high(a), concatbv2(beat_of(low(a)), 3))) );
        # a writeback advances the beat's ghost version to its tag.
        if wen {
            mem_tag(high(a), beat_of(low(a))) := tg;
        };
    }

    # read-response channel (memory_controller -> cache): the four words of
    # beat `a`, correct for the beat's ghost version.  (Write resolves are
    # pure acks -- the controller signals nothing; the cache observes only
    # `ready` going high again.)
    action rresp(a : addr, d : four_words) = {
        require unp0(d) = trace.st(mem_tag(high(a), beat_of(low(a)))).mem(concatbv3(high(a), concatbv2(beat_of(low(a)), 0)))
              & unp1(d) = trace.st(mem_tag(high(a), beat_of(low(a)))).mem(concatbv3(high(a), concatbv2(beat_of(low(a)), 1)))
              & unp2(d) = trace.st(mem_tag(high(a), beat_of(low(a)))).mem(concatbv3(high(a), concatbv2(beat_of(low(a)), 2)))
              & unp3(d) = trace.st(mem_tag(high(a), beat_of(low(a)))).mem(concatbv3(high(a), concatbv2(beat_of(low(a)), 3)));
    }
}

# ============================================================================
# MSHR data structures.
#
# There are TWO MSHRs (mshr_id = bv[1]) so two line misses can be outstanding
# concurrently, which is what creates the interesting bus-arbitration conflict
# (an eviction writeback from one MSHR vs. a fetch read from the other).
#
# Macro-states (exactly the five from mshr.md):
#   mshr_idle            -- free
#   mshr_req_lower       -- lower 256-bit beat requested, awaiting its response
#   mshr_finished_lower  -- lower beat captured, upper beat not yet issued
#   mshr_req_upper       -- upper beat requested, awaiting its response
#   mshr_drain           -- both beats captured; servicing the queued requests
#                           IN ORDER, then (victim chosen HERE, at the last
#                           moment) any eviction writeback, then the fill.
#
# The drain macro-state has an internal sub-phase (m_dphase) because the
# writeback needs the bus for two beats and the whole eviction must be
# race-free w.r.t. the victim line:
#   dp_resp   -- servicing the queued requests in FIFO order
#   dp_wb_lo  -- issuing the victim writeback lower beat  (bus)
#   dp_wb_hi  -- issuing the victim writeback upper beat  (bus)
#   dp_fill   -- writing the fetched line into the victim slot
#
# The coalescing queue is a FIFO: rq_head is the next entry to service,
# rq_next the next free entry.  Entries are serviced strictly in ACCEPTANCE
# ORDER -- this is what guarantees a queued read can never observe a write
# accepted after it.  Requests coalescing onto a DRAINING owner also simply
# enqueue (an immediate-serve fast path for a write would commit it into the
# fill buffer ahead of older queued reads of the same line -- a real
# memory-ordering violation under the per-operation trace spec).
# rq_next never wraps: an MSHR accepts at most 4 operations per residency
# episode (then reports full), which keeps the FIFO order argument trivial.
# ============================================================================
type mshr_state = { mshr_idle, mshr_req_lower, mshr_finished_lower, mshr_req_upper, mshr_drain }
type dphase = { dp_resp, dp_wb_lo, dp_wb_hi, dp_fill }

# One queued request.  rq_off is the offset from the line base.
type mshr_req = struct {
    rq_off   : woffset,
    rq_wen   : bool,
    rq_wdata : word
}

type cache_entry = struct {
    occupied : bool,
    dirty    : bool,
    tag      : line,
    lru      : bit,          # 2-way LRU is one bit (0/1); avoids integer theory
    val(O : woffset) : word
}

# ============================================================================
# cache_body -- the cache, parametrized over the trace, the user ports and
# the memory bus.  Instantiated once below as `simple_cache`.  Note the
# isolate's `with` clause: the memory controller is NOT included -- the
# interface contract on `bus` replaces the old wire-level inv_resp_*
# assumptions, so the cache's VCs contain neither the controller's transition
# relation nor its private invariants.
# ============================================================================
module cache_body(trace, user, bus) = {
    specification {}
        function cache(I : cache_idx) : cache_entry

        # ---- MSHR file (family of functions indexed by mshr_id) ----
        function m_state(Id : mshr_id)          : mshr_state
        function m_base(Id : mshr_id)           : line
        function m_q(Id : mshr_id, K : qidx)    : mshr_req   # coalescing FIFO
        function rq_head(Id : mshr_id)          : qidx       # next entry to service
        function rq_next(Id : mshr_id)          : qidx       # next free entry
        function rq_haswr(Id : mshr_id)         : bool       # a queued WRITE is pending
        function m_fbuf(Id : mshr_id, O : woffset) : word    # fetched line data
        function m_dirty(Id : mshr_id)          : bool       # line will be dirty on fill
        function m_dphase(Id : mshr_id)         : dphase     # drain sub-phase
        function m_victim_way(Id : mshr_id)     : way        # chosen at end of drain
        # the victim as a DIRECT slot index (= slot(hash(m_base), m_victim_way)).
        function m_victim_slot(Id : mshr_id)    : cache_idx

        # ---- ghost reference tags ----
        # tag of the operation queued at position K of MSHR Id.
        function rq_tag(Id : mshr_id, K : qidx) : trace.tag
        # trace position of the last COMMITTED operation: st(commit_tag).mem is
        # the memory with exactly the committed writes applied.  It equals
        # trace.now except while an accepted write sits unserviced in an MSHR
        # queue (queued writes commit at drain service; everything else commits
        # at acceptance).  At most ONE accepted write can be uncommitted at any
        # time: a queued write makes its MSHR full, which drops user.ready,
        # blocking ALL further accepts until it commits.
        var commit_tag : trace.tag
        # tag of the operation the current user response answers.
        var user_tag : trace.tag

        # ---- registered user-side outputs.  The user response/ready WIRES
        # are definition-driven from these (below), so they stay pinned at
        # every entry point; invariants (inv_ready, ref_done) are stated
        # over the registers. ----
        var ready_r     : bool
        var valid_r     : bool
        var resp_addr_r : addr
        var data_r      : word

        # ---- transient per-cycle arbitration guard (reset each edge) ----
        var port_used : bool   # user response port taken this edge

        after init {
            occupied(cache(I)) := false;
            dirty(cache(I)) := false;
            tag(cache(I)) := 0;
            lru(cache(I)) := 0;
            val(cache(I), O) := 0;
            m_state(Id)  := mshr_idle;
            m_base(Id)   := 0;
            m_dirty(Id)  := false;
            m_dphase(Id) := dp_resp;
            m_victim_way(Id) := w0;
            m_victim_slot(Id) := 0;
            m_fbuf(Id, O) := 0;
            rq_head(Id) := 0;
            rq_next(Id) := 0;
            rq_haswr(Id) := false;
            rq_off(m_q(Id, K))   := 0;
            rq_wen(m_q(Id, K))   := false;
            rq_wdata(m_q(Id, K)) := 0;
            rq_tag(Id, K) := 0;
            commit_tag := 0;
            user_tag   := 0;
            port_used := false;
            ready_r     := true;
            valid_r     := false;
            resp_addr_r := 0;
            data_r      := 0;
        }

        # ---- entry K of MSHR Id is pending (accepted, not yet serviced) ----
        relation rq_pend(Id : mshr_id, K : qidx)
        definition rq_pend(Id, K) = rq_head(Id) <= K & K < rq_next(Id)

        # ---- an MSHR is FULL if it has taken 4 operations this episode, OR a
        # queued write is pending (a write terminates coalescing -- mshr.md). ----
        relation mshr_full(Id : mshr_id)
        definition mshr_full(Id) = rq_next(Id) = 4 | rq_haswr(Id)

        # ---- an MSHR is EVICTING while it holds the bus/slot for a writeback or
        # is about to overwrite the victim.  New user requests are blocked during
        # this window so the victim line cannot be hit/rewritten mid-eviction. ----
        relation evicting(Id : mshr_id)
        definition evicting(Id) = (m_state(Id) = mshr_drain
            & (m_dphase(Id) = dp_wb_lo | m_dphase(Id) = dp_wb_hi | m_dphase(Id) = dp_fill))

        # ---- the committed abstract memory: the trace at the commit tag ----
        function cmem(A : addr) : word
        definition cmem(A) = trace.st(commit_tag).mem(A)

        # ---- the user-side output wires, driven combinationally from the
        # registers (reapplied after every wire havoc). ----
        definition user.ready     = ready_r
        definition user.valid     = valid_r
        definition user.resp_addr = resp_addr_r
        definition user.data      = data_r

        # ==================================================================
        # helper actions
        # ==================================================================

        # append an accepted request to MSHR id's FIFO.  The caller has just
        # stepped the trace, so the op's tag is trace.now.  A read commits at
        # acceptance (it does not change the memory), so commit_tag advances;
        # a write commits later, at drain service.
        action enqueue(id : mshr_id, off : woffset, wen : bool, wd : word) = {
            rq_off(m_q(id, rq_next(id)))   := off;
            rq_wen(m_q(id, rq_next(id)))   := wen;
            rq_wdata(m_q(id, rq_next(id))) := wd;
            rq_tag(id, rq_next(id)) := trace.now;
            if wen {
                rq_haswr(id) := true;
            } else {
                commit_tag := trace.now;
            };
            rq_next(id) := rq_next(id) + 1;
        }

        # service the HEAD queue entry at drain: a READ returns from the fill
        # buffer (takes the port; retries next edge if the port is busy); a
        # WRITE commits into the fill buffer AND advances commit_tag to its
        # tag (its trace entry already carries the write).
        action svc_head(id : mshr_id) = {
            var k : qidx := rq_head(id);
            if rq_wen(m_q(id, k)) {
                m_fbuf(id, rq_off(m_q(id, k))) := rq_wdata(m_q(id, k));
                m_dirty(id) := true;
                rq_haswr(id) := false;
                commit_tag := rq_tag(id, k);
                rq_head(id) := k + 1;
            } else {
                if ~port_used {
                    valid_r     := true;
                    resp_addr_r := concatbv3(m_base(id), rq_off(m_q(id, k)));
                    data_r      := m_fbuf(id, rq_off(m_q(id, k)));
                    user_tag       := rq_tag(id, k);
                    # record the returned value in the trace (obligation:
                    # t_qrd names the entry; inv_fbuf + t_qread give the value)
                    trace.observe(rq_tag(id, k), m_fbuf(id, rq_off(m_q(id, k))));
                    port_used  := true;
                    rq_head(id) := k + 1;
                };
            };
        }

        # write the fetched line into the (already-written-back) victim slot,
        # then free the MSHR.
        action do_fill(id : mshr_id) = {
            var vslot : cache_idx := m_victim_slot(id);
            var oway  : way := w1;
            if m_victim_way(id) = w1 { oway := w0; };
            var oslot : cache_idx := slot(hash(m_base(id)), oway);
            tag(cache(vslot))      := m_base(id);
            val(cache(vslot), O)   := m_fbuf(id, O);
            dirty(cache(vslot))    := m_dirty(id);
            occupied(cache(vslot)) := true;
            lru(cache(vslot)) := 0;
            lru(cache(oslot)) := 1;
            m_state(id) := mshr_idle;
        }

        # STEP C: drain servicing for one MSHR (non-bus part: FIFO service,
        # victim choice, and the fill).  The two writeback beats are issued by
        # the bus arbiter (STEP D) since they need the bus.
        action drain_step(id : mshr_id) = {
            if m_state(id) = mshr_drain {
                if m_dphase(id) = dp_resp {
                    if rq_head(id) ~= rq_next(id) {
                        call svc_head(id);
                    } else {
                        # queue drained: choose the victim NOW (last moment,
                        # from current LRU).  If it is dirty & occupied we must
                        # write it back; otherwise fill straight away.
                        var vw : way := w1;
                        if lru(cache(slot(hash(m_base(id)), w1))) = 1 { vw := w0; };
                        m_victim_way(id) := vw;
                        var vslot : cache_idx := slot(hash(m_base(id)), vw);
                        m_victim_slot(id) := vslot;
                        if occupied(cache(vslot)) & dirty(cache(vslot)) {
                            m_dphase(id) := dp_wb_lo;
                        } else {
                            call do_fill(id);
                        };
                    };
                } else { if m_dphase(id) = dp_fill {
                    call do_fill(id);
                } };
            };
        }

        # issue a victim-writeback beat b of MSHR id on the bus.  The command
        # carries the COMMIT FRONTIER as its tag: a resident entry's data IS
        # the committed memory at its addresses (inv_coh, stated directly at
        # the frontier), which discharges bus.cmd's data require verbatim,
        # and bus.cmd installs commit_tag as the beat's new ghost version --
        # making inv_wb_lo_shipped / inv_wb_shipped reflexive at the issue
        # edge.
        action issue_wb(id : mshr_id, b : bit) = {
            var vslot : cache_idx := m_victim_slot(id);
            call bus.cmd(true,
                         concatbv3(tag(cache(vslot)), concatbv2(b, 0)),
                         pack4(val(cache(vslot), concatbv2(b,3)),
                               val(cache(vslot), concatbv2(b,2)),
                               val(cache(vslot), concatbv2(b,1)),
                               val(cache(vslot), concatbv2(b,0))),
                         commit_tag);
        }

        # issue a fetch read beat b of MSHR id on the bus.  The tag argument
        # is irrelevant for a read (the response's correctness is pinned to
        # the beat's OWN version mem_tag); the commit frontier is a
        # convenient recorded tag to ship.
        action issue_rd(id : mshr_id, b : bit) = {
            call bus.cmd(false, concatbv3(m_base(id), concatbv2(b, 0)), mzero, commit_tag);
        }

        # ==================================================================
        # response capture -- the cache's half of the read-response channel.
        # Runs IN the cycle the controller resolves (a ghost action call
        # happens in the cycle of the call); equivalently one edge earlier
        # than the old registered-wire capture, with identical successor
        # states.  The response is correct for the beat's version
        # mem_tag(m_base, b) (bus.rresp's require, assumed here); inv_memtag
        # lifts it to the commit frontier -- no exception applies to a line
        # being fetched (it is not resident, its own MSHR is not draining,
        # and the other MSHR owns a different set).
        # ==================================================================
        after bus.rresp(a : addr, d : four_words) {
            if m_state(0) = mshr_req_lower & a = concatbv3(m_base(0), concatbv2(0,0)) {
                m_fbuf(0, concatbv2(0,0)) := unp0(d);
                m_fbuf(0, concatbv2(0,1)) := unp1(d);
                m_fbuf(0, concatbv2(0,2)) := unp2(d);
                m_fbuf(0, concatbv2(0,3)) := unp3(d);
                m_state(0) := mshr_finished_lower;
            } else { if m_state(0) = mshr_req_upper & a = concatbv3(m_base(0), concatbv2(1,0)) {
                m_fbuf(0, concatbv2(1,0)) := unp0(d);
                m_fbuf(0, concatbv2(1,1)) := unp1(d);
                m_fbuf(0, concatbv2(1,2)) := unp2(d);
                m_fbuf(0, concatbv2(1,3)) := unp3(d);
                m_state(0) := mshr_drain;
                m_dphase(0) := dp_resp;
            } };
            if m_state(1) = mshr_req_lower & a = concatbv3(m_base(1), concatbv2(0,0)) {
                m_fbuf(1, concatbv2(0,0)) := unp0(d);
                m_fbuf(1, concatbv2(0,1)) := unp1(d);
                m_fbuf(1, concatbv2(0,2)) := unp2(d);
                m_fbuf(1, concatbv2(0,3)) := unp3(d);
                m_state(1) := mshr_finished_lower;
            } else { if m_state(1) = mshr_req_upper & a = concatbv3(m_base(1), concatbv2(1,0)) {
                m_fbuf(1, concatbv2(1,0)) := unp0(d);
                m_fbuf(1, concatbv2(1,1)) := unp1(d);
                m_fbuf(1, concatbv2(1,2)) := unp2(d);
                m_fbuf(1, concatbv2(1,3)) := unp3(d);
                m_state(1) := mshr_drain;
                m_dphase(1) := dp_resp;
            } };
        }

        # ==================================================================
        # the clocked datapath
        # ==================================================================
        after env.clock(env_en : bool, env_addr : addr, env_wen : bool, env_wdata : word) {
            port_used := false;
            valid_r     := false;
            resp_addr_r := 0;
            data_r      := 0;

            # ===== STEP B: serve the incoming CPU request (gets port priority) =====
            # Every branch that ACCEPTS the request steps the trace (ghost),
            # associating the operation with tag trace.now.  Gated by ready_r:
            # the request wires are now driven by the LSQ (not the environment,
            # which used to AND them with user.ready), so the cache self-gates
            # on its own registered readiness -- identical acceptance condition
            # (ready_r), keeping the MSHR/queue invariants intact.
            if user.req_en & ready_r {
                var rl : line    := high(user.req_addr);
                var rs : key     := hash(rl);
                var ro : woffset := low(user.req_addr);
                var s0 : cache_idx := slot(rs, w0);
                var s1 : cache_idx := slot(rs, w1);
                var hit  : bool  := false;
                var hslot : cache_idx := s1;
                var hway : way   := w1;
                if occupied(cache(s1)) & tag(cache(s1)) = rl { hit:=true; hslot:=s1; hway:=w1; }
                else { if occupied(cache(s0)) & tag(cache(s0)) = rl { hit:=true; hslot:=s0; hway:=w0; } };
                if hit {
                    trace.step(rl, ro, user.req_wen, user.req_wdata);
                    commit_tag := trace.now;   # a hit commits at acceptance
                    if ~user.req_wen {
                        valid_r := true; resp_addr_r := user.req_addr; data_r := val(cache(hslot), ro);
                        user_tag   := trace.now;
                        port_used  := true;
                        # record the returned value in the trace (obligation:
                        # inv_coh: the entry IS the committed memory, and the
                        # read's own entry carries its predecessor's memory
                        # -- the pre-accept frontier -- unchanged)
                        trace.observe(trace.now, val(cache(hslot), ro));
                    } else {
                        val(cache(hslot), ro) := user.req_wdata;
                        dirty(cache(hslot))   := true;
                    };
                    if hway = w1 { lru(cache(s0)):=1; lru(cache(s1)):=0; }
                    else         { lru(cache(s0)):=0; lru(cache(s1)):=1; };
                } else {
                    # ---- miss: coalesce onto the owning MSHR, or allocate ----
                    var owner_found : bool := false;
                    var owner : mshr_id := 0;
                    if m_state(0) ~= mshr_idle & m_base(0) = rl { owner_found:=true; owner:=0; }
                    else { if m_state(1) ~= mshr_idle & m_base(1) = rl { owner_found:=true; owner:=1; } };
                    if owner_found {
                        # enqueue in FIFO order, even while the owner is
                        # draining -- the entry is serviced after all older
                        # entries, so a queued read can never observe a write
                        # accepted after it.
                        trace.step(rl, ro, user.req_wen, user.req_wdata);
                        call enqueue(owner, ro, user.req_wen, user.req_wdata);
                    } else {
                        # new miss: allocate an idle MSHR, unless another active
                        # MSHR already owns this SET (one MSHR per set -- avoids a
                        # two-MSHR fill collision).  Otherwise the request is
                        # DROPPED, i.e. NOT accepted: it is never serviced, gets
                        # no response, and does not advance the trace (safe:
                        # not responding never violates the response theorem).
                        var conflict : bool := false;
                        if m_state(0) ~= mshr_idle & hash(m_base(0)) = rs { conflict := true; };
                        if m_state(1) ~= mshr_idle & hash(m_base(1)) = rs { conflict := true; };
                        if ~conflict {
                            var aid : mshr_id := 0;
                            if m_state(0) ~= mshr_idle { aid := 1; };
                            trace.step(rl, ro, user.req_wen, user.req_wdata);
                            m_state(aid)  := mshr_req_lower;
                            m_base(aid)   := rl;
                            m_dirty(aid)  := false;
                            m_dphase(aid) := dp_resp;
                            m_fbuf(aid, O) := 0;
                            rq_head(aid) := 0;
                            rq_next(aid) := 0;
                            rq_haswr(aid) := false;
                            call enqueue(aid, ro, user.req_wen, user.req_wdata);
                        };
                    };
                };
            };

            # ===== STEP C: drain servicing (FIFO service / fill) =====
            call drain_step(0);
            call drain_step(1);

            # ===== STEP D: memory bus arbiter =====
            # Priority: eviction WRITEBACKS (both MSHRs) before fetch READS
            # (mshr.md: prioritize writes from evictions over reads from MSHRs).
            # A single command per edge; issues only when memory is ready
            # (command buffer free).  If not ready, the MSHR simply waits.
            if bus.ready {
                if m_state(0) = mshr_drain & m_dphase(0) = dp_wb_lo {
                    call issue_wb(0, 0); m_dphase(0) := dp_wb_hi;
                } else { if m_state(0) = mshr_drain & m_dphase(0) = dp_wb_hi {
                    call issue_wb(0, 1); m_dphase(0) := dp_fill;
                } else { if m_state(1) = mshr_drain & m_dphase(1) = dp_wb_lo {
                    call issue_wb(1, 0); m_dphase(1) := dp_wb_hi;
                } else { if m_state(1) = mshr_drain & m_dphase(1) = dp_wb_hi {
                    call issue_wb(1, 1); m_dphase(1) := dp_fill;
                } else { if m_state(0) = mshr_req_lower {
                    call issue_rd(0, 0);
                } else { if m_state(0) = mshr_finished_lower {
                    call issue_rd(0, 1); m_state(0) := mshr_req_upper;
                } else { if m_state(1) = mshr_req_lower {
                    call issue_rd(1, 0);
                } else { if m_state(1) = mshr_finished_lower {
                    call issue_rd(1, 1); m_state(1) := mshr_req_upper;
                } } } } } } } };
            };

            # ===== STEP E: readiness =====
            # Accept a new request only when no MSHR is full (mshr.md), an MSHR
            # is idle (so a new miss can always allocate), and no MSHR is mid-
            # eviction (so the victim line cannot be disturbed).
            ready_r := ~(mshr_full(0) | mshr_full(1))
                        & (m_state(0) = mshr_idle | m_state(1) = mshr_idle)
                        & ~evicting(0) & ~evicting(1);
        }

    # ========================================================================
    # Reference-tagging invariants.  Each microarchitectural element carries a
    # small local invariant relating its contents to the trace:
    #   (1) structural   -- cache/MSHR/queue shape facts
    #   (2) tags         -- queue tags vs. the trace; the commit-tag discipline
    #   (3) coherence    -- resident lines, the ghost memory versions, buffers
    #                       vs. cmem (= the trace at the commit tag)
    #   (4) theorem      -- the trace-level coherence spec (trace.coh_lw /
    #                       coh_nw) is discharged via trace.observe; ref_done
    #                       ties the response wires to the trace record
    # All of it is PRIVATE to this isolate: the memory controller no longer
    # assumes any cache invariant (its interface facts arrive as bus.cmd's
    # requires, checked at the call sites above).
    # ========================================================================

    # ---- "line H is resident" -- it occupies one of its set's two ways ----
    relation resident(H : line)
    definition resident(H) =
        (occupied(cache(slot(hash(H), w0))) & tag(cache(slot(hash(H), w0))) = H)
      | (occupied(cache(slot(hash(H), w1))) & tag(cache(slot(hash(H), w1))) = H)

    # ================ (1) structural ================
    # ---- an occupied slot's tag hashes to the slot's own set ----
    invariant [inv_hashkey] forall I : cache_idx.
        occupied(cache(I)) -> hash(tag(cache(I))) = bfe[1][3](I)
    # ---- a line lives in at most one slot ----
    invariant [inv_syn] forall I1 : cache_idx, I2 : cache_idx.
        (occupied(cache(I1)) & occupied(cache(I2)) & tag(cache(I1)) = tag(cache(I2))) -> I1 = I2
    # ---- at most one MSHR per set (enforced by the allocation conflict check).
    # Load-bearing: keeps the two MSHRs from ever touching the same cache slot. ----
    invariant [inv_oneperset]
        (m_state(0) ~= mshr_idle & m_state(1) ~= mshr_idle) ->
        hash(m_base(0)) ~= hash(m_base(1))
    # ---- an active MSHR's base line is NOT resident (its slot is only written
    # at do_fill, which simultaneously drops the MSHR to idle). ----
    invariant [inv_mbase_nr] forall Id : mshr_id.
        m_state(Id) ~= mshr_idle -> ~resident(m_base(Id))
    # ---- direct corollary of inv_mbase_nr + inv_hashkey: NO occupied slot holds
    # an active MSHR's base line. ----
    invariant [inv_mbase_notag] forall I : cache_idx, Id : mshr_id.
        (m_state(Id) ~= mshr_idle & occupied(cache(I))) -> tag(cache(I)) ~= m_base(Id)
    # ---- the stored victim slot is in m_base's set and occupied & dirty while an
    # eviction is in progress. ----
    invariant [inv_victim] forall Id : mshr_id.
        evicting(Id) -> (bfe[1][3](m_victim_slot(Id)) = hash(m_base(Id))
                       & occupied(cache(m_victim_slot(Id))) & dirty(cache(m_victim_slot(Id))))

    # ---- queue pointer discipline ----
    invariant [inv_q_bound] rq_head(Id) <= rq_next(Id) & rq_next(Id) <= 4
    invariant [inv_q_idle] m_state(Id) = mshr_idle -> (rq_head(Id) = rq_next(Id) & ~rq_haswr(Id))
    # ---- the queue is fully drained before the eviction phases begin (drain
    # leaves dp_resp only when empty; evicting blocks all further accepts).
    # Needed so do_fill (from dp_fill) re-establishes inv_q_idle. ----
    invariant [inv_q_evict] evicting(Id) -> (rq_head(Id) = rq_next(Id) & ~rq_haswr(Id))
    # ---- a queued write is the LAST accepted entry of its queue (a write
    # terminates coalescing: it makes the MSHR full, dropping user.ready) ----
    invariant [inv_q_wlast] (rq_pend(Id,K) & rq_wen(m_q(Id,K))) ->
        (K + 1 = rq_next(Id) & rq_haswr(Id))
    # ---- a pending write implies a NONEMPTY queue (guards the K+1 wraparound:
    # without this, next=0 with haswr and "K=7" satisfies the last-slot fact
    # vacuously, leaving a spurious CTI for inv_q_idle at do_fill) ----
    invariant [inv_q_haswr] rq_haswr(Id) -> rq_head(Id) < rq_next(Id)
    invariant [inv_q_haswr2] (rq_haswr(Id) & K + 1 = rq_next(Id) & K < 4) ->
        (rq_head(Id) <= K & rq_wen(m_q(Id,K)))
    # ---- at most one pending write GLOBALLY (any pending write drops ready) ----
    invariant [inv_onewr] ~(rq_haswr(0) & rq_haswr(1))
    # ---- the registered ready output really means what STEP B assumes ----
    invariant [inv_ready] ready_r ->
        (~mshr_full(0) & ~mshr_full(1)
         & (m_state(0) = mshr_idle | m_state(1) = mshr_idle)
         & ~evicting(0) & ~evicting(1))

    # ================ (2) tags ================
    invariant [t_tag_le] rq_pend(Id,K) -> (rq_tag(Id,K) <= trace.now & rq_tag(Id,K) ~= 0)
    invariant [t_ct_le] commit_tag <= trace.now
    # with no pending write everything accepted has committed
    invariant [t_ct_now] (~rq_haswr(0) & ~rq_haswr(1)) -> commit_tag = trace.now
    # the unique pending write is the newest trace entry, one past commit_tag,
    # and the trace entry records exactly this write
    invariant [t_qwr] (rq_pend(Id,K) & rq_wen(m_q(Id,K))) ->
        (rq_tag(Id,K) = trace.now
         & trace.tag.succ(commit_tag, trace.now)
         & trace.st(trace.now).op = op_write
         & trace.st(trace.now).op_addr = concatbv3(m_base(Id), rq_off(m_q(Id,K)))
         & trace.st(trace.now).op_data = rq_wdata(m_q(Id,K)))
    # ---- a pending READ's trace record: an unanswered read at the queue's
    # (line, offset) address.  ~op_done is what entitles svc_head to observe. ----
    invariant [t_qrd] (rq_pend(Id,K) & ~rq_wen(m_q(Id,K))) ->
        (trace.st(rq_tag(Id,K)).op = op_read
         & ~trace.st(rq_tag(Id,K)).op_done
         & trace.st(rq_tag(Id,K)).op_addr = concatbv3(m_base(Id), rq_off(m_q(Id,K))))
    # ---- pending tags are pairwise distinct (each acceptance is a fresh
    # trace position), so an observe cannot clobber another queued read ----
    invariant [t_tag_uniq] (rq_pend(Id1,K1) & rq_pend(Id2,K2)
        & rq_tag(Id1,K1) = rq_tag(Id2,K2)) -> (Id1 = Id2 & K1 = K2)
    # ---- THE per-entry tag invariant: a pending READ's correct value -- the
    # trace memory AT its own entry (= its pre-state: a read's entry carries
    # its predecessor's memory unchanged), at its address -- equals the
    # committed memory there.  Nothing that committed after the read was
    # accepted has written its address: same-line writes are behind it in
    # ITS OWN FIFO (uncommitted until serviced, and serviced after it);
    # other lines never alias its address.  This is exactly what discharges
    # observe's value-require at drain service (with inv_fbuf). ----
    invariant [t_qread] (rq_pend(Id,K) & ~rq_wen(m_q(Id,K))) ->
        trace.st(rq_tag(Id,K)).mem(concatbv3(m_base(Id), rq_off(m_q(Id,K))))
          = cmem(concatbv3(m_base(Id), rq_off(m_q(Id,K))))

    # ---- "line H sits in a dirty occupied slot" ----
    relation dirty_here(H : line)
    definition dirty_here(H) =
        (occupied(cache(slot(hash(H),w0))) & dirty(cache(slot(hash(H),w0))) & tag(cache(slot(hash(H),w0))) = H)
      | (occupied(cache(slot(hash(H),w1))) & dirty(cache(slot(hash(H),w1))) & tag(cache(slot(hash(H),w1))) = H)

    # ================ (3) coherence vs. the trace ================
    # Every element is pinned DIRECTLY to a point on the trace -- a resident
    # entry to the commit frontier itself, a memory beat to its own ghost
    # version (inv_memtag below) -- with NO quantifier over intermediate
    # trace positions (no (pres) companions; quantifying over all tags up to
    # the frontier is what made the old inv_coh_pres/if_wb_pres VCs blow
    # up).  Directly-at-frontier statements stay inductive because the
    # frontier only ever advances by EXACTLY ONE trace step, and the
    # committing operation always accounts for its own line in the same
    # edge; everything else is framed by one tr_step application.
    # ---- a resident entry IS the committed memory at its addresses: a
    # hit-write re-stamps its own offset as it commits (and no other slot
    # holds its line, inv_syn); a drain write-service commits to a
    # NON-resident line (inv_mbase_notag); a fill copies fbuf = cmem
    # (inv_fbuf). ----
    invariant [inv_coh] forall I : cache_idx, O : woffset.
        occupied(cache(I)) -> val(cache(I),O) = cmem(concatbv3(tag(cache(I)),O))

    # ================ (3b) the ghost memory versions vs. the frontier ================
    # bus.mem_tag names a RECORDED trace entry (so trace.step cannot clobber
    # the version an invariant below points at) ...
    invariant [bmt_le] bus.mem_tag(H, B) <= trace.now
    # ---- THE memory correspondence, successor of the old inv_memat: every
    # beat's ghost version is CURRENT -- the trace at the version equals the
    # trace at the commit frontier on that beat -- except where the frontier
    # is legitimately ahead of memory: (a) a dirty resident line; (b) a
    # dirtied draining MSHR's base line (its committed writes are in fbuf,
    # not yet written back).  Stated DIRECTLY at commit_tag -- no quantifier
    # over intermediate trace positions.  Inductive without a (pres)
    # companion because the frontier only ever advances by EXACTLY ONE trace
    # step (t_ct_now at an accept, t_qwr at a drain write-service), so a
    # single tr_step application re-proves the equality at every clean line:
    # a committing WRITE always excepts its own line in the same edge (a
    # hit-write dirties the slot; a drain service dirties its MSHR), and a
    # committing READ leaves the trace memory unchanged.  This is what lifts
    # a read response (correct at the beat's version, per bus.rresp) to the
    # commit frontier at capture -- no exception ever applies to a line
    # being fetched. ----
    invariant [inv_memtag] forall H : line, O : woffset.
        trace.st(bus.mem_tag(H, beat_of(O))).mem(concatbv3(H,O)) = trace.st(commit_tag).mem(concatbv3(H,O))
      | dirty_here(H)
      | (m_state(0) = mshr_drain & m_dirty(0) & m_base(0) = H)
      | (m_state(1) = mshr_drain & m_dirty(1) & m_base(1) = H)

    # ---- the eviction writeback lands beat-by-beat while the victim is
    # still resident-dirty (so its line is EXCEPTED in inv_memtag): these
    # carry the already-shipped beats' currency across that window, so the
    # fill -- which de-excepts the line -- can discharge inv_memtag for it.
    # A dphase past dp_wb_lo means the lower beat was issued (issue is gated
    # on ready, and dphase advances only on issue); dp_fill means both were.
    # Established REFLEXIVELY at the issue edge (issue_wb installs
    # mem_tag := commit_tag, and inv_coh says the shipped data is cmem);
    # preserved across the window because mid-eviction no accepts happen
    # (evicting drops user.ready) and the only possible commits -- the OTHER
    # MSHR's drain write-services -- touch a different set (inv_oneperset),
    # hence a different line, so tr_step frames the victim line. ----
    invariant [inv_wb_lo_shipped] forall Id : mshr_id, O : woffset.
        (m_state(Id) = mshr_drain & m_dphase(Id) = dp_wb_hi & beat_of(O) = 0) ->
        trace.st(bus.mem_tag(tag(cache(m_victim_slot(Id))), 0)).mem(concatbv3(tag(cache(m_victim_slot(Id))), O))
          = trace.st(commit_tag).mem(concatbv3(tag(cache(m_victim_slot(Id))), O))
    invariant [inv_wb_shipped] forall Id : mshr_id, O : woffset.
        (m_state(Id) = mshr_drain & m_dphase(Id) = dp_fill) ->
        trace.st(bus.mem_tag(tag(cache(m_victim_slot(Id))), beat_of(O))).mem(concatbv3(tag(cache(m_victim_slot(Id))), O))
          = trace.st(commit_tag).mem(concatbv3(tag(cache(m_victim_slot(Id))), O))

    # ---- fill buffers track the committed memory: the lower beat once
    # captured ... ----
    invariant [inv_fbuf_lo] forall Id : mshr_id, O : woffset.
        ((m_state(Id) = mshr_finished_lower | m_state(Id) = mshr_req_upper) & beat_of(O) = 0) ->
        m_fbuf(Id,O) = cmem(concatbv3(m_base(Id),O))
    # ---- ... and the whole line while draining.  (A pending queued write is
    # not yet in fbuf -- and, being uncommitted, not in cmem either; at drain
    # service it enters both simultaneously.) ----
    invariant [inv_fbuf] forall Id : mshr_id, O : woffset.
        m_state(Id) = mshr_drain -> m_fbuf(Id,O) = cmem(concatbv3(m_base(Id),O))

    # ================ (4) refinement THEOREM ================
    # The correctness statement itself lives in the trace isolate (coh_lw /
    # coh_nw): every ANSWERED read returns the value of the last write to its
    # address preceding it in the trace.  The cache discharges it by calling
    # trace.observe at the moment it produces each read response; observe's
    # require -- the returned value equals the ghost folded memory at the
    # read's own entry (= its pre-state) -- is proved from
    # inv_coh at a hit and from inv_fbuf / t_qread at a drain
    # service.  A queued read can never observe a write accepted after it:
    # FIFO service order guarantees younger same-line writes commit only
    # after the read is serviced.  (For writes the principle is structural:
    # the trace entry AT a write's tag is its predecessor updated at exactly
    # its address -- tr_step + t_qwr.)  Here we tie the registered response
    # port (which drives the user.valid/resp_addr/data wires) to the trace
    # record:
    invariant [ref_done] valid_r ->
        (trace.st(user_tag).op = op_read
         & trace.st(user_tag).op_done
         & trace.st(user_tag).op_data = data_r
         & trace.st(user_tag).op_addr = concatbv3(high(resp_addr_r), low(resp_addr_r)))
    

    isolate iso = this with this, trace, user, bus, env, addr_thy, basis
}
# The cache, parametrized over the trace, the user ports, and the memory bus.
instance simple_cache : cache_body(trace, user, bus)

# ============================================================================
# mc_body -- the memory controller: a concrete word memory behind the bus,
# parametrized over the trace and the bus.  Everything is IMPLEMENTATION
# (private): the word memory mmem, the one-deep command buffer, the latency
# counter, and the two invariants below are checked only in this isolate and
# are invisible to the cache.
#
#   GUARANTEE -- discharged ONCE, at the bus.rresp call site in the resolve
#   step: the returned beat equals the trace memory at the beat's ghost
#   version mem_tag.  It follows from inv_mm, this isolate's single memory
#   invariant, which mentions NO cache state (compare the old inv_memat's
#   dirty-line exceptions): mem_tag says which trace point each beat holds,
#   and bus.cmd's own body keeps it in sync with the eager write below.
#
#   ASSUMPTION -- bus.cmd's requires, assumed here at the latch (the erased
#   cache is this isolate's environment): commands only arrive when ready
#   (so the buffer never overflows and mmem/mem_tag are FROZEN while a read
#   is buffered), and a writeback's data is the trace at its tag.
# ============================================================================
module mc_body(trace, bus) = {
    implementation {
        function mmem(A : addr) : word

        var command_buf_valid : bool
        var command_buf_wen   : bool
        var command_buf_addr  : addr
        var svc_count : nat

        after init {
            mmem(A) := 0;
            command_buf_valid := false;
            command_buf_wen   := false;
            command_buf_addr  := 0;
            svc_count := 0;
        }

        # latch a command the moment the cache issues it (bus.cmd's assumed
        # `require ready` = buffer free, so nothing is ever dropped).  A
        # WRITE is applied to mmem eagerly at accept -- no read can be
        # accepted in between (single outstanding), so the early application
        # is unobservable and the resolve is a pure ack.  bus.cmd's body has
        # already advanced mem_tag for the beat, and its data require says
        # the beat equals the trace there: inv_mm is re-established at
        # exactly the four written word addresses.
        after bus.cmd(wen : bool, a : addr, d : four_words, tg : trace.tag) {
            command_buf_wen   := wen;
            command_buf_addr  := a;
            command_buf_valid := true;
            svc_count := mem_latency;
            if wen {
                mmem(concatbv3(high(a), concatbv2(beat_of(low(a)), 0))) := unp0(d);
                mmem(concatbv3(high(a), concatbv2(beat_of(low(a)), 1))) := unp1(d);
                mmem(concatbv3(high(a), concatbv2(beat_of(low(a)), 2))) := unp2(d);
                mmem(concatbv3(high(a), concatbv2(beat_of(low(a)), 3))) := unp3(d);
            };
        }

        after env.clock(env_en : bool, env_addr : addr, env_wen : bool, env_wdata : word) {
            if command_buf_valid {
                if svc_count = 0 {
                    if ~command_buf_wen {
                        # resolve a READ: respond with the buffered beat.
                        # The rresp require -- the data is the trace at the
                        # beat's version -- is inv_mm verbatim: mmem and
                        # mem_tag were frozen while the command was buffered
                        # (no cmd could arrive: ready was low).
                        var h : line := high(command_buf_addr);
                        var b : bit  := beat_of(low(command_buf_addr));
                        call bus.rresp(command_buf_addr,
                                       pack4(mmem(concatbv3(h, concatbv2(b, 3))),
                                             mmem(concatbv3(h, concatbv2(b, 2))),
                                             mmem(concatbv3(h, concatbv2(b, 1))),
                                             mmem(concatbv3(h, concatbv2(b, 0)))));
                    };
                    # a WRITE resolve is a pure ack: freeing the buffer
                    # raises ready again.
                    command_buf_valid := false;
                } else {
                    svc_count := svc_count - 1;
                }
            };
        }

        # ---- the flow-control wire, driven combinationally from the buffer.
        # A hidden DEFINITION of a visible wire (the c0/c1 pattern of
        # refinement3.ivy): pinned here, havocked in the cache's isolate. ----
        definition bus.ready = ~command_buf_valid

        # ---- private invariants ----
        # the ghost versions name recorded trace entries (so a trace.step by
        # the erased cache cannot clobber the entry inv_mm points at) ...
        invariant [mt_le] bus.mem_tag(H, B) <= trace.now
        # ... and THE memory invariant: every beat of mmem equals the trace
        # memory at the beat's ghost version.  No cache state, no exceptions,
        # no frontier -- the whole correspondence is pinned to trace points
        # BEFORE any not-yet-written-back write.
        invariant [inv_mm] forall H : line, O : woffset.
            mmem(concatbv3(H, O)) = trace.st(bus.mem_tag(H, beat_of(O))).mem(concatbv3(H, O))
    }

    isolate iso = this with this, trace, bus, env, addr_thy, basis
}
# The memory controller, parametrized over the trace and the memory bus.
instance memory_controller : mc_body(trace, bus)
