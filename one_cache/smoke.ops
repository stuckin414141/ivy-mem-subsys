# Smoke trace for mem_subsys (circular_queue.ivy).  See testbench.sv for the
# grammar.  All numbers are hex; addresses are word addresses 00..ff.
#
# Geometry (from circular_queue.ivy): woffset = addr[2:0] (8 words/line),
# set = hash(line) = line[2:0] = addr[5:3] (8 sets), way = bv[1] (2 ways) =>
# 16 resident lines over a 32-line pool, so tags 0..3 (addr[7:6]) collide
# 4-deep in every set and eviction is reachable.

# ---- A. cold miss, then hits inside the same line ----
r 00
r 01
r 07

# ---- B. store then load the same word (LSQ ordering / forwarding) ----
w 02 aaaa_1111_bbbb_2222
r 02

# ---- C. back-to-back misses to distinct sets (both MSHRs busy) ----
r 08
r 10
r 18
r 20

# ---- D. dirty line evicted by tag conflict in set 0, then re-read ----
w 00 dead_0000_dead_0000
r 40
r 80
r c0
r 00                 // must come back from DRAM as dead_0000_dead_0000

# ---- E. bubbles around a read-modify-read ----
n 3
r 41
n
w 41 1234_5678_9abc_def0
r 41

# ---- F. LSQ pressure: 8 back-to-back stores, then 8 loads, no bubbles ----
w 30 305_0f0f_305
w 31 315_0f0f_315
w 32 325_0f0f_325
w 33 335_0f0f_335
w 34 345_0f0f_345
w 35 355_0f0f_355
w 36 365_0f0f_365
w 37 375_0f0f_375
r 30
r 31
r 32
r 33
r 34
r 35
r 36
r 37

# ---- G. two dirty words in one line, evicted as a full 2-beat writeback ----
w 88 5a5a_5a5a_5a5a_5a5a
w 8f a5a5_a5a5_a5a5_a5a5
r c8                 // set 1, tag 3
r 08                 // set 1, tag 0
r 48                 // set 1, tag 1 -- 88's line is now the LRU victim
r 88
r 8f

# ---- H. stress: every set x every tag, store+load, rounds of rotating
#         word offsets; keeps both ways thrashing and dirties evictions ----
w 00 000_cafe_000
r 00
w 41 410_cafe_410
r 41
w 82 820_cafe_820
r 82
w c3 c30_cafe_c30
r c3
w 08 080_cafe_080
r 08
