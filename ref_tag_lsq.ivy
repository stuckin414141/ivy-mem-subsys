#lang ivy1.8

include numbers
include order

type key
type word
type line
type bit
type bv2
type mshr_id

# ---- LSQ indices are small bit vectors: the queues hold at most four
# entries each, and `store_next`/`load_next` equal to 4 means full. ----
type store_idx
type load_idx

type two_words
type four_words
individual mzero : four_words

function cat_w(H : word, L : word) : two_words
function cat_d(H : two_words, L : two_words) : four_words
function pack4(W3 : word, W2 : word, W1 : word, W0 : word) : four_words
function unp0(M : four_words) : word
function unp1(M : four_words) : word
function unp2(M : four_words) : word
function unp3(M : four_words) : word

function mem_latency : nat

type addr
type woffset
type way

# ---- `word`, `two_words` and `four_words` are ABSTRACT outside this
# isolate.  The bit-level encoding lives in the implementation, so every
# other isolate sees a beat as an uninterpreted quadruple constrained
# only by `p_unp0..3`.  This is the same trick `addr_thy` plays below,
# and for the same reason: with four_words = bv[256] visible, every
# query that mentions a fill or a writeback drags a 256-bit concat
# through the solver, and z3 bit-blasts it.  Nothing outside needs the
# encoding -- beats are only ever built with `pack4` and taken apart
# with `unp0..3`. ----
isolate data_impl = {
    property [p_unp0] forall W3 : word, W2 : word, W1 : word, W0 : word. unp0(pack4(W3, W2, W1, W0)) = W0
    property [p_unp1] forall W3 : word, W2 : word, W1 : word, W0 : word. unp1(pack4(W3, W2, W1, W0)) = W1
    property [p_unp2] forall W3 : word, W2 : word, W1 : word, W0 : word. unp2(pack4(W3, W2, W1, W0)) = W2
    property [p_unp3] forall W3 : word, W2 : word, W1 : word, W0 : word. unp3(pack4(W3, W2, W1, W0)) = W3

    implementation {
        interpret word -> bv[64]
        interpret two_words -> bv[128]
        interpret four_words -> bv[256]
        interpret cat_w -> concat
        interpret cat_d -> concat
        definition pack4(W3, W2, W1, W0) = cat_d(cat_w(W3, W2), cat_w(W1, W0))
        definition unp0(M) = bfe[0][63](M)
        definition unp1(M) = bfe[64][127](M)
        definition unp2(M) = bfe[128][191](M)
        definition unp3(M) = bfe[192][255](M)
        definition mzero = 0
    }
}

isolate basis = {
    interpret key -> bv[3]
    interpret bit -> bv[1]
    interpret bv2 -> bv[2]
    interpret mshr_id -> bv[1]
    interpret store_idx -> bv[3]
    interpret load_idx -> bv[3]

    definition mem_latency = 8
} with this, data_impl

function concatbv3(H : line, O : woffset) : addr
function high(A : addr) : line
function low(A : addr) : woffset
function concatbv2(B : bit, J : bv2) : woffset
function beat_of(O : woffset) : bit
individual w0 : way
individual w1 : way
function hash(H : line) : key

isolate addr_thy = {
    interpret woffset -> bv[3]
    interpret way -> bv[1]
    interpret concatbv2 -> concat
    definition beat_of(O) = bfe[2][2](O)
    definition w0 = 0
    definition w1 = 1

    property [p_way2]  forall W : way. W = w0 | W = w1
    property [p_way_ne] w0 ~= w1
    property [p_boff_beat]  forall B : bit, J : bv2. beat_of(concatbv2(B, J)) = B
    property [p_cover] forall O : woffset, B : bit. beat_of(O) = B ->
        (O = concatbv2(B, 0) | O = concatbv2(B, 1) | O = concatbv2(B, 2) | O = concatbv2(B, 3))
    property [p_full_inj] forall H1 : line, O1 : woffset, H2 : line, O2 : woffset. (concatbv3(H1, O1) = concatbv3(H2, O2)) -> (H1 = H2 & O1 = O2)
    property [p_highfull] forall H : line, O : woffset. high(concatbv3(H, O)) = H
    property [p_lowfull]  forall H : line, O : woffset. low(concatbv3(H, O)) = O

    # ---- addr and line are ABSTRACT outside this isolate.  The bit-level
    # encoding lives in the implementation, so every other isolate sees a
    # word address as an uninterpreted pair (line, woffset) constrained only
    # by the properties above.  This matters for more than tidiness: with
    # addr = bv[64] and line = bv[61], the coherence goals quantify over
    # 61- and 64-bit bit vectors, which z3 cannot bit-blast and can only
    # attack with MBQI. ----
    implementation {
        interpret addr -> bv[64]
        interpret line -> bv[61]
        definition high(A) = bfe[3][63](A)
        definition low(A) = bfe[0][2](A)
        interpret concatbv3 -> concat

        # ---- `concatbv3(high(A), low(A)) = A` is checked here rather
        # than exported.  Outside this isolate it is a matching loop:
        # instantiating it at any address term T *creates* the new
        # address `concatbv3(high(T), low(T))`, which `p_full_inj` then
        # pairs with every other address in the query, which yields more
        # equalities and more addresses.  Nothing outside reconstructs an
        # address from its halves -- every isolate builds addresses with
        # `concatbv3` and takes them apart with `p_highfull`/`p_lowfull`
        # -- so exporting it bought nothing and cost termination on any
        # goal that mentions several addresses. ----
        property [p_recon] forall A : addr. concatbv3(high(A), low(A)) = A

        definition hash(H) = bfe[0][2](H)
    }
} with this, basis

export action posedge

# ------------------------------------------------------------------
# The operation trace.
#
# `tag` indexes an arbitrary, fixed sequence of memory operations: the
# operation at index T reads or writes one word address, and a write
# also carries the datum it stores -- a read carries no datum.  The
# functions below are never assigned, so they stand for *any* sequence
# of operations over *any* initial memory image, and the proof holds
# for all of them.  Index 0 is the reset point, not an operation.
# ------------------------------------------------------------------

instance tag : unbounded_sequence

function op_wen(T : tag)   : bool    # write if true, read if false
function op_addr(T : tag)  : addr
function op_wdata(T : tag) : word    # the datum a write stores

function init_mem(A : addr) : word   # the power-on memory image

# ------------------------------------------------------------------
# The ISA reference: a memory that executes the operation trace, one
# operation per `step`.  `mnow` is the index of the last operation it
# executed.  A read leaves the architectural state alone -- the datum
# it returns is recorded by the trace, not held here.
# ------------------------------------------------------------------

isolate abs_memory = {
    # ---- The reference is proof state only: it is the ISA the LSQ is
    # verified against, not hardware.  Wrapping it in `specification`
    # keeps `tag` -- an unbounded sequence, which has no bit width -- out
    # of the hardware description. ----
    specification {
        function mem(A : addr) : word
        var mnow : tag

        after init {
            mem(A) := init_mem(A);
            mnow   := 0;
        }

        # ---- execute the next operation in the trace ----
        action step = {
            mnow := mnow.next;
            if op_wen(mnow) {
                mem(op_addr(mnow)) := op_wdata(mnow);
            };
        }
    }

    isolate iso = this with this, basis
}

# ------------------------------------------------------------------
# The trace: the history of what the reference actually did.  `st(T)` is
# the memory image reached after operation T, together with the datum
# operation T returned if it was a read.  `now` is the index of the last
# operation executed and `nxt` the index of the next one; entries above
# `now` are unwritten.
#
# The whole isolate is specification: the invariants below are what the
# LSQ proof reasons with, so they have to be visible outside it.
# ------------------------------------------------------------------

isolate trace = {
    specification {
        type state_t = struct {
            mem(A : addr) : word,   # memory image after the operation
            rdata : word            # datum a read returned
        }

        var now : tag
        var nxt : tag
        var st(T : tag) : state_t

        # ---- operation T has been executed ----
        relation done(T : tag)
        definition done(T) = 0 < T & T <= now

        after init {
            now := 0;
            nxt := now.next;
            st(T).mem(A : addr) := init_mem(A);
        }

        # ---- execute the next operation and record what happened ----
        action step = {
            now := nxt;
            nxt := nxt.next;
            call abs_memory.step;
            st(now).mem(A : addr) := abs_memory.mem(A);
            if ~op_wen(now) {
                # a read does not disturb the image, so the reference's
                # memory still holds the datum the read observed
                st(now).rdata := abs_memory.mem(op_addr(now));
            };
        }

        # ==============================================================
        # The trace is an execution of the abstract memory model: the
        # reference stands at st(now), and any two consecutive recorded
        # states are related by one step of it -- a write installs its
        # datum and changes nothing else, a read returns the image it
        # started from.
        #
        # Coherence -- every read returns the datum of the last write to
        # the same address -- follows from these by induction along the
        # trace, so it is not stated separately.  Stating it would also
        # take the isolate out of EPR: "no write to A between W and R" is
        # a universal over the operations in between, and in hypothesis
        # position that skolemizes to a function from the address back to
        # a tag, closing a tag -> addr -> tag cycle in the instantiation
        # graph.  The LSQ proof below never needs it: it walks the trace
        # one operation at a time instead (`s_img`, `s_img0`, `s_imgN`).
        # ==============================================================

        invariant [ref_now] abs_memory.mnow = now
        invariant [ref_nxt] tag.succ(now, nxt)
        invariant [ref_mem] abs_memory.mem(A) = st(now).mem(A)
        invariant [tr_step] (tag.succ(T,U) & done(U)) ->
            st(U).mem(A) = (op_wdata(U) if (op_wen(U) & A = op_addr(U))
                            else st(T).mem(A))
        invariant [tr_rd] (tag.succ(T,U) & done(U) & ~op_wen(U)) ->
            st(U).rdata = st(T).mem(op_addr(U))
    }
} with this, abs_memory

# ------------------------------------------------------------------
# The cpu.  It hands the operations of the trace to the LSQ in order and
# takes a response whenever the LSQ raises `valid`.  What it hands over
# is the next operation of the sequence, so the operation the LSQ
# accepts is `trace.nxt`.
#
# There is no request-enable input: the cpu offers an operation on every
# clock edge and the LSQ accepts it whenever it is ready, so `cpu.ready`
# is the only flow control.  Nothing is lost by dropping the input --
# the trace is already an arbitrary infinite sequence of operations over
# an arbitrary initial memory image, so the stalls it could model are
# already covered by the choice of trace.
# ------------------------------------------------------------------

object cpu = {
    wire req_addr  : addr
    wire req_wen   : bool
    wire req_wdata : word
    wire valid     : bool            # driven by the LSQ
    wire resp_addr : addr            # driven by the LSQ
    wire data      : word            # driven by the LSQ
    wire ready     : bool            # driven by the LSQ

    definition req_addr  = op_addr(trace.nxt)
    definition req_wen   = op_wen(trace.nxt)
    definition req_wdata = op_wdata(trace.nxt)
}

type store_queue_entry = struct {
    store_addr : addr,
    store_data : word,
    store_mark : load_idx            # load_next when the store arrived
}

type load_queue_entry = struct {
    load_addr  : addr,
    load_fwd   : bool,               # answered by store-to-load forwarding
    load_fdata : word,               # the forwarded datum
    load_mark  : store_idx           # store_next when the load arrived
}

# ---- the outcome of a store-queue search for a forwardable datum ----
type fwd_result = struct {
    fr_hit  : bool,
    fr_data : word
}

# ==================================================================
# The load-store queue.
#
#   * The cpu hands over at most one operation per clock edge; the LSQ
#     calls `trace.step` when it takes one, so `trace.now` is the tag of
#     the last operation accepted.
#
#   * Every queue entry carries the tag of its operation (`stag`,
#     `ltag`), and `ctag` is the tag of the last operation to have *left*
#     the LSQ -- the point the cache's memory image stands at.  The
#     operations held in the LSQ are then exactly `ctag+1 .. now`
#     (`cov` together with `nogap_*`).
#
#   * The cache is irrelevant to this proof.  Its implementation is
#     hidden, so `cache_to_lsq_creq_ready` and the whole response
#     channel are free inputs here, and the only thing assumed about
#     them is `cache_correct` below.
#
# The correctness statement is `resp` at the bottom: whenever the LSQ
# hands a datum back to the cpu, the address and the datum are those of
# the corresponding operation in the trace.
# ==================================================================

isolate lsq_body = {

    # ---- cache request channel: the request is driven here, the ready
    # comes from the cache ----
    wire lsq_to_cache_req_en     : bool
    wire lsq_to_cache_req_h      : line
    wire lsq_to_cache_req_o      : woffset
    wire lsq_to_cache_req_wen    : bool
    wire lsq_to_cache_req_wdata  : word
    wire lsq_to_cache_req_rid    : load_idx
    wire cache_to_lsq_creq_ready : bool

    # ---- cache response channel: all driven by the cache.  The echoed
    # address (`cache_to_lsq_resp_h`, `cache_to_lsq_resp_o`) is not used:
    # a response is matched to its load by `cache_to_lsq_resp_rid`, and
    # the address handed back to the cpu is the one the load queue
    # recorded when the operation arrived. ----
    wire cache_to_lsq_resp_valid : bool
    wire cache_to_lsq_resp_h     : line
    wire cache_to_lsq_resp_o     : woffset
    wire cache_to_lsq_resp_data  : word
    wire cache_to_lsq_resp_rid   : load_idx

    # ---- proof observation port.  The specification below watches the
    # datapath through these wires instead of reading its registers
    # directly.  It has to: `lsq_body`'s specification is visible in every
    # isolate that closes `with this`, so a register named there becomes
    # an interference symbol, and the datapath monitor -- hidden in those
    # isolates -- is then seen writing visible state.  A wire is exempt,
    # because its value is frozen at the pre-edge state for the whole
    # action and its defining equation stays inside `implementation`. ----
    wire ld_ans  : bool              # the head load is answered this edge
    wire st_go   : bool              # the cache takes the store on the port
    wire ld_head : load_idx          # the load queue's pointers, pre-edge
    wire ld_next : load_idx
    wire st_head : store_idx         # the store queue's pointers, pre-edge
    wire st_next : store_idx

    # ==================================================================
    # Specification.  The reference tags, the assumption about the cache
    # and the ghost bookkeeping live here, so the datapath in
    # `implementation` below carries no proof-only state.
    # ==================================================================
    specification {

        # ============ ghost state: the reference tags ============

        var ctag : tag                      # last operation to leave the LSQ
        function stag(J : store_idx) : tag  # tag of store-queue entry J
        function ltag(K : load_idx)  : tag  # tag of load-queue entry K
        var cpu_tag_r : tag                 # tag the response port answers

        after init {
            ctag := 0;
        }

        # ==============================================================
        # `cache_correct` -- the one assumption about the cache, and the
        # only thing this proof takes on trust.  When the cache answers a
        # load it returns the reference's memory image at `ctag`, the
        # operation the LSQ last let through.
        #
        # This is faithful because a request is held on the port until
        # the cache takes it and `ctag` advances exactly then, so the
        # image the cache computes from is the image at `ctag`; and
        # because nothing else may leave the LSQ while a load is
        # outstanding (`outst`), `ctag` still stands there when the datum
        # comes back.  Nothing else about the cache is used: its
        # implementation is hidden from this isolate, so the whole
        # response channel is a free input constrained only by this.
        #
        # It is stated against the reference alone: `l_kind` gives
        # `op_addr(ltag(K)) = load_queue(K).load_addr` for a pending load,
        # so naming the address the cache answered for needs no datapath
        # read -- which the specification is not allowed to make anyway.
        # ==============================================================
        before posedge {
            assume [cache_correct]
                cache_to_lsq_resp_valid & ld_head <= cache_to_lsq_resp_rid
                    & cache_to_lsq_resp_rid < ld_next ->
                cache_to_lsq_resp_data =
                    trace.st(ctag).mem(op_addr(ltag(cache_to_lsq_resp_rid)));
        }

        # ==============================================================
        # Ghost bookkeeping: the reference tags and the `trace.step` call.
        # These exist only for the proof, so they live in their own
        # monitor and the datapath monitor is free of them.
        #
        # This block sits in `specification`, which is declared *before*
        # `implementation`, so it runs first and every test here reads the
        # pre-edge datapath state -- exactly the state the matching
        # datapath test reads.  The order is also what makes `forward`
        # provable: the datapath calls it in step 4, after step 2 has
        # absorbed the head store, and its loop invariants are stated
        # against the `ctag` that this block has already advanced past
        # that store.
        # ==============================================================
        after posedge {

            # ---------- the head load is answered, so it leaves ----------
            if ld_ans {
                cpu_tag_r := ltag(ld_head);     # the tag the port answers
                ctag      := ltag(ld_head);
            };

            # ---------- the cache takes the store on the port ----------
            if st_go {
                ctag := stag(st_head);
            };

            # ---------- the cpu hands over an operation ----------
            if cpu.ready {
                call trace.step;                # the reference runs it
                if cpu.req_wen {
                    stag(st_next) := trace.now;
                } else {
                    ltag(ld_next) := trace.now;
                };
            };
        }
    }

    implementation {

        # ============ datapath state ============

        function store_queue(J : store_idx) : store_queue_entry
        var store_head : store_idx
        var store_next : store_idx

        function load_queue(K : load_idx) : load_queue_entry
        var load_head : load_idx
        var load_next : load_idx

        # ---- the request held on the cache port until the cache takes it ----
        var req_en_r    : bool
        var req_addr_r  : addr
        var req_wen_r   : bool
        var req_wdata_r : word
        var req_rid_r   : load_idx

        # ---- the head load has been taken by the cache and its datum is
        # still to come ----
        var load_out : bool

        # ---- the response port back to the cpu ----
        var cpu_valid_r : bool
        var cpu_addr_r  : addr
        var cpu_data_r  : word
        var cpu_ready_r : bool

        after init {
            store_head := 0; store_next := 0;
            load_head  := 0; load_next  := 0;
            store_queue(J).store_mark := 0;
            load_queue(K).load_mark   := 0;
            load_queue(K).load_fwd    := false;
            req_en_r    := false;
            load_out    := false;
            cpu_valid_r := false;
            cpu_ready_r := true;
        }

        relation store_pending(J : store_idx)
        definition store_pending(J) = store_head <= J & J < store_next
        relation load_pending(K : load_idx)
        definition load_pending(K) = load_head <= K & K < load_next

        # ---- Consistency.  A store may go to the cache only once every
        # load that arrived before it has been answered, and a load may be
        # answered only once every store that arrived before it has gone
        # to the cache.  The marks recorded at arrival are what these two
        # tests compare, and together they make the operations leave the
        # LSQ in the order they arrived. ----
        relation store_elig(J : store_idx)
        definition store_elig(J) = load_head >= store_queue(J).store_mark
        relation load_elig(K : load_idx)
        definition load_elig(K) = store_head >= load_queue(K).load_mark

        # ============ output wires ============

        definition lsq_to_cache_req_en    = req_en_r
        definition lsq_to_cache_req_h     = high(req_addr_r)
        definition lsq_to_cache_req_o     = low(req_addr_r)
        definition lsq_to_cache_req_wen   = req_wen_r
        definition lsq_to_cache_req_wdata = req_wdata_r
        definition lsq_to_cache_req_rid   = req_rid_r

        definition cpu.valid     = cpu_valid_r
        definition cpu.resp_addr = cpu_addr_r
        definition cpu.data      = cpu_data_r
        definition cpu.ready     = cpu_ready_r

        # ---- the proof observation port ----
        definition ld_ans  = load_head < load_next & load_elig(load_head)
            & ( load_queue(load_head).load_fwd
              | (load_out & cache_to_lsq_resp_valid
                 & cache_to_lsq_resp_rid = load_head) )
        definition st_go   = req_en_r & cache_to_lsq_creq_ready & req_wen_r
        definition ld_head = load_head
        definition ld_next = load_next
        definition st_head = store_head
        definition st_next = store_next

        # ==============================================================
        # Store-to-load forwarding: the datum of the newest pending store
        # to `a`, if there is one.  Walk the store queue from the oldest
        # entry to the newest keeping the last match; `ct` is the tag of
        # the last entry walked past, so the invariant says the reference
        # image at `ct` is either the datum kept or -- if nothing matched
        # -- still the image the cache holds.  On exit `j = store_next`
        # and `s_imgN` carries `ct` up to `now`.
        # ==============================================================
        action forward(a : addr) returns (r : fwd_result) = {
            var hit : bool := false;
            var dat : word;
            var ct  : tag := ctag;
            var j   : store_idx := store_head;
            while j < store_next
            invariant store_head <= j & j <= store_next
            invariant (j = store_head & ct = ctag)
                    | (store_head < j & ct = stag(j-1))
            invariant hit  -> dat = trace.st(ct).mem(a)
            invariant ~hit -> trace.st(ct).mem(a) = trace.st(ctag).mem(a)
            {
                if store_queue(j).store_addr = a {
                    hit := true;
                    dat := store_queue(j).store_data;
                };
                ct := stag(j);
                j  := j + 1;
            };
            r.fr_hit  := hit;
            r.fr_data := dat;
        }

        # ==============================================================
        # The datapath.  No ghost state is read or written here.
        # ==============================================================
        after posedge {

            # ---------- 1. answer the load at the head of the queue ----------
            cpu_valid_r := false;
            if ld_ans {
                cpu_valid_r := true;
                cpu_addr_r  := load_queue(load_head).load_addr;
                if load_queue(load_head).load_fwd {
                    cpu_data_r := load_queue(load_head).load_fdata;
                } else {
                    cpu_data_r := cache_to_lsq_resp_data;
                    load_out   := false;
                };
                load_head := load_head + 1;
            };

            # ---------- 2. the cache takes the request on the port ----------
            if req_en_r & cache_to_lsq_creq_ready {
                req_en_r := false;
                if st_go {
                    store_head := store_head + 1;
                } else {
                    load_out := true;
                };
            };

            # ---------- 3. present the next request to the cache ----------
            if ~req_en_r {
                if store_head < store_next & store_elig(store_head) {
                    req_en_r    := true;
                    req_wen_r   := true;
                    req_addr_r  := store_queue(store_head).store_addr;
                    req_wdata_r := store_queue(store_head).store_data;
                } else { if load_head < load_next & load_elig(load_head)
                            & ~load_queue(load_head).load_fwd & ~load_out {
                    req_en_r   := true;
                    req_wen_r  := false;
                    req_addr_r := load_queue(load_head).load_addr;
                    req_rid_r  := load_head;
                } };
            };

            # ---------- 4. accept the next operation from the cpu ----------
            if cpu.ready {
                if cpu.req_wen {
                    store_queue(store_next).store_addr := cpu.req_addr;
                    store_queue(store_next).store_data := cpu.req_wdata;
                    store_queue(store_next).store_mark := load_next;
                    store_next := store_next + 1;
                } else {
                    var fr : fwd_result;
                    fr := forward(cpu.req_addr);
                    load_queue(load_next).load_addr  := cpu.req_addr;
                    load_queue(load_next).load_fwd   := fr.fr_hit;
                    load_queue(load_next).load_fdata := fr.fr_data;
                    load_queue(load_next).load_mark  := store_next;
                    load_next := load_next + 1;
                };
            };

            # ---------- 5. recycle the indices when the LSQ is empty ----------
            if store_head = store_next & load_head = load_next {
                store_head := 0; store_next := 0;
                load_head  := 0; load_next  := 0;
                store_queue(J).store_mark := 0;
                load_queue(K).load_mark   := 0;
            };

            # ---------- 6. room for another operation next cycle ----------
            cpu_ready_r := store_next < 4 & load_next < 4;
        }

        # ==============================================================
        # Queue structure.
        # ==============================================================

        invariant [q_s] store_head <= store_next & store_next <= 4
        invariant [q_l] load_head <= load_next & load_next <= 4
        invariant [q_rdy] cpu_ready_r -> store_next < 4 & load_next < 4

        # ==============================================================
        # Each entry is the operation its tag names, the tags increase
        # along each queue, and every pending tag lies in (ctag, now].
        # ==============================================================

        invariant [c_now] ctag <= trace.now
        invariant [s_range] store_pending(J) ->
            ctag < stag(J) & stag(J) <= trace.now
        invariant [l_range] load_pending(K) ->
            ctag < ltag(K) & ltag(K) <= trace.now
        invariant [s_kind] store_pending(J) ->
              op_wen(stag(J))
            & op_addr(stag(J))  = store_queue(J).store_addr
            & op_wdata(stag(J)) = store_queue(J).store_data
        invariant [l_kind] load_pending(K) ->
              ~op_wen(ltag(K))
            & op_addr(ltag(K)) = load_queue(K).load_addr
        invariant [s_mono] store_pending(J1) & store_pending(J2) & J1 < J2 ->
            stag(J1) < stag(J2)
        invariant [l_mono] load_pending(K1) & load_pending(K2) & K1 < K2 ->
            ltag(K1) < ltag(K2)

        # ==============================================================
        # The marks interleave the two queues: `store_mark(J)` counts the
        # loads that arrived before store J, so a load is older than
        # store J exactly when its index is below that count.  These are
        # what turn the eligibility tests into statements about tags.
        # ==============================================================

        invariant [m_s] store_pending(J) ->
            load_head <= store_queue(J).store_mark
            & store_queue(J).store_mark <= load_next
        invariant [m_l] load_pending(K) ->
            store_head <= load_queue(K).load_mark
            & load_queue(K).load_mark <= store_next
        invariant [m_mono_s] store_pending(J1) & store_pending(J2) & J1 <= J2 ->
            store_queue(J1).store_mark <= store_queue(J2).store_mark
        invariant [m_mono_l] load_pending(K1) & load_pending(K2) & K1 <= K2 ->
            load_queue(K1).load_mark <= load_queue(K2).load_mark
        invariant [cross_s] store_pending(J) & load_pending(K) ->
            (stag(J) < ltag(K) <-> K >= store_queue(J).store_mark)
        invariant [cross_l] store_pending(J) & load_pending(K) ->
            (ltag(K) < stag(J) <-> J >= load_queue(K).load_mark)

        # ==============================================================
        # The LSQ holds exactly the operations after `ctag`: the oldest
        # pending entry is the operation right after `ctag` (`cov`), and
        # the operation right after any pending entry is again pending --
        # the next entry of the same queue if no operation of the other
        # kind arrived in between, and the oldest younger entry of the
        # other queue if one did (`nogap_*`).  `newest_*` closes the
        # other end: an entry with nothing behind it carries `now`.
        # ==============================================================

        invariant [cov] ctag < trace.now ->
              (store_pending(store_head) & tag.succ(ctag, stag(store_head)))
            | (load_pending(load_head)   & tag.succ(ctag, ltag(load_head)))

        invariant [newest_s] store_pending(J) & J + 1 = store_next
            & store_queue(J).store_mark = load_next -> stag(J) = trace.now
        invariant [newest_l] load_pending(K) & K + 1 = load_next
            & load_queue(K).load_mark = store_next -> ltag(K) = trace.now

        invariant [nogap_ss] store_pending(J) & J + 1 < store_next
            & store_queue(J+1).store_mark = store_queue(J).store_mark ->
            tag.succ(stag(J), stag(J+1))
        invariant [nogap_sl] store_pending(J)
            & store_queue(J).store_mark < load_next
            & (J + 1 >= store_next
               | store_queue(J).store_mark < store_queue(J+1).store_mark) ->
            tag.succ(stag(J), ltag(store_queue(J).store_mark))
        invariant [nogap_s0] store_pending(J) & stag(J) < trace.now ->
              (J + 1 < store_next
               & store_queue(J+1).store_mark = store_queue(J).store_mark)
            | store_queue(J).store_mark < load_next

        invariant [nogap_ll] load_pending(K) & K + 1 < load_next
            & load_queue(K+1).load_mark = load_queue(K).load_mark ->
            tag.succ(ltag(K), ltag(K+1))
        invariant [nogap_ls] load_pending(K)
            & load_queue(K).load_mark < store_next
            & (K + 1 >= load_next
               | load_queue(K).load_mark < load_queue(K+1).load_mark) ->
            tag.succ(ltag(K), stag(load_queue(K).load_mark))
        invariant [nogap_l0] load_pending(K) & ltag(K) < trace.now ->
              (K + 1 < load_next
               & load_queue(K+1).load_mark = load_queue(K).load_mark)
            | load_queue(K).load_mark < store_next

        # ==============================================================
        # Data.  The store queue is a chain of memory images: the image
        # right after store J differs from the image right after store
        # J-1 only at store J's own address (`s_img`), the oldest pending
        # store hangs off the image the cache holds (`s_img0`), and the
        # newest pending store carries the reference's current image
        # (`s_imgN`).  Walking that chain is what the forwarding loop
        # does, and it is also why no quantified "no store to A in
        # between" fact -- which would put a function from an address back
        # to a queue index in the instantiation graph and take the goals
        # out of the decidable fragment -- is needed anywhere.
        # ==============================================================

        invariant [s_img] store_pending(J) & store_head < J ->
            trace.st(stag(J)).mem(A) = (store_queue(J).store_data
                if A = store_queue(J).store_addr
                else trace.st(stag(J-1)).mem(A))
        invariant [s_img0] store_pending(store_head) ->
            trace.st(stag(store_head)).mem(A) = (store_queue(store_head).store_data
                if A = store_queue(store_head).store_addr
                else trace.st(ctag).mem(A))
        invariant [s_imgN]
              (store_head = store_next ->
                 trace.st(trace.now).mem(A) = trace.st(ctag).mem(A))
            & (store_head < store_next ->
                 trace.st(trace.now).mem(A) = trace.st(stag(store_next-1)).mem(A))

        # ---- a forwarded datum is already the datum the reference's read
        # returned; `st(T)` never changes once T is recorded, so this only
        # has to be established when the load arrives ----
        invariant [l_fwd] load_pending(K) & load_queue(K).load_fwd ->
            load_queue(K).load_fdata = trace.st(ltag(K)).rdata

        # ==============================================================
        # The request on the cache port, and the outstanding load.  These
        # say a presented request is still the head entry of its queue and
        # was eligible when presented, which is what makes a store
        # absorption and a load answer mutually exclusive -- so `ctag`
        # only ever has to advance by one operation per edge.
        # ==============================================================

        invariant [pres_s] req_en_r & req_wen_r ->
              store_pending(store_head)
            & store_elig(store_head)
            & req_addr_r  = store_queue(store_head).store_addr
            & req_wdata_r = store_queue(store_head).store_data
        invariant [pres_l] req_en_r & ~req_wen_r ->
              load_pending(load_head)
            & req_rid_r = load_head
            & load_elig(load_head)
            & ~load_queue(load_head).load_fwd
            & ~load_out
        invariant [outst] load_out ->
              load_pending(load_head)
            & load_elig(load_head)
            & ~load_queue(load_head).load_fwd
            & ~req_en_r

        # ==============================================================
        # The correctness statements.
        #
        # `resp`: a datum handed back to the cpu is the datum the
        # reference's read returned, at the address the reference read.
        #
        # `consistency`: the responses come back in program order.  A load
        # sits in the load queue exactly while its response is owed -- it
        # is enqueued when the cpu hands it over and leaves at the edge its
        # datum goes out -- so "no older response is still outstanding" is
        # exactly "every load left in the queue is younger than the one
        # being answered".
        # ==============================================================

        invariant [resp] cpu_valid_r ->
              ~op_wen(cpu_tag_r)
            & cpu_tag_r <= trace.now
            & cpu_addr_r = op_addr(cpu_tag_r)
            & cpu_data_r = trace.st(cpu_tag_r).rdata

        invariant [consistency] cpu_valid_r & load_pending(K) ->
            cpu_tag_r < ltag(K)
    }

} with this, trace, abs_memory, addr_thy, basis

type mshr_state = { mshr_idle, mshr_req_lower, mshr_finished_lower, mshr_req_upper, mshr_drain }
type dphase = { dp_resp, dp_wb_lo, dp_wb_hi, dp_fill }

type mshr_entry = struct {
    m_state  : mshr_state,
    m_base   : line,

    # ---- the single in-flight request this MSHR holds.  `ready_r`
    # drops as soon as either slot is occupied, so the cache absorbs
    # nothing more until it has been replayed into the fill buffer:
    # a second slot could never be reached.  cache_proof.md's closing
    # paragraph asks for depth one; taking it structurally rather than
    # as an invariant is what makes the fill buffer have a single
    # reference point, and hence what makes 1.2 provable. ----
    rq_valid : bool,
    rq_off   : woffset,
    rq_wen   : bool,
    rq_wdata : word,
    rq_rid   : load_idx,
    m_fbuf(O : woffset) : word,
    m_dirty  : bool,
    m_dphase : dphase,
    m_victim_way : way
}

type cache_entry = struct {
    occupied : bool,
    dirty    : bool,
    ltag     : line,
    lru      : bit,
    val(O : woffset) : word
}

# ==================================================================
# The cache, and below it the memory controller.  Both are datapath
# only.  This file proves the LSQ, and the only thing the LSQ is
# allowed to know about the cache is `cache_correct`, the assumption in
# `lsq_body`'s specification -- so neither isolate carries a reference
# tag, a ghost image, or an invariant.  They are here so the model is a
# complete machine and the LSQ's ports are driven by something real.
# Discharging `cache_correct` is the next piece of work and belongs to
# the isolate that will enclose both, not to this one.
# ==================================================================

isolate cache_body = {

    # ---- LSQ request channel: the request comes from the LSQ, the ready
    # is driven here ----
    wire lsq_to_cache_req_en     : bool
    wire lsq_to_cache_req_h      : line
    wire lsq_to_cache_req_o      : woffset
    wire lsq_to_cache_req_wen    : bool
    wire lsq_to_cache_req_wdata  : word
    wire lsq_to_cache_req_rid    : load_idx
    wire cache_to_lsq_creq_ready : bool

    # ---- LSQ response channel: all driven here ----
    wire cache_to_lsq_resp_valid : bool
    wire cache_to_lsq_resp_h     : line
    wire cache_to_lsq_resp_o     : woffset
    wire cache_to_lsq_resp_data  : word
    wire cache_to_lsq_resp_rid   : load_idx

    # ---- memory command channel: the command is driven here, the ready
    # comes from the memory controller ----
    wire cmd_en    : bool
    wire cmd_wen   : bool
    wire cmd_addr  : addr
    wire cmd_data  : four_words
    wire cmd_ready : bool

    # ---- memory response channel: all driven by the memory controller ----
    wire rsp_valid : bool
    wire rsp_addr  : addr
    wire rsp_data  : four_words

    implementation {
        function cache(K : key, W : way) : cache_entry

        function mshr(Id : mshr_id) : mshr_entry

        var ready_r : bool

        var port_used : bool

        var ev_ans      : bool
        var ev_ans_h    : line
        var ev_ans_o    : woffset
        var ev_ans_d    : word
        var ev_ans_rid  : load_idx
        var ev_cmd      : bool
        var ev_cmd_wen  : bool
        var ev_cmd_addr : addr
        var ev_cmd_data : four_words

        after init {
            occupied(cache(K,W)) := false;
            dirty(cache(K,W)) := false;
            ltag(cache(K,W)) := 0;
            lru(cache(K,W)) := 0;
            val(cache(K,W), O) := 0;
            m_state(mshr(Id))  := mshr_idle;
            m_base(mshr(Id))   := 0;
            m_dirty(mshr(Id))  := false;
            m_dphase(mshr(Id)) := dp_resp;
            m_victim_way(mshr(Id)) := w0;
            m_fbuf(mshr(Id), O) := 0;
            rq_valid(mshr(Id))  := false;
            rq_off(mshr(Id))    := 0;
            rq_wen(mshr(Id))    := false;
            rq_wdata(mshr(Id))  := 0;
            rq_rid(mshr(Id))    := 0;
            ready_r    := true;
            port_used  := false;
            ev_ans := false; ev_ans_h := 0; ev_ans_o := 0;
            ev_ans_d := 0; ev_ans_rid := 0;
            ev_cmd := false; ev_cmd_wen := false; ev_cmd_addr := 0;
            ev_cmd_data := mzero;
        }

        # ---- An MSHR is "full" as soon as it holds its one unserviced
        # request, so `ready_r` drops and the cache absorbs nothing more
        # until that request has been replayed into the fill buffer.
        #
        # This is cache_proof.md's closing paragraph, taken at the cache
        # end: it costs throughput -- a second miss to an unrelated line
        # now waits -- and buys the fill buffer a single reference point.
        # Because `ready_r` demands *both* slots empty, at most one slot
        # is ever occupied (`one_slot`) and `current` cannot advance
        # while it is (`rdy_ok`), which is what pins the fill buffer
        # to a single tag and makes `f_img_*` -- and hence 1.2 -- go
        # through with no ghost tag anywhere. ----
        relation mshr_full(Id : mshr_id)
        definition mshr_full(Id) = rq_valid(mshr(Id))

        relation evicting(Id : mshr_id)
        definition evicting(Id) = (m_state(mshr(Id)) = mshr_drain
            & (m_dphase(mshr(Id)) = dp_wb_lo | m_dphase(mshr(Id)) = dp_wb_hi | m_dphase(mshr(Id)) = dp_fill))

        # ---- the output wires are driven by the registers that hold the
        # cache's response and command ports ----
        definition cache_to_lsq_creq_ready = ready_r

        definition cache_to_lsq_resp_valid = ev_ans
        definition cache_to_lsq_resp_h     = ev_ans_h
        definition cache_to_lsq_resp_o     = ev_ans_o
        definition cache_to_lsq_resp_data  = ev_ans_d
        definition cache_to_lsq_resp_rid   = ev_ans_rid

        definition cmd_en   = ev_cmd
        definition cmd_wen  = ev_cmd_wen
        definition cmd_addr = ev_cmd_addr
        definition cmd_data = ev_cmd_data

        action enqueue(id : mshr_id, off : woffset, wen : bool, wd : word,
                       rid : load_idx) = {
            rq_valid(mshr(id)) := true;
            rq_off(mshr(id))   := off;
            rq_wen(mshr(id))   := wen;
            rq_wdata(mshr(id)) := wd;
            rq_rid(mshr(id))   := rid;
        }

        action svc_head(id : mshr_id) = {
            if rq_wen(mshr(id)) {
                m_fbuf(mshr(id), rq_off(mshr(id))) := rq_wdata(mshr(id));
                m_dirty(mshr(id))  := true;
                rq_valid(mshr(id)) := false;
            } else {
                if ~port_used & ~cache_to_lsq_resp_valid {
                    ev_ans       := true;
                    ev_ans_h     := m_base(mshr(id));
                    ev_ans_o     := rq_off(mshr(id));
                    ev_ans_d     := m_fbuf(mshr(id), rq_off(mshr(id)));
                    ev_ans_rid   := rq_rid(mshr(id));
                    port_used    := true;
                    rq_valid(mshr(id)) := false;
                };
            };
        }

        action do_fill(id : mshr_id) = {
            var vk   : key := hash(m_base(mshr(id)));
            var vw   : way := m_victim_way(mshr(id));
            var oway : way := w1;
            if vw = w1 { oway := w0; };
            ltag(cache(vk, vw))     := m_base(mshr(id));
            val(cache(vk, vw), O)   := m_fbuf(mshr(id), O);
            dirty(cache(vk, vw))    := m_dirty(mshr(id));
            occupied(cache(vk, vw)) := true;
            lru(cache(vk, vw))   := 0;
            lru(cache(vk, oway)) := 1;
            m_state(mshr(id)) := mshr_idle;
        }

        action drain_step(id : mshr_id) = {
            if m_state(mshr(id)) = mshr_drain {
                if m_dphase(mshr(id)) = dp_resp {
                    if rq_valid(mshr(id)) {
                        call svc_head(id);
                    } else {
                        var vw : way := w1;
                        if lru(cache(hash(m_base(mshr(id))), w1)) = 1 { vw := w0; };
                        var oid : mshr_id := 1;
                        if id = 1 { oid := 0; };
                        if evicting(oid) & hash(m_base(mshr(oid))) = hash(m_base(mshr(id))) {
                            if m_victim_way(mshr(oid)) = w0 { vw := w1; } else { vw := w0; };
                        };
                        m_victim_way(mshr(id)) := vw;
                        if occupied(cache(hash(m_base(mshr(id))), vw))
                           & dirty(cache(hash(m_base(mshr(id))), vw)) {
                            m_dphase(mshr(id)) := dp_wb_lo;
                        } else {
                            call do_fill(id);
                        };
                    };
                } else { if m_dphase(mshr(id)) = dp_fill {
                    call do_fill(id);
                } };
            };
        }

        action issue_wb(id : mshr_id, b : bit) = {
            var vk : key := hash(m_base(mshr(id)));
            var vw : way := m_victim_way(mshr(id));
            ev_cmd      := true;
            ev_cmd_wen  := true;
            ev_cmd_addr := concatbv3(ltag(cache(vk, vw)), concatbv2(b, 0));
            ev_cmd_data := pack4(val(cache(vk, vw), concatbv2(b,3)),
                                 val(cache(vk, vw), concatbv2(b,2)),
                                 val(cache(vk, vw), concatbv2(b,1)),
                                 val(cache(vk, vw), concatbv2(b,0)));
        }

        action issue_rd(id : mshr_id, b : bit) = {
            ev_cmd      := true;
            ev_cmd_wen  := false;
            ev_cmd_addr := concatbv3(m_base(mshr(id)), concatbv2(b, 0));
            ev_cmd_data := mzero;
        }

        action serve_request = {
            var h  : line    := lsq_to_cache_req_h;
            var o  : woffset := lsq_to_cache_req_o;
            var wen : bool   := lsq_to_cache_req_wen;
            var d  : word    := lsq_to_cache_req_wdata;
            var rid : load_idx := lsq_to_cache_req_rid;
            var a  : addr    := concatbv3(h, o);
            var rs : key     := hash(h);
            var hit  : bool  := false;
            var hway : way   := w1;
            if occupied(cache(rs, w1)) & ltag(cache(rs, w1)) = h { hit:=true; hway:=w1; }
            else { if occupied(cache(rs, w0)) & ltag(cache(rs, w0)) = h { hit:=true; hway:=w0; } };
            if hit {
                if ~wen {
                    ev_ans      := true;
                    ev_ans_h    := h;
                    ev_ans_o    := o;
                    ev_ans_d    := val(cache(rs, hway), o);
                    ev_ans_rid  := rid;
                    port_used := true;
                } else {
                    val(cache(rs, hway), o) := d;
                    dirty(cache(rs, hway))  := true;
                };
                if hway = w1 { lru(cache(rs, w0)):=1; lru(cache(rs, w1)):=0; }
                else         { lru(cache(rs, w0)):=0; lru(cache(rs, w1)):=1; };
            } else {
                var owner_found : bool := false;
                var owner : mshr_id := 0;
                if m_state(mshr(0)) ~= mshr_idle & m_base(mshr(0)) = h { owner_found:=true; owner:=0; }
                else { if m_state(mshr(1)) ~= mshr_idle & m_base(mshr(1)) = h { owner_found:=true; owner:=1; } };
                if owner_found {
                    call enqueue(owner, o, wen, d, rid);
                } else {
                    var aid : mshr_id := 0;
                    if m_state(mshr(0)) ~= mshr_idle { aid := 1; };
                    m_state(mshr(aid))  := mshr_req_lower;
                    m_base(mshr(aid))   := h;
                    m_dirty(mshr(aid))  := false;
                    m_dphase(mshr(aid)) := dp_resp;
                    call enqueue(aid, o, wen, d, rid);
                };
            };
        }

        action capture = {
            var a : addr := rsp_addr;
            var d : four_words := rsp_data;
            if m_state(mshr(0)) = mshr_req_lower & a = concatbv3(m_base(mshr(0)), concatbv2(0,0)) {
                m_fbuf(mshr(0), concatbv2(0,0)) := unp0(d);
                m_fbuf(mshr(0), concatbv2(0,1)) := unp1(d);
                m_fbuf(mshr(0), concatbv2(0,2)) := unp2(d);
                m_fbuf(mshr(0), concatbv2(0,3)) := unp3(d);
                m_state(mshr(0)) := mshr_finished_lower;
            } else { if m_state(mshr(0)) = mshr_req_upper & a = concatbv3(m_base(mshr(0)), concatbv2(1,0)) {
                m_fbuf(mshr(0), concatbv2(1,0)) := unp0(d);
                m_fbuf(mshr(0), concatbv2(1,1)) := unp1(d);
                m_fbuf(mshr(0), concatbv2(1,2)) := unp2(d);
                m_fbuf(mshr(0), concatbv2(1,3)) := unp3(d);
                m_state(mshr(0)) := mshr_drain;
                m_dphase(mshr(0)) := dp_resp;
            } };
            if m_state(mshr(1)) = mshr_req_lower & a = concatbv3(m_base(mshr(1)), concatbv2(0,0)) {
                m_fbuf(mshr(1), concatbv2(0,0)) := unp0(d);
                m_fbuf(mshr(1), concatbv2(0,1)) := unp1(d);
                m_fbuf(mshr(1), concatbv2(0,2)) := unp2(d);
                m_fbuf(mshr(1), concatbv2(0,3)) := unp3(d);
                m_state(mshr(1)) := mshr_finished_lower;
            } else { if m_state(mshr(1)) = mshr_req_upper & a = concatbv3(m_base(mshr(1)), concatbv2(1,0)) {
                m_fbuf(mshr(1), concatbv2(1,0)) := unp0(d);
                m_fbuf(mshr(1), concatbv2(1,1)) := unp1(d);
                m_fbuf(mshr(1), concatbv2(1,2)) := unp2(d);
                m_fbuf(mshr(1), concatbv2(1,3)) := unp3(d);
                m_state(mshr(1)) := mshr_drain;
                m_dphase(mshr(1)) := dp_resp;
            } };
        }

        after posedge {
            port_used := false;
            ev_ans   := false; ev_cmd := false;

            if rsp_valid {
                call capture;
            };

            if cmd_ready {
                if m_state(mshr(0)) = mshr_drain & m_dphase(mshr(0)) = dp_wb_lo {
                    call issue_wb(0, 0); m_dphase(mshr(0)) := dp_wb_hi;
                } else { if m_state(mshr(0)) = mshr_drain & m_dphase(mshr(0)) = dp_wb_hi {
                    call issue_wb(0, 1); m_dphase(mshr(0)) := dp_fill;
                } else { if m_state(mshr(1)) = mshr_drain & m_dphase(mshr(1)) = dp_wb_lo {
                    call issue_wb(1, 0); m_dphase(mshr(1)) := dp_wb_hi;
                } else { if m_state(mshr(1)) = mshr_drain & m_dphase(mshr(1)) = dp_wb_hi {
                    call issue_wb(1, 1); m_dphase(mshr(1)) := dp_fill;
                } else { if m_state(mshr(0)) = mshr_req_lower {
                    call issue_rd(0, 0);
                } else { if m_state(mshr(0)) = mshr_finished_lower {
                    call issue_rd(0, 1); m_state(mshr(0)) := mshr_req_upper;
                } else { if m_state(mshr(1)) = mshr_req_lower {
                    call issue_rd(1, 0);
                } else { if m_state(mshr(1)) = mshr_finished_lower {
                    call issue_rd(1, 1); m_state(mshr(1)) := mshr_req_upper;
                } } } } } } } };
            };

            if lsq_to_cache_req_en & ready_r & ~cache_to_lsq_resp_valid {
                call serve_request;
            };

            call drain_step(0);
            call drain_step(1);

            ready_r := ~(mshr_full(0) | mshr_full(1))
                        & (m_state(mshr(0)) = mshr_idle | m_state(mshr(1)) = mshr_idle)
                        & ~evicting(0) & ~evicting(1);
        }

    }

} with this, addr_thy, basis

isolate mc_body = {

    # ---- cache command channel: the command comes from the cache, the
    # ready is driven here ----
    wire cmd_en    : bool
    wire cmd_wen   : bool
    wire cmd_addr  : addr
    wire cmd_data  : four_words
    wire cmd_ready : bool

    # ---- cache response channel: all driven here ----
    wire rsp_valid : bool
    wire rsp_addr  : addr
    wire rsp_data  : four_words

    # ==================================================================
    # The controller is datapath only.  Its memory is real hardware --
    # the DRAM behind the port -- and nothing outside this isolate reads
    # it, so it needs no specification block and carries no invariants:
    # this file proves the LSQ, and the cache and the controller are
    # here only so the model is a complete machine.
    #
    # The write is unbuffered and is applied from the command wires
    # alone: a command lands in memory on the edge the port carries it,
    # one edge after the cache issued it.  The buffer below delays only
    # the *response*, and the write is applied at the top of the edge,
    # so a read never overtakes a write to the same beat.
    # ==================================================================
    implementation {

        function mmem(A : addr) : word

        # ---- the command buffer ----
        var cb0_valid : bool
        var cb0_wen   : bool
        var cb0_addr  : addr
        var cb1_valid : bool
        var cb1_wen   : bool
        var cb1_addr  : addr
        var svc_count : nat

        # ---- the registers driving the response port ----
        var rsp_valid_r : bool
        var rsp_addr_r  : addr
        var rsp_data_r  : four_words

        after init {
            mmem(A) := init_mem(A);
            cb0_valid := false; cb0_wen := false; cb0_addr := 0;
            cb1_valid := false; cb1_wen := false; cb1_addr := 0;
            svc_count := 0;
            rsp_valid_r := false; rsp_addr_r := 0; rsp_data_r := mzero;
        }

        definition cmd_ready = ~(cb0_valid & cb1_valid) & ~cmd_en

        definition rsp_valid = rsp_valid_r
        definition rsp_addr  = rsp_addr_r
        definition rsp_data  = rsp_data_r

        after posedge {
            if cmd_en & cmd_wen {
                mmem(concatbv3(high(cmd_addr), concatbv2(beat_of(low(cmd_addr)), 0))) := unp0(cmd_data);
                mmem(concatbv3(high(cmd_addr), concatbv2(beat_of(low(cmd_addr)), 1))) := unp1(cmd_data);
                mmem(concatbv3(high(cmd_addr), concatbv2(beat_of(low(cmd_addr)), 2))) := unp2(cmd_data);
                mmem(concatbv3(high(cmd_addr), concatbv2(beat_of(low(cmd_addr)), 3))) := unp3(cmd_data);
            };

            rsp_valid_r := false;

            if cmd_en {
                var a : addr := cmd_addr;
                if ~cb0_valid {
                    cb0_valid := true; cb0_wen := cmd_wen; cb0_addr := a;
                    svc_count := mem_latency;
                } else {
                    cb1_valid := true; cb1_wen := cmd_wen; cb1_addr := a;
                };
            };

            if cb0_valid & (cb0_wen | ~rsp_valid) {
                if svc_count = 0 {
                    if ~cb0_wen {
                        var h : line := high(cb0_addr);
                        var b : bit  := beat_of(low(cb0_addr));
                        rsp_valid_r := true;
                        rsp_addr_r  := cb0_addr;
                        rsp_data_r  := pack4(mmem(concatbv3(h, concatbv2(b, 3))),
                                             mmem(concatbv3(h, concatbv2(b, 2))),
                                             mmem(concatbv3(h, concatbv2(b, 1))),
                                             mmem(concatbv3(h, concatbv2(b, 0))));
                    };
                    if cb1_valid {
                        cb0_valid := true; cb0_wen := cb1_wen; cb0_addr := cb1_addr;
                        cb1_valid := false;
                        svc_count := mem_latency;
                    } else {
                        cb0_valid := false;
                    };
                } else {
                    svc_count := svc_count - 1;
                }
            };
        }

    }

} with this, addr_thy, basis

# ------------------------------------------------------------------
# Wire the isolates together.  Each isolate declares the wires on both
# sides of each of its channels; the connections are made here, so no
# isolate can see the logic that drives its inputs.
#
# The cache and the memory controller carry no proof here.  This file
# verifies the LSQ, and the only thing the LSQ is allowed to know about
# the cache is `cache_correct`, the assumption in `lsq_body`'s
# specification.  The channels are still connected, so the model is a
# complete machine and the composition -- which is what will owe a
# proof of `cache_correct` -- has something to close over.  No ghost
# wire crosses these boundaries: the reference tags live entirely
# inside `lsq_body`.
# ------------------------------------------------------------------

# ---- the LSQ's request port drives the cache's ----
definition cache_body.lsq_to_cache_req_en    = lsq_body.lsq_to_cache_req_en
definition cache_body.lsq_to_cache_req_h     = lsq_body.lsq_to_cache_req_h
definition cache_body.lsq_to_cache_req_o     = lsq_body.lsq_to_cache_req_o
definition cache_body.lsq_to_cache_req_wen   = lsq_body.lsq_to_cache_req_wen
definition cache_body.lsq_to_cache_req_wdata = lsq_body.lsq_to_cache_req_wdata
definition cache_body.lsq_to_cache_req_rid   = lsq_body.lsq_to_cache_req_rid

# ---- the cache's response port drives the LSQ's ----
definition lsq_body.cache_to_lsq_creq_ready = cache_body.cache_to_lsq_creq_ready
definition lsq_body.cache_to_lsq_resp_valid = cache_body.cache_to_lsq_resp_valid
definition lsq_body.cache_to_lsq_resp_h     = cache_body.cache_to_lsq_resp_h
definition lsq_body.cache_to_lsq_resp_o     = cache_body.cache_to_lsq_resp_o
definition lsq_body.cache_to_lsq_resp_data  = cache_body.cache_to_lsq_resp_data
definition lsq_body.cache_to_lsq_resp_rid   = cache_body.cache_to_lsq_resp_rid

# ---- the cache's command port drives the memory controller's ----
definition mc_body.cmd_en    = cache_body.cmd_en
definition mc_body.cmd_wen   = cache_body.cmd_wen
definition mc_body.cmd_addr  = cache_body.cmd_addr
definition mc_body.cmd_data  = cache_body.cmd_data

# ---- the memory controller's response port drives the cache's ----
definition cache_body.cmd_ready = mc_body.cmd_ready
definition cache_body.rsp_valid = mc_body.rsp_valid
definition cache_body.rsp_addr  = mc_body.rsp_addr
definition cache_body.rsp_data  = mc_body.rsp_data
