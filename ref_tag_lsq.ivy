#lang ivy1.8

include numbers
include order

type key
type word
type line
type bit
type bv2
type qidx
type mshr_id

# ---- LSQ indices are abstract ordered sequences, not bit vectors.  Nothing
# in the queues needs bit-vector semantics -- only 0, successor and order --
# and quantifying over a bit vector is what makes the coherence goals blow
# up in z3.  This is the same abstraction the reference tag already uses. ----
type store_idx
instance load_idx  : unbounded_sequence

type two_words
type four_words
individual mzero : four_words

function cat_w(H : word, L : word) : two_words
function cat_d(H : two_words, L : two_words) : four_words
function pack4(W3 : word, W2 : word, W1 : word, W0 : word) : four_words
function unp0(M : four_words) : word
function unp1(M : four_words) : word
function unp2(M : four_words) : word
function unp3(M : four_words) : word

function mem_latency : nat

type addr
type woffset
type way

isolate data_impl = {
    interpret word -> bv[64]
    interpret two_words -> bv[128]
    interpret four_words -> bv[256]
    interpret cat_w -> concat
    interpret cat_d -> concat
    definition pack4(W3, W2, W1, W0) = cat_d(cat_w(W3, W2), cat_w(W1, W0))
    definition unp0(M) = bfe[0][63](M)
    definition unp1(M) = bfe[64][127](M)
    definition unp2(M) = bfe[128][191](M)
    definition unp3(M) = bfe[192][255](M)
    definition mzero = 0
}

isolate basis = {
    interpret key -> bv[3]
    interpret bit -> bv[1]
    interpret bv2 -> bv[2]
    interpret qidx -> bv[3]
    interpret mshr_id -> bv[1]
    interpret store_idx -> bv[2]

    property [p_unp0] forall W3 : word, W2 : word, W1 : word, W0 : word. unp0(pack4(W3, W2, W1, W0)) = W0
    property [p_unp1] forall W3 : word, W2 : word, W1 : word, W0 : word. unp1(pack4(W3, W2, W1, W0)) = W1
    property [p_unp2] forall W3 : word, W2 : word, W1 : word, W0 : word. unp2(pack4(W3, W2, W1, W0)) = W2
    property [p_unp3] forall W3 : word, W2 : word, W1 : word, W0 : word. unp3(pack4(W3, W2, W1, W0)) = W3

    definition mem_latency = 8
} with this, data_impl

function concatbv3(H : line, O : woffset) : addr
function high(A : addr) : line
function low(A : addr) : woffset
function concatbv2(B : bit, J : bv2) : woffset
function beat_of(O : woffset) : bit
individual w0 : way
individual w1 : way
function hash(H : line) : key

isolate addr_thy = {
    interpret woffset -> bv[3]
    interpret way -> bv[1]
    interpret concatbv2 -> concat
    definition beat_of(O) = bfe[2][2](O)
    definition w0 = 0
    definition w1 = 1

    property [p_way2]  forall W : way. W = w0 | W = w1
    property [p_way_ne] w0 ~= w1
    property [p_boff_beat]  forall B : bit, J : bv2. beat_of(concatbv2(B, J)) = B
    property [p_cover] forall O : woffset, B : bit. beat_of(O) = B ->
        (O = concatbv2(B, 0) | O = concatbv2(B, 1) | O = concatbv2(B, 2) | O = concatbv2(B, 3))
    property [p_full_inj] forall H1 : line, O1 : woffset, H2 : line, O2 : woffset. (concatbv3(H1, O1) = concatbv3(H2, O2)) -> (H1 = H2 & O1 = O2)
    property [p_highfull] forall H : line, O : woffset. high(concatbv3(H, O)) = H
    property [p_lowfull]  forall H : line, O : woffset. low(concatbv3(H, O)) = O
    property [p_recon] forall A : addr. concatbv3(high(A), low(A)) = A

    # ---- addr and line are ABSTRACT outside this isolate.  The bit-level
    # encoding lives in the implementation, so every other isolate sees a
    # word address as an uninterpreted pair (line, woffset) constrained only
    # by the properties above.  This matters for more than tidiness: with
    # addr = bv[64] and line = bv[61], the coherence goals quantify over
    # 61- and 64-bit bit vectors, which z3 cannot bit-blast and can only
    # attack with MBQI. ----
    implementation {
        interpret addr -> bv[64]
        interpret line -> bv[61]
        definition high(A) = bfe[3][63](A)
        definition low(A) = bfe[0][2](A)
        interpret concatbv3 -> concat

        definition hash(H) = bfe[0][2](H)
    }
} with this, basis

export action posedge

object cpu = {
    wire env_en    : bool
    wire env_addr  : addr
    wire env_wen   : bool
    wire env_wdata : word
    wire req_en    : bool
    wire req_addr  : addr
    wire req_wen   : bool
    wire req_wdata : word
    wire valid     : bool
    wire resp_addr : addr
    wire data      : word
    wire ready : bool

    definition req_en    = env_en & ready
    definition req_addr  = env_addr
    definition req_wen   = env_wen
    definition req_wdata = env_wdata
}

isolate abs_memory = {
    function mem(A : addr) : word
    wire output : word

    after init {
        mem(A) := 0;
        output := 0;
    }

    action write(a : addr, w : word) = {
        mem(a) := w;
    }
    action read(a : addr) = {
        output := mem(a);
    }

    isolate iso = this with this, basis
}

type op_kind = {op_read, op_write}

isolate trace = {
    specification {
        instance tag : unbounded_sequence

        type state_t = struct {
            mem(A : addr) : word,
            op      : op_kind,
            op_addr : addr,
            op_data : word,
            op_done : bool,
            op_lwd  : word
        }

        var now : tag
        var st(T : tag) : state_t

        relation lwc_r(A : addr, W : tag)
        function lwd(A : addr) : word
        relation op_lw_r(R : tag, W : tag)

        relation mshr_wait(Id : mshr_id)
        function mshr_line(Id : mshr_id) : line

        relation cdirty(H : line)

        function ctag(H : line, O : woffset) : tag
        function mtag(H : line, O : woffset) : tag
        var pend_valid : bool
        var pend_a     : addr
        var pend_old   : tag

        function cver(H : line, O : woffset) : tag
        definition cver(H, O) =
            (pend_old if (pend_valid & concatbv3(H,O) = pend_a) else ctag(H, O))
        function cmem(H : line, O : woffset) : word
        definition cmem(H, O) = st(cver(H, O)).mem(concatbv3(H, O))
        function mmemv(H : line, O : woffset) : word
        definition mmemv(H, O) = st(mtag(H, O)).mem(concatbv3(H, O))

        after init {
            mshr_wait(Id) := false;
            mshr_line(Id) := 0;
            cdirty(H) := false;
            ctag(H, O) := 0;
            mtag(H, O) := 0;
            pend_valid := false; pend_a := 0; pend_old := 0;
            now := 0;
            st(T).mem(A : addr) := 0;
            st(T).op      := op_read;
            st(T).op_addr := 0;
            st(T).op_data := 0;
            st(T).op_done := false;
            st(T).op_lwd  := 0;
            lwc_r(A, W)   := W = 0;
            lwd(A)        := 0;
            op_lw_r(R, W) := W = 0;
        }

        action step(h : line, o : woffset, wen : bool, wd : word) = {
            var prev : tag := now;
            now := now.next;
            st(now).mem(A : addr) := st(prev).mem(A);
            st(now).op_addr := concatbv3(h, o);
            st(now).op_done := wen;
            if wen {
                st(now).op      := op_write;
                st(now).op_data := wd;
                st(now).op_lwd  := 0;
                st(now).mem(concatbv3(h, o)) := wd;
                lwc_r(concatbv3(h, o), W) := W = now;
                lwd(concatbv3(h, o)) := wd;
            } else {
                st(now).op      := op_read;
                st(now).op_data := 0;
                st(now).op_lwd  := lwd(concatbv3(h, o));
                op_lw_r(now, W) := lwc_r(concatbv3(h, o), W);
            };
            if wen {
                abs_memory.write(concatbv3(h, o), wd);
            } else {
                abs_memory.read(concatbv3(h, o));
            };
        }

        action observe(t : tag, v : word) = {
            require t ~= 0 & t <= now;
            require st(t).op = op_read & ~st(t).op_done;
            require v = st(t).mem(st(t).op_addr);
            st(t).op_data := v;
            st(t).op_done := true;
        }

        action mshr_alloc(id : mshr_id, h : line) = {
            require ~mshr_wait(id);
            require forall J : mshr_id. mshr_wait(J) -> mshr_line(J) ~= h;
            mshr_wait(id) := true;
            mshr_line(id) := h;
        }
        action mshr_free(id : mshr_id) = {
            mshr_wait(id) := false;
        }

        action dirty_line(h : line) = { cdirty(h) := true; }
        action clean_line(h : line) = { cdirty(h) := false; }

        action present_w(h : line, o : woffset, tg : tag) = {
            require tg <= now;
            pend_valid := true;
            pend_a     := concatbv3(h, o);
            pend_old   := ctag(h, o);
            ctag(h, o) := tg;
        }
        action commit_w = {
            pend_valid := false;
        }
        action wb(h : line, b : bit) = {
            mtag(h, concatbv2(b, 0)) := cver(h, concatbv2(b, 0));
            mtag(h, concatbv2(b, 1)) := cver(h, concatbv2(b, 1));
            mtag(h, concatbv2(b, 2)) := cver(h, concatbv2(b, 2));
            mtag(h, concatbv2(b, 3)) := cver(h, concatbv2(b, 3));
        }

        invariant [mshr_distinct] (mshr_wait(I) & mshr_wait(J) & mshr_line(I) = mshr_line(J)) -> I = J
        invariant [ver_le] ctag(H,O) <= now & mtag(H,O) <= now & pend_old <= now
        invariant [wr_own] (T <= now & st(T).op = op_write) ->
            st(T).mem(st(T).op_addr) = st(T).op_data
        invariant [lw_memd] st(now).mem(A) = lwd(A)
        invariant [lw_memat] (R <= now & st(R).op = op_read) ->
            st(R).mem(st(R).op_addr) = st(R).op_lwd
    }

    implementation {
        invariant [ref_mem] abs_memory.mem(A) = st(now).mem(A)

        invariant [tr_step] (tag.succ(T,U) & U <= now) ->
            st(U).mem(A) = (st(U).op_data if (st(U).op = op_write & A = st(U).op_addr) else st(T).mem(A))

        invariant [lwc_wr] (lwc_r(A,W) & W ~= 0) ->
            (W <= now & st(W).op = op_write & st(W).op_addr = A)
        invariant [lwc_latest] (lwc_r(A,W) & W < V & V <= now & st(V).op = op_write) ->
            st(V).op_addr ~= A
        invariant [lwc_none] (lwc_r(A,0) & V <= now & st(V).op = op_write) ->
            st(V).op_addr ~= A
        invariant [lwc_datum] (lwc_r(A,W) & W ~= 0) -> st(W).op_data = lwd(A)
        invariant [lwc_datum0] lwc_r(A,0) -> lwd(A) = 0
        invariant [lwc_fun] (lwc_r(A,W1) & lwc_r(A,W2)) -> W1 = W2

        invariant [lw_is_wr] (op_lw_r(R,W) & R <= now & st(R).op = op_read & W ~= 0) ->
            (W < R & st(W).op = op_write & st(W).op_addr = st(R).op_addr
             & st(W).op_data = st(R).op_lwd)
        invariant [lw_latest] (op_lw_r(R,W) & R <= now & st(R).op = op_read
             & W < V & V < R & st(V).op = op_write) ->
            st(V).op_addr ~= st(R).op_addr
        invariant [lw_none] (op_lw_r(R,0) & R <= now & st(R).op = op_read
             & V < R & st(V).op = op_write) ->
            st(V).op_addr ~= st(R).op_addr
        invariant [lw_zero] (op_lw_r(R,0) & R <= now & st(R).op = op_read) ->
            st(R).op_lwd = 0
        invariant [lw_fun] (op_lw_r(R,W1) & op_lw_r(R,W2) & R <= now & st(R).op = op_read) ->
            W1 = W2

        invariant [coh_val] (R <= now & st(R).op = op_read & st(R).op_done) ->
            st(R).op_data = st(R).op_lwd
        invariant [coh_lw] (op_lw_r(R,W) & W ~= 0
             & R <= now & st(R).op = op_read & st(R).op_done) ->
            st(R).op_data = st(W).op_data
        invariant [coh_nw] (op_lw_r(R,0)
             & R <= now & st(R).op = op_read & st(R).op_done) ->
            st(R).op_data = 0
    }
} with this, abs_memory

isolate membus = {
    specification {
        # ------------------------------------------------------------------
        # The LSQ <-> cache bus.  Besides the request/response wires the bus
        # carries the LSQ INDEX of every request, and it keeps a registry of
        # the in-flight LSQ entries under those indices: an entry is entered
        # when the LSQ accepts the CPU operation (which is where the
        # operation gets its reference tag) and is retired when the LSQ
        # retires it to the CPU.
        #
        # Because the bus knows the whole set of operations the LSQ has
        # accepted but not yet drained, it is the bus -- not the LSQ -- that
        # can carry the bridge between the reference trace and the version
        # of memory the cache holds (m_br / m_ld_bridge below).  The LSQ is
        # then left with nothing but ORDER obligations, and the cache is left
        # with the whole coherence argument: it must hand back, for the LSQ
        # index it answers, the value that index's reference tag reads.
        # ------------------------------------------------------------------

        # ---- in-flight store-queue entries, keyed by store-queue index ----
        relation sq_live(K : store_idx)
        function sq_h(K : store_idx)  : line
        function sq_o(K : store_idx)  : woffset
        function sq_d(K : store_idx)  : word
        function sq_tg(K : store_idx) : trace.tag        # GHOST

        # ---- in-flight load-queue entries, keyed by load-queue index ----
        # lq_pres: the entry has been handed to the cache and no response has
        #          been taken yet.
        # lq_cur : when the entry was accepted no buffered store shadowed its
        #          address, i.e. the cache was (and therefore still is)
        #          up to date for it.  This is exactly "the load did not
        #          forward"; only such loads may be presented.
        relation lq_live(K : load_idx)
        relation lq_pres(K : load_idx)
        relation lq_cur(K : load_idx)
        function lq_h(K : load_idx)  : line
        function lq_o(K : load_idx)  : woffset
        function lq_tg(K : load_idx) : trace.tag         # GHOST

        # ---- no buffered store shadows word (H,O).  Spelled out slot by slot
        # rather than quantified over store_idx: quantifying over the (finite,
        # bit-vector) store index is what makes these goals blow up in z3. ----
        relation no_st(H : line, O : woffset)
        definition no_st(H, O) =
            ~(sq_live(0) & sq_h(0) = H & sq_o(0) = O)
          & ~(sq_live(1) & sq_h(1) = H & sq_o(1) = O)
          & ~(sq_live(2) & sq_h(2) = H & sq_o(2) = O)
          & ~(sq_live(3) & sq_h(3) = H & sq_o(3) = O)

        # ---- ... and "some buffered store at (H,O) is younger than tag T" ----
        relation st_after(H : line, O : woffset, T : trace.tag)
        definition st_after(H, O, T) =
            (sq_live(0) & sq_h(0) = H & sq_o(0) = O & T < sq_tg(0))
          | (sq_live(1) & sq_h(1) = H & sq_o(1) = O & T < sq_tg(1))
          | (sq_live(2) & sq_h(2) = H & sq_o(2) = O & T < sq_tg(2))
          | (sq_live(3) & sq_h(3) = H & sq_o(3) = O & T < sq_tg(3))

        var req_en    : bool
        var req_h     : line
        var req_o     : woffset
        var req_wen   : bool
        var req_wdata : word
        var req_sid   : store_idx
        var req_rid   : load_idx
        var req_tag   : trace.tag                        # GHOST

        var resp_valid : bool
        var resp_h     : line
        var resp_o     : woffset
        var resp_data  : word
        var resp_rid   : load_idx

        var rd_out  : bool
        var out_rid : load_idx

        wire creq_ready : bool
        wire ready : bool
        definition ready = creq_ready & ~req_en & ~resp_valid

        after init {
            sq_live(J) := false; sq_h(J) := 0; sq_o(J) := 0;
            sq_d(J) := 0; sq_tg(J) := 0;
            lq_live(K) := false; lq_pres(K) := false; lq_cur(K) := false;
            lq_h(K) := 0; lq_o(K) := 0; lq_tg(K) := 0;
            req_en := false; req_h := 0; req_o := 0;
            req_wen := false; req_wdata := 0;
            req_sid := 0; req_rid := 0; req_tag := 0;
            resp_valid := false; resp_h := 0; resp_o := 0;
            resp_data := 0; resp_rid := 0;
            rd_out := false; out_rid := 0;
        }

        # ---- the LSQ accepts a CPU store into store-queue slot k ----
        action accept_store(k : store_idx, h : line, o : woffset, d : word) = {
            require ~sq_live(k);
            call trace.step(h, o, true, d);
            sq_live(k) := true;
            sq_h(k)    := h;
            sq_o(k)    := o;
            sq_d(k)    := d;
            sq_tg(k)   := trace.now;
        }

        # ---- the LSQ accepts a CPU load into load-queue slot k ----
        action accept_load(k : load_idx, h : line, o : woffset) = {
            require ~lq_live(k);
            var unshadowed : bool := no_st(h, o);
            call trace.step(h, o, false, 0);
            lq_live(k) := true;
            lq_pres(k) := false;
            lq_cur(k)  := unshadowed;
            lq_h(k)    := h;
            lq_o(k)    := o;
            lq_tg(k)   := trace.now;
        }

        # ---- the LSQ drains store-queue slot k to the cache ----
        # The three ordering requirements are all the LSQ has to establish:
        #   the entry drained is the OLDEST buffered store to its address,
        #   every entry still live in the load queue is YOUNGER than it, and
        #   no read is outstanding (so the cache's version of the presented
        #   address cannot move under a load that is already in the cache).
        action present_store(k : store_idx, h : line, o : woffset, d : word) = {
            require ready;
            require sq_live(k) & sq_h(k) = h & sq_o(k) = o & sq_d(k) = d;
            require forall J : store_idx.
                (sq_live(J) & J ~= k & sq_h(J) = h & sq_o(J) = o)
                  -> sq_tg(k) < sq_tg(J);
            require forall K : load_idx. lq_live(K) -> sq_tg(k) < lq_tg(K);
            require ~rd_out;
            req_en := true; req_h := h; req_o := o;
            req_wen := true; req_wdata := d;
            req_sid := k; req_tag := sq_tg(k);
            sq_live(k) := false;
            call trace.present_w(h, o, sq_tg(k));
        }

        # ---- the LSQ hands load-queue slot k to the cache ----
        action present_load(k : load_idx, h : line, o : woffset) = {
            require ready;
            require ~rd_out;
            require lq_live(k) & ~lq_pres(k) & lq_cur(k);
            require lq_h(k) = h & lq_o(k) = o;
            req_en := true; req_h := h; req_o := o;
            req_wen := false; req_wdata := 0;
            req_rid := k; req_tag := lq_tg(k);
            lq_pres(k) := true;
            rd_out  := true;
            out_rid := k;
        }

        action take_req = {
            req_en := false;
        }

        # ---- the cache answers the read it holds.  The value handed back
        # must be the value the reference tag registered under the returned
        # LSQ index reads: this is the cache's whole coherence obligation. ----
        action answer(h : line, o : woffset, d : word, rid : load_idx) = {
            require ~resp_valid;
            require ~req_en;
            require rd_out & rid = out_rid;
            require lq_h(rid) = h & lq_o(rid) = o;
            require d = trace.st(lq_tg(rid)).mem(concatbv3(h, o));
            resp_valid := true; resp_h := h; resp_o := o;
            resp_data := d; resp_rid := rid;
        }

        action take_resp = {
            require resp_valid;
            resp_valid := false;
            rd_out     := false;
            lq_pres(resp_rid) := false;
        }

        # ---- the LSQ retires load-queue slot k to the CPU ----
        action finish_load(k : load_idx, v : word) = {
            require lq_live(k) & ~lq_pres(k);
            require v = trace.st(lq_tg(k)).mem(concatbv3(lq_h(k), lq_o(k)));
            call trace.observe(lq_tg(k), v);
            lq_live(k) := false;
        }

        # ---- registry entries describe the operation they were entered with ----
        invariant [m_sq_wr] sq_live(J) ->
            (sq_tg(J) ~= 0 & sq_tg(J) <= trace.now
             & trace.st(sq_tg(J)).op = op_write
             & trace.st(sq_tg(J)).op_addr = concatbv3(sq_h(J), sq_o(J))
             & trace.st(sq_tg(J)).op_data = sq_d(J))
        invariant [m_lq_rd] lq_live(K) ->
            (lq_tg(K) ~= 0 & lq_tg(K) <= trace.now
             & trace.st(lq_tg(K)).op = op_read
             & ~trace.st(lq_tg(K)).op_done
             & trace.st(lq_tg(K)).op_addr = concatbv3(lq_h(K), lq_o(K)))

        # ---- distinct live entries carry distinct reference tags ----
        invariant [m_lq_distinct] (lq_live(I) & lq_live(J) & lq_tg(I) = lq_tg(J)) -> I = J

        # ---- at most one read is in the cache, and it is a live entry ----
        invariant [m_pres_out] lq_pres(K) -> (rd_out & K = out_rid)
        invariant [m_rd_out] rd_out ->
            (lq_live(out_rid) & lq_pres(out_rid) & lq_cur(out_rid))
        invariant [m_no_wr_rd] rd_out -> ~(req_en & req_wen)

        # ---- a buffered store whose datum is not its word's last written
        # datum is overwritten by a younger buffered store to the same word:
        # equivalently, the YOUNGEST buffered store to a word carries that
        # word's last written datum, which is what forwarding returns. ----
        invariant [m_sq_last] (sq_live(J)
            & sq_d(J) ~= trace.lwd(concatbv3(sq_h(J), sq_o(J))))
            -> st_after(sq_h(J), sq_o(J), sq_tg(J))

        invariant [req_ok] req_en ->
            (req_tag ~= 0 & req_tag <= trace.now
             & (req_wen -> (trace.st(req_tag).op = op_write
                            & trace.st(req_tag).op_addr = concatbv3(req_h, req_o)
                            & trace.st(req_tag).op_data = req_wdata))
             & (~req_wen -> (trace.st(req_tag).op = op_read
                             & trace.st(req_tag).op_addr = concatbv3(req_h, req_o)
                             & trace.st(trace.ctag(req_h, req_o)).mem(concatbv3(req_h, req_o))
                               = trace.st(req_tag).mem(concatbv3(req_h, req_o)))))
        invariant [rd_reg] (req_en & ~req_wen) ->
            (rd_out & req_rid = out_rid & req_tag = lq_tg(req_rid)
             & lq_h(req_rid) = req_h & lq_o(req_rid) = req_o)
        invariant [rd_resp] resp_valid ->
            (rd_out & resp_rid = out_rid
             & lq_live(resp_rid) & lq_pres(resp_rid)
             & lq_h(resp_rid) = resp_h & lq_o(resp_rid) = resp_o)
        invariant [rd_norq] resp_valid -> ~req_en
        invariant [out_le] lq_tg(out_rid) <= trace.now
    }

    # ------------------------------------------------------------------
    # THE BRIDGE between the reference trace and the version of memory the
    # cache holds.  It is private to the bus: what leaves the bus is the
    # already-instantiated fact in req_ok, so neither the LSQ nor the cache
    # ever has to carry these.
    # ------------------------------------------------------------------
    implementation {
        # ---- an unshadowed load stays unshadowed: every buffered store to
        # its address is younger than it (new stores always are) ----
        invariant [m_ld_nold] (lq_live(K) & lq_cur(K) & sq_live(J)
                               & sq_h(J) = lq_h(K) & sq_o(J) = lq_o(K))
            -> lq_tg(K) < sq_tg(J)

        # ---- with no buffered store to a word, the version of that word the
        # cache holds is the last write to it ----
        invariant [m_br] no_st(H, O) ->
            trace.st(trace.ctag(H,O)).mem(concatbv3(H,O)) = trace.lwd(concatbv3(H,O))

        # ---- ... and therefore, for a load that was not shadowed when it was
        # accepted, the version the cache holds is exactly the one that load's
        # reference tag reads ----
        invariant [m_ld_bridge] (lq_live(K) & lq_cur(K)) ->
            trace.st(trace.ctag(lq_h(K), lq_o(K))).mem(concatbv3(lq_h(K), lq_o(K)))
              = trace.st(lq_tg(K)).mem(concatbv3(lq_h(K), lq_o(K)))
    }
} with this, trace, addr_thy, basis

type store_queue_entry = struct {
    store_h    : line,
    store_o    : woffset,
    store_data : word,
    store_mark : load_idx
}
type load_queue_entry = struct {
    load_h     : line,
    load_o     : woffset,
    load_fwd   : bool,
    load_fdata : word
}

module lsq_body(trace, cpu, membus, cache, bus) = {

    implementation {
        var load_outstanding : bool

        function store_queue(K : store_idx) : store_queue_entry
        var store_head : store_idx
        var store_next : store_idx

        function load_queue(K : load_idx) : load_queue_entry
        var load_head : load_idx
        var load_next : load_idx

        var cpu_valid_r : bool
        var cpu_addr_r  : addr
        var cpu_data_r  : word
        var cpu_ready_r : bool
        var cpu_tag_r   : trace.tag

        var ev_cpl      : bool
        var ev_cpl_idx  : load_idx
        var ev_acc      : bool
        var ev_acc_wen  : bool
        var ev_acc_sidx : store_idx
        var ev_acc_lidx : load_idx
        var ev_pres      : bool
        var ev_pres_wen  : bool
        var ev_pres_sidx : store_idx
        var ev_pres_lidx : load_idx

        after init {
            load_outstanding := false;
            store_queue(K).store_h := 0; store_queue(K).store_o := 0;
            store_queue(K).store_data := 0; store_queue(K).store_mark := 0;
            store_head := 0; store_next := 0;
            load_queue(K).load_h := 0; load_queue(K).load_o := 0;
            load_queue(K).load_fwd := false; load_queue(K).load_fdata := 0;
            load_head := 0; load_next := 0;
            cpu_valid_r := false; cpu_addr_r := 0; cpu_data_r := 0;
            cpu_tag_r := 0; cpu_ready_r := true;
            ev_cpl := false; ev_cpl_idx := 0;
            ev_acc := false; ev_acc_wen := false;
            ev_acc_sidx := 0; ev_acc_lidx := 0;
            ev_pres := false; ev_pres_wen := false;
            ev_pres_sidx := 0; ev_pres_lidx := 0;
        }

        relation store_pending(K : store_idx)
        definition store_pending(K) = store_head <= K & K < store_next
        relation load_pending(K : load_idx)
        definition load_pending(K) = load_head <= K & K < load_next
        relation store_full
        definition store_full = store_next = 2
        relation load_full
        definition load_full = load_next = 2

        definition cpu.valid      = cpu_valid_r
        definition cpu.resp_addr  = cpu_addr_r
        definition cpu.data       = cpu_data_r
        definition cpu.ready      = cpu_ready_r

        relation older_load_pending(K : store_idx)
        definition older_load_pending(K) =
            load_head < load_next & load_head < store_queue(K).store_mark

        after posedge {
            cpu_valid_r := false; cpu_addr_r := 0; cpu_data_r := 0;
            ev_cpl := false; ev_acc := false; ev_pres := false;

            if load_head < load_next & load_queue(load_head).load_fwd {
                cpu_valid_r := true;
                cpu_addr_r  := concatbv3(load_queue(load_head).load_h,
                                         load_queue(load_head).load_o);
                cpu_data_r  := load_queue(load_head).load_fdata;
                ev_cpl      := true;
                ev_cpl_idx  := load_head;
                load_head   := load_head.next;
            } else { if load_head < load_next & load_outstanding & membus.resp_valid
                        & membus.resp_rid = load_head {
                cpu_valid_r := true;
                cpu_addr_r  := concatbv3(load_queue(load_head).load_h,
                                         load_queue(load_head).load_o);
                cpu_data_r  := membus.resp_data;
                ev_cpl      := true;
                ev_cpl_idx  := load_head;
                load_head   := load_head.next;
                load_outstanding := false;
                call membus.take_resp;
            } };

            if store_head = store_next { store_head := 0; store_next := 0; };
            if load_head = load_next {
                load_head := 0; load_next := 0;
                store_queue(K).store_mark := 0;
            };

            var presented : bool := false;

            if store_head < store_next & membus.ready
               & ~older_load_pending(store_head) {
                ev_pres      := true;
                ev_pres_wen  := true;
                ev_pres_sidx := store_head;
                store_head   := store_head + 1;
                presented    := true;
            };

            if ~presented & load_head < load_next & ~load_queue(load_head).load_fwd
               & ~load_outstanding & membus.ready {
                load_outstanding := true;
                ev_pres      := true;
                ev_pres_wen  := false;
                ev_pres_lidx := load_head;
            };

            if cpu.req_en {
                var ra : addr    := cpu.req_addr;
                var rh : line    := high(ra);
                var ro : woffset := low(ra);
                ev_acc     := true;
                ev_acc_wen := cpu.req_wen;
                if cpu.req_wen {
                    store_queue(store_next).store_h := rh;
                    store_queue(store_next).store_o := ro;
                    store_queue(store_next).store_data := cpu.req_wdata;
                    store_queue(store_next).store_mark := load_next;
                    ev_acc_sidx := store_next;
                    store_next  := store_next + 1;
                } else {
                    var fwd   : bool := false;
                    var fdata : word := 0;
                    if store_pending(1) & store_queue(1).store_h = rh
                       & store_queue(1).store_o = ro {
                        fwd := true; fdata := store_queue(1).store_data;
                    } else { if store_pending(0) & store_queue(0).store_h = rh
                                & store_queue(0).store_o = ro {
                        fwd := true; fdata := store_queue(0).store_data;
                    } };
                    load_queue(load_next).load_h := rh;
                    load_queue(load_next).load_o := ro;
                    load_queue(load_next).load_fwd := fwd;
                    load_queue(load_next).load_fdata := fdata;
                    ev_acc_lidx := load_next;
                    load_next   := load_next.next;
                };
            };

            cpu_ready_r := ~store_full & ~load_full & ~load_outstanding;
        }

        after posedge {
            cpu_tag_r := 0;

            if ev_cpl {
                cpu_tag_r := membus.lq_tg(ev_cpl_idx);
                membus.finish_load(ev_cpl_idx, cpu_data_r);
            };

            if ev_pres {
                if ev_pres_wen {
                    membus.present_store(ev_pres_sidx,
                                         store_queue(ev_pres_sidx).store_h,
                                         store_queue(ev_pres_sidx).store_o,
                                         store_queue(ev_pres_sidx).store_data);
                } else {
                    membus.present_load(ev_pres_lidx,
                                        load_queue(ev_pres_lidx).load_h,
                                        load_queue(ev_pres_lidx).load_o);
                };
            };

            if ev_acc {
                if ev_acc_wen {
                    membus.accept_store(ev_acc_sidx,
                                        store_queue(ev_acc_sidx).store_h,
                                        store_queue(ev_acc_sidx).store_o,
                                        store_queue(ev_acc_sidx).store_data);
                } else {
                    membus.accept_load(ev_acc_lidx,
                                       load_queue(ev_acc_lidx).load_h,
                                       load_queue(ev_acc_lidx).load_o);
                };
            };
        }

        # ---- structural ----
        invariant [sq_bound] store_head <= store_next & store_next <= 2
        invariant [lq_bound] load_head <= load_next & load_next <= 2
        invariant [inv_ready] cpu_ready_r -> (~store_full & ~load_full & ~load_outstanding)
        invariant [lo_pend] load_outstanding -> load_head < load_next
        invariant [lo_nofwd] load_outstanding -> ~load_queue(load_head).load_fwd

        # ---- the bus registry mirrors the queues ----
        invariant [sq_sync] membus.sq_live(K) = store_pending(K)
        invariant [sq_ent] store_pending(K) ->
            (membus.sq_h(K) = store_queue(K).store_h
             & membus.sq_o(K) = store_queue(K).store_o
             & membus.sq_d(K) = store_queue(K).store_data)
        invariant [lq_sync] membus.lq_live(K) = load_pending(K)
        invariant [lq_ent] load_pending(K) ->
            (membus.lq_h(K) = load_queue(K).load_h
             & membus.lq_o(K) = load_queue(K).load_o)
        invariant [lq_cur_sync] load_pending(K) ->
            (membus.lq_cur(K) = ~load_queue(K).load_fwd)
        invariant [lo_sync] membus.rd_out = load_outstanding
        invariant [lo_out] load_outstanding ->
            (load_head < load_next & membus.out_rid = load_head
             & membus.lq_pres(load_head))
        invariant [lo_pres] membus.lq_pres(K) -> (load_outstanding & K = load_head)

        invariant [sq_tag_le] store_pending(K) ->
            (membus.sq_tg(K) ~= 0 & membus.sq_tg(K) <= trace.now)
        invariant [lq_tag_le] load_pending(K) ->
            (membus.lq_tg(K) ~= 0 & membus.lq_tg(K) <= trace.now)

        # ---- ORDER: this is all the LSQ owes the rest of the system ----
        invariant [sq_mono] (store_pending(K1) & store_pending(K2) & K1 < K2) ->
            membus.sq_tg(K1) < membus.sq_tg(K2)
        invariant [lq_mono] (load_pending(K1) & load_pending(K2) & K1 < K2) ->
            membus.lq_tg(K1) < membus.lq_tg(K2)
        invariant [sq_mark] (store_pending(J) & load_pending(K)
                             & store_queue(J).store_mark <= K) ->
            membus.sq_tg(J) < membus.lq_tg(K)
        invariant [sq_mark_le] store_pending(K) ->
            store_queue(K).store_mark <= load_next
        invariant [sq_mark_mono] (store_pending(0) & store_pending(1)) ->
            store_queue(0).store_mark <= store_queue(1).store_mark
        # ---- while a read is in the cache every buffered store is younger
        # than the load at the head, so no store can be drained past it ----
        invariant [lo_nostore] (load_outstanding & store_pending(K)) ->
            load_head < store_queue(K).store_mark

        # ---- the only value fact left in the LSQ: what the forwarding
        # network hands back is what the forwarded load's tag reads ----
        invariant [lq_fwd_val] (load_pending(K) & load_queue(K).load_fwd) ->
            trace.st(membus.lq_tg(K)).mem(concatbv3(load_queue(K).load_h, load_queue(K).load_o))
              = load_queue(K).load_fdata

        invariant [cpu_done] cpu_valid_r ->
            (cpu_tag_r ~= 0 & cpu_tag_r <= trace.now
             & trace.st(cpu_tag_r).op = op_read & trace.st(cpu_tag_r).op_done
             & trace.st(cpu_tag_r).op_data = cpu_data_r
             & trace.st(cpu_tag_r).op_addr = cpu_addr_r)
    }

    isolate iso = this with this, trace, cpu, membus, cache, bus, addr_thy, basis
}

isolate bus = {
    specification {
        var cmd_en   : bool
        var cmd_wen  : bool
        var cmd_addr : addr
        var cmd_data : four_words

        var rsp_valid : bool
        var rsp_addr  : addr
        var rsp_data  : four_words

        wire ready : bool

        after init {
            cmd_en := false; cmd_wen := false; cmd_addr := 0; cmd_data := mzero;
            rsp_valid := false; rsp_addr := 0; rsp_data := mzero;
        }

        action cmd(wen : bool, a : addr, d : four_words) = {
            var h : line := high(a);
            var b : bit  := beat_of(low(a));
            require ready;
            require ~rsp_valid;
            require wen -> (forall Id : mshr_id.
                trace.mshr_wait(Id) -> trace.mshr_line(Id) ~= h);
            require wen ->
                ( unp0(d) = trace.cmem(h, concatbv2(b, 0))
                & unp1(d) = trace.cmem(h, concatbv2(b, 1))
                & unp2(d) = trace.cmem(h, concatbv2(b, 2))
                & unp3(d) = trace.cmem(h, concatbv2(b, 3)) );
            cmd_en := true; cmd_wen := wen; cmd_addr := a; cmd_data := d;
            if wen {
                call trace.wb(h, b);
            };
        }

        action take_cmd = {
            cmd_en := false;
        }

        action rresp(a : addr, d : four_words) = {
            var h : line := high(a);
            var b : bit  := beat_of(low(a));
            require ~rsp_valid;
            require unp0(d) = trace.mmemv(h, concatbv2(b,0))
                  & unp1(d) = trace.mmemv(h, concatbv2(b,1))
                  & unp2(d) = trace.mmemv(h, concatbv2(b,2))
                  & unp3(d) = trace.mmemv(h, concatbv2(b,3));
            rsp_valid := true; rsp_addr := a; rsp_data := d;
        }

        action take_rsp = {
            rsp_valid := false;
        }

        invariant [cmd_ok] (cmd_en & cmd_wen) ->
            ( unp0(cmd_data) = trace.mmemv(high(cmd_addr), concatbv2(beat_of(low(cmd_addr)), 0))
            & unp1(cmd_data) = trace.mmemv(high(cmd_addr), concatbv2(beat_of(low(cmd_addr)), 1))
            & unp2(cmd_data) = trace.mmemv(high(cmd_addr), concatbv2(beat_of(low(cmd_addr)), 2))
            & unp3(cmd_data) = trace.mmemv(high(cmd_addr), concatbv2(beat_of(low(cmd_addr)), 3)) )
    }
} with this, trace, addr_thy, basis

type mshr_state = { mshr_idle, mshr_req_lower, mshr_finished_lower, mshr_req_upper, mshr_drain }
type dphase = { dp_resp, dp_wb_lo, dp_wb_hi, dp_fill }

type mshr_req = struct {
    rq_off   : woffset,
    rq_wen   : bool,
    rq_wdata : word,
    rq_rid   : load_idx
}

type mshr_entry = struct {
    m_state  : mshr_state,
    m_base   : line,
    m_q(K : qidx) : mshr_req,
    rq_head  : qidx,
    rq_next  : qidx,
    rq_write_pending : bool,
    m_fbuf(O : woffset) : word,
    m_dirty  : bool,
    m_dphase : dphase,
    m_victim_way : way
}

type cache_entry = struct {
    occupied : bool,
    dirty    : bool,
    tag      : line,
    lru      : bit,
    val(O : woffset) : word
}

module cache_body(trace, membus, bus, mc) = {

    specification {
        # ---- the cache's whole contract: what comes back on the response
        # channel is coherent for the reference tag of the LSQ index the
        # response is tagged with. ----
        invariant [coh] membus.resp_valid ->
            membus.resp_data =
                trace.st(membus.lq_tg(membus.resp_rid)).mem(
                    concatbv3(membus.resp_h, membus.resp_o))
    }

    implementation {
        function cache(K : key, W : way) : cache_entry

        function mshr(Id : mshr_id) : mshr_entry

        function rq_tag(Id : mshr_id, K : qidx) : trace.tag

        var ready_r : bool

        var port_used : bool

        var ev_acc      : bool
        var ev_acc_hit  : bool
        var ev_acc_id   : mshr_id
        var ev_acc_k    : qidx
        var ev_svcw     : bool
        var ev_alloc    : bool
        var ev_alloc_id : mshr_id
        var ev_alloc_h  : line
        var ev_fill0    : bool
        var ev_fill0_occ : bool
        var ev_fill0_tag : line
        var ev_fill1    : bool
        var ev_fill1_occ : bool
        var ev_fill1_tag : line
        var ev_ans      : bool
        var ev_ans_hit  : bool
        var ev_ans_id   : mshr_id
        var ev_ans_k    : qidx
        var ev_ans_h    : line
        var ev_ans_o    : woffset
        var ev_ans_d    : word
        var ev_ans_rid  : load_idx
        var ev_cmd      : bool
        var ev_cmd_wen  : bool
        var ev_cmd_addr : addr
        var ev_cmd_data : four_words

        after init {
            occupied(cache(K,W)) := false;
            dirty(cache(K,W)) := false;
            tag(cache(K,W)) := 0;
            lru(cache(K,W)) := 0;
            val(cache(K,W), O) := 0;
            m_state(mshr(Id))  := mshr_idle;
            m_base(mshr(Id))   := 0;
            m_dirty(mshr(Id))  := false;
            m_dphase(mshr(Id)) := dp_resp;
            m_victim_way(mshr(Id)) := w0;
            m_fbuf(mshr(Id), O) := 0;
            rq_head(mshr(Id)) := 0;
            rq_next(mshr(Id)) := 0;
            rq_write_pending(mshr(Id)) := false;
            rq_off(m_q(mshr(Id), K))   := 0;
            rq_wen(m_q(mshr(Id), K))   := false;
            rq_wdata(m_q(mshr(Id), K)) := 0;
            rq_rid(m_q(mshr(Id), K))   := 0;
            rq_tag(Id, K) := 0;
            ready_r    := true;
            port_used  := false;
            ev_acc := false; ev_acc_hit := false;
            ev_acc_id := 0; ev_acc_k := 0; ev_svcw := false;
            ev_alloc := false; ev_alloc_id := 0; ev_alloc_h := 0;
            ev_fill0 := false; ev_fill1 := false;
            ev_fill0_occ := false; ev_fill0_tag := 0;
            ev_fill1_occ := false; ev_fill1_tag := 0;
            ev_ans := false; ev_ans_hit := false; ev_ans_id := 0;
            ev_ans_k := 0; ev_ans_h := 0; ev_ans_o := 0;
            ev_ans_d := 0; ev_ans_rid := 0;
            ev_cmd := false; ev_cmd_wen := false; ev_cmd_addr := 0;
            ev_cmd_data := mzero;
        }

        relation rq_pend(Id : mshr_id, K : qidx)
        definition rq_pend(Id, K) = rq_head(mshr(Id)) <= K & K < rq_next(mshr(Id))

        relation mshr_full(Id : mshr_id)
        definition mshr_full(Id) = rq_next(mshr(Id)) = 4 | rq_write_pending(mshr(Id))

        relation evicting(Id : mshr_id)
        definition evicting(Id) = (m_state(mshr(Id)) = mshr_drain
            & (m_dphase(mshr(Id)) = dp_wb_lo | m_dphase(mshr(Id)) = dp_wb_hi | m_dphase(mshr(Id)) = dp_fill))

        function cver(H : line, O : woffset) : trace.tag
        definition cver(H, O) = trace.cver(H, O)
        function cmem(H : line, O : woffset) : word
        definition cmem(H, O) = trace.cmem(H, O)

        definition membus.creq_ready = ready_r

        action enqueue(id : mshr_id, off : woffset, wen : bool, wd : word,
                       rid : load_idx) = {
            rq_off(m_q(mshr(id), rq_next(mshr(id))))   := off;
            rq_wen(m_q(mshr(id), rq_next(mshr(id))))   := wen;
            rq_wdata(m_q(mshr(id), rq_next(mshr(id)))) := wd;
            rq_rid(m_q(mshr(id), rq_next(mshr(id))))   := rid;
            ev_acc_id := id;
            ev_acc_k  := rq_next(mshr(id));
            if wen {
                rq_write_pending(mshr(id)) := true;
            };
            rq_next(mshr(id)) := rq_next(mshr(id)) + 1;
        }

        action svc_head(id : mshr_id) = {
            var k : qidx := rq_head(mshr(id));
            if rq_wen(m_q(mshr(id), k)) {
                m_fbuf(mshr(id), rq_off(m_q(mshr(id), k))) := rq_wdata(m_q(mshr(id), k));
                m_dirty(mshr(id)) := true;
                rq_write_pending(mshr(id)) := false;
                ev_svcw := true;
                rq_head(mshr(id)) := k + 1;
            } else {
                if ~port_used & ~membus.resp_valid {
                    ev_ans       := true;
                    ev_ans_hit   := false;
                    ev_ans_id    := id;
                    ev_ans_k     := k;
                    ev_ans_h     := m_base(mshr(id));
                    ev_ans_o     := rq_off(m_q(mshr(id), k));
                    ev_ans_d     := m_fbuf(mshr(id), rq_off(m_q(mshr(id), k)));
                    ev_ans_rid   := rq_rid(m_q(mshr(id), k));
                    port_used    := true;
                    rq_head(mshr(id))  := k + 1;
                };
            };
        }

        action do_fill(id : mshr_id) = {
            var vk   : key := hash(m_base(mshr(id)));
            var vw   : way := m_victim_way(mshr(id));
            var oway : way := w1;
            if vw = w1 { oway := w0; };
            var oocc : bool := occupied(cache(vk, vw));
            var otag : line := tag(cache(vk, vw));
            tag(cache(vk, vw))      := m_base(mshr(id));
            val(cache(vk, vw), O)   := m_fbuf(mshr(id), O);
            dirty(cache(vk, vw))    := m_dirty(mshr(id));
            occupied(cache(vk, vw)) := true;
            lru(cache(vk, vw))   := 0;
            lru(cache(vk, oway)) := 1;
            m_state(mshr(id)) := mshr_idle;
            if id = 0 { ev_fill0 := true; ev_fill0_occ := oocc; ev_fill0_tag := otag; }
            else       { ev_fill1 := true; ev_fill1_occ := oocc; ev_fill1_tag := otag; };
        }

        action drain_step(id : mshr_id) = {
            if m_state(mshr(id)) = mshr_drain {
                if m_dphase(mshr(id)) = dp_resp {
                    if rq_head(mshr(id)) ~= rq_next(mshr(id)) {
                        call svc_head(id);
                    } else {
                        var vw : way := w1;
                        if lru(cache(hash(m_base(mshr(id))), w1)) = 1 { vw := w0; };
                        var oid : mshr_id := 1;
                        if id = 1 { oid := 0; };
                        if evicting(oid) & hash(m_base(mshr(oid))) = hash(m_base(mshr(id))) {
                            if m_victim_way(mshr(oid)) = w0 { vw := w1; } else { vw := w0; };
                        };
                        m_victim_way(mshr(id)) := vw;
                        if occupied(cache(hash(m_base(mshr(id))), vw))
                           & dirty(cache(hash(m_base(mshr(id))), vw)) {
                            m_dphase(mshr(id)) := dp_wb_lo;
                        } else {
                            call do_fill(id);
                        };
                    };
                } else { if m_dphase(mshr(id)) = dp_fill {
                    call do_fill(id);
                } };
            };
        }

        action issue_wb(id : mshr_id, b : bit) = {
            var vk : key := hash(m_base(mshr(id)));
            var vw : way := m_victim_way(mshr(id));
            ev_cmd      := true;
            ev_cmd_wen  := true;
            ev_cmd_addr := concatbv3(tag(cache(vk, vw)), concatbv2(b, 0));
            ev_cmd_data := pack4(val(cache(vk, vw), concatbv2(b,3)),
                                 val(cache(vk, vw), concatbv2(b,2)),
                                 val(cache(vk, vw), concatbv2(b,1)),
                                 val(cache(vk, vw), concatbv2(b,0)));
        }

        action issue_rd(id : mshr_id, b : bit) = {
            ev_cmd      := true;
            ev_cmd_wen  := false;
            ev_cmd_addr := concatbv3(m_base(mshr(id)), concatbv2(b, 0));
            ev_cmd_data := mzero;
        }

        action serve_request = {
            var h  : line    := membus.req_h;
            var o  : woffset := membus.req_o;
            var wen : bool   := membus.req_wen;
            var d  : word    := membus.req_wdata;
            var rid : load_idx := membus.req_rid;
            var tg : trace.tag := membus.req_tag;
            var a  : addr    := concatbv3(h, o);
            var rs : key     := hash(h);
            var hit  : bool  := false;
            var hway : way   := w1;
            ev_acc := true;
            if occupied(cache(rs, w1)) & tag(cache(rs, w1)) = h { hit:=true; hway:=w1; }
            else { if occupied(cache(rs, w0)) & tag(cache(rs, w0)) = h { hit:=true; hway:=w0; } };
            ev_acc_hit  := hit;
            if hit {
                if ~wen {
                    ev_ans      := true;
                    ev_ans_hit  := true;
                    ev_ans_h    := h;
                    ev_ans_o    := o;
                    ev_ans_d    := val(cache(rs, hway), o);
                    ev_ans_rid  := rid;
                    port_used := true;
                } else {
                    val(cache(rs, hway), o) := d;
                    dirty(cache(rs, hway))  := true;
                };
                if hway = w1 { lru(cache(rs, w0)):=1; lru(cache(rs, w1)):=0; }
                else         { lru(cache(rs, w0)):=0; lru(cache(rs, w1)):=1; };
            } else {
                var owner_found : bool := false;
                var owner : mshr_id := 0;
                if m_state(mshr(0)) ~= mshr_idle & m_base(mshr(0)) = h { owner_found:=true; owner:=0; }
                else { if m_state(mshr(1)) ~= mshr_idle & m_base(mshr(1)) = h { owner_found:=true; owner:=1; } };
                if owner_found {
                    call enqueue(owner, o, wen, d, rid);
                } else {
                    var aid : mshr_id := 0;
                    if m_state(mshr(0)) ~= mshr_idle { aid := 1; };
                    ev_alloc    := true;
                    ev_alloc_id := aid;
                    ev_alloc_h  := h;
                    m_state(mshr(aid))  := mshr_req_lower;
                    m_base(mshr(aid))   := h;
                    m_dirty(mshr(aid))  := false;
                    m_dphase(mshr(aid)) := dp_resp;
                    m_fbuf(mshr(aid), O) := 0;
                    rq_head(mshr(aid)) := 0;
                    rq_next(mshr(aid)) := 0;
                    rq_write_pending(mshr(aid)) := false;
                    call enqueue(aid, o, wen, d, rid);
                };
            };
        }

        action capture = {
            var a : addr := bus.rsp_addr;
            var d : four_words := bus.rsp_data;
            if m_state(mshr(0)) = mshr_req_lower & a = concatbv3(m_base(mshr(0)), concatbv2(0,0)) {
                m_fbuf(mshr(0), concatbv2(0,0)) := unp0(d);
                m_fbuf(mshr(0), concatbv2(0,1)) := unp1(d);
                m_fbuf(mshr(0), concatbv2(0,2)) := unp2(d);
                m_fbuf(mshr(0), concatbv2(0,3)) := unp3(d);
                m_state(mshr(0)) := mshr_finished_lower;
            } else { if m_state(mshr(0)) = mshr_req_upper & a = concatbv3(m_base(mshr(0)), concatbv2(1,0)) {
                m_fbuf(mshr(0), concatbv2(1,0)) := unp0(d);
                m_fbuf(mshr(0), concatbv2(1,1)) := unp1(d);
                m_fbuf(mshr(0), concatbv2(1,2)) := unp2(d);
                m_fbuf(mshr(0), concatbv2(1,3)) := unp3(d);
                m_state(mshr(0)) := mshr_drain;
                m_dphase(mshr(0)) := dp_resp;
            } };
            if m_state(mshr(1)) = mshr_req_lower & a = concatbv3(m_base(mshr(1)), concatbv2(0,0)) {
                m_fbuf(mshr(1), concatbv2(0,0)) := unp0(d);
                m_fbuf(mshr(1), concatbv2(0,1)) := unp1(d);
                m_fbuf(mshr(1), concatbv2(0,2)) := unp2(d);
                m_fbuf(mshr(1), concatbv2(0,3)) := unp3(d);
                m_state(mshr(1)) := mshr_finished_lower;
            } else { if m_state(mshr(1)) = mshr_req_upper & a = concatbv3(m_base(mshr(1)), concatbv2(1,0)) {
                m_fbuf(mshr(1), concatbv2(1,0)) := unp0(d);
                m_fbuf(mshr(1), concatbv2(1,1)) := unp1(d);
                m_fbuf(mshr(1), concatbv2(1,2)) := unp2(d);
                m_fbuf(mshr(1), concatbv2(1,3)) := unp3(d);
                m_state(mshr(1)) := mshr_drain;
                m_dphase(mshr(1)) := dp_resp;
            } };
        }

        after posedge {
            port_used := false;
            ev_acc    := false;
            ev_svcw   := false;
            ev_alloc  := false;
            ev_fill0 := false; ev_fill1 := false;
            ev_ans   := false; ev_cmd := false;

            if bus.rsp_valid {
                call capture;
                call bus.take_rsp;
            };

            if bus.ready {
                if m_state(mshr(0)) = mshr_drain & m_dphase(mshr(0)) = dp_wb_lo {
                    call issue_wb(0, 0); m_dphase(mshr(0)) := dp_wb_hi;
                } else { if m_state(mshr(0)) = mshr_drain & m_dphase(mshr(0)) = dp_wb_hi {
                    call issue_wb(0, 1); m_dphase(mshr(0)) := dp_fill;
                } else { if m_state(mshr(1)) = mshr_drain & m_dphase(mshr(1)) = dp_wb_lo {
                    call issue_wb(1, 0); m_dphase(mshr(1)) := dp_wb_hi;
                } else { if m_state(mshr(1)) = mshr_drain & m_dphase(mshr(1)) = dp_wb_hi {
                    call issue_wb(1, 1); m_dphase(mshr(1)) := dp_fill;
                } else { if m_state(mshr(0)) = mshr_req_lower {
                    call issue_rd(0, 0);
                } else { if m_state(mshr(0)) = mshr_finished_lower {
                    call issue_rd(0, 1); m_state(mshr(0)) := mshr_req_upper;
                } else { if m_state(mshr(1)) = mshr_req_lower {
                    call issue_rd(1, 0);
                } else { if m_state(mshr(1)) = mshr_finished_lower {
                    call issue_rd(1, 1); m_state(mshr(1)) := mshr_req_upper;
                } } } } } } } };
            };

            if membus.req_en & ready_r & ~membus.resp_valid {
                call membus.take_req;
                call serve_request;
            };

            call drain_step(0);
            call drain_step(1);

            ready_r := ~(mshr_full(0) | mshr_full(1))
                        & (m_state(mshr(0)) = mshr_idle | m_state(mshr(1)) = mshr_idle)
                        & ~evicting(0) & ~evicting(1);
        }

        after posedge {
            if ev_cmd {
                if ev_cmd_wen {
                    bus.cmd(true, ev_cmd_addr, ev_cmd_data);
                } else {
                    bus.cmd(false, ev_cmd_addr, mzero);
                };
            };

            if ev_ans {
                membus.answer(ev_ans_h, ev_ans_o, ev_ans_d, ev_ans_rid);
            };

            if ev_svcw {
                call trace.commit_w;
            };

            if ev_acc {
                if ev_acc_hit {
                    if membus.req_wen {
                        call trace.commit_w;
                        call trace.dirty_line(membus.req_h);
                    };
                } else {
                    rq_tag(ev_acc_id, ev_acc_k) := membus.req_tag;
                };
            };

            if ev_alloc {
                trace.mshr_alloc(ev_alloc_id, ev_alloc_h);
            };

            if ev_fill0 {
                if ev_fill0_occ { call trace.clean_line(ev_fill0_tag); };
                if m_dirty(mshr(0)) { call trace.dirty_line(m_base(mshr(0))); }
                else                { call trace.clean_line(m_base(mshr(0))); };
                trace.mshr_free(0);
            };
            if ev_fill1 {
                if ev_fill1_occ { call trace.clean_line(ev_fill1_tag); };
                if m_dirty(mshr(1)) { call trace.dirty_line(m_base(mshr(1))); }
                else                { call trace.clean_line(m_base(mshr(1))); };
                trace.mshr_free(1);
            };
        }

        invariant [inv_hashkey] forall K : key, W : way.
            occupied(cache(K,W)) -> hash(tag(cache(K,W))) = K
        invariant [inv_syn] forall K1 : key, W1 : way, K2 : key, W2 : way.
            (occupied(cache(K1,W1)) & occupied(cache(K2,W2))
             & tag(cache(K1,W1)) = tag(cache(K2,W2))) -> (K1 = K2 & W1 = W2)

        invariant [inv_mbase_notag] forall K : key, W : way, Id : mshr_id.
            (m_state(mshr(Id)) ~= mshr_idle & occupied(cache(K,W))) ->
                tag(cache(K,W)) ~= m_base(mshr(Id))

        invariant [inv_diffbase]
            (m_state(mshr(0)) ~= mshr_idle & m_state(mshr(1)) ~= mshr_idle) ->
            m_base(mshr(0)) ~= m_base(mshr(1))
        invariant [inv_mshr_tr] forall Id : mshr_id.
            trace.mshr_wait(Id) = (m_state(mshr(Id)) ~= mshr_idle)
        invariant [inv_mshr_line] forall Id : mshr_id.
            m_state(mshr(Id)) ~= mshr_idle -> trace.mshr_line(Id) = m_base(mshr(Id))

        invariant [inv_noalias] forall K : key, W : way, Id : mshr_id.
            (trace.mshr_wait(Id) & occupied(cache(K,W))) ->
                tag(cache(K,W)) ~= trace.mshr_line(Id)

        invariant [inv_vway]
            (evicting(0) & evicting(1)
             & hash(m_base(mshr(0))) = hash(m_base(mshr(1)))) ->
                m_victim_way(mshr(0)) ~= m_victim_way(mshr(1))
        invariant [inv_victim] forall Id : mshr_id.
            evicting(Id) ->
                (occupied(cache(hash(m_base(mshr(Id))), m_victim_way(mshr(Id))))
               & dirty(cache(hash(m_base(mshr(Id))), m_victim_way(mshr(Id)))))

        invariant [inv_q_bound] rq_head(mshr(Id)) <= rq_next(mshr(Id)) & rq_next(mshr(Id)) <= 4
        invariant [inv_q_idle] m_state(mshr(Id)) = mshr_idle -> (rq_head(mshr(Id)) = rq_next(mshr(Id)) & ~rq_write_pending(mshr(Id)))
        invariant [inv_q_evict] evicting(Id) -> (rq_head(mshr(Id)) = rq_next(mshr(Id)) & ~rq_write_pending(mshr(Id)))
        invariant [inv_q_wlast] (rq_pend(Id,K) & rq_wen(m_q(mshr(Id),K))) ->
            (K + 1 = rq_next(mshr(Id)) & rq_write_pending(mshr(Id)))
        invariant [inv_q_haswr] rq_write_pending(mshr(Id)) -> rq_head(mshr(Id)) < rq_next(mshr(Id))
        invariant [inv_q_haswr2] (rq_write_pending(mshr(Id)) & K + 1 = rq_next(mshr(Id)) & K < 4) ->
            (rq_head(mshr(Id)) <= K & rq_wen(m_q(mshr(Id),K)))
        invariant [inv_onewr] ~(rq_write_pending(mshr(0)) & rq_write_pending(mshr(1)))
        invariant [inv_req_ready] membus.req_en -> (ready_r & ~membus.resp_valid)
        invariant [inv_ready] ready_r ->
            (~mshr_full(0) & ~mshr_full(1)
             & (m_state(mshr(0)) = mshr_idle | m_state(mshr(1)) = mshr_idle)
             & ~evicting(0) & ~evicting(1))

        invariant [t_tag_le] rq_pend(Id,K) -> (rq_tag(Id,K) <= trace.now & rq_tag(Id,K) ~= 0)
        invariant [t_qrd] (rq_pend(Id,K) & ~rq_wen(m_q(mshr(Id),K))) ->
            (trace.st(rq_tag(Id,K)).op = op_read
             & trace.st(rq_tag(Id,K)).op_addr = concatbv3(m_base(mshr(Id)), rq_off(m_q(mshr(Id),K))))
        invariant [t_qread] (rq_pend(Id,K) & ~rq_wen(m_q(mshr(Id),K))) ->
            trace.st(rq_tag(Id,K)).mem(concatbv3(m_base(mshr(Id)), rq_off(m_q(mshr(Id),K))))
              = cmem(m_base(mshr(Id)), rq_off(m_q(mshr(Id),K)))
        invariant [inv_qrd_chan] (rq_pend(Id,K) & ~rq_wen(m_q(mshr(Id),K))) ->
            (membus.rd_out & rq_tag(Id,K) = membus.lq_tg(membus.out_rid)
             & rq_rid(m_q(mshr(Id),K)) = membus.out_rid)
        invariant [inv_qrd_nresp] (rq_pend(Id,K) & ~rq_wen(m_q(mshr(Id),K))) ->
            ~membus.resp_valid
        invariant [inv_qrd_nreq] (rq_pend(Id,K) & ~rq_wen(m_q(mshr(Id),K))) ->
            ~(membus.req_en & ~membus.req_wen)
        invariant [inv_rd_head] (rq_pend(Id,K) & ~rq_wen(m_q(mshr(Id),K))) ->
            K = rq_head(mshr(Id))
        invariant [inv_rd_one] ~(
            (rq_pend(0, rq_head(mshr(0))) & ~rq_wen(m_q(mshr(0), rq_head(mshr(0)))))
          & (rq_pend(1, rq_head(mshr(1))) & ~rq_wen(m_q(mshr(1), rq_head(mshr(1))))))

        invariant [t_qwr] (rq_pend(Id,K) & rq_wen(m_q(mshr(Id),K))) ->
            (trace.st(rq_tag(Id,K)).op = op_write
             & trace.st(rq_tag(Id,K)).op_addr = concatbv3(m_base(mshr(Id)), rq_off(m_q(mshr(Id),K)))
             & trace.st(rq_tag(Id,K)).op_data = rq_wdata(m_q(mshr(Id),K)))
        invariant [inv_pw] trace.pend_valid =
            ((rq_write_pending(mshr(0)) | rq_write_pending(mshr(1))) | (membus.req_en & membus.req_wen))
        invariant [inv_pw_req] (membus.req_en & membus.req_wen) ->
            trace.pend_a = concatbv3(membus.req_h, membus.req_o)
        invariant [inv_pw_a] (rq_pend(Id,K) & rq_wen(m_q(mshr(Id),K))) ->
            (trace.pend_a = concatbv3(m_base(mshr(Id)), rq_off(m_q(mshr(Id),K)))
             & trace.ctag(m_base(mshr(Id)), rq_off(m_q(mshr(Id),K))) = rq_tag(Id,K))

        # ---- a write can neither be presented nor be sitting unapplied while
        # a read is in the cache: the request channel refuses a write while a
        # read is outstanding, and the cache is not ready while a write is
        # queued.  So the commit lag is closed for the whole life of a read,
        # and over that life the cached version cver is just ctag. ----
        invariant [inv_rd_nopw] membus.rd_out ->
            (~rq_write_pending(mshr(0)) & ~rq_write_pending(mshr(1)))
        invariant [inv_rd_nopend] membus.rd_out -> ~trace.pend_valid

        invariant [inv_cdirty] forall K : key, W : way.
            (occupied(cache(K,W)) & dirty(cache(K,W))) -> trace.cdirty(tag(cache(K,W)))
        invariant [inv_mshr_clean] forall Id : mshr_id.
            trace.mshr_wait(Id) -> ~trace.cdirty(trace.mshr_line(Id))

        invariant [inv_coh] forall K : key, W : way, O : woffset.
            occupied(cache(K,W)) -> val(cache(K,W),O) = cmem(tag(cache(K,W)), O)

        invariant [inv_memtag] forall H : line, O : woffset.
            trace.mmemv(H,O) = cmem(H,O)
          | trace.cdirty(H)
          | (m_state(mshr(0)) = mshr_drain & m_dirty(mshr(0)) & trace.mshr_line(0) = H)
          | (m_state(mshr(1)) = mshr_drain & m_dirty(mshr(1)) & trace.mshr_line(1) = H)

        invariant [inv_wb_lo_shipped] forall Id : mshr_id, O : woffset.
            (m_state(mshr(Id)) = mshr_drain & m_dphase(mshr(Id)) = dp_wb_hi & beat_of(O) = 0) ->
            trace.mmemv(tag(cache(hash(m_base(mshr(Id))), m_victim_way(mshr(Id)))), O)
              = cmem(tag(cache(hash(m_base(mshr(Id))), m_victim_way(mshr(Id)))), O)
        invariant [inv_wb_shipped] forall Id : mshr_id, O : woffset.
            (m_state(mshr(Id)) = mshr_drain & m_dphase(mshr(Id)) = dp_fill) ->
            trace.mmemv(tag(cache(hash(m_base(mshr(Id))), m_victim_way(mshr(Id)))), O)
              = cmem(tag(cache(hash(m_base(mshr(Id))), m_victim_way(mshr(Id)))), O)

        invariant [inv_fbuf_lo] forall Id : mshr_id, O : woffset.
            ((m_state(mshr(Id)) = mshr_finished_lower | m_state(mshr(Id)) = mshr_req_upper) & beat_of(O) = 0) ->
            m_fbuf(mshr(Id),O) = cmem(m_base(mshr(Id)), O)
        invariant [inv_fbuf] forall Id : mshr_id, O : woffset.
            m_state(mshr(Id)) = mshr_drain -> m_fbuf(mshr(Id),O) = cmem(m_base(mshr(Id)), O)
    }

    isolate iso = this with this, trace, membus, bus, mc, addr_thy, basis
}

module mc_body(trace, bus, membus) = {

    specification {
        invariant [coh] bus.rsp_valid ->
            ( unp0(bus.rsp_data) = trace.mmemv(high(bus.rsp_addr), concatbv2(beat_of(low(bus.rsp_addr)),0))
            & unp1(bus.rsp_data) = trace.mmemv(high(bus.rsp_addr), concatbv2(beat_of(low(bus.rsp_addr)),1))
            & unp2(bus.rsp_data) = trace.mmemv(high(bus.rsp_addr), concatbv2(beat_of(low(bus.rsp_addr)),2))
            & unp3(bus.rsp_data) = trace.mmemv(high(bus.rsp_addr), concatbv2(beat_of(low(bus.rsp_addr)),3)) )
    }

    implementation {
        function mmem(A : addr) : word

        var cb0_valid : bool
        var cb0_wen   : bool
        var cb0_addr  : addr
        var cb1_valid : bool
        var cb1_wen   : bool
        var cb1_addr  : addr
        var svc_count : nat

        after init {
            mmem(A) := 0;
            cb0_valid := false; cb0_wen := false; cb0_addr := 0;
            cb1_valid := false; cb1_wen := false; cb1_addr := 0;
            svc_count := 0;
        }

        definition bus.ready = ~(cb0_valid & cb1_valid) & ~bus.cmd_en

        after posedge {
            if bus.cmd_en {
                var a : addr := bus.cmd_addr;
                var d : four_words := bus.cmd_data;
                if bus.cmd_wen {
                    mmem(concatbv3(high(a), concatbv2(beat_of(low(a)), 0))) := unp0(d);
                    mmem(concatbv3(high(a), concatbv2(beat_of(low(a)), 1))) := unp1(d);
                    mmem(concatbv3(high(a), concatbv2(beat_of(low(a)), 2))) := unp2(d);
                    mmem(concatbv3(high(a), concatbv2(beat_of(low(a)), 3))) := unp3(d);
                };
                if ~cb0_valid {
                    cb0_valid := true; cb0_wen := bus.cmd_wen; cb0_addr := a;
                    svc_count := mem_latency;
                } else {
                    cb1_valid := true; cb1_wen := bus.cmd_wen; cb1_addr := a;
                };
                call bus.take_cmd;
            };

            if cb0_valid & (cb0_wen | ~bus.rsp_valid) {
                if svc_count = 0 {
                    if ~cb0_wen {
                        var h : line := high(cb0_addr);
                        var b : bit  := beat_of(low(cb0_addr));
                        bus.rresp(cb0_addr,
                                  pack4(mmem(concatbv3(h, concatbv2(b, 3))),
                                        mmem(concatbv3(h, concatbv2(b, 2))),
                                        mmem(concatbv3(h, concatbv2(b, 1))),
                                        mmem(concatbv3(h, concatbv2(b, 0)))));
                    };
                    if cb1_valid {
                        cb0_valid := true; cb0_wen := cb1_wen; cb0_addr := cb1_addr;
                        cb1_valid := false;
                        svc_count := mem_latency;
                    } else {
                        cb0_valid := false;
                    };
                } else {
                    svc_count := svc_count - 1;
                }
            };
        }

        invariant [cmd_room] bus.cmd_en -> ~(cb0_valid & cb1_valid)
        invariant [inv_mm] forall H : line, O : woffset.
            mmem(concatbv3(H, O)) = trace.mmemv(H, O)
          | (bus.cmd_en & bus.cmd_wen & high(bus.cmd_addr) = H
             & beat_of(low(bus.cmd_addr)) = beat_of(O))
    }

    isolate iso = this with this, trace, bus, membus, addr_thy, basis
}

instance memory_controller : mc_body(trace, bus, membus)
instance simple_cache : cache_body(trace, membus, bus, memory_controller)
instance the_lsq : lsq_body(trace, cpu, membus, simple_cache, bus)
